---
// Icone line monocromatiche per lo shop (stesso stile di ServiceIcon).
// Dimensione via --icon-size (default 1.4rem); colore via currentColor.
// "corso" e "servizio" restano per compatibilità; i reparti usano le altre.
interface Props {
  name: "corso" | "consulenza" | "servizio" | "formazione" | "sicurezza" | "haccp" | "privacy";
}
const { name } = Astro.props;
---

<span class="shop-icon" data-icon={name}>
  {(name === "corso" || name === "formazione") && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 4 2.5 8.5 12 13l9.5-4.5L12 4Z" />
      <path d="M6.5 10.7v4.5c0 1.4 2.5 2.5 5.5 2.5s5.5-1.1 5.5-2.5v-4.5" />
      <path d="M21.5 8.5v5.2" />
    </svg>
  )}
  {name === "consulenza" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2.8" y="6" width="12.7" height="12" rx="2.2" />
      <path d="m15.5 10.2 5.7-3.2v10l-5.7-3.2" />
    </svg>
  )}
  {name === "servizio" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6.5 3h7.6l4.4 4.4V21h-12V3Z" />
      <path d="M14 3v4.6h4.5" />
      <path d="M9.5 12.5h5.5M9.5 16h5.5" />
    </svg>
  )}
  {name === "sicurezza" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 3h9l5 5v6" />
      <path d="M14 3v5h5" />
      <path d="M5 3v18h7" />
      <path d="M17.5 13.5 21 15v2.6c0 2-1.5 3.5-3.5 4.4-2-.9-3.5-2.4-3.5-4.4V15l3.5-1.5Z" />
      <path d="M8 9h3M8 12.5h4" />
    </svg>
  )}
  {name === "haccp" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 15.5c-2.3-.5-4-2.4-4-4.7A4.6 4.6 0 0 1 8.2 6.2a4.6 4.6 0 0 1 7.6 0A4.6 4.6 0 0 1 21 10.8c0 2.3-1.7 4.2-4 4.7" />
      <path d="M7 13v7h10v-7" />
      <path d="M7 17h10" />
    </svg>
  )}
  {name === "privacy" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="4.5" y="10.5" width="15" height="10" rx="2.2" />
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
      <path d="M12 14.5v2.5" />
    </svg>
  )}
</span>

<style>
  .shop-icon { display: inline-flex; width: var(--icon-size, 1.4rem); height: var(--icon-size, 1.4rem); }
  .shop-icon svg { width: 100%; height: 100%; }
</style>
