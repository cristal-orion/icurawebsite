---
// Sezione aree con scroll orizzontale "pinnato": scorrendo la pagina le card entrano
// da destra, si fermano al centro (foto a colori + scansione) e poi lasciano il posto
// alla successiva. Su schermi stretti o con "riduci animazioni" diventa una lista verticale.
import ServiceIcon from "@components/ServiceIcon.astro";

const aree = [
  {
    titolo: "Consulenza e Sicurezza", slogan: "Proteggi ciò che conta.",
    desc: "Valutiamo i rischi, organizziamo la prevenzione e mettiamo in regola l’impresa: deleghe, modelli 231, privacy, ambiente. Quando arriva un’ispezione, trova un sistema che funziona.",
    comprende: ["Sicurezza D.Lgs. 81/08", "Cantieri", "GDPR e privacy", "HACCP e medicina"],
    href: "/servizi/consulenza", icon: "consulenza", img: "/images/macroaree-consulenza.webp",
    alt: "Consulenza e sicurezza sul lavoro iCura Impresa",
  },
  {
    titolo: "Engineering", slogan: "Costruisci su basi sicure.",
    desc: "Dal rilievo 3D alla progettazione di spazi e impianti, fino alla prevenzione incendi e al collaudo. Una sola squadra, un solo responsabile per pratica.",
    comprende: ["Progettazione", "Rilievi 3D", "Prevenzione incendi e CPI", "Collaudi e perizie"],
    href: "/servizi/engineering", icon: "engineering", img: "/images/macroaree-engineering.webp",
    alt: "Engineering e prevenzione incendi iCura Impresa",
  },
  {
    titolo: "Formazione", slogan: "Il futuro cresce con le persone.",
    desc: "Corsi per sviluppare competenze e rispettare gli obblighi di legge: in aula, a distanza o in azienda, senza fermare il lavoro. Dove possibile, con i fondi già versati.",
    comprende: ["Formazione obbligatoria", "Aula e a distanza", "Fondi interprofessionali", "Attestati e registri"],
    href: "/servizi/formazione", icon: "formazione", img: "/images/macroaree-formazione.webp",
    alt: "Formazione sicurezza in aula iCura Impresa",
  },
  {
    titolo: "Sistemi di Gestione", slogan: "Dai valore a come lavori.",
    desc: "Organizziamo processi e responsabilità e ti accompagniamo fino alla certificazione e alla qualificazione per le gare. La certificazione la rilascia l’organismo: noi ti portiamo fin lì.",
    comprende: ["ISO 9001, 14001, 45001", "ISO 27001 e 37001", "Parità di genere", "Attestazione SOA"],
    href: "/servizi/certificazioni", icon: "certificazioni", img: "/images/macroaree-certificazioni.webp",
    alt: "Certificazioni ISO e attestazione SOA iCura Impresa",
  },
  {
    titolo: "Finanza Agevolata", slogan: "Dai risorse alle tue idee.",
    desc: "Individuiamo i bandi compatibili con i tuoi progetti e li seguiamo dall’inizio alla fine: requisiti, domanda, rendicontazione.",
    comprende: ["Bando ISI INAIL", "ZES Unica Mezzogiorno", "Iper-ammortamento 2026–2028", "Fondi per la formazione"],
    href: "/servizi/finanza-agevolata", icon: "finanza-agevolata", img: "/images/macroaree-finanza-agevolata.webp",
    alt: "Finanza agevolata e bandi iCura Impresa",
  },
  {
    titolo: "Digitale e IA", slogan: "Dai forma digitale al tuo metodo.",
    desc: "Processi digitalizzati, app e gestionali su misura costruiti con l’intelligenza artificiale, integrati con sistemi di gestione e consulenza.",
    comprende: ["Processi digitalizzati", "App su misura", "Gestionali", "Intelligenza artificiale"],
    href: "/servizi/digitale", icon: "digitale", img: "/images/digitale-gestionale.webp",
    alt: "Gestionale digitale su misura iCura Impresa",
  },
] as const;
const N = aree.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<section id="servizi" class="aree" data-aree style={`--n: ${N}`} aria-labelledby="aree-heading">
  <div class="aree__sticky">
    <div class="container aree__head">
      <div>
        <p class="eyebrow">Le aree</p>
        <h2 id="aree-heading" class="aree__title">Dalla sicurezza ai bandi, <span class="italic">un solo</span> referente.</h2>
      </div>
      <div class="aree__meter" aria-hidden="true">
        <span class="aree__count"><span data-count>01</span> <span class="aree__count-tot">/ {pad(N)}</span></span>
        <span class="aree__progress"><span class="aree__progress-fill" data-progress></span></span>
      </div>
    </div>

    <div class="aree__viewport">
      <div class="aree__track" data-track>
        {aree.map((a, i) => (
          <a href={a.href} class:list={["area", { "is-active": i === 0 }]} data-panel>
            <span class="area__body">
              <span class="area__top" aria-hidden="true">
                <span class="area__n">{pad(i + 1)}</span>
                <span class="area__icon"><ServiceIcon name={a.icon} /></span>
              </span>
              <h3 class="area__title">{a.titolo}</h3>
              <span class="area__slogan">{a.slogan}</span>
              <span class="area__desc">{a.desc}</span>
              <ul class="area__tags">{a.comprende.map((c) => <li>{c}</li>)}</ul>
              <span class="area__cta">Scopri l’area <span aria-hidden="true">→</span></span>
            </span>
            <span class="area__media">
              <img src={a.img} alt={a.alt} loading="lazy" decoding="async" />
              <span class="area__scan" aria-hidden="true"></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-aree]").forEach((sec) => {
    const sticky = sec.querySelector<HTMLElement>(".aree__sticky")!;
    const track = sec.querySelector<HTMLElement>("[data-track]")!;
    const panels = [...sec.querySelectorAll<HTMLElement>("[data-panel]")];
    const count = sec.querySelector<HTMLElement>("[data-count]")!;
    const progress = sec.querySelector<HTMLElement>("[data-progress]")!;
    const N = panels.length;
    const mq = matchMedia("(min-width: 56.01rem) and (prefers-reduced-motion: no-preference)");
    let centers: number[] = [];
    let active = -1;
    let raf = 0;

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
    // Ogni card "sosta" al centro: il movimento avviene nel 60% centrale del tratto.
    const hold = (t: number) => { const x = clamp((t - 0.2) / 0.6); return x * x * (3 - 2 * x); };

    const measure = () => { centers = panels.map((p) => p.offsetLeft + p.offsetWidth / 2); };
    const scrollable = () => sec.offsetHeight - sticky.offsetHeight;

    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      panels.forEach((p, j) => p.classList.toggle("is-active", j === i));
      count.textContent = String(i + 1).padStart(2, "0");
    };

    const update = () => {
      raf = 0;
      if (!sec.classList.contains("is-pinned")) return;
      const p = clamp(-sec.getBoundingClientRect().top / scrollable());
      const raw = p * (N - 1);
      const i0 = Math.min(Math.floor(raw), N - 2);
      const pos = i0 + hold(raw - i0);
      const a = Math.floor(pos), f = pos - a;
      const c = centers[a] + ((centers[a + 1] ?? centers[a]) - centers[a]) * f;
      track.style.transform = `translate3d(${sticky.clientWidth / 2 - c}px, 0, 0)`;
      panels.forEach((el, j) => el.style.setProperty("--d", String(Math.min(Math.abs(j - pos), 1))));
      progress.style.transform = `scaleX(${p})`;
      setActive(Math.round(pos));
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(update); };

    const apply = () => {
      sec.classList.toggle("is-pinned", mq.matches);
      if (!mq.matches) {
        track.style.transform = "";
        panels.forEach((el) => el.style.removeProperty("--d"));
        return;
      }
      measure();
      queue();
    };

    addEventListener("scroll", queue, { passive: true });
    addEventListener("resize", () => { measure(); queue(); });
    mq.addEventListener("change", apply);
    apply();

    // Tastiera: il focus su una card fuori schermo porta lo scroll alla sua posizione.
    panels.forEach((el, i) => el.addEventListener("focus", () => {
      if (!sec.classList.contains("is-pinned")) return;
      const top = sec.getBoundingClientRect().top + scrollY;
      scrollTo({ top: top + (scrollable() * i) / (N - 1), behavior: "instant" as ScrollBehavior });
    }));
  });
</script>

<style>
  .aree {
    position: relative;
    background-color: var(--color-paper);
    background-image: radial-gradient(color-mix(in srgb, var(--color-ink) 9%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
    padding-block: var(--space-3xl);
  }

  .aree__head {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between;
    gap: var(--space-lg); margin-bottom: var(--space-xl);
  }
  .aree__title { font-size: var(--text-4xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; max-width: 16ch; margin: 0; }
  .aree__title .italic { font-style: italic; font-weight: 400; }
  .aree__meter { display: none; flex-direction: column; align-items: flex-end; gap: 0.6rem; }
  .aree__count { font-family: var(--font-mono); font-size: var(--text-2xl); font-weight: 600; color: var(--color-ink); letter-spacing: 0.04em; }
  .aree__count-tot { color: var(--color-muted); font-size: var(--text-md); }
  .aree__progress { position: relative; width: 12rem; height: 2px; background: var(--color-rule); overflow: hidden; border-radius: 2px; }
  .aree__progress-fill { position: absolute; inset: 0; background: var(--color-accent); transform: scaleX(0); transform-origin: left; }

  /* ── Lista verticale (mobile / riduci animazioni) ── */
  .aree__track { display: grid; gap: var(--space-lg); padding-inline: var(--page-gutter); max-width: var(--page-max); margin-inline: auto; }

  .area {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--color-surface);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    color: inherit; text-decoration: none;
  }
  .area:hover { text-decoration: none; }
  .area__body { display: flex; flex-direction: column; padding: clamp(var(--space-lg), 3vw, var(--space-2xl)); }
  .area__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-lg); }
  .area__n { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; letter-spacing: 0.1em; color: var(--color-accent); }
  .area__icon { --icon-size: 2rem; color: var(--color-accent); }
  .area__title { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 var(--space-xs); color: var(--color-ink); }
  .area__slogan { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--color-accent); margin-bottom: var(--space-md); }
  .area__desc { font-size: var(--text-md); line-height: 1.6; color: var(--color-ink-2); max-width: 46ch; }
  .area__tags { list-style: none; margin: var(--space-lg) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .area__tags li {
    font-size: var(--text-xs); font-weight: 500; white-space: nowrap;
    padding: 0.3rem 0.7rem; border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent); color: var(--color-ink-2);
  }
  .area__cta { margin-top: auto; padding-top: var(--space-lg); font-weight: 600; font-size: var(--text-sm); color: var(--color-accent); display: inline-flex; gap: 0.5em; }
  .area__cta span { transition: transform var(--dur-base) var(--ease-out); }
  .area:hover .area__cta span { transform: translateX(4px); }

  .area__media { position: relative; overflow: hidden; background: var(--color-ink); min-height: 16rem; }
  .area__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .area__scan { display: none; }

  /* ── Modalità "pinnata": scroll verticale → movimento orizzontale ── */
  .aree.is-pinned { height: calc(100svh + (var(--n) - 1) * 75svh); padding: 0; }
  .aree.is-pinned .aree__sticky {
    position: sticky; top: var(--header-h);
    height: calc(100svh - var(--header-h));
    display: flex; flex-direction: column; justify-content: center;
    overflow: hidden;
    padding-block: var(--space-xl);
  }
  .aree.is-pinned .aree__meter { display: flex; }
  .aree.is-pinned .aree__head { margin-bottom: var(--space-lg); }
  .aree.is-pinned .aree__title { font-size: var(--text-3xl); max-width: 24ch; }
  .aree.is-pinned .aree__viewport { flex: 1; min-height: 0; display: flex; align-items: center; }
  .aree.is-pinned .aree__track {
    display: flex; gap: var(--space-2xl);
    padding: 0; margin: 0; max-width: none;
    will-change: transform;
  }
  .aree.is-pinned .area {
    --d: 1;
    flex: none;
    width: min(66rem, 76vw);
    height: min(30rem, 100%);
    transform: scale(calc(1 - var(--d) * 0.1));
    opacity: calc(1 - var(--d) * 0.55);
  }
  .aree.is-pinned .aree__viewport { height: 100%; }
  .aree.is-pinned .area__media img {
    filter: grayscale(100%);
    transform: scale(1.06);
    transition: filter 0.8s var(--ease-out), transform 1.2s var(--ease-out);
  }
  .aree.is-pinned .area.is-active { box-shadow: var(--shadow-lift); border-color: color-mix(in srgb, var(--color-accent) 35%, transparent); }
  .aree.is-pinned .area.is-active .area__media img { filter: none; transform: scale(1); }

  /* Linea di scansione quando la card arriva al centro */
  .aree.is-pinned .area__scan {
    display: block;
    position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: #93c5fd;
    box-shadow: 0 0 18px 4px color-mix(in srgb, var(--color-accent) 70%, transparent);
    opacity: 0;
  }
  .aree.is-pinned .area.is-active .area__scan { animation: area-scan 1.1s var(--ease-in-out) forwards; }
  @keyframes area-scan {
    0% { top: 0; opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  @media (max-width: 56rem) {
    .area { grid-template-columns: 1fr; }
    .area__media { order: -1; min-height: 0; aspect-ratio: 16 / 9; }
  }
</style>
