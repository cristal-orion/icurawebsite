---
const { pathname } = Astro.url;
const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname.startsWith(path);

// Mega-menu Servizi: ogni colonna = una pagina servizio + sotto-voci che
// atterrano su ancore (id sulle card AreaGrid) nelle pagine esistenti.
const menu = [
  {
    label: "Consulenza",
    href: "/servizi/consulenza",
    voci: [
      { label: "Sicurezza sul lavoro · 81/08", href: "/servizi/consulenza#sicurezza-lavoro" },
      { label: "Sicurezza nei cantieri", href: "/servizi/consulenza#cantieri" },
      { label: "HACCP alimentare", href: "/servizi/consulenza#haccp" },
      { label: "Medicina del lavoro", href: "/servizi/consulenza#medicina-lavoro" },
      { label: "GDPR & Privacy", href: "/servizi/consulenza#gdpr" },
      { label: "Consulenza ambientale", href: "/servizi/consulenza#ambiente" },
    ],
  },
  {
    label: "Engineering",
    href: "/servizi/engineering",
    voci: [
      { label: "Progettazione edile", href: "/servizi/engineering#edile" },
      { label: "Impiantistica", href: "/servizi/engineering#impianti" },
      { label: "Prevenzione incendi · CPI", href: "/servizi/engineering#antincendio" },
      { label: "Collaudi e perizie", href: "/servizi/engineering#collaudi" },
      { label: "Qualifiche e test materiali", href: "/servizi/engineering#qualifiche" },
    ],
  },
  {
    label: "Formazione",
    href: "/servizi/formazione",
    voci: [
      { label: "Formazione lavoratori", href: "/servizi/formazione#cat-lavoratori" },
      { label: "Ruoli · RSPP, RLS, preposti", href: "/servizi/formazione#cat-ruoli" },
      { label: "Antincendio · primo soccorso", href: "/servizi/formazione#cat-emergenze" },
      { label: "Attrezzature · carrelli, PLE", href: "/servizi/formazione#cat-attrezzature" },
      { label: "Corsi finanziati", href: "/servizi/formazione#formazione-fondi" },
    ],
  },
  {
    label: "Certificazioni",
    href: "/servizi/certificazioni",
    voci: [
      { label: "ISO 9001 · Qualità", href: "/servizi/certificazioni#iso-9001" },
      { label: "ISO 14001 · Ambiente", href: "/servizi/certificazioni#iso-14001" },
      { label: "ISO 45001 · Sicurezza", href: "/servizi/certificazioni#iso-45001" },
      { label: "Parità di genere · 125", href: "/servizi/certificazioni#parita" },
      { label: "Attestazione SOA", href: "/servizi/certificazioni#soa" },
    ],
  },
  {
    label: "Finanza agevolata",
    href: "/servizi/finanza-agevolata",
    voci: [
      { label: "Bando ISI INAIL", href: "/bando-isi" },
      { label: "ZES Unica 2026", href: "/zes-unica" },
      { label: "Sgravi INAIL · OT23", href: "/servizi/finanza-agevolata#ot23" },
      { label: "Transizione 5.0", href: "/servizi/finanza-agevolata#transizione" },
      { label: "Formazione finanziata", href: "/servizi/formazione#formazione-fondi" },
    ],
  },
];

const agevolazioni = [
  { label: "ZES Unica 2026", href: "/zes-unica" },
  { label: "Bando ISI INAIL", href: "/bando-isi" },
];

const serviziActive =
  pathname.startsWith("/servizi") ||
  pathname === "/zes-unica" ||
  pathname === "/bando-isi";
---

<a href="#main" class="skip-link">Salta al contenuto</a>

<nav class="nav-pill" aria-label="Navigazione principale">
  <a href="/" class="nav-pill__wordmark" aria-label="iCura Impresa, homepage">
    <span>iCura Impresa</span>
  </a>

  <ul class="nav-pill__links">
    <li>
      <a
        href="/chi-siamo"
        class={`nav-pill__link${isActive("/chi-siamo") ? " is-active" : ""}`}
        aria-current={isActive("/chi-siamo") ? "page" : undefined}
      >
        Chi siamo
      </a>
    </li>

    <li class="nav-pill__dropdown" data-dropdown>
      <button
        type="button"
        class={`nav-pill__link nav-pill__trigger${serviziActive ? " is-active" : ""}`}
        aria-expanded="false"
        aria-haspopup="true"
        aria-controls="nav-servizi-menu"
        data-dropdown-trigger
      >
        Servizi
        <span class="nav-pill__caret" aria-hidden="true">▾</span>
      </button>
      <ul id="nav-servizi-menu" class="nav-pill__menu nav-pill__mega" data-dropdown-menu>
        {menu.map((col) => (
          <li class="nav-mega__col">
            <a
              href={col.href}
              class={`nav-mega__head${isActive(col.href) ? " is-active" : ""}`}
              aria-current={isActive(col.href) ? "page" : undefined}
            >
              {col.label}
            </a>
            <ul class="nav-mega__sub">
              {col.voci.map((v) => (
                <li>
                  <a href={v.href} class="nav-mega__link">{v.label}</a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </li>

    <li>
      <a
        href="/lavora-con-noi"
        class={`nav-pill__link${isActive("/lavora-con-noi") ? " is-active" : ""}`}
        aria-current={isActive("/lavora-con-noi") ? "page" : undefined}
      >
        Lavora con noi
      </a>
    </li>

    <li>
      <a
        href="/contatti"
        class={`nav-pill__link${isActive("/contatti") ? " is-active" : ""}`}
        aria-current={isActive("/contatti") ? "page" : undefined}
      >
        Contatti
      </a>
    </li>
  </ul>

  <a href="/contatti" class="nav-pill__cta">
    Richiedi consulenza
    <span aria-hidden="true">→</span>
  </a>

  <button
    type="button"
    class="nav-pill__burger"
    data-nav-toggle
    aria-expanded="false"
    aria-controls="nav-mobile"
    aria-label="Apri il menu di navigazione"
  >
    <span class="nav-pill__burger-bar" aria-hidden="true"></span>
    <span class="nav-pill__burger-bar" aria-hidden="true"></span>
  </button>
</nav>

<div class="nav-mobile" id="nav-mobile" data-nav-mobile hidden>
  <ul class="nav-mobile__list">
    <li>
      <a href="/chi-siamo" class={isActive("/chi-siamo") ? "is-active" : undefined}>Chi siamo</a>
    </li>
    <li class="nav-mobile__group">
      <span class="nav-mobile__group-label">Servizi</span>
      <ul>
        {menu.map((col) => (
          <li>
            <a href={col.href} class={isActive(col.href) ? "is-active" : undefined}>{col.label}</a>
          </li>
        ))}
      </ul>
    </li>
    <li class="nav-mobile__group">
      <span class="nav-mobile__group-label">Agevolazioni</span>
      <ul>
        {agevolazioni.map((a) => (
          <li>
            <a href={a.href} class={isActive(a.href) ? "is-active" : undefined}>{a.label}</a>
          </li>
        ))}
      </ul>
    </li>
    <li>
      <a href="/lavora-con-noi" class={isActive("/lavora-con-noi") ? "is-active" : undefined}>Lavora con noi</a>
    </li>
    <li>
      <a href="/contatti" class={isActive("/contatti") ? "is-active" : undefined}>Contatti</a>
    </li>
  </ul>
  <a href="/contatti" class="btn btn--primary nav-mobile__cta">
    Richiedi consulenza
    <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    if (!trigger || !menu) return;

    const open = () => {
      dropdown.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      dropdown.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    };
    const toggle = () => (dropdown.classList.contains("is-open") ? close() : open());

    trigger.addEventListener("click", toggle);

    // Esc chiude e riporta il focus al trigger
    dropdown.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        close();
        trigger.focus();
      }
    });

    // Click fuori chiude
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node)) close();
    });

    // Focus fuori dal dropdown chiude
    dropdown.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!dropdown.contains(document.activeElement)) close();
      });
    });
  });

  // Menu mobile (hamburger)
  const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navMobile = document.querySelector<HTMLElement>("[data-nav-mobile]");
  if (navToggle && navMobile) {
    const closeNav = () => {
      navMobile.hidden = true;
      navToggle.setAttribute("aria-expanded", "false");
    };
    const openNav = () => {
      navMobile.hidden = false;
      navToggle.setAttribute("aria-expanded", "true");
    };
    navToggle.addEventListener("click", () => {
      navMobile.hidden ? openNav() : closeNav();
    });
    navMobile.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", closeNav)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!navMobile.hidden && !navMobile.contains(t) && !navToggle.contains(t)) {
        closeNav();
      }
    });
  }
</script>

<style>
  .nav-pill {
    position: fixed;
    top: var(--space-md);
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
    padding: 0.5rem 0.5rem 0.5rem 1rem;
    background: color-mix(in oklch, var(--color-paper) 80%, transparent);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-pill);
    box-shadow: 0 8px 24px -16px oklch(0% 0 0 / 0.18);
    z-index: 50;
    max-width: calc(100% - var(--page-gutter) * 2);
  }

  .nav-pill__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-decoration: none;
    padding-right: 0.25rem;
  }
  .nav-pill__wordmark:hover { text-decoration: none; }

  .nav-pill__links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0 var(--space-sm);
    border-left: var(--rule-hair) solid var(--color-rule);
    border-right: var(--rule-hair) solid var(--color-rule);
  }

  .nav-pill__link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    padding: 0.35rem 0;
    transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .nav-pill__link:hover { color: var(--color-ink); text-decoration: none; }
  .nav-pill__link.is-active { color: var(--color-ink); }
  .nav-pill__link.is-active::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -0.7em;
    transform: translateY(-50%);
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--color-highlight);
  }

  /* Trigger del dropdown — pulsante che si comporta da link */
  .nav-pill__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .nav-pill__caret {
    font-size: 0.7em;
    line-height: 1;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .nav-pill__dropdown.is-open .nav-pill__caret { transform: rotate(180deg); }

  /* Menu a tendina */
  .nav-pill__dropdown { position: relative; }
  .nav-pill__menu {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 50%;
    transform: translateX(-50%) translateY(-0.25rem);
    min-width: 13rem;
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    background: color-mix(in oklch, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    box-shadow: 0 12px 32px -18px oklch(0% 0 0 / 0.28);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .nav-pill__dropdown:hover .nav-pill__menu,
  .nav-pill__dropdown:focus-within .nav-pill__menu,
  .nav-pill__dropdown.is-open .nav-pill__menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .nav-pill__menu-link {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-input);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .nav-pill__menu-link:hover {
    background: var(--color-paper-3);
    color: var(--color-ink);
    text-decoration: none;
  }
  .nav-pill__menu-link.is-active { color: var(--color-ink); font-weight: 500; }

  /* Mega-menu Servizi — pannello a colonne, centrato sul viewport
     (position:fixed) così con 5 colonne non sfora mai i bordi. */
  .nav-pill__mega {
    position: fixed;
    top: calc(var(--space-md) + 3.4rem);
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-md) var(--space-lg);
    width: min(56rem, calc(100vw - 1.5rem));
    max-width: calc(100vw - 1.5rem);
    padding: var(--space-md);
  }
  .nav-mega__col { min-width: 0; }
  .nav-mega__head {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0.25rem 0.4rem 0.5rem;
    margin-bottom: 0.4rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .nav-mega__head:hover { color: var(--color-accent); text-decoration: none; }
  .nav-mega__head.is-active { color: var(--color-accent); }
  .nav-mega__sub {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .nav-mega__link {
    display: block;
    padding: 0.32rem 0.4rem;
    border-radius: var(--radius-input);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .nav-mega__link:hover {
    background: var(--color-paper-3);
    color: var(--color-ink);
    text-decoration: none;
  }

  .nav-pill__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.5rem 1rem;
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .nav-pill__cta:hover {
    background: var(--color-accent-hover);
    text-decoration: none;
  }

  /* Hamburger — solo mobile */
  .nav-pill__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    border-radius: var(--radius-input);
  }
  .nav-pill__burger-bar {
    display: block;
    width: 1.15rem;
    height: 2px;
    margin-inline: auto;
    background: var(--color-ink);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }
  .nav-pill__burger[aria-expanded="true"] .nav-pill__burger-bar:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }
  .nav-pill__burger[aria-expanded="true"] .nav-pill__burger-bar:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* Pannello menu mobile */
  .nav-mobile {
    position: fixed;
    top: calc(var(--space-md) + 3.25rem);
    left: var(--page-gutter);
    right: var(--page-gutter);
    z-index: 49;
    margin-inline: auto;
    max-width: 26rem;
    padding: var(--space-sm);
    background: color-mix(in oklch, var(--color-paper) 96%, transparent);
    backdrop-filter: blur(14px) saturate(130%);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    box-shadow: 0 16px 44px -22px oklch(0% 0 0 / 0.34);
  }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .nav-mobile__list a {
    display: block;
    padding: 0.7rem 0.6rem;
    font-size: var(--text-md);
    color: var(--color-ink);
    text-decoration: none;
    border-radius: var(--radius-input);
  }
  .nav-mobile__list a:hover { background: var(--color-paper-3); text-decoration: none; }
  .nav-mobile__list a.is-active { color: var(--color-accent); font-weight: 500; }
  .nav-mobile__group-label {
    display: block;
    padding: 0.7rem 0.6rem 0.2rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }
  .nav-mobile__group ul { list-style: none; margin: 0; padding: 0 0 0 var(--space-sm); }
  .nav-mobile__cta {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-sm);
  }

  /* Mobile — pill compatta: wordmark + hamburger; link e CTA nel menu */
  @media (max-width: 56rem) {
    .nav-pill { gap: var(--space-sm); padding: 0.4rem 0.4rem 0.4rem 0.85rem; }
    .nav-pill__links { display: none; }
    .nav-pill__cta { display: none; }
    .nav-pill__burger { display: flex; }
  }

  /* Desktop — il pannello mobile resta nascosto anche se aperto e si ridimensiona */
  @media (min-width: 56.0625rem) {
    .nav-mobile { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-pill__menu { transition: opacity var(--dur-fast) var(--ease-out); transform: translateX(-50%); }
    .nav-pill__dropdown:hover .nav-pill__menu,
    .nav-pill__dropdown:focus-within .nav-pill__menu,
    .nav-pill__dropdown.is-open .nav-pill__menu { transform: translateX(-50%); }
    .nav-pill__caret { transition: none; }
  }
</style>
