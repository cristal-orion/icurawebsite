---
import ServiceIcon from "@components/ServiceIcon.astro";
import { aree as areeHome } from "../data/home";
// Mega-menu Servizi: colonne e voci stanno in data/menu.ts (le usa anche lo schedario in home).
import { menu } from "../data/menu";

const { pathname } = Astro.url;
// Nelle pagine con hero navy l'header parte scuro e torna chiaro appena si scorre.
const darkTopPages = ["/", "/lavora-con-noi", "/bando-isi", "/zes-unica"];
const darkTop =
  darkTopPages.includes(pathname.replace(/\/$/, "") || "/") ||
  pathname.startsWith("/acquista") ||
  pathname.startsWith("/servizi/"); // tutte le pagine servizio hanno PageHero
const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname.startsWith(path);

// Per il mega-menu: ogni colonna del menu + slogan, descrizione, icona e foto
// della stessa area in home (src/data/home.ts), abbinati per indirizzo.
const aree = menu.map((col) => {
  const a = areeHome.find((x) => x.href === col.href);
  return {
    ...col,
    slogan: a?.slogan ?? "",
    desc: a?.desc ?? "",
    icon: a?.icon ?? "consulenza",
    img: a?.img ?? "",
  };
});

const agevolazioni = [
  { label: "ZES Unica Mezzogiorno", href: "/zes-unica" },
  { label: "Bando ISI INAIL", href: "/bando-isi" },
];

// Voce in evidenza (badge amber). Cambia qui label/href per evidenziare altro.
// Bando ISI resta raggiungibile dal menu Finanza Agevolata.
const promo = {
  label: "Acquista online",
  href: "/acquista",
  badge: "Nuovo",
};

const serviziActive =
  pathname.startsWith("/servizi") ||
  pathname === "/zes-unica" ||
  pathname === "/bando-isi";
---

<a href="#main" class="skip-link">Salta al contenuto</a>

<header class:list={["site-header", { "site-header--dark-top is-top": darkTop }]} data-site-header>
  <nav class="site-header__inner" aria-label="Navigazione principale">
    <a href="/" class="site-header__wordmark" aria-label="iCuraImpresa, homepage">
      i<strong>Cura</strong>Impresa<span class="site-header__dot" aria-hidden="true">.</span>
    </a>

    <ul class="site-nav">
      <li>
        <a
          href="/chi-siamo"
          class={`site-nav__link${isActive("/chi-siamo") ? " is-active" : ""}`}
          aria-current={isActive("/chi-siamo") ? "page" : undefined}
        >
          Chi siamo
        </a>
      </li>

      <li class="site-nav__dropdown" data-dropdown>
        <button
          type="button"
          class={`site-nav__link site-nav__trigger${serviziActive ? " is-active" : ""}`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="nav-servizi-menu"
          data-dropdown-trigger
        >
          Servizi
          <span class="site-nav__caret" aria-hidden="true">▾</span>
        </button>
        <div id="nav-servizi-menu" class="site-mega" data-dropdown-menu data-mega>
          {/* colonna sinistra: le aree. Passarci sopra (o col focus) cambia il pannello. */}
          <ul class="site-mega__rail">
            {aree.map((a, i) => (
              <li>
                <a
                  href={a.href}
                  class:list={["site-mega__area", { "is-current": isActive(a.href) }]}
                  aria-current={isActive(a.href) ? "page" : undefined}
                  data-mega-area={i}
                >
                  <span class="site-mega__icon"><ServiceIcon name={a.icon} /></span>
                  <span class="site-mega__area-txt">
                    <span class="site-mega__area-name">{a.label}</span>
                    <span class="site-mega__area-slogan">{a.slogan}</span>
                  </span>
                  <span class="site-mega__area-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>

          {/* pannelli: uno per area, visibile solo quello attivo */}
          <div class="site-mega__panels">
            {aree.map((a, i) => (
              <section class="site-mega__panel" data-mega-panel={i} aria-label={a.label}>
                <div class="site-mega__detail">
                  <a href={a.href} class="site-mega__title">{a.label}</a>
                  <p class="site-mega__desc">{a.desc}</p>
                  <ul class="site-mega__links">
                    {a.voci.map((v) => (
                      <li><a href={v.href} class="site-mega__link">{v.label}<span aria-hidden="true">→</span></a></li>
                    ))}
                  </ul>
                  <a href={a.href} class="site-mega__all">Tutta l’area {a.label} <span aria-hidden="true">→</span></a>
                </div>
                <figure class="site-mega__media">
                  <img src={a.img} alt="" loading="lazy" decoding="async" />
                  <figcaption>{a.slogan}</figcaption>
                </figure>
              </section>
            ))}
            <div class="site-mega__help">
              <p><strong>Non sai da dove partire?</strong> Raccontaci l’esigenza: ti indichiamo noi l’area giusta.</p>
              <div class="site-mega__help-actions">
                <a href="tel:+390816580779" class="site-mega__phone">081 658 0779</a>
                <a href="/contatti" class="site-mega__cta">Richiedi consulenza <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </div>
      </li>

      <li>
        <a
          href="/blog"
          class={`site-nav__link${isActive("/blog") ? " is-active" : ""}`}
          aria-current={isActive("/blog") ? "page" : undefined}
        >
          Blog
        </a>
      </li>

      <li>
        <a
          href="/lavora-con-noi"
          class={`site-nav__link${isActive("/lavora-con-noi") ? " is-active" : ""}`}
          aria-current={isActive("/lavora-con-noi") ? "page" : undefined}
        >
          Lavora con noi
        </a>
      </li>

      <li>
        <a
          href="/contatti"
          class={`site-nav__link${isActive("/contatti") ? " is-active" : ""}`}
          aria-current={isActive("/contatti") ? "page" : undefined}
        >
          Contatti
        </a>
      </li>
    </ul>

    <div class="site-header__actions">
      <a
        href={promo.href}
        class={`site-header__promo${isActive(promo.href) ? " is-active" : ""}`}
      >
        <span class="site-header__promo-badge">{promo.badge}</span>
        <span class="site-header__promo-label">{promo.label}</span>
      </a>
      <a href="tel:+390816580779" class="site-header__phone">081 658 0779</a>
      <a href="/contatti" class="site-header__cta">
        Richiedi consulenza
        <span aria-hidden="true">→</span>
      </a>

      <button
        type="button"
        class="site-header__burger"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Apri il menu di navigazione"
      >
        <span class="site-header__burger-bar" aria-hidden="true"></span>
        <span class="site-header__burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<div class="nav-mobile" id="nav-mobile" data-nav-mobile hidden>
  <a href={promo.href} class="nav-mobile__promo">
    <span class="nav-mobile__promo-badge">{promo.badge}</span>
    <span>{promo.label}</span>
    <span aria-hidden="true">→</span>
  </a>
  <ul class="nav-mobile__list">
    <li>
      <a href="/chi-siamo" class={isActive("/chi-siamo") ? "is-active" : undefined}>Chi siamo</a>
    </li>
    <li class="nav-mobile__group">
      <span class="nav-mobile__group-label">Servizi</span>
      <ul>
        {aree.map((col) => (
          <li>
            <a href={col.href} class:list={["nav-mobile__area", { "is-active": isActive(col.href) }]}>
              <span class="nav-mobile__icon"><ServiceIcon name={col.icon} /></span>{col.label}
            </a>
          </li>
        ))}
      </ul>
    </li>
    <li>
      <a href="/blog" class={isActive("/blog") ? "is-active" : undefined}>Blog</a>
    </li>
    <li class="nav-mobile__group">
      <span class="nav-mobile__group-label">Agevolazioni</span>
      <ul>
        {agevolazioni.map((a) => (
          <li>
            <a href={a.href} class={isActive(a.href) ? "is-active" : undefined}>{a.label}</a>
          </li>
        ))}
      </ul>
    </li>
    <li>
      <a href="/lavora-con-noi" class={isActive("/lavora-con-noi") ? "is-active" : undefined}>Lavora con noi</a>
    </li>
    <li>
      <a href="/contatti" class={isActive("/contatti") ? "is-active" : undefined}>Contatti</a>
    </li>
  </ul>
  <a href="/contatti" class="btn btn--primary nav-mobile__cta">
    Richiedi consulenza
    <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    if (!trigger || !menu) return;

    const open = () => {
      dropdown.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      dropdown.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    };
    const toggle = () => (dropdown.classList.contains("is-open") ? close() : open());

    trigger.addEventListener("click", toggle);

    // Esc chiude e riporta il focus al trigger
    dropdown.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        close();
        trigger.focus();
      }
    });

    // Click fuori chiude
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node)) close();
    });

    // Focus fuori dal dropdown chiude
    dropdown.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!dropdown.contains(document.activeElement)) close();
      });
    });

    // Col mouse si apre al passaggio (con un attimo di tolleranza, così non si chiude
    // mentre ci si sposta dal pulsante al pannello). Il clic resta per touch e tastiera.
    if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let timer = 0;
      dropdown.addEventListener("pointerenter", () => { clearTimeout(timer); timer = window.setTimeout(open, 90); });
      dropdown.addEventListener("pointerleave", () => { clearTimeout(timer); timer = window.setTimeout(close, 220); });
    }

    // Mega-menu: l'area sotto il puntatore (o col focus) mostra il suo pannello.
    const areas = [...menu.querySelectorAll<HTMLElement>("[data-mega-area]")];
    const panels = [...menu.querySelectorAll<HTMLElement>("[data-mega-panel]")];
    if (!areas.length) return;
    const show = (i: number) => {
      areas.forEach((a, j) => a.classList.toggle("is-active", j === i));
      panels.forEach((p, j) => p.classList.toggle("is-active", j === i));
    };
    const current = areas.findIndex((a) => a.classList.contains("is-current"));
    show(current >= 0 ? current : 0);
    areas.forEach((a, i) => {
      a.addEventListener("pointerenter", () => show(i));
      a.addEventListener("focus", () => show(i));
      // frecce su/giù per scorrere le aree
      a.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
        e.preventDefault();
        areas[(i + (e.key === "ArrowDown" ? 1 : areas.length - 1)) % areas.length].focus();
      });
    });
  });

  // Header scuro sopra l'hero: diventa chiaro appena inizia lo scroll.
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header?.classList.contains("site-header--dark-top")) {
    const sync = () => header.classList.toggle("is-top", scrollY < 8);
    sync();
    addEventListener("scroll", sync, { passive: true });
  }

  // Menu mobile (hamburger)
  const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navMobile = document.querySelector<HTMLElement>("[data-nav-mobile]");
  if (navToggle && navMobile) {
    const closeNav = () => {
      navMobile.hidden = true;
      navToggle.setAttribute("aria-expanded", "false");
    };
    const openNav = () => {
      navMobile.hidden = false;
      navToggle.setAttribute("aria-expanded", "true");
    };
    navToggle.addEventListener("click", () => {
      navMobile.hidden ? openNav() : closeNav();
    });
    navMobile.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", closeNav)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!navMobile.hidden && !navMobile.contains(t) && !navToggle.contains(t)) {
        closeNav();
      }
    });
  }
</script>

<style>
  /* ── Barra header a tutta larghezza (clinico-tech) ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    min-height: var(--header-h);
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: var(--rule-hair) solid var(--color-rule);
    transition: background 0.35s var(--ease-out), border-color 0.35s var(--ease-out);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
    max-width: 84rem;
    min-height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .site-header__wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-wordmark);
    font-weight: 500;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__wordmark strong { font-weight: 800; }
  .site-header__wordmark:hover { text-decoration: none; }
  .site-header__dot { color: var(--color-accent); }

  /* ── Link di navigazione ── */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
    margin: 0 auto 0 var(--space-md);
    padding: 0;
  }
  .site-nav__link {
    position: relative;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    text-decoration: none;
    padding: 0.4rem 0;
    transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .site-nav__link:hover { color: var(--color-accent); text-decoration: none; }
  .site-nav__link.is-active { color: var(--color-accent); }

  .site-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .site-nav__caret {
    font-size: 0.7em;
    line-height: 1;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-nav__dropdown { position: relative; }
  .site-nav__dropdown.is-open .site-nav__caret { transform: rotate(180deg); }

  /* ── Mega-menu Servizi — pannello navy a due livelli: aree a sinistra, dettaglio a destra ── */
  .site-mega {
    --m-sky: #60a5fa;
    --m-rail: #070d1a;
    --m-tile: #16213a;
    position: fixed;
    top: calc(var(--header-h) + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(-0.5rem);
    z-index: 50;
    display: grid;
    grid-template-columns: 20rem 1fr;
    width: min(72rem, calc(100vw - 1.5rem));
    margin: 0;
    color: #e2e8f0;
    background: #0b1324;
    border-radius: 18px;
    box-shadow: 0 40px 80px -30px rgba(2, 6, 23, 0.75); /* taste-skill-ignore: è un menu sospeso sopra la pagina */
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
  }
  .site-nav__dropdown.is-open .site-mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
    transition: opacity var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out), visibility 0s;
  }

  /* colonna aree: un tono più scuro del pannello, niente filo di separazione */
  .site-mega__rail {
    list-style: none; margin: 0; padding: 0.75rem;
    display: flex; flex-direction: column; gap: 2px;
    background: var(--m-rail);
  }
  .site-mega__area {
    position: relative;
    display: grid; grid-template-columns: 2.5rem 1fr auto; align-items: center; gap: 0.85rem;
    padding: 0.7rem 0.75rem;
    border-radius: 12px;
    color: #cbd5e1; text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .site-mega__area:hover { text-decoration: none; }
  .site-mega__area.is-active { background: var(--m-tile); color: #fff; }
  .site-mega__area:focus-visible { outline: 2px solid var(--m-sky); outline-offset: -2px; }
  .site-mega__icon {
    display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 10px;
    color: var(--m-sky); background: rgba(59, 130, 246, 0.14);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .site-mega__icon :global(svg) { width: 1.25rem; height: 1.25rem; }
  .site-mega__area.is-active .site-mega__icon { background: var(--color-accent); color: #fff; }
  .site-mega__area-txt { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .site-mega__area-name { font-family: var(--font-display); font-weight: 600; font-size: var(--text-md); letter-spacing: -0.01em; }
  .site-mega__area-slogan { font-size: var(--text-sm); line-height: 1.35; color: #94a3b8; }
  .site-mega__area.is-active .site-mega__area-slogan { color: #cbd5e1; }
  .site-mega__area-arrow { color: var(--m-sky); opacity: 0; transform: translateX(-4px); transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .site-mega__area.is-active .site-mega__area-arrow { opacity: 1; transform: none; }
  .site-mega__area.is-current .site-mega__area-name::after { content: " ·"; color: var(--m-sky); }

  /* pannelli di dettaglio */
  .site-mega__panels { display: grid; grid-template-rows: 1fr auto; min-width: 0; }
  .site-mega__panel { display: none; grid-template-columns: 1fr 16rem; gap: var(--space-xl); padding: 1.75rem 1.75rem 1.5rem; }
  .site-mega__panel.is-active { display: grid; animation: mega-in var(--dur-base) var(--ease-out); }
  @keyframes mega-in { from { opacity: 0; transform: translateX(6px); } }
  .site-mega__detail { display: flex; flex-direction: column; min-width: 0; }
  .site-mega__title { font-family: var(--font-display); font-weight: 700; font-size: var(--text-2xl); letter-spacing: -0.02em; line-height: 1.1; color: #fff; text-decoration: none; }
  .site-mega__title:hover { color: var(--m-sky); text-decoration: none; }
  .site-mega__desc { margin: 0.6rem 0 1.25rem; font-size: var(--text-md); line-height: 1.55; color: #cbd5e1; max-width: 50ch; }
  .site-mega__links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem; }
  .site-mega__link {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    padding: 0.65rem 0.85rem; border-radius: 10px;
    font-size: var(--text-md); color: #e2e8f0; text-decoration: none;
    background: var(--m-tile);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .site-mega__link span { color: #64748b; transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .site-mega__link:hover, .site-mega__link:focus-visible { background: var(--color-accent); color: #fff; text-decoration: none; }
  .site-mega__link:hover span, .site-mega__link:focus-visible span { color: #fff; transform: translateX(2px); }
  .site-mega__all { align-self: flex-start; margin-top: 1.25rem; font-size: var(--text-md); font-weight: 600; color: var(--m-sky); text-decoration: underline; text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  .site-mega__all:hover { color: #fff; }

  /* foto dell'area: in bianco e nero, prende colore quando ci passi sopra */
  .site-mega__media { position: relative; margin: 0; min-height: 16rem; border-radius: 12px; overflow: hidden; }
  .site-mega__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(0.85); transition: filter var(--dur-slow) var(--ease-out); }
  .site-mega__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 35%, rgba(2, 6, 23, 0.85)); } /* taste-skill-ignore: velo neutro per leggere la didascalia sulla foto */
  .site-mega__panel:hover .site-mega__media img { filter: none; }
  .site-mega__media figcaption { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; z-index: 1; font-family: var(--font-display); font-weight: 600; font-size: var(--text-xl); line-height: 1.15; color: #fff; }

  /* striscia in basso: aiuto per chi non sa quale area scegliere */
  .site-mega__help {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-md);
    padding: 1rem 1.75rem; background: var(--m-rail);
  }
  .site-mega__help p { margin: 0; font-size: var(--text-md); color: #cbd5e1; }
  .site-mega__help strong { color: #fff; font-weight: 600; }
  .site-mega__help-actions { display: flex; gap: 0.5rem; flex: none; }
  .site-mega__phone { display: inline-flex; align-items: center; padding: 0.55rem 1rem; border-radius: 999px; font-size: var(--text-sm); font-weight: 600; font-variant-numeric: tabular-nums; color: #e2e8f0; text-decoration: none; background: var(--m-tile); transition: background var(--dur-fast) var(--ease-out); }
  .site-mega__phone:hover { background: #23314f; text-decoration: none; }
