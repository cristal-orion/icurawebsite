---
const { pathname } = Astro.url;
const isActive = (path: string) =>
  path === "/" ? pathname === "/" : pathname.startsWith(path);

// Mega-menu Servizi: ogni colonna = una pagina servizio + sotto-voci che
// atterrano su ancore (id sulle card AreaGrid) nelle pagine esistenti.
const menu = [
  {
    label: "Consulenza",
    href: "/servizi/consulenza",
    voci: [
      { label: "Sicurezza sul lavoro · 81/08", href: "/servizi/consulenza/sicurezza-lavoro" },
      { label: "Sicurezza nei cantieri", href: "/servizi/consulenza/cantieri" },
      { label: "HACCP alimentare", href: "/servizi/consulenza/haccp" },
      { label: "Medicina del lavoro", href: "/servizi/consulenza/medicina-lavoro" },
      { label: "GDPR & Privacy", href: "/servizi/consulenza/gdpr" },
      { label: "Consulenza ambientale", href: "/servizi/consulenza/ambiente" },
      { label: "Consulenza aziendale", href: "/servizi/consulenza/aziendale" },
    ],
  },
  {
    label: "Engineering",
    href: "/servizi/engineering",
    voci: [
      { label: "Progettazione edile", href: "/servizi/engineering#edile" },
      { label: "Impiantistica", href: "/servizi/engineering#impianti" },
      { label: "Prevenzione incendi · CPI", href: "/servizi/engineering#antincendio" },
      { label: "Collaudi e perizie", href: "/servizi/engineering#collaudi" },
      { label: "Qualifiche e test materiali", href: "/servizi/engineering#qualifiche" },
    ],
  },
  {
    label: "Formazione",
    href: "/servizi/formazione",
    voci: [
      { label: "Formazione lavoratori", href: "/servizi/formazione#cat-lavoratori" },
      { label: "Ruoli · RSPP, RLS, preposti", href: "/servizi/formazione#cat-ruoli" },
      { label: "Antincendio · primo soccorso", href: "/servizi/formazione#cat-emergenze" },
      { label: "Attrezzature · carrelli, PLE", href: "/servizi/formazione#cat-attrezzature" },
      { label: "Corsi finanziati", href: "/servizi/formazione#formazione-fondi" },
    ],
  },
  {
    label: "Certificazioni",
    href: "/servizi/certificazioni",
    voci: [
      { label: "ISO 9001 · Qualità", href: "/servizi/certificazioni/iso-9001" },
      { label: "ISO 14001 · Ambiente", href: "/servizi/certificazioni/iso-14001" },
      { label: "ISO 45001 · Sicurezza", href: "/servizi/certificazioni/iso-45001" },
      { label: "ISO 27001 · Informazioni", href: "/servizi/certificazioni/iso-27001" },
      { label: "ISO 37001 · Anti-corruzione", href: "/servizi/certificazioni/iso-37001" },
      { label: "Parità di genere · 125", href: "/servizi/certificazioni/parita-genere" },
      { label: "Attestazione SOA", href: "/servizi/certificazioni/soa" },
    ],
  },
  {
    label: "Finanza agevolata",
    href: "/servizi/finanza-agevolata",
    voci: [
      { label: "Bando ISI INAIL", href: "/bando-isi" },
      { label: "ZES Unica 2026", href: "/zes-unica" },
      { label: "Sgravi INAIL · OT23", href: "/servizi/finanza-agevolata#ot23" },
      { label: "Transizione 5.0", href: "/servizi/finanza-agevolata#transizione" },
      { label: "Formazione finanziata", href: "/servizi/formazione#formazione-fondi" },
    ],
  },
];

const agevolazioni = [
  { label: "ZES Unica 2026", href: "/zes-unica" },
  { label: "Bando ISI INAIL", href: "/bando-isi" },
];

// Bando in evidenza (badge amber). Cambia qui label/href per evidenziarne un altro.
const bandoEvidenza = {
  label: "Bando ISI INAIL",
  href: "/bando-isi",
  badge: "In evidenza",
};

const serviziActive =
  pathname.startsWith("/servizi") ||
  pathname === "/zes-unica" ||
  pathname === "/bando-isi";
---

<a href="#main" class="skip-link">Salta al contenuto</a>

<header class="site-header">
  <nav class="site-header__inner" aria-label="Navigazione principale">
    <a href="/" class="site-header__wordmark" aria-label="iCura Impresa, homepage">
      i<strong>Cura</strong>Impresa<span class="site-header__dot" aria-hidden="true">.</span>
    </a>

    <ul class="site-nav">
      <li>
        <a
          href="/chi-siamo"
          class={`site-nav__link${isActive("/chi-siamo") ? " is-active" : ""}`}
          aria-current={isActive("/chi-siamo") ? "page" : undefined}
        >
          Chi siamo
        </a>
      </li>

      <li class="site-nav__dropdown" data-dropdown>
        <button
          type="button"
          class={`site-nav__link site-nav__trigger${serviziActive ? " is-active" : ""}`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="nav-servizi-menu"
          data-dropdown-trigger
        >
          Servizi
          <span class="site-nav__caret" aria-hidden="true">▾</span>
        </button>
        <ul id="nav-servizi-menu" class="site-mega" data-dropdown-menu>
          {menu.map((col) => (
            <li class="site-mega__col">
              <a
                href={col.href}
                class={`site-mega__head${isActive(col.href) ? " is-active" : ""}`}
                aria-current={isActive(col.href) ? "page" : undefined}
              >
                {col.label}
              </a>
              <ul class="site-mega__sub">
                {col.voci.map((v) => (
                  <li>
                    <a href={v.href} class="site-mega__link">{v.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </li>

      <li>
        <a
          href="/blog"
          class={`site-nav__link${isActive("/blog") ? " is-active" : ""}`}
          aria-current={isActive("/blog") ? "page" : undefined}
        >
          Blog
        </a>
      </li>

      <li>
        <a
          href="/lavora-con-noi"
          class={`site-nav__link${isActive("/lavora-con-noi") ? " is-active" : ""}`}
          aria-current={isActive("/lavora-con-noi") ? "page" : undefined}
        >
          Lavora con noi
        </a>
      </li>

      <li>
        <a
          href="/contatti"
          class={`site-nav__link${isActive("/contatti") ? " is-active" : ""}`}
          aria-current={isActive("/contatti") ? "page" : undefined}
        >
          Contatti
        </a>
      </li>
    </ul>

    <div class="site-header__actions">
      <a
        href={bandoEvidenza.href}
        class={`site-header__promo${isActive(bandoEvidenza.href) ? " is-active" : ""}`}
      >
        <span class="site-header__promo-badge">{bandoEvidenza.badge}</span>
        <span class="site-header__promo-label">{bandoEvidenza.label}</span>
      </a>
      <a href="tel:+390816580779" class="site-header__phone">+39 081 658 0779</a>
      <a href="/contatti" class="site-header__cta">
        Richiedi consulenza
        <span aria-hidden="true">→</span>
      </a>

      <button
        type="button"
        class="site-header__burger"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Apri il menu di navigazione"
      >
        <span class="site-header__burger-bar" aria-hidden="true"></span>
        <span class="site-header__burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>

<div class="nav-mobile" id="nav-mobile" data-nav-mobile hidden>
  <a href={bandoEvidenza.href} class="nav-mobile__promo">
    <span class="nav-mobile__promo-badge">{bandoEvidenza.badge}</span>
    <span>{bandoEvidenza.label}</span>
    <span aria-hidden="true">→</span>
  </a>
  <ul class="nav-mobile__list">
    <li>
      <a href="/chi-siamo" class={isActive("/chi-siamo") ? "is-active" : undefined}>Chi siamo</a>
    </li>
    <li class="nav-mobile__group">
      <span class="nav-mobile__group-label">Servizi</span>
      <ul>
        {menu.map((col) => (
          <li>
            <a href={col.href} class={isActive(col.href) ? "is-active" : undefined}>{col.label}</a>
          </li>
        ))}
      </ul>
    </li>
    <li>
      <a href="/blog" class={isActive("/blog") ? "is-active" : undefined}>Blog</a>
    </li>
    <li class="nav-mobile__group">
      <span class="nav-mobile__group-label">Agevolazioni</span>
      <ul>
        {agevolazioni.map((a) => (
          <li>
            <a href={a.href} class={isActive(a.href) ? "is-active" : undefined}>{a.label}</a>
          </li>
        ))}
      </ul>
    </li>
    <li>
      <a href="/lavora-con-noi" class={isActive("/lavora-con-noi") ? "is-active" : undefined}>Lavora con noi</a>
    </li>
    <li>
      <a href="/contatti" class={isActive("/contatti") ? "is-active" : undefined}>Contatti</a>
    </li>
  </ul>
  <a href="/contatti" class="btn btn--primary nav-mobile__cta">
    Richiedi consulenza
    <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-dropdown]").forEach((dropdown) => {
    const trigger = dropdown.querySelector<HTMLButtonElement>("[data-dropdown-trigger]");
    const menu = dropdown.querySelector<HTMLElement>("[data-dropdown-menu]");
    if (!trigger || !menu) return;

    const open = () => {
      dropdown.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
    };
    const close = () => {
      dropdown.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
    };
    const toggle = () => (dropdown.classList.contains("is-open") ? close() : open());

    trigger.addEventListener("click", toggle);

    // Esc chiude e riporta il focus al trigger
    dropdown.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        close();
        trigger.focus();
      }
    });

    // Click fuori chiude
    document.addEventListener("click", (e) => {
      if (!dropdown.contains(e.target as Node)) close();
    });

    // Focus fuori dal dropdown chiude
    dropdown.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!dropdown.contains(document.activeElement)) close();
      });
    });
  });

  // Menu mobile (hamburger)
  const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navMobile = document.querySelector<HTMLElement>("[data-nav-mobile]");
  if (navToggle && navMobile) {
    const closeNav = () => {
      navMobile.hidden = true;
      navToggle.setAttribute("aria-expanded", "false");
    };
    const openNav = () => {
      navMobile.hidden = false;
      navToggle.setAttribute("aria-expanded", "true");
    };
    navToggle.addEventListener("click", () => {
      navMobile.hidden ? openNav() : closeNav();
    });
    navMobile.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", closeNav)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeNav();
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!navMobile.hidden && !navMobile.contains(t) && !navToggle.contains(t)) {
        closeNav();
      }
    });
  }
</script>

<style>
  /* ── Barra header a tutta larghezza (clinico-tech) ── */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    min-height: var(--header-h);
    background: color-mix(in srgb, var(--color-paper) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
    max-width: 84rem;
    min-height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .site-header__wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-wordmark);
    font-weight: 500;
    font-size: var(--text-xl);
    letter-spacing: -0.03em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__wordmark strong { font-weight: 800; }
  .site-header__wordmark:hover { text-decoration: none; }
  .site-header__dot { color: var(--color-accent); }

  /* ── Link di navigazione ── */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
    margin: 0 auto 0 var(--space-md);
    padding: 0;
  }
  .site-nav__link {
    position: relative;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    text-decoration: none;
    padding: 0.4rem 0;
    transition: color var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .site-nav__link:hover { color: var(--color-accent); text-decoration: none; }
  .site-nav__link.is-active { color: var(--color-accent); }

  .site-nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .site-nav__caret {
    font-size: 0.7em;
    line-height: 1;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-nav__dropdown { position: relative; }
  .site-nav__dropdown.is-open .site-nav__caret { transform: rotate(180deg); }

  /* ── Mega-menu Servizi — pannello a colonne, centrato sul viewport ── */
  .site-mega {
    position: fixed;
    top: calc(var(--header-h) + 0.5rem);
    left: 50%;
    transform: translateX(-50%) translateY(-0.4rem);
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-md) var(--space-lg);
    width: min(60rem, calc(100vw - 1.5rem));
    max-width: calc(100vw - 1.5rem);
    margin: 0;
    padding: var(--space-lg);
    list-style: none;
    background: color-mix(in srgb, var(--color-paper) 96%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .site-nav__dropdown.is-open .site-mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .site-mega__col { min-width: 0; }
  .site-mega__head {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-ink);
    text-decoration: none;
    padding: 0 0.4rem 0.5rem;
    margin-bottom: 0.4rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .site-mega__head:hover { color: var(--color-accent); text-decoration: none; }
  .site-mega__head.is-active { color: var(--color-accent); }
  .site-mega__sub {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .site-mega__link {
    display: block;
    padding: 0.35rem 0.4rem;
    border-radius: var(--radius-input);
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-ink) 66%, transparent);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .site-mega__link:hover {
    background: var(--color-paper-blue);
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ── Azioni a destra: telefono + CTA + burger ── */
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-left: auto;
  }

  /* Bando in evidenza — pill con badge amber (uso raro dell'amber consentito) */
  .site-header__promo {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.8rem 0.35rem 0.4rem;
    border: var(--rule-hair) solid color-mix(in srgb, var(--color-highlight) 45%, transparent);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-highlight) 10%, transparent);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .site-header__promo:hover,
  .site-header__promo.is-active {
    background: color-mix(in srgb, var(--color-highlight) 18%, transparent);
    border-color: color-mix(in srgb, var(--color-highlight) 70%, transparent);
    text-decoration: none;
  }
  .site-header__promo-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    background: var(--color-highlight);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
  }

  .site-header__phone {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border: var(--rule-hair) solid color-mix(in srgb, var(--color-accent) 30%, transparent);
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .site-header__phone:hover { background: color-mix(in srgb, var(--color-accent) 8%, transparent); text-decoration: none; }

  /* CTA: pill NAVY → blu su hover */
  .site-header__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.6rem 1.3rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    border-radius: var(--radius-pill);
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .site-header__cta:hover { background: var(--color-accent); text-decoration: none; }

  /* Hamburger — solo mobile */
  .site-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    border-radius: var(--radius-input);
    color: var(--color-ink);
  }
  .site-header__burger-bar {
    display: block;
    width: 1.25rem;
    height: 2px;
    margin-inline: auto;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }
  .site-header__burger[aria-expanded="true"] .site-header__burger-bar:nth-child(1) {
    transform: translateY(3px) rotate(45deg);
  }
  .site-header__burger[aria-expanded="true"] .site-header__burger-bar:nth-child(2) {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* ── Pannello menu mobile — sheet navy sotto la barra ── */
  .nav-mobile {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 49;
    padding: var(--space-xl) var(--page-gutter) var(--space-lg);
    background: var(--color-ink);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile__promo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: var(--space-md);
    padding: 0.8rem 1rem;
    background: color-mix(in srgb, var(--color-highlight) 16%, transparent);
    border: var(--rule-hair) solid color-mix(in srgb, var(--color-highlight) 45%, transparent);
    border-radius: var(--radius-card);
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-paper);
    text-decoration: none;
  }
  .nav-mobile__promo > span:last-child { margin-left: auto; }
  .nav-mobile__promo-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    background: var(--color-highlight);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-pill);
  }
  .nav-mobile__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; }
  .nav-mobile__list a {
    display: block;
    padding: 0.7rem 0.2rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-paper);
    text-decoration: none;
    border-radius: var(--radius-input);
  }
  .nav-mobile__list a:hover { color: var(--color-accent); text-decoration: none; }
  .nav-mobile__list a.is-active { color: var(--color-accent); }
  .nav-mobile__group { margin-block: 0.4rem; }
  .nav-mobile__group-label {
    display: block;
    padding: 0.6rem 0.2rem 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
  }
  .nav-mobile__group ul { list-style: none; margin: 0; padding: 0 0 0 var(--space-sm); }
  .nav-mobile__group ul a { font-size: var(--text-md); font-weight: 500; color: color-mix(in srgb, var(--color-paper) 80%, transparent); }
  .nav-mobile__cta {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: var(--space-lg);
  }

  /* Mobile — barra compatta: wordmark + burger; link/telefono/CTA nel menu */
  @media (max-width: 56rem) {
    .site-nav { display: none; }
