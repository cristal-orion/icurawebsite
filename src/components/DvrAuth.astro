---
// Guscio delle pagine Registrati / Accedi dell'analizzatore DVR: fondo navy con griglia di
// punti (come le hero), a sinistra che cosa controlla l'analizzatore, a destra la card del form.
// Gli stili dei campi sono :global perché il form arriva dallo slot della pagina.
import DotGrid from "@components/DotGrid.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}
const { eyebrow, title, lede } = Astro.props;

const controlli = [
  { n: "01", t: "Norme citate ancora in vigore", d: "Atti abrogati citati come vigenti, articoli che non esistono più." },
  { n: "02", t: "Rischi dovuti per il tuo settore", d: "Riconosce l'attività e cerca i capitoli di rischio attesi." },
  { n: "03", t: "Data, revisione e figure", d: "I requisiti formali dell'art. 28 del D.Lgs. 81/2008." },
];
---

<section class="dvr-auth">
  <DotGrid />
  <div class="container dvr-auth__grid">
    <div class="dvr-auth__intro">
      <a href="/analizzatore-dvr/" class="dvr-auth__back"><span aria-hidden="true">←</span> Analizzatore DVR</a>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="dvr-auth__title" set:html={title} />
      <p class="dvr-auth__lede">{lede}</p>

      <ol class="dvr-auth__checks" aria-label="Che cosa controlla l'analizzatore">
        {controlli.map((c) => (
          <li>
            <span class="dvr-auth__n">{c.n}</span>
            <span>
              <strong>{c.t}</strong>
              <span class="dvr-auth__d">{c.d}</span>
            </span>
          </li>
        ))}
      </ol>
      <p class="dvr-auth__privacy">I dati sensibili si oscurano prima della valutazione e il PDF si cancella appena letto.</p>
    </div>

    <div class="dvr-auth__card">
      <slot />
    </div>
  </div>
</section>

<style>
  .dvr-auth {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .dvr-auth__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .dvr-auth__intro { padding-top: var(--space-md); }
  .dvr-auth__back {
    display: inline-flex; gap: 0.4em; margin-bottom: var(--space-lg);
    font-size: var(--text-sm); color: color-mix(in srgb, var(--color-paper) 70%, transparent);
    text-decoration: none;
  }
  .dvr-auth__back:hover { color: var(--color-paper); }
  .dvr-auth__title {
    font-size: var(--text-4xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05;
    color: var(--color-paper); margin: var(--space-2xs) 0 0; max-width: 16ch;
  }
  .dvr-auth__title :global(em) { font-style: normal; color: var(--color-accent); }
  .dvr-auth__lede {
    font-size: var(--text-lg); line-height: 1.5; max-width: 42ch; margin-top: var(--space-md);
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }
  .dvr-auth__checks {
    list-style: none; margin: var(--space-xl) 0 0; padding: 0;
    display: grid; gap: var(--space-sm);
  }
  .dvr-auth__checks li {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: var(--color-ink-inset);
    border: var(--rule-hair) solid color-mix(in srgb, var(--color-paper) 8%, transparent);
    border-radius: var(--radius-card);
  }
  .dvr-auth__n { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--color-accent); padding-top: 0.2em; }
  .dvr-auth__checks strong { display: block; font-weight: 600; color: var(--color-paper); }
  .dvr-auth__d { display: block; font-size: var(--text-sm); color: color-mix(in srgb, var(--color-paper) 62%, transparent); margin-top: 0.15rem; }
  .dvr-auth__privacy {
    margin-top: var(--space-md); font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.02em; color: color-mix(in srgb, var(--color-paper) 55%, transparent);
  }

  .dvr-auth__card {
    background: var(--color-surface); color: var(--color-ink);
    padding: clamp(var(--space-lg), 3vw, var(--space-2xl));
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lift);
  }

  /* ── Form (contenuto dallo slot) ── */
  .dvr-auth__card :global(form) { display: flex; flex-direction: column; gap: var(--space-md); }
  .dvr-auth__card :global(.form-title) { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; margin: 0; }
  .dvr-auth__card :global(.form-sub) { font-size: var(--text-sm); color: var(--color-ink-2); margin: calc(var(--space-xs) * -1) 0 0; line-height: 1.5; }
  .dvr-auth__card :global(.row) { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .dvr-auth__card :global(.field) { display: flex; flex-direction: column; gap: var(--space-2xs); }
  .dvr-auth__card :global(.field label) { font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted); }
  .dvr-auth__card :global(.field input) {
    width: 100%; padding: 0.75rem 0.9rem;
    background: var(--color-paper); border: 1px solid var(--color-rule);
    border-radius: var(--radius-input); font-family: var(--font-body); font-size: var(--text-md);
    color: var(--color-ink); transition: border-color var(--dur-fast) var(--ease-out);
  }
  .dvr-auth__card :global(.field input:focus) { border-color: var(--color-accent); outline: 2px solid var(--color-focus); outline-offset: 1px; }
  .dvr-auth__card :global(.field input[aria-invalid="true"]) { border-color: #dc2626; }
  .dvr-auth__card :global(.field__hint) { font-size: var(--text-xs); color: var(--color-muted); margin: 0; }
  .dvr-auth__card :global(.field__err) { font-size: var(--text-sm); color: #b91c1c; margin: 0; }
  .dvr-auth__card :global(.alert) {
    margin: 0; padding: var(--space-sm) var(--space-md); border-radius: var(--radius-input);
    background: #fef2f2; color: #991b1b; font-size: var(--text-sm); line-height: 1.5;
  }
  .dvr-auth__card :global(.alert a) { color: inherit; font-weight: 600; }
  .dvr-auth__card :global(.consent) { display: flex; gap: 0.6rem; align-items: flex-start; font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.5; }
  .dvr-auth__card :global(.consent a) { color: var(--color-accent); }
  .dvr-auth__card :global(.consent input) { margin-top: 0.25rem; flex: none; }
  .dvr-auth__card :global(.hp-field) { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .dvr-auth__card :global(.submit) { justify-content: center; margin-top: var(--space-2xs); }
  .dvr-auth__card :global(.switch) { text-align: center; margin: 0; font-size: var(--text-sm); color: var(--color-ink-2); }
  .dvr-auth__card :global(.switch a) { color: var(--color-accent); font-weight: 600; }
  .dvr-auth__card :global(.pw) { position: relative; }
  .dvr-auth__card :global(.pw input) { padding-right: 5.5rem; }
  .dvr-auth__card :global(.pw button) {
    position: absolute; right: 0.4rem; top: 50%; translate: 0 -50%;
    padding: 0.35rem 0.6rem; border: 0; border-radius: var(--radius-input); background: transparent;
    font-family: var(--font-mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--color-ink-2); cursor: pointer;
  }
  .dvr-auth__card :global(.pw button:hover) { background: var(--color-paper-2); }

  @media (max-width: 64rem) {
    .dvr-auth__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
    .dvr-auth__checks { display: none; }
  }
  @media (max-width: 40rem) {
    .dvr-auth__card :global(.row) { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Mostra/nascondi password (il pulsante esiste solo con JS attivo).
  document.querySelectorAll<HTMLElement>(".pw").forEach((wrap) => {
    const input = wrap.querySelector("input");
    if (!input) return;
    const btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = "Mostra";
    btn.setAttribute("aria-pressed", "false");
    btn.addEventListener("click", () => {
      const vis = input.type === "password";
      input.type = vis ? "text" : "password";
      btn.textContent = vis ? "Nascondi" : "Mostra";
      btn.setAttribute("aria-pressed", String(vis));
    });
    wrap.append(btn);
  });
</script>
