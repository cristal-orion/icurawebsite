---
import Placeholder from "@components/Placeholder.astro";

// Sezione "macro aree" a cerchi cliccabili (richiesta esplicita del cliente,
// ispirata a Qualifica Group).
const aree = [
  {
    titolo: "Consulenza",
    href: "/servizi/consulenza",
    foto: "/images/macroaree-consulenza.webp",
    alt: "Consulenti iCura Impresa in riunione operativa in ufficio, documenti sul tavolo e luce naturale",
  },
  {
    titolo: "Formazione",
    href: "/servizi/formazione",
    foto: "/images/macroaree-formazione.webp",
    alt: "Formatore iCura Impresa durante una lezione in aula sulla sicurezza sul lavoro",
  },
  {
    titolo: "Engineering",
    href: "/servizi/engineering",
    foto: "/images/macroaree-engineering.webp",
    alt: "Tecnici iCura Impresa con casco di sicurezza al lavoro su una planimetria in cantiere",
  },
  {
    titolo: "Finanza agevolata",
    href: "/servizi/finanza-agevolata",
    foto: "/images/macroaree-finanza-agevolata.webp",
    alt: "Consulente iCura Impresa firma documenti aziendali su una scrivania con appunti e telefono",
  },
  {
    titolo: "Certificazioni",
    href: "/servizi/certificazioni",
    foto: "/images/macroaree-certificazioni.webp",
    alt: "Archivio di faldoni e documentazione tecnica per audit e certificazioni aziendali",
  },
];
---

<section class="section macroaree" aria-labelledby="macroaree-heading">
  <div class="container">
    <h2 id="macroaree-heading" class="sr-only">Le nostre aree di servizio</h2>
    <ul class="macroaree__grid">
      {aree.map((a) => (
        <li class="macroaree__item">
          <a href={a.href} class="macroaree__link">
            <span class="macroaree__media">
              <Placeholder aspect="1/1" src={a.foto} alt={a.alt} />
            </span>
            <span class="macroaree__label">{a.titolo}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .macroaree__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-lg);
  }
  .macroaree__link {
    display: block;
    text-decoration: none;
    text-align: center;
  }
  .macroaree__media {
    display: block;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(140deg, var(--color-accent), var(--color-highlight));
    transition: transform 0.7s var(--ease-in-out);
  }
  .macroaree__media :global(.placeholder) {
    border-radius: 50%;
    overflow: hidden;
    display: block;
  }
  /* Hover: il cerchio gira su se stesso (360°) + leggero lift */
  .macroaree__link:hover .macroaree__media {
    transform: translateY(-4px) scale(1.02) rotate(360deg);
  }
  .macroaree__label {
    display: block;
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
    color: var(--color-accent);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .macroaree__link:hover .macroaree__label {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 64rem) {
    .macroaree__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
  }
  @media (max-width: 40rem) {
    .macroaree__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .macroaree__label { font-size: var(--text-md); }
  }

  @media (prefers-reduced-motion: reduce) {
    .macroaree__media { transition: none; }
    .macroaree__link:hover .macroaree__media { transform: none; }
  }
</style>
