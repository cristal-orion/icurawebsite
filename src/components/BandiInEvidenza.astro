---
// Sezione "Bandi, scadenze e risposte" — sfondo azzurro (accent-soft).
// Card cliccabili con stato e date (testi del cliente, verificati al 7 ottobre 2026).
const bandi = [
  {
    badge: "In vigore",
    titolo: "Accordo Stato-Regioni del 17 aprile 2025",
    meta: "Formazione",
    desc: "Nuove durate e nuove abilitazioni per la formazione sulla sicurezza. Il periodo transitorio si è concluso il 24 maggio 2026: i corsi si erogano solo con le nuove regole.",
    cta: "Chiedi una verifica degli attestati",
    href: "/servizi/formazione",
  },
  {
    badge: "In vigore",
    titolo: "Patente a crediti",
    meta: "Cantieri",
    desc: "Obbligatoria per imprese e lavoratori autonomi che operano nei cantieri. Regole sanzionatorie più severe dal 31 ottobre 2025 e decurtazioni per lavoro irregolare dal 1° gennaio 2026.",
    cta: "Controlla i crediti con noi",
    href: "/servizi/consulenza/cantieri",
  },
  {
    badge: "Aperto",
    titolo: "Iper-ammortamento 2026–2028",
    meta: "Investimenti",
    desc: "Maggiorazione del costo ammortizzabile per i beni 4.0 e gli impianti per l'autoproduzione (L. 199/2025, art. 1, commi 427–436): investimenti dal 1° gennaio 2026 al 30 settembre 2028, prenotazione sulla piattaforma GSE attiva dal 12 giugno 2026.",
    cta: "Pianifica l'investimento",
    href: "/servizi/finanza-agevolata",
  },
  {
    badge: "Domande chiuse",
    titolo: "Bando ISI INAIL 2025",
    meta: "Bandi",
    desc: "Compilazione delle domande chiusa il 28 maggio 2026. Le domande ammesse negli elenchi si perfezionano entro le 18:00 del 26 ottobre 2026. L'avviso ISI 2026 non è ancora stato pubblicato: il progetto si prepara adesso.",
    cta: "Prepara il progetto",
    href: "/bando-isi",
  },
  {
    badge: "Prossima finestra",
    titolo: "ZES Unica 2026–2028",
    meta: "Mezzogiorno",
    desc: "Finestra 2026 chiusa il 30 maggio. Chi ha presentato la comunicazione invia l'integrativa dal 3 al 17 gennaio 2027; per gli investimenti 2027 la finestra è dal 31 marzo al 30 maggio 2027.",
    cta: "Verifica i requisiti",
    href: "/zes-unica",
  },
];
---

<section class="section bandi-ev" aria-labelledby="bandi-ev-heading">
  <div class="container">
    <header class="bandi-ev__head">
      <p class="eyebrow">Un posto dove tornare</p>
      <h2 id="bandi-ev-heading" class="bandi-ev__title">Bandi, scadenze e risposte: sempre aggiornati.</h2>
      <p class="bandi-ev__lede">
        Finanziamenti, norme e certificazioni sono percorsi con requisiti e date. Qui trovi lo stato di ciascuno, verificato su fonti ufficiali; quando cambia qualcosa che ti riguarda, te lo diciamo noi.
      </p>
    </header>

    <ul class="bandi-ev__grid">
      {bandi.map((b) => (
        <li class="bando-card">
          <span class="bando-card__badge">{b.badge}</span>
          <h3 class="bando-card__title">{b.titolo}</h3>
          <p class="bando-card__meta">{b.meta}</p>
          <p class="bando-card__desc">{b.desc}</p>
          <a href={b.href} class="link-cta bando-card__link">
            {b.cta}
            <span class="link-cta__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="bandi-ev__note">Stato e date verificati su fonti ufficiali al 7 ottobre 2026.</p>
  </div>
</section>

<style>
  .bandi-ev { background: var(--color-accent-soft); }
  .bandi-ev__head { margin-bottom: var(--space-xl); max-width: 54ch; }
  .bandi-ev__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }
  .bandi-ev__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.5;
    margin-top: var(--space-sm);
  }
  .bandi-ev__note {
    margin: var(--space-lg) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  .bandi-ev__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-lg);
  }
  .bando-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-xl);
    background: var(--color-paper);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    transition: border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .bando-card:hover {
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-rule));
    transform: translateY(-2px);
  }
  .bando-card__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-highlight);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-2xs);
  }
  .bando-card__title {
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .bando-card__meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0;
  }
  .bando-card__desc {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: 1.55;
    margin: var(--space-2xs) 0 0;
    flex: 1;
  }
  .bando-card__link {
    margin-top: var(--space-md);
    align-self: flex-start;
  }
  .bando-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .bando-card:hover { transform: none; }
  }
</style>
