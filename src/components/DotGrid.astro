---
// Griglia tecnica di punti per i fondi navy: i punti si accendono di blu attorno al cursore.
// Va messa dentro un contenitore con `position: relative; isolation: isolate`:
// copre tutto il genitore e segue il mouse su di esso. Con touch o "riduci animazioni" resta statica.
---

<canvas class="dot-grid" data-dot-grid aria-hidden="true"></canvas>

<script>
  document.querySelectorAll<HTMLCanvasElement>("[data-dot-grid]").forEach((canvas) => {
    const host = canvas.parentElement;
    const ctx = canvas.getContext("2d");
    if (!host || !ctx) return;
    const GAP = 28, R = 220;
    let w = 0, h = 0, mx = -9999, my = -9999, raf = 0;

    const draw = () => {
      raf = 0;
      ctx.clearRect(0, 0, w, h);
      for (let y = GAP / 2; y < h; y += GAP) {
        for (let x = GAP / 2; x < w; x += GAP) {
          const d = Math.hypot(x - mx, y - my);
          const k = d < R ? (1 - d / R) ** 2 : 0;
          ctx.fillStyle = k ? `rgba(96, 165, 250, ${0.1 + k * 0.75})` : "rgba(248, 250, 252, 0.07)";
          const r = 1 + k * 1.2;
          ctx.fillRect(x - r / 2, y - r / 2, r, r);
        }
      }
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(draw); };
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = host.clientWidth; h = host.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      queue();
    };
    new ResizeObserver(resize).observe(host);

    const motion = !matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (motion && matchMedia("(hover: hover)").matches) {
      host.addEventListener("pointermove", (e) => {
        const r = host.getBoundingClientRect();
        mx = e.clientX - r.left; my = e.clientY - r.top;
        queue();
      });
      host.addEventListener("pointerleave", () => { mx = my = -9999; queue(); });
    }
  });
</script>

<style>
  .dot-grid {
    position: absolute; inset: 0; z-index: -1;
    width: 100%; height: 100%;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, #000 40%, transparent 100%);
            mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, #000 40%, transparent 100%);
  }
</style>
