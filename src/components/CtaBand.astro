---
import Placeholder from "@components/Placeholder.astro";

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: { src?: string; alt: string };
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
  labelledby?: string;
}
const { eyebrow, title, lede, image, primary, secondary, labelledby } = Astro.props;
const headingId = labelledby ?? "cta-band-heading";
---

<section class="section cta-band-section" aria-labelledby={headingId}>
  <div class="container">
    <div class={`cta-band${image ? " cta-band--media" : ""}`}>
      <div class="cta-band__body">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id={headingId} class="cta-band__title">{title}</h2>
        {lede && <p class="cta-band__lede">{lede}</p>}
        <div class="cta-band__ctas">
          <a href={primary.href} class="btn btn--primary">
            {primary.label}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          {secondary && (
            <a href={secondary.href} class="link-cta">{secondary.label}</a>
          )}
        </div>
      </div>

      {image && (
        <div class="cta-band__media">
          <Placeholder aspect="4/3" src={image.src} alt={image.alt} />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--color-accent-soft);
    border: var(--rule-hair) solid color-mix(in srgb, var(--color-accent) 18%, transparent);
    border-radius: var(--radius-lg);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
  }
  .cta-band--media {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .cta-band__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 20ch;
    margin: 0;
    overflow-wrap: anywhere;
  }
  .cta-band__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.5;
    max-width: 44ch;
    margin: var(--space-sm) 0 0;
  }
  .cta-band__ctas {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }
  .cta-band__media :global(.placeholder) {
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  @media (max-width: 56rem) {
    .cta-band--media {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .cta-band__media { order: -1; }
  }
</style>
