---
// Home "in profondità": dopo l'hero la pagina non scorre in verticale ma lungo un
// tunnel three.js. Ogni sezione è una card HTML che arriva da lontano (piccola e
// sfocata), si ferma all'altezza dello spettatore e poi gli passa accanto.
// Senza WebGL o con "riduci animazioni" le card restano una normale colonna.
import ServiceIcon from "@components/ServiceIcon.astro";
import { numeri, obiettivi, aree, bandi, passi, team } from "../data/home";

const pad = (n: number) => String(n).padStart(2, "0");
// Etichette per l'HUD laterale, nello stesso ordine delle card.
const labels = ["iCura Impresa", "Il tuo obiettivo", ...aree.map((a) => a.titolo), "Bandi e scadenze", "Come lavoriamo", "Le persone", "Il prossimo passo"];
const N = labels.length;
---

<section class="tunnel" data-tunnel style={`--n: ${N}`} aria-label="Scopri iCura Impresa">
  <div class="tunnel__stage" data-stage>
    <canvas class="tunnel__canvas" data-canvas aria-hidden="true"></canvas>
    <div class="tunnel__vignette" aria-hidden="true"></div>

    <div class="tunnel__hud" aria-hidden="true">
      <span class="tunnel__hud-n"><span data-hud-n>01</span><span class="tunnel__hud-tot"> / {pad(N)}</span></span>
      <span class="tunnel__hud-bar"><span data-hud-bar></span></span>
      <span class="tunnel__hud-label" data-hud-label>{labels[0]}</span>
    </div>
    <p class="tunnel__hint" data-hint aria-hidden="true">Scorri per entrare <span>↓</span></p>

    <ol class="tunnel__cards" data-cards>
      {/* 01 · NUMERI */}
      <li class="tslot" data-card><div class="tcard tcard--numeri">
        <p class="eyebrow">iCura Impresa · Napoli</p>
        <h2 class="tcard__title">Consulenza, sicurezza e bandi. <span class="accent">Un solo referente.</span></h2>
        <dl class="tnum">
          {numeri.map((m) => (
            <div class="tnum__item"><dt>{m.n}</dt><dd>{m.l}</dd></div>
          ))}
        </dl>
        <span class="tglare" aria-hidden="true"></span>
      </div></li>

      {/* 02 · OBIETTIVI */}
      <li class="tslot" data-card><div class="tcard tcard--goal">
        <p class="eyebrow">Parti dal tuo obiettivo</p>
        <h2 class="tcard__title">Che cosa vuoi realizzare <span class="accent">nella tua impresa?</span></h2>
        <ul class="tgoal">
          {obiettivi.map((o) => (
            <li class="tgoal__row">
              <span class="tgoal__t">{o.t}</span>
              <span class="tgoal__aree">
                {o.aree.map((a) => <a href={a.href} class="tgoal__tag">{a.label}</a>)}
              </span>
            </li>
          ))}
        </ul>
        <span class="tglare" aria-hidden="true"></span>
      </div></li>

      {/* 03–08 · AREE */}
      {aree.map((a, i) => (
        <li class="tslot" data-card><div class="tcard tcard--area">
          <div class="tarea__media">
            <img src={a.img} alt={a.alt} loading="lazy" decoding="async" />
            <span class="tarea__n">{pad(i + 1)} / {pad(aree.length)}</span>
          </div>
          <div class="tarea__body">
            <span class="tarea__icon"><ServiceIcon name={a.icon} /></span>
            <p class="eyebrow">{a.titolo}</p>
            <h2 class="tcard__title tcard__title--sm">{a.slogan}</h2>
            <p class="tarea__desc">{a.desc}</p>
            <ul class="tarea__list">{a.comprende.map((c) => <li>{c}</li>)}</ul>
            <a href={a.href} class="btn btn--primary">Scopri {a.titolo} <span class="btn__arrow" aria-hidden="true">→</span></a>
          </div>
          <span class="tglare" aria-hidden="true"></span>
        </div></li>
      ))}

      {/* 09 · BANDI */}
      <li class="tslot" data-card><div class="tcard tcard--bandi">
        <p class="eyebrow">Bandi, scadenze e risposte</p>
        <h2 class="tcard__title">Sempre aggiornati, <span class="accent">verificati su fonti ufficiali.</span></h2>
        <ul class="tbandi">
          {bandi.map((b) => (
            <li>
              <a href={b.href} class="tbando">
                <span class="tbando__badge" data-state={b.badge}>{b.badge}</span>
                <span class="tbando__t">{b.titolo}</span>
                <span class="tbando__cta">{b.cta} →</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="tcard__note">Stato e date verificati al 7 ottobre 2026.</p>
        <span class="tglare" aria-hidden="true"></span>
      </div></li>

      {/* 10 · COME LAVORIAMO */}
      <li class="tslot" data-card><div class="tcard tcard--why">
        <div class="twhy__media"><img src="/images/chi-siamo-riunione-team.webp" alt="Team di consulenti iCura Impresa in riunione operativa" loading="lazy" decoding="async" /></div>
        <div>
          <p class="eyebrow">Come lavoriamo</p>
          <h2 class="tcard__title tcard__title--sm">Dall’ascolto <span class="accent">al risultato.</span></h2>
          <ol class="twhy">
            {passi.map((p, i) => (
              <li><span class="twhy__n">{pad(i + 1)}</span><div><h3>{p.t}</h3><p>{p.d}</p></div></li>
            ))}
          </ol>
          <p class="tcard__note"><strong>Preventivo scritto.</strong> Dice che cosa è compreso e chi fa che cosa, prima di iniziare.</p>
        </div>
        <span class="tglare" aria-hidden="true"></span>
      </div></li>

      {/* 11 · TEAM */}
      <li class="tslot" data-card><div class="tcard tcard--team">
        <p class="eyebrow">Le persone</p>
        <h2 class="tcard__title">Nove persone, <span class="accent">guidate da un ingegnere.</span></h2>
        <ul class="tteam">
          {team.map((t) => (
            <li><img src={t.img} alt={t.alt} loading="lazy" decoding="async" /><h3>{t.h}</h3><p>{t.k}</p></li>
          ))}
        </ul>
        <span class="tglare" aria-hidden="true"></span>
      </div></li>

      {/* 12 · CTA */}
      <li class="tslot" data-card><div class="tcard tcard--cta">
        <p class="eyebrow">Il prossimo passo</p>
        <h2 class="tcard__title tcard__title--xl">Il resto <span class="accent">lo costruiamo insieme.</span></h2>
        <p class="tcta__lede">Un progetto, persone da formare, un’ispezione in arrivo: iniziamo dalla tua esigenza.</p>
        <div class="tcta__actions">
          <a href="#contatto" class="btn btn--primary btn--big">Scrivici <span class="btn__arrow" aria-hidden="true">↓</span></a>
          <a href="tel:+390816580779" class="btn btn--ghost">081 658 0779</a>
        </div>
        <span class="tglare" aria-hidden="true"></span>
      </div></li>
    </ol>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-tunnel]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hasGL = (() => {
    try { return !!document.createElement("canvas").getContext("webgl2"); } catch { return false; }
  })();

  if (root && !reduce && hasGL) init(root);

  async function init(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const canvas = root.querySelector<HTMLCanvasElement>("[data-canvas]")!;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    const tilts = cards.map((c) => c.firstElementChild as HTMLElement);
    const hudN = root.querySelector<HTMLElement>("[data-hud-n]")!;
    const hudBar = root.querySelector<HTMLElement>("[data-hud-bar]")!;
    const hudLabel = root.querySelector<HTMLElement>("[data-hud-label]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const labels = cards.map((c) => c.querySelector(".eyebrow")?.textContent?.trim() ?? "");
    const N = cards.length;

    const { createTunnelScene } = await import("../scripts/tunnel-scene");
    root.classList.add("is-3d");
    const scene = createTunnelScene(canvas, N);

    // Ogni tappa vale STEP schermate di scroll. Si parte con la prima card ancora
    // lontana (START) e si finisce con l'ultima ferma al centro (END).
    const STEP = 0.95;
    const START = -0.7;
    const END = N - 1 + 0.2;
    const HOLD = 0.24; // quota di ogni tappa in cui la card resta ferma davanti a te
    const DEPTH = 1500; // px di profondità tra una card e la successiva
    let vh = window.innerHeight;
    let top = 0;
    let scrollable = 1;

    function layout() {
      vh = window.innerHeight;
      root.style.height = `${Math.round((END - START) * STEP * vh + vh)}px`;
      top = root.getBoundingClientRect().top + window.scrollY;
      scrollable = root.offsetHeight - vh;
    }

    // Scroll → posizione "grezza" lungo il tunnel → posizione con le soste.
    const smooth = (x: number) => x * x * x * (x * (x * 6 - 15) + 10);
    function withStops(raw: number) {
      const k = Math.floor(raw);
      const u = raw - k;
      const v = Math.min(Math.max((u - HOLD) / (1 - 2 * HOLD), 0), 1);
      return k + smooth(v);
    }
    function target() {
      const f = Math.min(Math.max((window.scrollY - top) / scrollable, 0), 1);
      return withStops(START + f * (END - START));
    }

    let cam = target();
    // Tilt: solo la card ferma davanti a te. Col mouse segue il puntatore,
    // sui touch ondeggia piano da sola così il testo "esce" comunque.
    const canHover = window.matchMedia("(hover: hover)").matches;
    const MAX_TILT = 11;
    const ptr = { x: -1, y: -1 };
    const tilt = cards.map(() => ({ rx: 0, ry: 0, go: 0 }));
    let lastIdx = -1;

    function place(c: number) {
      cards.forEach((card, i) => {
        const d = i - c; // > 0 davanti a te, < 0 già superata
        let z: number, op: number, blur: number, dim: number;
        const side = Math.sin(i * 1.9);
        if (d >= 0) {
          z = -d * DEPTH;
          op = d < 1.4 ? 1 : Math.max(0, 1 - (d - 1.4) / 0.9);
          blur = Math.min(Math.max(d - 0.04, 0) * 7, 14);
          dim = Math.min(Math.max(d - 0.04, 0) * 0.45, 0.75);
        } else {
          const p = -d;
          z = p * 900;
          op = Math.max(0, 1 - p / 0.42);
          blur = p * 22;
          dim = 0;
        }
        const x = d > 0 ? side * d * 260 : side * d * -120;
        const y = d > 0 ? Math.cos(i * 1.3) * d * 90 : 0;
        const rot = d > 0 ? side * Math.min(d, 1.5) * -6 : 0;
        // Ferma davanti a te: niente transform, così il testo è rasterizzato nitido.
        card.style.transform = Math.abs(d) < 0.003 ? "none" : `translate3d(${x}px, ${y}px, ${z}px) rotateY(${rot}deg)`;
        card.style.opacity = op.toFixed(3);
        card.style.filter = blur > 0.2 || dim > 0.01 ? `blur(${blur.toFixed(1)}px) brightness(${(1 - dim).toFixed(2)})` : "none";
        card.style.zIndex = String(1000 - Math.round(d * 100));
        card.style.visibility = op < 0.01 ? "hidden" : "visible";
        card.classList.toggle("is-here", Math.abs(d) < 0.12);
      });

      const idx = Math.min(Math.max(Math.round(c), 0), N - 1);
      if (idx !== lastIdx) {
        lastIdx = idx;
        hudN.textContent = String(idx + 1).padStart(2, "0");
        hudLabel.textContent = labels[idx];
      }
      hudBar.style.transform = `scaleX(${Math.min(Math.max(c / (N - 1), 0), 1)})`;
      hint.classList.toggle("is-gone", c > -0.3);
      // la camera avanza per (N + 1) "tratte": un po' di tunnel prima e dopo le card
      scene.setProgress((c + 1.2) / (N + 2));
    }

    let raf = 0;
    let prev = performance.now();
    let active = false;
    function tick(now: number) {
      const dt = Math.min((now - prev) / 1000, 0.05);
      prev = now;
      const t = target();
      cam += (t - cam) * (1 - Math.exp(-dt * 7));
      if (Math.abs(t - cam) < 0.0005) cam = t;
      place(cam);
      applyTilt(now, dt);
      if (active) raf = requestAnimationFrame(tick);
    }

    function applyTilt(now: number, dt: number) {
      const k = 1 - Math.exp(-dt * 9);
      cards.forEach((slot, i) => {
        const here = slot.classList.contains("is-here");
        let rx = 0, ry = 0, go = 0, gx = 0.5, gy = 0;
        if (here) {
          if (canHover) {
            const r = slot.getBoundingClientRect();
            const inside = ptr.x >= r.left && ptr.x <= r.right && ptr.y >= r.top && ptr.y <= r.bottom;
            if (inside) {
              gx = (ptr.x - r.left) / r.width;
              gy = (ptr.y - r.top) / r.height;
              ry = (gx - 0.5) * 2 * MAX_TILT;
              rx = (0.5 - gy) * 2 * MAX_TILT;
              go = 1;
            }
          } else {
            const t = now / 1000;
            ry = Math.sin(t * 0.9) * 6;
            rx = Math.cos(t * 0.7) * 4;
            gx = 0.5 + ry / 12; gy = 0.5 - rx / 8; go = 0.6;
          }
        }
        const s = tilt[i];
        s.rx += (rx - s.rx) * k;
        s.ry += (ry - s.ry) * k;
        s.go += (go - s.go) * k;
        if (!here && Math.abs(s.rx) + Math.abs(s.ry) + s.go < 0.01) {
          if (s.rx || s.ry) { s.rx = s.ry = s.go = 0; tilts[i].style.cssText = ""; }
          return;
        }
        const el = tilts[i];
        el.style.setProperty("--rx", `${s.rx.toFixed(2)}deg`);
        el.style.setProperty("--ry", `${s.ry.toFixed(2)}deg`);
        el.style.setProperty("--go", s.go.toFixed(3));
        if (go) { el.style.setProperty("--gx", `${(gx * 100).toFixed(1)}%`); el.style.setProperty("--gy", `${(gy * 100).toFixed(1)}%`); }
      });
    }

    // Lavora solo quando il tunnel è a schermo.
    new IntersectionObserver(([e]) => {
      active = e.isIntersecting;
      if (active) { prev = performance.now(); scene.start(); raf = requestAnimationFrame(tick); }
      else { scene.stop(); cancelAnimationFrame(raf); }
    }).observe(stage);

    window.addEventListener("pointermove", (e) => {
      ptr.x = e.clientX; ptr.y = e.clientY;
      scene.setPointer(e.clientX / window.innerWidth - 0.5, e.clientY / window.innerHeight - 0.5);
    }, { passive: true });

    // Con la tastiera: un link dentro una card lontana porta lo scroll fino a lei.
    cards.forEach((card, i) => card.addEventListener("focusin", () => {
      const f = (i - START) / (END - START);
      window.scrollTo({ top: top + f * scrollable, behavior: "instant" as ScrollBehavior });
    }));

    window.addEventListener("resize", layout);
    layout();
    cam = target();
    place(cam);
  }
</script>

<style is:global>
  /* Scrollbar in tinta col tunnel (solo home: questo componente sta solo lì). */
  html:has(.tunnel) { scrollbar-width: thin; scrollbar-color: #3b82f6 #0f172a; background: #0f172a; }
  html:has(.tunnel)::-webkit-scrollbar { width: 8px; }
  html:has(.tunnel)::-webkit-scrollbar-track { background: #0f172a; }
  html:has(.tunnel)::-webkit-scrollbar-thumb { background: linear-gradient(#3b82f6, #6366f1); border-radius: 8px; border: 2px solid #0f172a; }
</style>

<style>
  /* ───────── BASE (anche senza 3D: colonna di card su navy) ───────── */
  .tunnel {
    position: relative;
    background: var(--color-ink);
    color: var(--color-ink);
  }
  .tunnel__stage { position: relative; }
  .tunnel__canvas, .tunnel__vignette, .tunnel__hud, .tunnel__hint { display: none; }
  .tunnel__cards {
    list-style: none; margin: 0;
    padding: var(--space-2xl) var(--page-gutter);
    display: flex; flex-direction: column; align-items: center; gap: var(--space-xl);
  }

  /* ───────── MODALITÀ TUNNEL ───────── */
  .tunnel.is-3d .tunnel__stage {
    position: sticky; top: 0;
    height: 100vh; height: 100svh;
    overflow: hidden;
  }
  .tunnel.is-3d .tunnel__canvas { display: block; position: absolute; inset: 0; width: 100%; height: 100%; }
  .tunnel.is-3d .tunnel__vignette {
    display: block; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at 50% 55%, transparent 45%, rgba(15, 23, 42, 0.75) 100%);
  }
  .tunnel.is-3d .tunnel__cards {
    position: absolute; inset: 0; padding: 0;
    padding-top: var(--header-h);
    perspective: 1000px; perspective-origin: 50% 55%;
    transform-style: preserve-3d;
    display: block;
  }
  .tunnel.is-3d .tslot {
    position: absolute; left: 50%; top: calc(50% + var(--header-h) / 2);
    translate: -50% -50%;
    pointer-events: none;
  }
  .tunnel.is-3d .tslot.is-here { pointer-events: auto; }

  /* HUD */
  .tunnel.is-3d .tunnel__hud {
    display: flex; flex-direction: column; gap: 0.6rem;
    position: absolute; left: var(--page-gutter); bottom: var(--space-lg); z-index: 2000;
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase;
    color: #cbd5e1; pointer-events: none;
  }
  .tunnel__hud-n { font-size: var(--text-lg); color: #fff; font-weight: 600; }
  .tunnel__hud-tot { color: #64748b; }
  .tunnel__hud-bar { width: 9rem; height: 2px; background: rgba(255, 255, 255, 0.14); overflow: hidden; }
  .tunnel__hud-bar span { display: block; height: 100%; background: var(--color-accent); transform-origin: left; transform: scaleX(0); }
  .tunnel__hud-label { color: #93c5fd; }

  .tunnel.is-3d .tunnel__hint {
    display: block; position: absolute; left: 50%; bottom: var(--space-lg); translate: -50% 0; z-index: 2000;
    margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.14em; text-transform: uppercase;
    color: #cbd5e1; transition: opacity var(--dur-slow) var(--ease-out);
  }
  .tunnel__hint span { display: inline-block; animation: hint 1.6s ease-in-out infinite; }
  .tunnel__hint.is-gone { opacity: 0; }
  @keyframes hint { 50% { transform: translateY(4px); } }

  /* ───────── CARD ───────── */
  .tcard {
    position: relative;
    /* Tilt alla vanilla-tilt: la card ruota verso il puntatore e i blocchi interni
       stanno su piani diversi (translateZ), così "escono" dalla card. */
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    width: min(60rem, calc(100vw - 2 * var(--page-gutter)));
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 3rem);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(147, 197, 253, 0.25), 0 0 60px -10px rgba(59, 130, 246, 0.35);
  }
  .tcard .eyebrow { margin-bottom: var(--space-xs); }

  /* Piani di profondità: ogni contenitore intermedio deve restare 3D. */
  .tcard :is(.tarea__body, .tgoal, .tgoal__row, .tgoal__aree, .tbandi, .tbandi > li, .tteam, .tteam > li, .tnum, .twhy, .twhy > li, .tcta__actions, .tarea__list) { transform-style: preserve-3d; }
  .tcard--why > div { transform-style: preserve-3d; }
  .tcard .eyebrow { transform: translateZ(30px); }
  .tcard .tcard__title { transform: translateZ(60px); }
  .tcard :is(.tarea__desc, .tcta__lede, .tcard__note, .tgoal__t, .twhy p) { transform: translateZ(30px); }
  .tcard :is(.twhy h3, .twhy__n, .tbando__t) { transform: translateZ(45px); }
  .tcard :is(.tnum__item, .tarea__list li) { transform: translateZ(40px); }
  .tcard :is(.btn, .tgoal__tag, .tbando__cta) { transform: translateZ(55px); }
  .tcard .tarea__icon { transform: translateZ(70px); }
  .tcard .tteam img { transform: translateZ(25px); }
  .tcard .tteam :is(h3, p) { transform: translateZ(40px); }
  .tcard .tbando { transform-style: preserve-3d; }
  .tcard .btn:hover .btn__arrow { transform: translateX(2px); }

  /* riflesso di luce che segue il puntatore */
  .tglare {
    position: absolute; inset: 0; border-radius: inherit; overflow: hidden;
    pointer-events: none; transform: translateZ(1px);
  }
  .tglare::before {
    content: ""; position: absolute; inset: -50%;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 40%);
    opacity: var(--go, 0);
  }
  .tcard--cta .tglare::before { background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgba(147, 197, 253, 0.28), transparent 40%); }
  .tcard__title { font-size: var(--text-3xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 var(--space-lg); color: var(--color-ink); }
  .tcard__title--sm { font-size: var(--text-2xl); margin-bottom: var(--space-sm); }
  .tcard__title--xl { font-size: var(--text-4xl); }
  .tcard .accent { color: var(--color-accent); }
  .tcard__note { font-size: var(--text-sm); color: var(--color-muted); margin: var(--space-md) 0 0; }
  .tcard__note strong { color: var(--color-ink); }

  /* numeri */
  .tnum { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-md); margin: 0; }
  .tnum__item { margin: 0; padding-left: var(--space-sm); border-left: 2px solid var(--color-accent); }
  .tnum dt { font-family: var(--font-display); font-weight: 700; font-size: var(--text-2xl); line-height: 1; white-space: nowrap; }
  .tnum dd { margin: 0.4rem 0 0; font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.4; }

  /* obiettivi */
  .tgoal { list-style: none; margin: 0; padding: 0; }
  .tgoal__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1rem; padding-block: 0.8rem; border-top: 1px solid var(--color-rule); }
  .tgoal__t { font-family: var(--font-display); font-weight: 600; font-size: var(--text-lg); }
  .tgoal__aree { display: flex; flex-wrap: wrap; gap: 0.4rem; }
