---
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="container">
    <div class="foot__top">
      <div class="foot__brand">
        <a href="/" class="foot__brand-lockup" aria-label="iCura Impresa, homepage">
          <span class="foot__wordmark">i<strong>Cura</strong>Impresa<span class="foot__dot" aria-hidden="true">.</span></span>
          <img
            class="foot__logo"
            src="/images/brand/logo-icura-white.webp"
            alt=""
            width="460"
            height="600"
            loading="lazy"
            decoding="async"
            aria-hidden="true"
          />
        </a>
        <p class="foot__desc">
          Un solo interlocutore per la sicurezza, la formazione e gli adempimenti
          della tua impresa. Dal 2014, su tutta Italia.
        </p>
        <p class="foot__tagline">Vivi Sicuro!</p>
      </div>

      <nav class="foot__col" aria-label="Servizi">
        <span class="foot__label">Servizi</span>
        <ul>
          <li><a href="/servizi/consulenza">Consulenza &amp; Sicurezza</a></li>
          <li><a href="/servizi/engineering">Engineering &amp; Antincendio</a></li>
          <li><a href="/servizi/formazione">Formazione</a></li>
          <li><a href="/servizi/certificazioni">Certificazioni &amp; Gare</a></li>
          <li><a href="/servizi/finanza-agevolata">Finanza agevolata</a></li>
        </ul>
      </nav>

      <nav class="foot__col" aria-label="Azienda">
        <span class="foot__label">Azienda</span>
        <ul>
          <li><a href="/chi-siamo">Chi siamo</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/lavora-con-noi">Lavora con noi</a></li>
          <li><a href="/contatti">Contatti</a></li>
        </ul>
      </nav>

      <div class="foot__col">
        <span class="foot__label">Contatti</span>
        <address class="foot__address">
          Corso Secondigliano, 236<br />
          80144 Napoli (NA) · Italia<br />
          <a href="tel:+390816580779">081 658 0779</a><br />
          <a href="mailto:info@icuraimpresa.it">info@icuraimpresa.it</a>
        </address>
      </div>
    </div>

    <div class="foot__meta">
      <span>© {year} iCura Impresa S.r.l. — Tutti i diritti riservati.</span>
      <span class="foot__meta-links">
        <a href="/privacy">Privacy</a>
        <a href="/cookie">Cookie</a>
        <span>Sede legale: Via John Fitzgerald Kennedy 73, Napoli (NA) · P.IVA 09078161214</span>
      </span>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--color-ink);
    color: var(--color-paper);
    padding-block: var(--space-3xl) var(--space-lg);
  }

  .foot__top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: var(--space-2xl) var(--space-xl);
    align-items: start;
  }

  .foot__brand { display: flex; flex-direction: column; gap: var(--space-md); }
  .foot__brand-lockup {
    display: inline-flex; align-items: center; gap: var(--space-sm);
    align-self: flex-start; text-decoration: none; line-height: 1;
  }
  .foot__brand-lockup:hover { text-decoration: none; }
  .foot__wordmark {
    font-family: var(--font-wordmark); font-weight: 500;
    font-size: var(--text-xl); letter-spacing: -0.03em; color: var(--color-paper);
  }
  .foot__wordmark strong { font-weight: 800; }
  .foot__dot { color: var(--color-accent); }
  .foot__logo { height: 2.75rem; width: auto; }
  .foot__desc {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-paper) 62%, transparent);
    max-width: 34ch;
    margin: 0;
  }
  .foot__tagline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-accent);
    margin: 0;
  }

  .foot__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .foot__col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-sm); }
  .foot__col a,
  .foot__address a {
    font-size: var(--text-sm);
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot__col a:hover,
  .foot__address a:hover { color: var(--color-accent); text-decoration: none; }

  .foot__address {
    font-style: normal;
    font-size: var(--text-sm);
    line-height: 1.9;
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .foot__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-md);
    align-items: center;
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid color-mix(in srgb, var(--color-paper) 12%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-paper) 45%, transparent);
  }
  .foot__meta-links { display: inline-flex; flex-wrap: wrap; gap: var(--space-lg); align-items: center; }
  .foot__meta a { color: color-mix(in srgb, var(--color-paper) 45%, transparent); text-decoration: none; }
  .foot__meta a:hover { color: var(--color-accent); text-decoration: none; }

  @media (max-width: 64rem) {
    .foot__top { grid-template-columns: 1fr 1fr; }
    .foot__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 40rem) {
    .foot__top { grid-template-columns: 1fr; }
    .foot__meta { flex-direction: column; align-items: flex-start; }
  }
</style>
