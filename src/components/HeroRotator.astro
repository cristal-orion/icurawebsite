---
// Hero a carosello: una slide per area, avanza da sola con una linea di avanzamento
// a segmenti (ispirato a React Bits Pro "Hero 6", rifatto in Astro + JS vanilla).
// Effetti: titolo che sale parola per parola, foto rivelata da una "scansione",
// chip HUD sulla foto, griglia tecnica di punti che reagisce al cursore.
// Il titolo SEO è l'<h1> statico; le slide sono contenuto decorativo/navigazione.
const slides = [
  {
    area: "Sicurezza sul lavoro.", slogan: "Proteggi ciò che conta.",
    desc: "Valutazione dei rischi, DVR, cantieri, HACCP e medicina del lavoro: un sistema che regge anche all’ispezione.",
    href: "/servizi/consulenza", img: "/images/sicurezza-ispezione-capannone.webp", glow: "#3b82f6",
    chips: [{ k: "DVR", t: "Aggiornato" }, { k: "Sopralluogo", t: "Capannone · Napoli" }, { k: "D.Lgs. 81/08", t: "Adempimenti in regola" }],
  },
  {
    area: "Engineering.", slogan: "Costruisci su basi sicure.",
    desc: "Rilievi 3D, progettazione di spazi e impianti, prevenzione incendi e collaudi. Un responsabile per pratica.",
    href: "/servizi/engineering", img: "/images/macroaree-engineering.webp", glow: "#0ea5e9",
    chips: [{ k: "Rilievo 3D", t: "Nuvola di punti" }, { k: "Prevenzione incendi", t: "Pratica VV.F." }, { k: "Collaudo", t: "Programmato" }],
  },
  {
    area: "Formazione.", slogan: "Il futuro cresce con le persone.",
    desc: "Corsi obbligatori e di crescita, in aula, a distanza o in azienda. Dove possibile, con i fondi interprofessionali.",
    href: "/servizi/formazione", img: "/images/macroaree-formazione.webp", glow: "#6366f1",
    chips: [{ k: "Accordo Stato-Regioni", t: "2025" }, { k: "Fondi interprofessionali", t: "Piano formativo" }, { k: "Attestati", t: "Registrati" }],
  },
  {
    area: "Certificazioni.", slogan: "Dai valore a come lavori.",
    desc: "ISO 9001, 14001, 45001, 27001, 37001, parità di genere e attestazione SOA: ti accompagniamo fino all’organismo.",
    href: "/servizi/certificazioni", img: "/images/macroaree-certificazioni.webp", glow: "#2563eb",
    chips: [{ k: "ISO 9001", t: "Sistema qualità" }, { k: "Attestazione SOA", t: "Gare pubbliche" }, { k: "UNI/PdR 125", t: "Parità di genere" }],
  },
  {
    area: "Finanza agevolata.", slogan: "Dai risorse alle tue idee.",
    desc: "Bando ISI INAIL, ZES Unica, iper-ammortamento: dai requisiti alla rendicontazione.",
    href: "/servizi/finanza-agevolata", img: "/images/macroaree-finanza-agevolata.webp", glow: "#06b6d4",
    chips: [{ k: "Bando ISI INAIL", t: "Requisiti verificati" }, { k: "ZES Unica", t: "Credito d’imposta" }, { k: "Rendicontazione", t: "Seguita fino in fondo" }],
  },
  {
    area: "Digitale e IA.", slogan: "Dai forma digitale al tuo metodo.",
    desc: "App e gestionali su misura, costruiti con l’intelligenza artificiale e integrati con i tuoi processi.",
    href: "/servizi/digitale", img: "/images/digitale-gestionale.webp", glow: "#8b5cf6",
    chips: [{ k: "Gestionale", t: "Su misura" }, { k: "Intelligenza artificiale", t: "Processi automatizzati" }, { k: "Dati", t: "Integrati" }],
  },
];
const DURATION = 6000;

// Titolo spezzato in parole, con indice progressivo per lo sfalsamento dell'animazione.
const words = (s: (typeof slides)[number]) => {
  const a = s.area.split(" ");
  const b = s.slogan.split(" ");
  return { a, b, offset: a.length };
};
---

<section class="rot" data-rot style={`--rot-dur: ${DURATION}ms`} aria-roledescription="carosello" aria-label="Le aree di iCura Impresa">
  <div class="rot__glows" aria-hidden="true">
    {slides.map((s, i) => <span class:list={["rot__glow", { "is-active": i === 0 }]} style={`--glow: ${s.glow}`}></span>)}
  </div>
  <canvas class="rot__grid" data-grid aria-hidden="true"></canvas>

  <div class="rot__inner">
    <div class="rot__text">
      <h1 class="rot__h1">Consulenza, sicurezza, formazione e bandi per le imprese, a Napoli.</h1>

      <div class="rot__slides">
        {slides.map((s, i) => {
          const w = words(s);
          return (
            <a href={s.href} class:list={["rot__slide", { "is-active": i === 0 }]} data-slide aria-hidden={i === 0 ? undefined : "true"} tabindex={i === 0 ? undefined : "-1"} aria-label={`${s.area} ${s.slogan}`}>
              <span class="rot__area" aria-hidden="true">
                {w.a.map((x, j) => <span class="w"><span style={`--i: ${j}`}>{x}</span></span>)}
              </span>
              <span class="rot__slogan" aria-hidden="true">
                {w.b.map((x, j) => <span class="w"><span style={`--i: ${j + w.offset}`}>{x}</span></span>)}
              </span>
              <span class="rot__desc">{s.desc}</span>
            </a>
          );
        })}
      </div>

      <div class="rot__ctas">
        <a href="/contatti" class="rot__cta">Parliamo della tua impresa</a>
        <a href="#servizi" class="rot__link">Esplora le aree <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="rot__bar" role="tablist" aria-label="Scegli l’area">
      {slides.map((s, i) => (
        <button type="button" role="tab" class:list={["rot__seg", { "is-active": i === 0 }]} data-seg aria-selected={i === 0 ? "true" : "false"} aria-label={s.area.replace(".", "")}>
          <span class="rot__fill"></span>
        </button>
      ))}
    </div>

    <div class="rot__media" data-media aria-hidden="true">
      <div class="rot__frame">
        {slides.map((s, i) => (
          <img src={s.img} alt="" class:list={["rot__img", { "is-active": i === 0 }]} data-img loading={i === 0 ? "eager" : "lazy"} decoding="async" />
        ))}
        <span class="rot__scan" data-scan></span>
        <span class="rot__corner rot__corner--tl"></span>
        <span class="rot__corner rot__corner--tr"></span>
        <span class="rot__corner rot__corner--bl"></span>
        <span class="rot__corner rot__corner--br"></span>
      </div>
      {slides.map((s, i) => (
        <div class:list={["rot__chips", { "is-active": i === 0 }]} data-chips>
          {s.chips.map((c, j) => (
            <span class={`rot__chip rot__chip--${j}`} style={`--j: ${j}`}>
              <span class="rot__chip-dot"></span>
              <span class="rot__chip-k">{c.k}</span>
              <span class="rot__chip-t">{c.t}</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-rot]").forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const segs = [...root.querySelectorAll<HTMLButtonElement>("[data-seg]")];
    const imgs = [...root.querySelectorAll<HTMLImageElement>("[data-img]")];
    const glows = [...root.querySelectorAll<HTMLElement>(".rot__glow")];
    const chips = [...root.querySelectorAll<HTMLElement>("[data-chips]")];
    const scan = root.querySelector<HTMLElement>("[data-scan]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = 0;

    if (!reduce) root.classList.add("is-auto");

    const go = (n: number) => {
      const prev = cur;
      cur = (n + slides.length) % slides.length;
      if (cur === prev) return;
      const set = (list: HTMLElement[]) => list.forEach((el, i) => el.classList.toggle("is-active", i === cur));
      [slides, segs, imgs, glows, chips].forEach(set);
      // La foto precedente resta sotto mentre la nuova si rivela dall'alto.
      imgs.forEach((el, i) => el.classList.toggle("is-prev", i === prev));
      slides.forEach((el, i) => {
        if (i === cur) { el.removeAttribute("aria-hidden"); el.removeAttribute("tabindex"); }
        else { el.setAttribute("aria-hidden", "true"); el.tabIndex = -1; }
      });
      segs.forEach((el, i) => el.setAttribute("aria-selected", String(i === cur)));
      // Riavvio la linea di scansione.
      scan.classList.remove("is-run");
      void scan.offsetWidth;
      scan.classList.add("is-run");
    };

    // Dopo il caricamento precarico tutte le foto: la scansione deve rivelare un'immagine pronta.
    const preload = () => imgs.forEach((img) => (img.loading = "eager"));
    if (document.readyState === "complete") preload();
    else addEventListener("load", preload, { once: true });

    // Avanzamento guidato dall'animazione CSS della barra: pausa (hover/focus) gratis.
    segs.forEach((seg, i) => {
      seg.addEventListener("click", () => go(i));
      seg.querySelector(".rot__fill")!.addEventListener("animationend", () => { if (i === cur) go(cur + 1); });
    });

    // Fuori schermo o tab nascosto: pausa.
    new IntersectionObserver(([e]) => root.classList.toggle("is-paused", !e.isIntersecting)).observe(root);
    document.addEventListener("visibilitychange", () => root.classList.toggle("is-hidden", document.hidden));

    // ── Griglia tecnica di punti: si accende attorno al cursore (solo con mouse) ──
    const canvas = root.querySelector<HTMLCanvasElement>("[data-grid]")!;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const GAP = 28, R = 220;
    let w = 0, h = 0, mx = -9999, my = -9999, raf = 0;

    const draw = () => {
      raf = 0;
      ctx.clearRect(0, 0, w, h);
      for (let y = GAP / 2; y < h; y += GAP) {
        for (let x = GAP / 2; x < w; x += GAP) {
          const d = Math.hypot(x - mx, y - my);
          const k = d < R ? (1 - d / R) ** 2 : 0;
          ctx.fillStyle = k ? `rgba(96, 165, 250, ${0.1 + k * 0.75})` : "rgba(248, 250, 252, 0.07)";
          const r = 1 + k * 1.2;
          ctx.fillRect(x - r / 2, y - r / 2, r, r);
        }
      }
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(draw); };
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = root.clientWidth; h = root.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      queue();
    };
    new ResizeObserver(resize).observe(root);

    if (!reduce && matchMedia("(hover: hover)").matches) {
      root.addEventListener("pointermove", (e) => {
        const r = root.getBoundingClientRect();
        mx = e.clientX - r.left; my = e.clientY - r.top;
        queue();
      });
      root.addEventListener("pointerleave", () => { mx = my = -9999; queue(); });
    }
  });
</script>

<style>
  .rot {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--color-ink);
    color: var(--color-paper);
    min-height: calc(100svh - var(--header-h));
    display: grid;
    align-items: center;
  }

  /* Bagliore dietro la foto: un livello per slide, sfuma in opacità */
  .rot__glows { position: absolute; inset: 0; z-index: -2; }
  .rot__glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 45% 60% at 74% 50%, color-mix(in srgb, var(--glow) 42%, transparent), transparent 70%),
      radial-gradient(ellipse 30% 40% at 92% 12%, color-mix(in srgb, var(--glow) 24%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .rot__glow.is-active { opacity: 1; }

  /* Griglia di punti, sfumata ai bordi */
  .rot__grid {
    position: absolute; inset: 0; z-index: -1;
    width: 100%; height: 100%;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, #000 40%, transparent 100%);
            mask-image: radial-gradient(ellipse 90% 85% at 50% 50%, #000 40%, transparent 100%);
  }

  .rot__inner {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--page-gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(var(--space-lg), 4vw, var(--space-3xl));
    align-items: center;
  }

  .rot__h1 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0 0 var(--space-lg);
    max-width: 42ch;
    line-height: 1.6;
  }

  /* Slide di testo impilate nella stessa cella: niente salti di layout */
  .rot__slides { display: grid; }
  .rot__slide {
    grid-area: 1 / 1;
    display: flex; flex-direction: column;
    color: inherit; text-decoration: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out);
  }
  .rot__slide.is-active { opacity: 1; pointer-events: auto; transition-duration: 0.1s; }
  .rot__slide:hover { text-decoration: none; }
  .rot__area, .rot__slogan {
    display: flex; flex-wrap: wrap; column-gap: 0.25em;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .rot__area { color: var(--color-paper); }
  .rot__slogan { color: color-mix(in srgb, var(--color-paper) 42%, transparent); }

  /* Parole che salgono da dietro una maschera */
  .w { display: inline-block; overflow: hidden; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .w > span {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 0.35s var(--ease-in);
  }
  .rot__slide.is-active .w > span {
    transform: none;
    transition: transform 0.9s var(--ease-out) calc(0.15s + var(--i) * 0.07s);
  }

  .rot__desc {
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    max-width: 44ch;
    opacity: 0; transform: translateY(0.5rem);
    transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }
  .rot__slide.is-active .rot__desc { opacity: 1; transform: none; transition: opacity 0.8s var(--ease-out) 0.55s, transform 0.8s var(--ease-out) 0.55s; }

  .rot__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); margin-top: var(--space-xl); }
  .rot__cta {
    display: inline-flex; align-items: center;
    padding: 0.9rem 1.8rem;
    background: var(--color-paper); color: var(--color-ink);
    font-weight: 600; border-radius: var(--radius-pill); text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .rot__cta:hover { background: var(--color-accent); color: #fff; text-decoration: none; }
  .rot__link { display: inline-flex; gap: 0.5em; color: var(--color-paper); font-weight: 600; font-size: var(--text-sm); text-decoration: none; }
  .rot__link:hover { color: var(--color-accent); text-decoration: none; }

  /* Linea di avanzamento a segmenti */
  .rot__bar { display: flex; flex-direction: column; gap: 0.6rem; align-self: stretch; justify-content: center; }
  .rot__seg {
    position: relative;
    width: 2px; flex: 0 1 4.5rem;
    padding: 0; border: 0; cursor: pointer;
    background: color-mix(in srgb, var(--color-paper) 18%, transparent);
    border-radius: 2px;
  }
  .rot__seg::after { content: ""; position: absolute; inset: -0.5rem -0.75rem; } /* area cliccabile più larga */
  .rot__fill { position: absolute; inset: 0; background: var(--color-paper); transform: scaleY(0); transform-origin: top; border-radius: inherit; }
  .rot__seg.is-active .rot__fill { transform: scaleY(1); box-shadow: 0 0 12px var(--color-accent); }
  .rot.is-auto .rot__seg.is-active .rot__fill { animation: rot-fill var(--rot-dur) linear forwards; }
  .rot.is-auto:hover .rot__fill,
  .rot.is-auto:focus-within .rot__fill,
  .rot.is-paused .rot__fill,
  .rot.is-hidden .rot__fill { animation-play-state: paused; }
  @keyframes rot-fill { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  .rot__seg:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 6px; }

  /* ── Foto: rivelata dall'alto con linea di scansione + mirino agli angoli ── */
  .rot__media { position: relative; }
  .rot__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 70svh;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-ink-inset);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }
  .rot__img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    z-index: 0;
    clip-path: inset(0 0 100% 0);
    transform: scale(1.06);
  }
  .rot__img.is-prev { clip-path: inset(0); z-index: 1; }
  .rot__img.is-active {
    clip-path: inset(0); z-index: 2; transform: scale(1);
    transition: clip-path 1.1s var(--ease-in-out), transform 7s var(--ease-out);
  }

  .rot__scan {
    position: absolute; left: 0; right: 0; top: 0; z-index: 3;
    height: 2px;
    background: #93c5fd;
    box-shadow: 0 0 18px 4px color-mix(in srgb, var(--color-accent) 70%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .rot__scan::after { /* scia luminosa sopra la linea */
    content: ""; position: absolute; left: 0; right: 0; bottom: 2px; height: 5rem;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-accent) 22%, transparent), transparent);
  }
  .rot__scan.is-run { animation: rot-scan 1.1s var(--ease-in-out) forwards; }
  @keyframes rot-scan {
    0% { top: 0; opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }

  .rot__corner { position: absolute; z-index: 4; width: 1.4rem; height: 1.4rem; border: 2px solid color-mix(in srgb, var(--color-paper) 70%, transparent); pointer-events: none; }
  .rot__corner--tl { top: 1rem; left: 1rem; border-right: 0; border-bottom: 0; }
  .rot__corner--tr { top: 1rem; right: 1rem; border-left: 0; border-bottom: 0; }
  .rot__corner--bl { bottom: 1rem; left: 1rem; border-right: 0; border-top: 0; }
  .rot__corner--br { bottom: 1rem; right: 1rem; border-left: 0; border-top: 0; }

  /* ── Chip HUD in vetro sulla foto ── */
  .rot__chips { position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  .rot__chip {
    position: absolute;
    display: grid; grid-template-columns: auto 1fr; column-gap: 0.6rem; align-items: center;
    padding: 0.6rem 0.9rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-ink) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-paper) 16%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
            backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.55);
    white-space: nowrap;
    opacity: 0; transform: translateY(0.75rem) scale(0.96);
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .rot__chips.is-active .rot__chip {
    opacity: 1; transform: none;
    transition: opacity 0.6s var(--ease-out) calc(0.9s + var(--j) * 0.18s), transform 0.7s var(--ease-out) calc(0.9s + var(--j) * 0.18s);
  }
  .rot__chip-dot {
    grid-row: span 2;
    width: 0.55rem; height: 0.55rem; border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px color-mix(in srgb, #4ade80 22%, transparent);
  }
  .rot__chip-k { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #93c5fd; }
  .rot__chip-t { font-size: var(--text-sm); font-weight: 600; color: var(--color-paper); }
  .rot__chip--0 { top: 9%; left: -1.5rem; }
  .rot__chip--1 { top: 46%; right: -2rem; }
  .rot__chip--2 { bottom: 9%; left: 12%; }

  @media (max-width: 56rem) {
    .rot { min-height: auto; }
    .rot__inner { grid-template-columns: 1fr; gap: var(--space-lg); padding-block: var(--space-xl); }
    .rot__media { order: -2; }
    .rot__frame { aspect-ratio: 4 / 3; max-height: none; }
    .rot__bar { order: -1; flex-direction: row; align-self: auto; }
    .rot__seg { width: auto; height: 2px; flex: 1 1 0; }
    .rot__fill { transform: scaleX(0); transform-origin: left; }
    .rot__seg.is-active .rot__fill { transform: scaleX(1); }
    .rot.is-auto .rot__seg.is-active .rot__fill { animation-name: rot-fill-x; }
    .rot__glow { background: radial-gradient(ellipse 80% 40% at 50% 20%, color-mix(in srgb, var(--glow) 35%, transparent), transparent 70%); }
    .rot__chip { padding: 0.45rem 0.7rem; }
    .rot__chip-t { font-size: var(--text-xs); }
    .rot__chip--0 { top: 0.75rem; left: 0.75rem; }
    .rot__chip--1 { display: none; }
    .rot__chip--2 { bottom: 0.75rem; left: auto; right: 0.75rem; }
  }
  @keyframes rot-fill-x { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .w > span, .rot__slide.is-active .w > span { transform: none; transition: none; }
    .rot__img, .rot__img.is-active { transform: none; transition: none; }
    .rot__scan { display: none; }
    .rot__chip, .rot__chips.is-active .rot__chip { transform: none; }
  }
</style>
