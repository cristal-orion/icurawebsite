---
// Icone line monocromatiche per le aree di servizio.
// Dimensione via --icon-size (default 1.75rem); colore via currentColor.
interface Props {
  name: "consulenza" | "formazione" | "engineering" | "finanza-agevolata" | "certificazioni" | "digitale";
}
const { name } = Astro.props;
---

<span class="service-icon" data-icon={name}>
  {name === "consulenza" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3 4.5 5.8v5.4c0 4.4 3.2 7.7 7.5 9 4.3-1.3 7.5-4.6 7.5-9V5.8L12 3Z" />
      <path d="m8.8 11.7 2.2 2.2 4.2-4.6" />
    </svg>
  )}
  {name === "formazione" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 4 2.5 8.5 12 13l9.5-4.5L12 4Z" />
      <path d="M6.5 10.7v4.5c0 1.4 2.5 2.5 5.5 2.5s5.5-1.1 5.5-2.5v-4.5" />
      <path d="M21.5 8.5v5.2" />
    </svg>
  )}
  {name === "engineering" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="3.2" />
      <path d="M12 2.4v2.7M12 18.9v2.7M2.4 12h2.7M18.9 12h2.7M5.1 5.1l1.9 1.9M17 17l1.9 1.9M18.9 5.1 17 7M7 17l-1.9 1.9" />
    </svg>
  )}
  {name === "finanza-agevolata" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M15.6 8.7a4.3 4.3 0 1 0 0 6.6" />
      <path d="M6.7 11h6.1M6.7 13.4h6.1" />
    </svg>
  )}
  {name === "certificazioni" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="9" r="5.2" />
      <path d="m8.7 13.3-1.9 7.2L12 17.9l5.2 2.6-1.9-7.2" />
    </svg>
  )}
  {name === "digitale" && (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="6.5" y="6.5" width="11" height="11" rx="1.5" />
      <path d="M9.5 9.5h5v5h-5z" />
      <path d="M9.5 3v3.5M14.5 3v3.5M9.5 17.5V21M14.5 17.5V21M3 9.5h3.5M3 14.5h3.5M17.5 9.5H21M17.5 14.5H21" />
    </svg>
  )}
</span>

<style>
  .service-icon {
    display: inline-flex;
    line-height: 0;
  }
  .service-icon svg {
    width: var(--icon-size, 1.75rem);
    height: var(--icon-size, 1.75rem);
    display: block;
  }
</style>
