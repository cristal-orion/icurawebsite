---
// Home "schedario": un cassetto 3D di cartelle, una per area (più bandi e chi siamo).
// Al passaggio la cartella si solleva; al clic esce dal cassetto e si apre al centro
// come un fascicolo: dentro la copertina c'è l'area, nella tasca i servizi come fogli.
// Tutto è HTML in CSS 3D (niente WebGL): testo nitido e indicizzabile.
// Su mobile il cassetto diventa una pila e il fascicolo un pannello dal basso.
// Stile: superfici piene a gradini di tono, niente gradienti, ombre, contorni o numerazioni.
import DotGrid from "@components/DotGrid.astro";
import { numeri, obiettivi, aree, bandi, passi } from "../data/home";
import { menu } from "../data/menu";

type Foglio = { t: string; k?: string; href?: string };
type Cartella = {
  id: string; titolo: string; slogan: string; desc: string;
  img: string; alt: string; href: string; cta: string;
  fogli: Foglio[]; numeri?: boolean; evidenza?: boolean;
};

const cartelle: Cartella[] = [
  ...aree.map((a) => ({
    id: a.href.split("/").pop()!,
    titolo: a.titolo, slogan: a.slogan, desc: a.desc,
    img: a.img, alt: a.alt, href: a.href,
    cta: `Vai a ${a.titolo}`,
    fogli: (menu.find((m) => m.href === a.href)?.voci ?? []).map((v) => ({ t: v.label, href: v.href })),
  })),
  {
    id: "bandi", titolo: "Bandi e scadenze", slogan: "Sempre aggiornati, verificati su fonti ufficiali.",
    desc: "Norme in vigore, agevolazioni aperte e prossime finestre: ti diciamo che cosa riguarda la tua impresa e che cosa fare adesso. Stato e date verificati al 7 ottobre 2026.",
    img: "/images/bando-documenti-inail.webp", alt: "Documenti per il bando ISI INAIL", href: "/servizi/finanza-agevolata",
    cta: "Vai alla finanza agevolata", evidenza: true,
    fogli: bandi.map((b) => ({ t: b.titolo, k: `${b.badge}: ${b.cta.toLowerCase()}`, href: b.href })),
  },
  {
    id: "chi-siamo", titolo: "Chi siamo", slogan: "Nove persone, guidate da un ingegnere.",
    desc: "A Napoli dal 2014: un solo referente per sicurezza, formazione, engineering, certificazioni e bandi. Prima di iniziare, un preventivo scritto che dice che cosa è compreso e chi fa che cosa.",
    img: "/images/chi-siamo-riunione-team.webp", alt: "Team di consulenti iCura Impresa in riunione operativa", href: "/chi-siamo",
    cta: "Conosci il team", numeri: true,
    fogli: passi.map((p) => ({ t: p.t, k: p.d })),
  },
];

// Fondo di ogni cartella: blu accent mescolato al navy, più chiaro davanti e più scuro in
// fondo. Senza bordi, sono questi gradini di tono a separare una cartella dall'altra.
const mix = (p: number) => {
  const a = [0x3b, 0x82, 0xf6], b = [0x0f, 0x17, 0x2a];
  return "#" + a.map((v, k) => Math.round(v * p + b[k] * (1 - p)).toString(16).padStart(2, "0")).join(""); // taste-skill-ignore: è un colore esadecimale
};
const fondo = (c: Cartella, i: number) => (c.evidenza ? "var(--color-highlight)" : mix(0.6 - i * 0.065));

// Obiettivi → cartelle da evidenziare (le aree linkate cadono dentro una cartella per prefisso).
const goals = obiettivi.map((o) => ({
  t: o.t,
  ids: [...new Set(o.aree.map((a) => cartelle.find((c) => a.href.startsWith(c.href))?.id).filter(Boolean))].join(" "),
}));

const N = cartelle.length;
---

<section class="arch" data-arch style={`--n: ${N}`} aria-labelledby="arch-title">
  <DotGrid />

  <div class="arch__head">
    <h1 id="arch-title" class="arch__h1">Un solo archivio per la tua impresa.</h1>
    <p class="arch__lede">Consulenza e sicurezza sul lavoro, formazione, engineering, certificazioni e bandi: a Napoli dal 2014.</p>
    <a href="#contatto" class="btn btn--primary arch__cta">Richiedi una consulenza <span class="btn__arrow" aria-hidden="true">→</span></a>
  </div>

  <div class="arch__stage" data-stage>
    <div class="drawer" data-drawer>
      <ul class="drawer__folders">
        {cartelle.map((c, i) => (
          <li class:list={["folder", { "folder--evidenza": c.evidenza }]} data-folder={c.id} style={`--i: ${i}; --ri: ${N - 1 - i}; --c: ${fondo(c, i)}`}>
            <button type="button" class="folder__btn" data-open={c.id} aria-haspopup="dialog" aria-controls={`dossier-${c.id}`}>
              <span class="folder__in">
                <span class="folder__tab">{c.titolo}</span>
                <span class="folder__body">
                  <span class="folder__text">
                    <span class="folder__title">{c.titolo}</span>
                    <span class="folder__slogan">{c.slogan}</span>
                  </span>
                  <img class="folder__img" src={c.img} alt="" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                </span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <div class="drawer__side drawer__side--l" aria-hidden="true"></div>
      <div class="drawer__side drawer__side--r" aria-hidden="true"></div>
      <div class="drawer__front" aria-hidden="true">
        <span class="drawer__plate">Archivio iCura Impresa</span>
        <span class="drawer__handle"></span>
      </div>
    </div>
  </div>

  <div class="arch__goals" role="group" aria-labelledby="arch-goals-t">
    <p id="arch-goals-t" class="arch__goals-label">Non sai da dove partire? Scegli un obiettivo.</p>
    {goals.map((g) => <button type="button" class="arch__goal" data-goal={g.ids} aria-pressed="false">{g.t}</button>)}
  </div>
</section>

{/* Fascicoli aperti: livello fisso spostato sotto <body> dallo script. */}
<div class="dossiers" data-dossiers hidden>
  <div class="dossiers__backdrop" data-close></div>
  {cartelle.map((c, i) => (
    <section class:list={["dossier", { "dossier--evidenza": c.evidenza }]} id={`dossier-${c.id}`} data-dossier={c.id} style={`--c: ${fondo(c, i)}`} role="dialog" aria-modal="true" aria-labelledby={`dossier-${c.id}-t`} inert>
      <div class="dossier__cover">
        <div class="dossier__front" aria-hidden="true">
          <span class="dossier__tab">{c.titolo}</span>
          <span class="dossier__front-title">{c.titolo}</span>
          <span class="dossier__front-slogan">{c.slogan}</span>
        </div>
        <div class="dossier__back">
          <img class="dossier__img" src={c.img} alt={c.alt} loading="lazy" decoding="async" />
          <div class="dossier__copy">
            <h2 id={`dossier-${c.id}-t`} class="dossier__title">{c.slogan}</h2>
            <p class="dossier__desc">{c.desc}</p>
            {c.numeri && (
              <dl class="dossier__nums">{numeri.map((m) => <div><dt>{m.n}</dt><dd>{m.l}</dd></div>)}</dl>
            )}
            <a href={c.href} class="btn btn--primary dossier__cta">{c.cta} <span class="btn__arrow" aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
      <div class="dossier__pocket">
        <h3 class="dossier__count">{c.numeri ? "Come lavoriamo" : `Dentro il fascicolo ${c.titolo}`}</h3>
        <ul class="dossier__sheets">
          {c.fogli.map((f, j) => {
            const Tag = f.href ? "a" : "div";
            return (
              <li style={`--s: ${j}`}>
                <Tag class="sheet" href={f.href}>
                  <span class="sheet__t">{f.t}</span>
                  {f.k && <span class="sheet__k">{f.k}</span>}
                  {f.href && <span class="sheet__go" aria-hidden="true">→</span>}
                </Tag>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))}
  <nav class="dossiers__bar" aria-label="Fascicoli">
    <button type="button" class="dossiers__btn" data-step="-1">← <span data-prev-label></span></button>
    <button type="button" class="dossiers__btn dossiers__btn--close" data-close>Chiudi</button>
    <button type="button" class="dossiers__btn" data-step="1"><span data-next-label></span> →</button>
  </nav>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-arch]");
  const overlay = document.querySelector<HTMLElement>("[data-dossiers]");
  if (root && overlay) {
    const drawer = root.querySelector<HTMLElement>("[data-drawer]")!;
    const stage = root.querySelector<HTMLElement>("[data-stage]")!;
    const dossiers = [...overlay.querySelectorAll<HTMLElement>("[data-dossier]")];
    const ids = dossiers.map((d) => d.dataset.dossier!);
    const folderOf = (id: string) => root.querySelector<HTMLElement>(`[data-folder="${id}"]`)!;
    const titleOf = (i: number) => folderOf(ids[(i + ids.length) % ids.length]).querySelector(".folder__title")!.textContent!;
    const prevLabel = overlay.querySelector<HTMLElement>("[data-prev-label]")!;
    const nextLabel = overlay.querySelector<HTMLElement>("[data-next-label]")!;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

    // Il livello dei fascicoli va sotto <body>: così posso rendere inerte tutto il resto.
    document.body.append(overlay);
    const outside = () => [...document.body.children].filter((el) => el !== overlay) as HTMLElement[];

    let current = -1;
    let busy = false;

    // Tempi allineati alle transizioni CSS (vedi blocco FASCICOLO negli stili).
    const PULL = 260, IN = 420, COVER = 820;

    const show = async (i: number) => {
      const d = dossiers[i];
      current = i;
      prevLabel.textContent = titleOf(i - 1);
      nextLabel.textContent = titleOf(i + 1);
      d.inert = false;
      d.classList.add("is-in");
      await wait(IN);
      d.classList.add("is-open");
      d.querySelector<HTMLElement>(".dossier__title")!.focus({ preventScroll: true });
      await wait(COVER);
    };

    const hide = async () => {
      const d = dossiers[current];
      d.classList.remove("is-open");
      await wait(COVER * 0.7);
      d.classList.remove("is-in");
      await wait(IN);
      d.inert = true;
    };

    const open = async (i: number) => {
      if (busy || current !== -1) return;
      busy = true;
      folderOf(ids[i]).classList.add("is-pulled");
      overlay.hidden = false;
      document.documentElement.classList.add("has-dossier");
      outside().forEach((el) => (el.inert = true));
      await wait(PULL);
      await show(i);
      busy = false;
    };

    const close = async () => {
      if (busy || current === -1) return;
      busy = true;
      const id = ids[current];
      await hide();
      overlay.hidden = true;
      document.documentElement.classList.remove("has-dossier");
      outside().forEach((el) => (el.inert = false));
      folderOf(id).classList.remove("is-pulled");
      folderOf(id).querySelector<HTMLElement>("[data-open]")!.focus({ preventScroll: true });
      current = -1;
      busy = false;
    };

    const step = async (delta: number) => {
      if (busy || current === -1) return;
      busy = true;
      const from = current;
      await hide();
      folderOf(ids[from]).classList.remove("is-pulled");
      const to = (from + delta + ids.length) % ids.length;
      folderOf(ids[to]).classList.add("is-pulled");
      await show(to);
      busy = false;
    };

    root.querySelectorAll<HTMLButtonElement>("[data-open]").forEach((btn) =>
      btn.addEventListener("click", () => open(ids.indexOf(btn.dataset.open!))),
    );
    overlay.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", close));
    overlay.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((btn) =>
      btn.addEventListener("click", () => step(Number(btn.dataset.step))),
    );
    document.addEventListener("keydown", (e) => {
      if (current === -1) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") step(1);
      else if (e.key === "ArrowLeft") step(-1);
    });
    // Le titolazioni ricevono il focus all'apertura, senza entrare nell'ordine di tabulazione.
    dossiers.forEach((d) => d.querySelector<HTMLElement>(".dossier__title")!.setAttribute("tabindex", "-1"));

    // Obiettivi: evidenziano le cartelle che servono, le altre si spengono.
    const goalBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-goal]")];
    goalBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        const on = btn.getAttribute("aria-pressed") !== "true";
        goalBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn && on)));
        const match = on ? btn.dataset.goal!.split(" ") : [];
        drawer.classList.toggle("is-filtered", on);
        ids.forEach((id) => folderOf(id).classList.toggle("is-match", match.includes(id)));
      }),
    );

    // Il cassetto segue il cursore: lieve rotazione, interpolata a ogni frame. Verso l'alto
    // si inclina di più (si guarda meglio dentro), così le linguette non si nascondono.
    if (!reduce && matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      const tick = () => {
        x += (tx - x) * 0.08;
        y += (ty - y) * 0.08;
        drawer.style.setProperty("--tilt-x", `${(y * 3).toFixed(2)}deg`);
        drawer.style.setProperty("--tilt-y", `${(x * 9).toFixed(2)}deg`);
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.001 ? requestAnimationFrame(tick) : 0;
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
      root.addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        tx = Math.max(-1, Math.min(1, (e.clientX - r.left) / r.width * 2 - 1));
        ty = Math.max(-1, Math.min(1, (e.clientY - r.top) / r.height * 2 - 1));
        kick();
      });
      root.addEventListener("pointerleave", () => { tx = 0; ty = 0; kick(); });
    }

    // Entrata del cassetto quando entra in vista.
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      root.classList.add("is-ready");
      io.disconnect();
    }, { threshold: 0.2 }).observe(stage);
  }
</script>

<style>
  /* ───────── HERO / ARCHIVIO ─────────
     Desktop: testo, azione e obiettivi a sinistra, cassetto a destra. Sotto i 64rem una colonna. */
  .arch {
    --folder-w: 100%;
    --folder-h: clamp(10rem, 42svh - 7rem, 15rem);
    --tab-w: 12rem;
    --tab-h: 2.5rem;
    --gap: 44px;      /* profondità tra una cartella e l'altra */
    --rise: 2.5rem;   /* ogni cartella più indietro sta più su: la sua linguetta resta tutta visibile */
    --lift: 4.5rem;   /* quanto sale al passaggio */
    --front-h: calc(var(--folder-h) * 0.5);

    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100svh - var(--header-h));
    display: grid;
    grid-template-columns: minmax(20rem, 30rem) minmax(0, 1fr);
    grid-template-rows: auto auto;
    grid-template-areas: "head stage" "goals stage";
    align-content: center;
    column-gap: clamp(var(--space-lg), 4vw, var(--space-2xl));
    padding: var(--space-lg) max(var(--page-gutter), (100vw - var(--page-max)) / 2);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .arch__head { grid-area: head; align-self: end; }
  .arch__h1 {
    font-family: var(--font-display); font-size: clamp(2.4rem, 1.5rem + 2.4vw, 3.75rem);
    font-weight: 650; letter-spacing: -0.03em; line-height: 1; margin: 0;
    color: var(--color-paper);
  }
  .arch__lede {
    margin: var(--space-md) 0 0; max-width: 36ch;
    font-size: var(--text-lg); line-height: 1.5;
    color: color-mix(in srgb, var(--color-paper) 82%, transparent);
  }
  .arch__cta { margin-top: var(--space-lg); }

  .arch__goals {
    grid-area: goals; align-self: start;
    margin: var(--space-xl) 0 0;
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs);
  }
  .arch__goals-label {
    width: 100%; margin: 0 0 var(--space-3xs);
    font-size: var(--text-md); font-weight: 600;
    color: var(--color-paper);
  }
  .arch__goal {
    font: inherit; font-size: var(--text-sm); cursor: pointer;
    padding: 0.5rem 0.95rem; border: 0; border-radius: var(--radius-pill);
    color: var(--color-paper);
    background: var(--color-ink-inset);
    transition: background var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .arch__goal:hover { background: #2a3a55; }
  .arch__goal:active { transform: scale(0.97); }
  .arch__goal:focus-visible { outline: 2px solid #93c5fd; outline-offset: 2px; }
  .arch__goal[aria-pressed="true"] { background: var(--color-accent); color: #fff; }

  /* ───────── CASSETTO 3D ─────────
     Lo spettatore sta sopra (perspective-origin alto): le cartelle in fondo salgono e
     rimpiccioliscono. La prima cartella è la più vicina; le linguette scalano da sinistra a destra. */
  .arch__stage {
    grid-area: stage;
    display: grid; place-items: end center;
    padding-top: calc(var(--tab-h) + (var(--n) - 1) * var(--rise) + var(--lift) - 1rem);
    perspective: 1500px;
    perspective-origin: 50% -40%;
  }
  .drawer {
    --tilt-x: 0deg; --tilt-y: 0deg;
    position: relative;
    width: var(--folder-w); height: var(--folder-h);
    transform-style: preserve-3d;
    transform: rotateX(calc(-12deg + var(--tilt-x))) rotateY(var(--tilt-y));
  }
  /* Le cartelle stanno tutte nella stessa cella: `order` le dipinge dalla più lontana alla
     più vicina. Chrome fa l'hit-test in ordine di pittura anche in 3D, quindi senza questo
     il clic su una linguetta finirebbe sulla cartella dietro. Il DOM (e il Tab) resta in ordine. */
  .drawer__folders {
    list-style: none; margin: 0; padding: 0;
    position: absolute; inset: 0;
    display: grid;
    transform-style: preserve-3d;
  }

  .folder {
    grid-area: 1 / 1;
    order: var(--ri);
    position: relative;
    transform-style: preserve-3d;
    transform: translate3d(0, calc(var(--i) * -1 * var(--rise)), calc(var(--i) * -1 * var(--gap)));
    transition: transform 520ms var(--ease-out), opacity 400ms var(--ease-out), filter 400ms var(--ease-out);
  }
  .folder--evidenza { --ink: var(--color-ink); }
  .drawer.is-filtered .folder:not(.is-match) { filter: saturate(0.3) brightness(0.5); }
  .folder.is-pulled {
    transform: translate3d(0, calc(var(--i) * -1 * var(--rise) - 130%), calc(var(--i) * -1 * var(--gap) + 160px));
    opacity: 0;
    transition-duration: 380ms, 300ms, 300ms;
    transition-timing-function: var(--ease-in);
  }

  /* Il bottone resta fermo e fa da area di clic (corpo + linguetta, ::after); a salire è
     solo la parte visibile (.folder__in, senza puntatore). Se salisse tutta la cartella,
     coprirebbe le linguette dietro e resterebbe "agganciata" al cursore. */
  .folder__btn {
    all: unset; box-sizing: border-box;
    position: absolute; inset: 0;
    cursor: pointer;
    transform-style: preserve-3d;
  }
  .folder__btn::after {
    content: ""; position: absolute; bottom: 100%;
    left: calc(var(--i) * (100% - var(--tab-w)) / (var(--n) - 1));
    width: var(--tab-w); height: var(--tab-h);
  }
  .folder__btn:focus-visible .folder__tab { outline: 2px solid #93c5fd; outline-offset: 3px; }

  /* Entrata: le cartelle salgono nel cassetto una dopo l'altra (sul livello interno, così
     la transform della cartella resta libera per l'uscita). */
  .folder__in {
    --fill: var(--c);
    position: absolute; inset: 0; display: block; pointer-events: none;
    color: var(--ink, #fff);
    translate: 0 60%; opacity: 0;
  }
  .arch.is-ready .folder__in {
    translate: 0 0; opacity: 1;
    transition: translate 900ms var(--ease-out), opacity 600ms var(--ease-out), transform 520ms var(--ease-out);
    transition-delay: calc(var(--ri) * 70ms + 150ms), calc(var(--ri) * 70ms + 150ms), 0s;
  }
  .folder__btn:focus-visible .folder__in,
  .drawer.is-filtered .folder.is-match .folder__in { transform: translateY(calc(-1 * var(--lift))); }
  .folder__btn:focus-visible .folder__in { --fill: var(--color-accent); color: #fff; }
  /* Solo con un puntatore vero: su touch l'hover resterebbe acceso dopo il tocco. */
  @media (hover: hover) {
    .folder__btn:hover .folder__in { transform: translateY(calc(-1 * var(--lift))); --fill: var(--color-accent); color: #fff; }
    .folder__btn:hover .folder__body > * { opacity: 1; }
  }

  .folder__tab, .folder__body { background: var(--fill); transition: background var(--dur-base) var(--ease-out); }
  .folder__tab {
    position: absolute; bottom: calc(100% - 1px);
    left: calc(var(--i) * (100% - var(--tab-w)) / (var(--n) - 1));
    width: var(--tab-w); height: var(--tab-h);
    display: flex; align-items: center;
    padding: 0 1rem;
    border-radius: 10px 10px 0 0;
    font-size: 0.875rem; font-weight: 600; line-height: 1.1;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .folder__body {
    position: absolute; inset: 0;
    display: grid; grid-template-columns: minmax(0, 1fr) 36%; align-items: start; gap: var(--space-lg);
    padding: var(--space-md) var(--space-lg) 0;
    border-radius: 0 10px 10px 10px;
  }
  /* Delle cartelle dietro si vede solo una striscia: il contenuto compare quando salgono. */
  .folder__body > * { opacity: 0; transition: opacity 300ms var(--ease-out); }
  .folder:first-child .folder__body > *,
  .folder__btn:focus-visible .folder__body > *,
  .drawer.is-filtered .folder.is-match .folder__body > * { opacity: 1; }
  .folder__text { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .folder__title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 650; letter-spacing: -0.015em; line-height: 1.1; }
  .folder__slogan { font-size: var(--text-md); opacity: 0.82; }
  /* La foto è "pinzata" dentro la cartella: il frontale del cassetto ne copre la parte bassa. */
  .folder__img { width: 100%; height: calc(var(--folder-h) - var(--space-md)); object-fit: cover; display: block; }

