---
// Riga "immagine + testo" alternabile — pattern di densità riusabile per
// dare respiro visivo alle pagine (rompe i muri di testo) e seminare le
// foto reali accanto al contenuto. Pensato per essere impilato più volte
// dentro una sezione: passa `flip` a righe alterne per il layout a zig-zag.
import Placeholder from "@components/Placeholder.astro";

interface Props {
  image: { src?: string; alt: string };
  title: string;
  paras: string[];
  eyebrow?: string;
  points?: string[];
  chips?: string[];
  cta?: { href: string; label: string };
  flip?: boolean;
  aspect?: "16/9" | "4/3" | "1/1" | "3/4" | "21/9";
  id?: string;
  labelledby?: string;
}
const {
  image,
  title,
  paras,
  eyebrow,
  points,
  chips,
  cta,
  flip = false,
  aspect = "4/3",
  id,
  labelledby,
} = Astro.props;
const headingId = labelledby ?? id ?? undefined;
---

<div class="feature-row" id={id} data-flip={flip ? "true" : "false"}>
  <div class="container feature-row__grid">
    <div class="feature-row__media">
      <Placeholder aspect={aspect} src={image.src} alt={image.alt} />
    </div>
    <div class="feature-row__body">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h3 id={headingId} class="feature-row__title">{title}</h3>
      {paras.map((p) => (
        <p class="feature-row__para">{p}</p>
      ))}
      {points && points.length > 0 && (
        <ul class="feature-row__points">
          {points.map((pt) => (
            <li>
              <span class="feature-row__tick" aria-hidden="true">✓</span>
              <span>{pt}</span>
            </li>
          ))}
        </ul>
      )}
      {chips && chips.length > 0 && (
        <ul class="chips" aria-label="Riferimenti">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
      )}
      {cta && (
        <a href={cta.href} class="link-cta feature-row__cta">
          {cta.label}
          <span class="link-cta__arrow" aria-hidden="true">→</span>
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .feature-row {
    padding-block: var(--space-xl);
  }
  .feature-row__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-lg), 4vw, var(--space-2xl));
    align-items: center;
  }
  /* zig-zag: immagine a destra sulle righe "flip" (solo da desktop) */
  .feature-row[data-flip="true"] .feature-row__media {
    order: 2;
  }

  .feature-row__media :global(.placeholder) {
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .feature-row__title {
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 var(--space-sm);
    max-width: 20ch;
  }
  .feature-row__para {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.6;
    max-width: 56ch;
  }
  .feature-row__para + .feature-row__para {
    margin-top: var(--space-sm);
  }

  .feature-row__points {
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }
  .feature-row__points li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    color: var(--color-ink);
    line-height: 1.45;
  }
  .feature-row__tick {
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 700;
    margin-top: 0.15em;
  }

  .feature-row__cta {
    margin-top: var(--space-lg);
  }

  @media (max-width: 56rem) {
    .feature-row__grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
    /* immagine sempre sopra il testo su mobile, anche se flip */
    .feature-row[data-flip="true"] .feature-row__media {
      order: -1;
    }
  }
</style>
