---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/inter-tight";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/raleway";
import "@styles/global.css";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import CookieConsent from "@components/CookieConsent.astro";

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
  /** Immagine per l'anteprima social (OG/Twitter). Path assoluto dalla root o URL completo. */
  image?: string;
  /** Esclude la pagina dall'indice dei motori di ricerca. */
  noindex?: boolean;
  /** Tipo Open Graph (default "website", per gli articoli "article"). */
  ogType?: string;
  /** Dati strutturati JSON-LD aggiuntivi, specifici della pagina (Service, Article…). */
  jsonld?: object | object[];
}

const {
  title,
  description = "iCura Impresa — consulenza per la sicurezza sul lavoro, formazione, engineering e adempimenti normativi. Napoli, dal 2014.",
  pageClass = "",
  image = "/images/esternoicura.webp",
  noindex = false,
  ogType = "website",
  jsonld,
} = Astro.props;

const fullTitle = title === "iCura Impresa" ? title : `${title} · iCura Impresa`;

// URL assoluti a partire da Astro.site (definito in astro.config.mjs).
const abs = (p: string) => new URL(p, Astro.site).href;

// Canonical con slash finale, coerente con l'output "directory" di Astro
// e con gli URL del sitemap (evita segnalazioni di duplicati in Search Console).
const withSlash = (p: string) => (p.endsWith("/") ? p : p + "/");
const path = withSlash(Astro.url.pathname);
const canonical = abs(path);
const ogImage = image.startsWith("http") ? image : abs(image);
const robots = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// ── Breadcrumb automatico dal path ──────────────────────────────
// Il segmento "servizi" non ha una pagina indice, quindi non diventa una tappa.
const pretty = (s: string) =>
  s.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const segs = path.split("/").filter(Boolean);
const crumbs: { name: string; url: string }[] = [{ name: "Home", url: "/" }];
let acc = "";
segs.forEach((seg, i) => {
  acc += "/" + seg;
  if (seg === "servizi") return;
  crumbs.push({ name: i === segs.length - 1 ? title : pretty(seg), url: acc });
});

// ── JSON-LD: identità aziendale (Organization + WebSite) ────────
const orgId = abs("/#organization");
const organization = {
  "@type": ["Organization", "ProfessionalService"],
  "@id": orgId,
  name: "iCura Impresa",
  legalName: "iCura Impresa S.r.l.",
  url: abs("/"),
  logo: abs("/images/brand/logo-icura.webp"),
  image: abs("/images/esternoicura.webp"),
  description:
    "Consulenza integrata per la sicurezza sul lavoro, la formazione, l'engineering e l'antincendio, le certificazioni e la finanza agevolata delle imprese. Napoli, dal 2014.",
  foundingDate: "2014",
  telephone: "+39 081 658 0779",
  email: "info@icuraimpresa.it",
  vatID: "IT09078161214",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Corso Secondigliano, 236",
    postalCode: "80144",
    addressLocality: "Napoli",
    addressRegion: "NA",
    addressCountry: "IT",
  },
  areaServed: { "@type": "Country", name: "Italia" },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "18:00",
  },
  hasMap:
    "https://www.google.com/maps/search/?api=1&query=Corso+Secondigliano+236,+80144+Napoli",
  knowsAbout: [
    "Sicurezza sul lavoro",
    "D.Lgs. 81/08",
    "RSPP",
    "Documento di Valutazione dei Rischi (DVR)",
    "Sicurezza nei cantieri (PSC/POS)",
    "HACCP",
    "Medicina del lavoro",
    "GDPR",
    "Prevenzione incendi e CPI",
    "Engineering e progettazione impiantistica",
    "Formazione sulla sicurezza sul lavoro",
    "Certificazioni ISO 9001, 14001, 45001",
    "Certificazione della parità di genere UNI/PdR 125",
    "Attestazione SOA",
    "Finanza agevolata e bandi",
    "Bando ISI INAIL",
    "ZES Unica",
    "Transizione 5.0",
  ],
};

const website = {
  "@type": "WebSite",
  "@id": abs("/#website"),
  url: abs("/"),
  name: "iCura Impresa",
  inLanguage: "it-IT",
  publisher: { "@id": orgId },
};

const breadcrumb =
  crumbs.length > 1
    ? {
        "@type": "BreadcrumbList",
        itemListElement: crumbs.map((c, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: c.name,
          item: abs(withSlash(c.url)),
        })),
      }
    : null;

const graph: object[] = [organization, website];
if (breadcrumb) graph.push(breadcrumb);
const extra = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [...graph, ...extra],
};
---

<!doctype html>
<html lang="it">
  <head>
    <!-- Google Consent Mode v2 — default denied (DEVE stare prima di GTM) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var __icuraConsent = null;
      try { __icuraConsent = localStorage.getItem('icura-consent'); } catch (e) {}
      if (__icuraConsent === 'granted') {
        gtag('consent', 'default', {
          ad_storage:'granted', ad_user_data:'granted', ad_personalization:'granted',
          analytics_storage:'granted', functionality_storage:'granted', security_storage:'granted'
        });
      } else {
        gtag('consent', 'default', {
          ad_storage:'denied', ad_user_data:'denied', ad_personalization:'denied',
          analytics_storage:'denied', functionality_storage:'granted', security_storage:'granted',
          wait_for_update: 500
        });
      }
    </script>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TM8GDD69');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="author" content="iCura Impresa S.r.l." />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="iCura Impresa" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={fullTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Dati strutturati (JSON-LD) -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class={pageClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TM8GDD69"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <!-- Clippy AI Widget -->
    <script src="https://clippyai.duckdns.org/static/clippy-embed.js" data-config-id="24932cb9"></script>

    <script>
      // Scroll reveal globale — fa entrare con un fade-up morbido titoli,
      // testi, card e immagini quando arrivano nel viewport. Vale su tutte
      // le pagine (è nel layout). Progressive enhancement: parte solo con
      // JS e motion attivo; gli elementi già nel primo viewport NON vengono
      // nascosti, così non c'è nessun flash sopra la piega.
      (() => {
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        const main = document.getElementById("main");
        if (!main || !("IntersectionObserver" in window)) return;

        const SELECTOR = [
          ".eyebrow",
          "h2:not(.sr-only)",
          "h3:not(.sr-only)",
          "[class*='card']",
          "[class*='lede']",
          ".macroaree__item",
          ".stat",
          ".intro__title",
          ".intro__body",
          "figure.placeholder",
        ].join(",");

        // Candidati dentro <main>, esclusi quelli dell'hero (ha già la sua animazione).
        let items = Array.from(main.querySelectorAll(SELECTOR)).filter(
          (el) => !el.closest(".hero-impact")
        );

        // Dedup: se un elemento è dentro un altro candidato, tieni solo il più esterno
        // (es. un <h3> dentro una card → anima la card, non entrambi).
        const set = new Set(items);
        items = items.filter((el) => {
          let p = el.parentElement;
          while (p) {
            if (set.has(p)) return false;
            p = p.parentElement;
          }
          return true;
        });
        if (!items.length) return;

        // Stagger: piccolo ritardo progressivo tra fratelli che entrano insieme
        // (una fila di card / numeri appare a cascata).
        const order = new Map();
        for (const el of items) {
          const parent = el.parentElement;
          const n = order.get(parent) || 0;
          order.set(parent, n + 1);
          el.style.setProperty("--reveal-delay", Math.min(n, 8) * 110 + "ms");
        }

        document.documentElement.classList.add("reveal-ready");

        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0 }
        );

        const fold = window.innerHeight * 0.9;
        for (const el of items) {
          if (el.getBoundingClientRect().top < fold) {
            // Già nel primo viewport: mostralo subito, senza nasconderlo prima.
            el.classList.add("is-visible");
          } else {
            el.setAttribute("data-reveal", "");
            io.observe(el);
          }
        }
      })();
    </script>
  </body>
</html>
