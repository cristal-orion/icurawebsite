---
import "@styles/global.css";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  pageClass?: string;
}

const {
  title,
  description = "iCura Impresa — consulenza per la sicurezza sul lavoro, formazione, engineering e adempimenti normativi. Napoli, dal 2014.",
  pageClass = "",
} = Astro.props;

const fullTitle = title === "iCura Impresa" ? title : `${title} · iCura Impresa`;
---

<!doctype html>
<html lang="it">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-TM8GDD69');</script>
    <!-- End Google Tag Manager -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1a3b" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class={pageClass}>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-TM8GDD69"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Clippy AI Widget -->
    <script src="https://clippyai.duckdns.org/static/clippy-embed.js" data-config-id="24932cb9"></script>
  </body>
</html>
