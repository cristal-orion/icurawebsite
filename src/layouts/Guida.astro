---
// Template minimo per gli articoli del blog ("guide pratiche").
// Riceve il testo già strutturato: sezioni con paragrafi ed elenchi.
// I paragrafi possono contenere link inline (HTML scritto qui nel repo, mai da input utente).
import Base from "@layouts/Base.astro";
import AreaGrid from "@components/AreaGrid.astro";
import CtaBand from "@components/CtaBand.astro";

type Blocco = { p: string } | { ul: string[] };
interface Sezione {
  id: string;
  titolo: string;
  blocchi: Blocco[];
}
interface Props {
  title: string;
  description: string;
  categoria: string;
  h1: string;
  lede: string;
  dataIso: string;
  dataLabel: string;
  sezioni: Sezione[];
  servizioHref: string;
  ctaTitle: string;
  ctaLede: string;
  altre: { categoria: string; titolo: string; href: string }[];
}
const {
  title,
  description,
  categoria,
  h1,
  lede,
  dataIso,
  dataLabel,
  sezioni,
  servizioHref,
  ctaTitle,
  ctaLede,
  altre,
} = Astro.props;

const articleLd = {
  "@type": "Article",
  headline: h1,
  description,
  datePublished: dataIso,
  dateModified: dataIso,
  inLanguage: "it-IT",
  articleSection: categoria,
  author: { "@id": new URL("/#organization", Astro.site).href },
  publisher: { "@id": new URL("/#organization", Astro.site).href },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={title} description={description} ogType="article" jsonld={articleLd}>
  <header class="page-header section">
    <div class="container">
      <a href="/blog" class="breadcrumb-back">&larr; Tutte le guide</a>
      <p class="eyebrow">Guida pratica · {categoria}</p>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <p class="byline">
        A cura di iCuraImpresa · approfondimento editoriale ·
        <time datetime={dataIso}>{dataLabel}</time>
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section">
    <div class="container guida">
      <nav class="guida__toc" aria-labelledby="guida-toc">
        <p id="guida-toc" class="guida__toc-title">In questa guida</p>
        <ol>
          {sezioni.map((s) => (
            <li><a href={`#${s.id}`}>{s.titolo}</a></li>
          ))}
        </ol>
      </nav>

      <article class="guida__body">
        {sezioni.map((s) => (
          <section id={s.id} aria-labelledby={`${s.id}-t`}>
            <h2 id={`${s.id}-t`}>{s.titolo}</h2>
            {s.blocchi.map((b) =>
              "p" in b ? (
                <p set:html={b.p} />
              ) : (
                <ul>
                  {b.ul.map((v) => <li>{v}</li>)}
                </ul>
              )
            )}
          </section>
        ))}
        <p class="guida__back"><a href="/blog" class="link-cta"><span aria-hidden="true">←</span> Tutte le guide</a></p>
      </article>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="guida-altre">
    <div class="container">
      <p class="eyebrow">Continua a esplorare</p>
      <h2 id="guida-altre" class="section-title">Altre guide per la tua impresa.</h2>
      <AreaGrid
        aree={altre.map((a) => ({ nome: a.titolo, desc: a.categoria, href: a.href, cta: "Leggi la guida" }))}
      />
    </div>
  </section>

  <CtaBand
    eyebrow="Il prossimo passo"
    title={ctaTitle}
    lede={ctaLede}
    primary={{ href: "/contatti", label: "Richiedi un confronto" }}
    secondary={{ href: servizioHref, label: "Approfondisci il servizio" }}
    labelledby="guida-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .breadcrumb-back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .breadcrumb-back:hover { color: var(--color-accent); text-decoration: none; }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
    max-width: 22ch;
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 56ch; }
  .byline {
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .guida {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .guida__toc { position: sticky; top: calc(var(--space-md) + 64px); }
  .guida__toc-title {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin: 0 0 var(--space-sm);
  }
  .guida__toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .guida__toc a { color: var(--color-ink-2); text-decoration: none; font-size: var(--text-md); line-height: 1.4; }
  .guida__toc a:hover { color: var(--color-accent); }

  .guida__body { max-width: 66ch; }
  .guida__body section + section { margin-top: var(--space-xl); }
  .guida__body h2 {
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-sm);
    scroll-margin-top: calc(var(--space-md) + 64px);
  }
  .guida__body p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.6; margin: 0 0 var(--space-md); }
  .guida__body ul { margin: 0 0 var(--space-md); padding-left: 1.2rem; color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.55; display: flex; flex-direction: column; gap: var(--space-2xs); }
  .guida__body :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 0.2em; }
  .guida__back { margin-top: var(--space-xl) !important; }
  .guida__body .guida__back :global(a) { text-decoration: none; }

  @media (max-width: 56rem) {
    .guida { grid-template-columns: 1fr; gap: var(--space-lg); }
    .guida__toc { position: static; }
  }
</style>
