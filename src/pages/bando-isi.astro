---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";

const requisiti = [
  "Impresa iscritta alla Camera di Commercio.",
  "In regola con i versamenti contributivi (DURC).",
  "Investimento minimo: 5.000 € (alcuni assi).",
  "Progetto realizzabile entro il termine del bando.",
];

const fasi = [
  { n: "01", titolo: "Pre-check", desc: "Verifichiamo idoneità impresa e progetto. Gratuito." },
  { n: "02", titolo: "Progettazione", desc: "Definiamo l'intervento, prepariamo la documentazione tecnica." },
  { n: "03", titolo: "Domanda", desc: "Compilazione e invio sul portale INAIL nella finestra click-day." },
  { n: "04", titolo: "Rendicontazione", desc: "Esecuzione, monitoraggio, chiusura della pratica all'INAIL." },
];
---

<Base
  title="Bando ISI 2024"
  description="Bando ISI INAIL 2024: 369 milioni di euro a fondo perduto per la sicurezza sul lavoro. Verifica idoneità con Icuraimpresa."
>
  {/* ───── Hero · Stat-Led ───── */}
  <section class="hero-stat">
    <div class="container hero-stat__inner">
      <p class="eyebrow">Bando ISI INAIL 2024</p>
      <p class="hero-stat__display">
        <span class="hero-stat__num">369</span>
        <span class="hero-stat__unit">mln €</span>
      </p>
      <p class="hero-stat__qualifier">
        A fondo perduto, per investimenti in sicurezza sul lavoro. Fino al <strong>65%</strong> dell'investimento, massimo <strong>130.000&nbsp;€</strong>.
      </p>
      <div class="hero-stat__ctas">
        <a href="/contatti" class="btn btn--primary">
          Verifica idoneità
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href="#fasi" class="btn btn--secondary">Come funziona</a>
      </div>
    </div>
  </section>

  <hr class="rule rule--thick" aria-hidden="true" />

  {/* ───── Immagine simbolo bando ───── */}
  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/bando-linea-produzione.webp"
        alt="Linea di produzione metalmeccanica italiana modernizzata: una pressa industriale nuova in primo piano con barriere fotoelettriche di sicurezza ben visibili e segnaletica gialla a terra; sullo sfondo sfocato un operatore in DPI completi consulta un tablet rugged; capannone ben illuminato luce diurna mista, palette desaturata con accenti arancio sui DPI; fotografia editoriale industriale, no posa marketing, no slogan visibili"
      />
    </div>
  </section>

  {/* ───── Requisiti ───── */}
  <section class="section">
    <div class="container two-col">
      <div>
        <p class="eyebrow">01 — Requisiti</p>
        <h2>Chi può fare domanda.</h2>
      </div>
      <ul class="reqs">
        {requisiti.map((r) => (
          <li class="req">{r}</li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  {/* ───── Fasi ───── */}
  <section id="fasi" class="section">
    <div class="container">
      <p class="eyebrow">02 — Come funziona</p>
      <h2 class="fasi__heading">Quattro fasi, una persona di riferimento.</h2>
      <ol class="fasi">
        {fasi.map((f) => (
          <li class="fase">
            <span class="fase__n">{f.n}</span>
            <h3 class="fase__titolo">{f.titolo}</h3>
            <p class="fase__desc">{f.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ───── Documenti detail ───── */}
  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="16/9"
        src="/images/bando-documenti-inail.webp"
        alt="Top-down view su una scrivania professionale: tre pile ordinate di documenti tecnici stampati con timbri INAIL visibili, una calcolatrice meccanica in grigio scuro, una penna stilografica nera appoggiata di traverso, un righello in legno; sfondo carta avorio leggermente texturizzata; nessuna persona, nessun monitor, nessun caffè; composizione asimmetrica sbilanciata a sinistra, luce frontale morbida, palette neutra calda; fotografia editoriale silenziosa"
      />
    </div>
  </section>

  {/* ───── Final CTA ───── */}
  <section class="section closing">
    <div class="container">
      <h2>Il pre-check è gratuito. Capiamo se ha senso, poi decidi tu.</h2>
      <a href="/contatti" class="btn btn--primary">
        Prenota il pre-check
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero-stat {
    padding-block: var(--space-2xl) var(--space-4xl);
    background: linear-gradient(
      180deg,
      var(--color-paper) 0%,
      var(--color-accent-soft) 100%
    );
  }
  .hero-stat__display {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin: var(--space-md) 0 var(--space-lg);
    font-family: var(--font-display);
    line-height: 0.9;
    font-feature-settings: "tnum";
  }
  .hero-stat__num {
    font-size: clamp(6rem, 4rem + 12vw, 14rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    color: var(--color-highlight);
  }
  .hero-stat__unit {
    font-size: clamp(2rem, 1.5rem + 3vw, 4rem);
    font-weight: 500;
    color: var(--color-ink);
  }
  .hero-stat__qualifier {
    font-size: var(--text-xl);
    color: var(--color-ink-2);
    max-width: 50ch;
    margin-bottom: var(--space-xl);
  }
  .hero-stat__qualifier strong { color: var(--color-ink); font-weight: 600; }
  .hero-stat__ctas { display: flex; gap: var(--space-sm); flex-wrap: wrap; }

  .two-col {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .reqs { list-style: none; margin: 0; padding: 0; }
  .req {
    padding: var(--space-md) 0;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    font-size: var(--text-lg);
    position: relative;
    padding-left: 2rem;
  }
  .req:first-child { border-top: var(--rule-hair) solid var(--color-rule); }
  .req::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .fasi__heading { font-size: var(--text-3xl); margin-bottom: var(--space-xl); max-width: 22ch; }
  .fasi {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fase {
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    margin-left: -1px;
  }
  .fase:first-child { margin-left: 0; }
  .fase__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-md);
  }
  .fase__titolo { font-size: var(--text-xl); margin: 0 0 var(--space-2xs); font-weight: 500; }
  .fase__desc { color: var(--color-ink-2); margin: 0; font-size: var(--text-md); }

  .closing { text-align: center; background: var(--color-paper-2); }
  .closing h2 {
    font-size: var(--text-3xl);
    max-width: 28ch;
    margin: 0 auto var(--space-lg);
  }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
    .fasi { grid-template-columns: 1fr; }
    .fase { margin-left: 0; margin-top: -1px; }
  }
  @media (min-width: 56rem) and (max-width: 76rem) {
    .fasi { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
