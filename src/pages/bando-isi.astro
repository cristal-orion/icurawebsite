---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";

const facts = [
  { num: "600 mln €", label: "Dotazione a fondo perduto (edizione 2025/2026)" },
  { num: "fino al 65%", label: "Delle spese — fino all'80% con modelli organizzativi" },
  { num: "5.000–130.000 €", label: "Importo del contributo" },
];

const finanzia = [
  {
    nome: "Macchinari più sicuri",
    desc: "Sostituzione di macchine e attrezzature obsolete con soluzioni a norma, più sicure ed efficienti.",
  },
  {
    nome: "Riduzione dei rischi",
    desc: "Interventi su rumore, vibrazioni, agenti nocivi, movimentazione carichi e rischio infortuni.",
  },
  {
    nome: "Modelli organizzativi",
    desc: "Adozione di modelli organizzativi e di responsabilità sociale: contributo fino all'80%.",
  },
  {
    nome: "Bonifica amianto",
    desc: "Rimozione e smaltimento di materiali contenenti amianto dai luoghi di lavoro.",
  },
];

const fasi = [
  { n: "01", titolo: "Pre-check idoneità", desc: "Verifichiamo che impresa e progetto rientrino negli assi di finanziamento del bando. È gratuito." },
  { n: "02", titolo: "Progetto a punteggio", desc: "Disegniamo l'intervento per massimizzare il punteggio: tipologia, rischio ridotto e parametri premiali." },
  { n: "03", titolo: "Documentazione", desc: "Prepariamo perizia, preventivi e tutta la modulistica tecnica richiesta dall'INAIL." },
  { n: "04", titolo: "Click day", desc: "Carichiamo e inviamo la domanda all'apertura dello sportello, dove conta l'ordine cronologico." },
  { n: "05", titolo: "Rendicontazione", desc: "Seguiamo realizzazione, collaudo e rendiconto fino all'erogazione del contributo." },
];

const faq = [
  {
    q: "Cos'è il click day e perché conta arrivare pronti?",
    a: "Il Bando ISI assegna i fondi a sportello: alla data fissata si invia la domanda e contano l'ordine cronologico e la velocità di invio, fino a esaurimento delle risorse. Non basta avere un buon progetto — serve essere validati e pronti a inviare nell'istante giusto. Per questo prepariamo tutto in anticipo e simuliamo l'invio.",
  },
  {
    q: "Quanto posso ottenere a fondo perduto?",
    a: "Il contributo copre il 65% delle spese ammissibili, che sale fino all'80% per i progetti dell'Asse dedicato ai modelli organizzativi e di responsabilità sociale. L'importo va da un minimo di 5.000 € a un massimo di 130.000 € per progetto.",
  },
  {
    q: "Che spese posso finanziare con il Bando ISI?",
    a: "Acquisto di macchinari e attrezzature più sicure in sostituzione di quelle obsolete, interventi di riduzione dei rischi (rumore, vibrazioni, movimentazione carichi, agenti nocivi), adozione di modelli organizzativi e bonifica di materiali contenenti amianto. Nel pre-check valutiamo quali voci massimizzano contributo e punteggio.",
  },
  {
    q: "La mia impresa può partecipare?",
    a: "Possono partecipare la generalità delle imprese iscritte alla Camera di Commercio, con alcune specificità per assi e settori (incluso quello agricolo). La verifica di idoneità dell'impresa e del progetto è proprio il primo passo che facciamo, gratuitamente, nel pre-check.",
  },
];
---

<Base
  title="Bando ISI INAIL 2025"
  description="Bando ISI INAIL 2025/2026: 600 milioni a fondo perduto per la sicurezza sul lavoro, contributi fino al 65% (80% con modelli organizzativi), da 5.000 a 130.000 €. iCura Impresa prepara la domanda e ti accompagna al click day."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Finanza agevolata · Bando ISI</p>
      <h1>Bando ISI INAIL 2025.</h1>
      <p class="lede">
        600 milioni a fondo perduto per mettere in sicurezza macchinari, processi e ambienti di lavoro. È a sportello, con click day: vince chi arriva pronto. La domanda la prepariamo noi.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt class="fact__num">{f.num}</dt>
            <dd class="fact__label">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/bando-isi-click-day-documenti.webp"
        alt="Documentazione tecnica per il Bando ISI preparata su una scrivania di consulenza: laptop con schermata non leggibile, checklist, calcolatrice e fascicoli ordinati, mani di un consulente al lavoro prima del click day, luce naturale"
      />
    </div>
  </section>

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Cos'è</p>
        <h2>Contributi a fondo perduto per la sicurezza.</h2>
      </div>
      <div class="prose">
        <p>
          Il Bando ISI dell'INAIL finanzia a fondo perduto i progetti delle imprese che migliorano le condizioni di salute e sicurezza sul lavoro. L'edizione 2025/2026 mette a disposizione 600 milioni di euro: il contributo copre fino al 65% delle spese, fino all'80% se si adottano modelli organizzativi e di responsabilità sociale.
        </p>
        <p>
          L'importo va da 5.000 a 130.000 € e si possono finanziare anche interventi aggiuntivi. La selezione è a sportello con click day e ordine cronologico di invio: per questo la preparazione anticipata fa la differenza.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt-2">
    <div class="container">
      <p class="eyebrow">Cosa puoi finanziare</p>
      <AreaGrid aree={finanzia} />
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <Steps
    eyebrow="Come ti aiutiamo"
    title="Pronti per il click day."
    steps={fasi}
    labelledby="isi-fasi"
  />

  <section class="section section--tight">
    <div class="container">
      <p class="note">
        Calendario, finestre di domanda e click day dell'edizione in corso vengono definiti dall'INAIL anno per anno: ti avvisiamo noi appena aprono e arriviamo pronti.
      </p>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-isi"
    labelledby="isi-faq"
    items={faq}
    tone="alt-blue"
  />

  <CtaBand
    title="Verifichiamo la tua idoneità al Bando ISI."
    lede="Pre-check gratuito · risposta entro 48 ore. Capiamo se il tuo progetto è finanziabile e prepariamo la domanda."
    image={{
      src: "/images/bando-isi-click-day-documenti.webp",
      alt: "Scrivania di consulenza pronta per il click day del Bando ISI: fascicoli tecnici, checklist, calcolatrice e laptop con portale non leggibile, mani di un consulente iCura Impresa che ordina i documenti, luce naturale, fotografia documentaria professionale",
    }}
    primary={{ href: "/contatti", label: "Richiedi il pre-check" }}
    labelledby="isi-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 54ch; }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
  }
  .fact { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .fact__num {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-highlight);
  }
  .fact__label { font-size: var(--text-sm); color: var(--color-ink-2); margin: 0; line-height: 1.45; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 18ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 60ch; }
  .prose p:last-child { margin-bottom: 0; }
  .note { font-size: var(--text-sm) !important; color: var(--color-muted) !important; }

  @media (max-width: 56rem) {
    .facts { grid-template-columns: 1fr; gap: var(--space-md); }
    .two-col { grid-template-columns: 1fr; }
  }
</style>
