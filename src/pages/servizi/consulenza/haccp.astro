---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const c = {
  "title": "HACCP a Napoli: manuale e corsi alimentaristi",
  "description": "Manuale di autocontrollo HACCP, formazione degli alimentaristi, procedure e assistenza ai controlli ASL e NAS per bar, ristoranti e laboratori.",
  "eyebrow": "Consulenza · Sicurezza alimentare",
  "h1": "Sicurezza alimentare e HACCP.",
  "lede": "Il manuale di autocontrollo non è un documento da tenere in un cassetto: è lo strumento che dimostra, punto per punto, come tieni sotto controllo i rischi alimentari della tua attività — e quello che ASL e NAS chiedono per primo quando entrano.",
  "aChi": [
    "Ristoranti, pizzerie, bar, pasticcerie, gastronomie e laboratori artigianali.",
    "Mense aziendali e scolastiche, catering, strutture ricettive con somministrazione.",
    "Produzione, confezionamento, trasporto e vendita di alimenti, compresi i negozi di vicinato.",
    "Chi apre, subentra o cambia tipologia di lavorazione e deve presentare la notifica sanitaria."
  ],
  "chips": [
    "Reg. CE 852/2004",
    "D.Lgs. 193/2007",
    "Reg. UE 1169/2011 — allergeni",
    "Formazione alimentaristi (disciplina regionale)",
    "Notifica sanitaria / SCIA"
  ],
  "intro": [
    "Chiunque produca, manipoli, somministri, confezioni, trasporti o venda alimenti — anche il bar sotto casa o la mensa aziendale — è un Operatore del Settore Alimentare (OSA) ai sensi del Regolamento CE 852/2004. Questo significa un obbligo preciso: avere un sistema di autocontrollo basato sui principi HACCP, messo per iscritto, aggiornato e applicato ogni giorno, non solo esibito in caso di controllo.",
    "Significa sapere esattamente dove nel tuo processo — dalla ricezione delle materie prime alla somministrazione — può insorgere un pericolo biologico, chimico o fisico, quali sono i punti critici da tenere sotto controllo, come li misuri e che cosa fai se un valore esce dai limiti. Se il manuale non rispecchia quello che succede davvero in cucina o in laboratorio, in caso di ispezione vale meno di niente; la responsabilità, anche penale nei casi più gravi, resta del titolare."
  ],
  "sottoAree": [
    {
      "nome": "Manuale di autocontrollo HACCP",
      "desc": "Redazione o revisione del piano su misura: analisi dei pericoli, punti critici di controllo (CCP), limiti critici, procedure di monitoraggio e azioni correttive. Un documento che descrive il tuo processo reale, non un modello scaricato."
    },
    {
      "nome": "Formazione obbligatoria degli alimentaristi",
      "desc": "Corsi per titolari, responsabili e addetti con i moduli previsti dalla disciplina regionale in base al livello di rischio, e gestione delle scadenze di aggiornamento di tutto il personale."
    },
    {
      "nome": "Piano di sanificazione e buone prassi igieniche (PRP)",
      "desc": "Procedure di pulizia e sanificazione di ambienti, attrezzature e superfici, gestione degli infestanti, tracciabilità delle materie prime, controllo della catena del freddo."
    },
    {
      "nome": "Etichettatura e allergeni",
      "desc": "Verifica delle informazioni obbligatorie su etichette e menu e gestione della comunicazione degli allergeni ai sensi del Reg. UE 1169/2011, anche per la somministrazione al banco."
    },
    {
      "nome": "Gestione dei controlli ASL e NAS",
      "desc": "Assistenza prima, durante e dopo l'ispezione: verifica preventiva della documentazione, presenza al sopralluogo quando serve, gestione di non conformità e prescrizioni."
    },
    {
      "nome": "Notifica sanitaria e SCIA alimentare",
      "desc": "Predisposizione e aggiornamento della notifica ai sensi del Reg. CE 852/2004 in caso di apertura, subentro, variazione dell'attività o della tipologia di lavorazione."
    }
  ],
  "ottieni": [
    "Un manuale HACCP che descrive davvero il tuo processo, con registrazioni pronte all'uso.",
    "Un unico referente per sopralluogo, formazione e scadenze, senza rimpalli tra consulenti.",
    "Attestati e aggiornamenti del personale monitorati, con avviso prima della scadenza.",
    "Assistenza nel giorno del controllo ASL o NAS, non solo un documento da mostrare."
  ],
  "ruoli": [
    {
      "titolo": "Svolto direttamente da iCuraImpresa",
      "desc": "Sopralluogo, analisi dei pericoli, manuale e procedure, piano di sanificazione, verifica allergeni, notifica sanitaria, assistenza ai controlli, scadenzario."
    },
    {
      "titolo": "Coordinato da iCuraImpresa",
      "desc": "Formazione degli alimentaristi, erogata secondo la disciplina regionale, e analisi di laboratorio (tamponi, acque, alimenti) quando previste dal piano."
    },
    {
      "titolo": "Svolto da terzi",
      "desc": "I laboratori accreditati eseguono le analisi; l'ASL riceve la notifica e svolge i controlli ufficiali."
    }
  ],
  "fasi": [
    {
      "n": "01",
      "titolo": "Sopralluogo e analisi del processo",
      "desc": "Veniamo nella tua attività — cucina, laboratorio, banco, magazzino — per mappare il flusso reale degli alimenti, dalla materia prima al prodotto finito."
    },
    {
      "n": "02",
      "titolo": "Redazione del piano di autocontrollo",
      "desc": "Costruiamo il manuale identificando i punti critici di controllo specifici della tua attività, con limiti, monitoraggio e azioni correttive coerenti con quello che si fa davvero in reparto."
    },
    {
      "n": "03",
      "titolo": "Formazione del personale",
      "desc": "Organizziamo i corsi per titolare, responsabili e addetti e verifichiamo che ogni persona a contatto con gli alimenti — anche part-time o stagionale — abbia l'attestato in corso di validità."
    },
    {
      "n": "04",
      "titolo": "Gestione nel tempo e aggiornamento",
      "desc": "Monitoriamo scadenze della formazione, revisioni del manuale, modifiche normative e cambi di menu o di attività che richiedono un aggiornamento del piano."
    }
  ],
  "faq": [
    {
      "q": "Devo avere il manuale HACCP anche se lavoro da solo?",
      "a": "Sì. L'obbligo di autocontrollo basato sui principi HACCP riguarda ogni Operatore del Settore Alimentare a prescindere dal numero di persone impiegate. Cambia la complessità del piano, non l'obbligo di averlo scritto e applicato."
    },
    {
      "q": "Quanto dura l'attestato degli alimentaristi e ogni quanto va rinnovato?",
      "a": "La formazione degli alimentaristi è disciplinata a livello regionale: durata dei corsi e periodicità degli aggiornamenti dipendono dalla regione e dal livello di rischio dell'attività. Verifichiamo caso per caso la scadenza reale degli attestati del tuo personale invece di applicare una regola standard, e teniamo conto del riconoscimento degli attestati rilasciati in altre regioni."
    },
    {
      "q": "Che cosa controllano davvero ASL e NAS in un'ispezione?",
      "a": "Verificano se il manuale esiste, è aggiornato e corrisponde a quello che succede nei locali: temperature di conservazione, tracciabilità, stato igienico di ambienti e attrezzature, gestione dei rifiuti e formazione del personale presente. Un manuale scollegato dalla realtà operativa o un attestato scaduto anche di un solo addetto sono tra le non conformità più contestate."
    },
    {
      "q": "Che cosa rischio se non ho il piano HACCP o non lo applico?",
      "a": "La mancata o scorretta applicazione dei principi HACCP è sanzionata in via amministrativa dal D.Lgs. 193/2007, con importi diversi a seconda della violazione. Nei casi più gravi l'organo di controllo può disporre la sospensione dell'attività o il sequestro del prodotto. L'importo esatto dipende dal tipo di irregolarità e va valutato caso per caso."
    },
    {
      "q": "Il manuale che ho scaricato online o comprato anni fa va ancora bene?",
      "a": "Quasi mai. Un modello generico non descrive i tuoi punti critici reali e, se non è stato aggiornato dopo cambi di menu, fornitori, layout o normativa sugli allergeni, in sede di controllo risulta inadeguato. Il piano va rivisto ogni volta che cambia qualcosa di sostanziale nel processo."
    },
    {
      "q": "La comunicazione degli allergeni a voce basta?",
      "a": "Il Reg. UE 1169/2011 impone di rendere disponibile l'informazione sugli allergeni anche per la somministrazione senza menu scritto: la comunicazione verbale è ammessa solo se il personale è formato e se esiste una documentazione scritta consultabile su richiesta. Una gestione improvvisata degli allergeni è tra le non conformità più frequenti nei controlli a bar e ristoranti."
    }
  ],
  "fonti": [
    "Regolamento (CE) n. 852/2004 sull'igiene dei prodotti alimentari",
    "D.Lgs. 6 novembre 2007, n. 193 — sanzioni per le violazioni in materia di igiene alimentare",
    "Regolamento (UE) n. 1169/2011 — informazioni sugli alimenti ai consumatori (allergeni)"
  ],
  "fontiNota": "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.",
  "correlati": [
    {
      "nome": "Sicurezza sul lavoro",
      "desc": "DVR e nomine per la stessa attività, con un unico referente.",
      "href": "/servizi/consulenza/sicurezza-lavoro"
    },
    {
      "nome": "Formazione",
      "desc": "Corsi obbligatori per il personale, in aula o a distanza.",
      "href": "/servizi/formazione"
    },
    {
      "nome": "Ambiente",
      "desc": "Rifiuti, scarichi ed emissioni per laboratori e produzione.",
      "href": "/servizi/consulenza/ambiente"
    }
  ],
  "ctaTitle": "Parliamo della tua attività.",
  "ctaLede": "Raccontaci che cosa produci o servi e quante persone lavorano con te: ti diciamo che cosa serve per il manuale, la formazione e i controlli. Richiedi un ricontatto: ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
};

const eyebrow = "Consulenza · Sicurezza alimentare";
const h1 = "Sicurezza alimentare e HACCP.";
const taglineTitle = "Il manuale deve reggere all'ispezione, non solo esistere.";
const areeTitle = "Dall'analisi dei pericoli alla formazione degli alimentaristi.";
const ottieniTitle = "Che cosa resta in azienda, a lavoro finito.";
const ruoliTitle = "Responsabilità chiare, dal primo giorno.";
const stepsTitle = "Dal primo incontro alla gestione nel tempo.";

const img = {
  "src": "/images/consulenza-haccp-cucina.webp",
  "alt": "Consulente iCura Impresa durante un controllo HACCP in una cucina professionale: adulto con copricapo monouso e giacca navy verifica una checklist con il responsabile del locale, piano in acciaio e ambiente ordinato, luce naturale, fotografia documentaria professionale"
};
const ctaImg = {
  "src": "/images/consulenza-haccp-cucina.webp",
  "alt": "Consulente iCura Impresa durante un controllo HACCP in una cucina professionale: adulto con copricapo monouso e giacca navy verifica una checklist con il responsabile del locale, piano in acciaio e ambiente ordinato, luce naturale, fotografia documentaria professionale"
};
---

<Base title={c.title} description={c.description}>
  <PageHero back={{ href: "/servizi/consulenza", label: "Torna a Consulenza" }}>
    <Fragment slot="eyebrow">{eyebrow}</Fragment>
    <Fragment slot="title">{h1}</Fragment>
    <Fragment slot="lede">{c.lede}</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder aspect="21/9" src={img.src ?? undefined} alt={img.alt} />
    </div>
  </section>

  <ServiceExtras part="aChi" id="haccp" items={c.aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>{taglineTitle}</h2>
      </div>
      <div class="prose">
        {c.intro.map((p) => <p>{p}</p>)}
        <ul class="chips" aria-label="Riferimenti normativi">
          {c.chips.map((ch) => <li>{ch}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="haccp-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="haccp-aree" class="section-title">{areeTitle}</h2>
      <AreaGrid aree={c.sottoAree} />
    </div>
  </section>

  <section class="section section--alt-2" aria-labelledby="haccp-ottieni">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Che cosa consegniamo</p>
        <h2 id="haccp-ottieni" class="two-col__title">{ottieniTitle}</h2>
      </div>
      <ul class="checklist">
        {c.ottieni.map((o) => (
          <li class="checklist__item">
            <span class="checklist__tick" aria-hidden="true">✓</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ServiceExtras part="ruoli" id="haccp" title={ruoliTitle} ruoli={c.ruoli} />

  <hr class="rule" aria-hidden="true" />

  <Steps eyebrow="Come lavoriamo" title={stepsTitle} steps={c.fasi} labelledby="haccp-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-haccp"
    labelledby="haccp-faq"
    items={c.faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="haccp" items={c.fonti} nota={c.fontiNota} />

  <ServiceExtras part="correlati" id="haccp" correlati={c.correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title={c.ctaTitle}
    lede={c.ctaLede}
    image={{ src: ctaImg.src ?? undefined, alt: ctaImg.alt }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="haccp-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }
  .note { font-size: var(--text-sm) !important; color: var(--color-muted) !important; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
