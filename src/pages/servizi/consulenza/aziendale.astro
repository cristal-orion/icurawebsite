---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const c = {
  "title": "Consulenza aziendale e modello 231 a Napoli",
  "description": "Organizzazione, deleghe di funzioni, procedure e modello 231 per le PMI campane. Analisi iniziale, preventivo scritto e un referente unico. Chiedi un ricontatto.",
  "eyebrow": "Consulenza · Organizzazione aziendale",
  "h1": "Consulenza aziendale e organizzativa.",
  "lede": "Un'azienda che cresce ha bisogno di un'organizzazione che regge: ruoli chiari, deleghe valide, un modello di gestione che tenga insieme sicurezza, ambiente, qualità e privacy invece di farli viaggiare su binari separati.",
  "aChi": [
    "Titolari e amministratori che firmano documenti senza avere il quadro completo di chi fa che cosa.",
    "Aziende in crescita, con più sedi o più responsabili, che devono formalizzare deleghe e organigramma.",
    "Imprese che lavorano con capofiliera, pubblica amministrazione o gare che richiedono un modello organizzativo 231.",
    "Chi vuole un solo referente per tenere allineati scadenzari, documenti e responsabili delle diverse aree."
  ],
  "chips": [
    "D.Lgs. 231/2001",
    "Art. 16 D.Lgs. 81/08 — delega di funzioni",
    "Organigramma della sicurezza",
    "Modello organizzativo",
    "D.Lgs. 81/2026 — reati ambientali"
  ],
  "intro": [
    "Molte aziende affrontano sicurezza, ambiente, qualità e privacy come quattro pratiche separate, ognuna con il suo consulente, il suo scadenzario, il suo linguaggio. Il risultato è che nessuno ha il quadro completo: il datore di lavoro firma documenti che non sempre riflettono come l'azienda funziona davvero, le deleghe sono generiche o scadute, l'organigramma della sicurezza non coincide con quello reale. Quando arriva un controllo, un infortunio o una verifica di un cliente capofiliera, le contraddizioni emergono tutte insieme.",
    "La consulenza aziendale nasce per chiudere questo scarto: mettere ordine nella struttura organizzativa — chi decide che cosa, chi risponde di che cosa, con quali poteri e quali risorse — e usarla come base comune per tutti gli adempimenti. Una delega di funzioni scritta bene, un organigramma aggiornato, un modello organizzativo coerente con l'attività reale valgono come prevenzione prima ancora che come adempimento."
  ],
  "sottoAree": [
    {
      "nome": "Struttura organizzativa e deleghe di funzioni",
      "desc": "Organigramma aziendale e deleghe ex art. 16 D.Lgs. 81/08: atto scritto con data certa, accettazione del delegato, poteri di organizzazione, gestione e controllo e autonomia di spesa effettivi. Senza questi requisiti la delega è inefficace e la responsabilità resta al datore di lavoro."
    },
    {
      "nome": "Modelli organizzativi e di gestione (D.Lgs. 231/2001)",
      "desc": "Adozione o aggiornamento del modello 231: mappatura dei reati presupposto rilevanti per l'attività — compresi i reati ambientali riformati dal D.Lgs. 81/2026 — procedure, flussi verso l'organismo di vigilanza, sistema disciplinare."
    },
    {
      "nome": "Organigramma della sicurezza e catena di responsabilità",
      "desc": "Individuazione formale di datore di lavoro, dirigenti, preposti, RSPP, RLS, medico competente e addetti alle emergenze, coerente con l'organigramma reale e con il DVR, aggiornata a ogni variazione."
    },
    {
      "nome": "Coordinamento tra sicurezza, ambiente, qualità e privacy",
      "desc": "Un solo referente che tiene allineati scadenzari, documenti e responsabili delle diverse aree, evitando che DVR, autorizzazioni ambientali, sistema qualità e trattamento dei dati viaggino scollegati."
    },
    {
      "nome": "Affiancamento nel tempo e gestione delle scadenze",
      "desc": "Monitoraggio di formazione obbligatoria, visite mediche, verifiche periodiche, rinnovi e aggiornamenti normativi che riguardano l'intera struttura."
    }
  ],
  "ottieni": [
    "Un organigramma reale, coerente tra sicurezza, qualità, ambiente e privacy, non quattro versioni diverse su quattro faldoni.",
    "Deleghe di funzioni scritte secondo i requisiti dell'art. 16 D.Lgs. 81/08.",
    "Un modello organizzativo (dove ha senso adottarlo) tarato sui rischi reali della tua attività.",
    "Un referente unico che segue l'azienda nel tempo e aggiorna i documenti quando cambia l'organizzazione, un ruolo o la normativa."
  ],
  "ruoli": [
    {
      "titolo": "Svolto direttamente da iCuraImpresa",
      "desc": "Analisi dell'organizzazione, deleghe, organigrammi, modelli organizzativi e procedure, coordinamento tra aree, scadenzario."
    },
    {
      "titolo": "Svolto da terzi",
      "desc": "Il notaio o i mezzi che conferiscono data certa agli atti; l'organismo di vigilanza, se esterno all'azienda, svolge la propria attività in autonomia."
    }
  ],
  "fasi": [
    {
      "n": "01",
      "titolo": "Analisi dell'organizzazione",
      "desc": "Sopralluogo e ricognizione della struttura reale: chi decide, chi controlla, come sono distribuiti compiti e responsabilità tra soci, dirigenti, preposti e figure della sicurezza, qualità e ambiente."
    },
    {
      "n": "02",
      "titolo": "Mappatura degli scarti",
      "desc": "Confronto tra organizzazione reale e documenti esistenti (organigramma, deleghe, DVR, eventuale modello 231): dove i ruoli sulla carta non coincidono con chi decide davvero."
    },
    {
      "n": "03",
      "titolo": "Costruzione del modello di gestione",
      "desc": "Redazione o aggiornamento di deleghe, organigramma della sicurezza e, dove opportuno, modello organizzativo 231 con le procedure, coordinati con gli altri documenti aziendali."
    },
    {
      "n": "04",
      "titolo": "Gestione nel tempo",
      "desc": "Revisione dei documenti a ogni cambio organizzativo, aggiornamento su nuovi reati presupposto o novità normative, un referente unico per ogni area."
    }
  ],
  "faq": [
    {
      "q": "Il modello organizzativo 231 è obbligatorio per la mia azienda?",
      "a": "No, l'adozione del modello ex D.Lgs. 231/2001 è facoltativa. È però lo strumento che consente all'ente l'esonero dalla responsabilità amministrativa se un reato presupposto è commesso nel suo interesse o vantaggio. Per molte PMI diventa di fatto necessario quando lavorano con capofiliera, pubblica amministrazione o gare che lo richiedono."
    },
    {
      "q": "Che cosa cambia con il D.Lgs. 81/2026 sui reati ambientali?",
      "a": "Il D.Lgs. 21 aprile 2026, n. 81 (G.U. n. 113 del 18 maggio 2026), in vigore dal 2 giugno 2026, attua la direttiva (UE) 2024/1203 sulla tutela penale dell'ambiente: riforma i reati ambientali del codice penale, introduce nuove fattispecie (tra cui il commercio di prodotti inquinanti e le condotte su sostanze lesive dell'ozono e gas fluorurati) e aggiorna l'art. 25-undecies del D.Lgs. 231/2001, rafforzando le sanzioni per gli enti. Chi ha già un modello 231 deve verificare se copre le nuove fattispecie."
    },
    {
      "q": "Una delega di funzioni scritta a mano su un foglio basta?",
      "a": "No. L'art. 16 del D.Lgs. 81/08 richiede atto scritto con data certa, accettazione espressa del delegato, professionalità ed esperienza adeguate, attribuzione reale dei poteri di organizzazione, gestione e controllo, autonomia di spesa e adeguata pubblicità della delega. Manca anche solo uno di questi elementi e la delega può essere considerata inefficace."
    },
    {
      "q": "Se delego le funzioni di sicurezza a un dirigente, resto comunque responsabile?",
      "a": "In parte sì. La delega non esclude l'obbligo di vigilanza del datore di lavoro sul corretto operato del delegato (art. 16, c. 3). Restano inoltre non delegabili la valutazione dei rischi e la designazione dell'RSPP (art. 17). La delega serve a distribuire correttamente i compiti, non a trasferire ogni responsabilità."
    },
    {
      "q": "L'organigramma della sicurezza va rifatto ogni volta che cambia qualcosa?",
      "a": "Va aggiornato ogni volta che cambiano ruoli, mansioni, responsabili o assetto organizzativo: è tra le prime cose che un organo di vigilanza controlla, perché mostra se l'azienda sa davvero chi fa che cosa."
    },
    {
      "q": "Che differenza c'è tra questo servizio e il DVR o la consulenza HACCP?",
      "a": "DVR, HACCP, privacy e sistemi qualità sono adempimenti verticali su un rischio o un processo specifico. La consulenza aziendale lavora un livello sopra: costruisce la struttura — chi decide, chi risponde, con quali poteri — che rende quegli adempimenti coerenti tra loro e realmente applicati."
    }
  ],
  "fonti": [
    "D.Lgs. 8 giugno 2001, n. 231 — responsabilità amministrativa degli enti",
    "D.Lgs. 81/2008, artt. 16 e 17",
    "D.Lgs. 21 aprile 2026, n. 81 (G.U. n. 113 del 18 maggio 2026) — attuazione della direttiva (UE) 2024/1203; in vigore dal 2 giugno 2026"
  ],
  "fontiNota": "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.",
  "correlati": [
    {
      "nome": "ISO 9001",
      "desc": "Il sistema di gestione della qualità come spina dorsale dell'organizzazione.",
      "href": "/servizi/certificazioni/iso-9001"
    },
    {
      "nome": "ISO 37001",
      "desc": "Il sistema di gestione anticorruzione, complementare al modello 231.",
      "href": "/servizi/certificazioni/iso-37001"
    },
    {
      "nome": "Sicurezza sul lavoro",
      "desc": "DVR e organigramma della sicurezza coerenti con l'organizzazione.",
      "href": "/servizi/consulenza/sicurezza-lavoro"
    }
  ],
  "ctaTitle": "Parliamo della tua organizzazione.",
  "ctaLede": "Raccontaci come è organizzata oggi l'azienda e che cosa ti preoccupa: ti diciamo dove i documenti non coincidono con la realtà e come rimettere ordine. Richiedi un ricontatto: ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
};

const eyebrow = "Consulenza · Organizzazione aziendale";
const h1 = "Consulenza aziendale e organizzativa.";
const taglineTitle = "La struttura che tiene insieme tutto il resto.";
const areeTitle = "Dalle deleghe di funzioni al modello organizzativo 231.";
const ottieniTitle = "Che cosa resta in azienda, a lavoro finito.";
const ruoliTitle = "Responsabilità chiare, dal primo giorno.";
const stepsTitle = "Dall'analisi dell'organizzazione alla gestione nel tempo.";

const img = {
  "src": "/images/consulenza-aziendale-organizzazione.webp",
  "alt": "Riunione di organizzazione aziendale in un ufficio italiano: consulente adulto in abito blu navy mostra un organigramma su tablet a un imprenditore seduto alla scrivania, documenti non leggibili sul tavolo, luce naturale, atmosfera collaborativa e riservata, palette desaturata navy/grigio, fotografia documentaria professionale, no posa frontale, no sorrisi"
};
const ctaImg = {
  "src": "/images/consulenza-aziendale-organizzazione.webp",
  "alt": img.alt
};
---

<Base title={c.title} description={c.description}>
  <PageHero back={{ href: "/servizi/consulenza", label: "Torna a Consulenza" }}>
    <Fragment slot="eyebrow">{eyebrow}</Fragment>
    <Fragment slot="title">{h1}</Fragment>
    <Fragment slot="lede">{c.lede}</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder aspect="21/9" src={img.src ?? undefined} alt={img.alt} />
    </div>
  </section>

  <ServiceExtras part="aChi" id="aziendale" items={c.aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>{taglineTitle}</h2>
      </div>
      <div class="prose">
        {c.intro.map((p) => <p>{p}</p>)}
        <ul class="chips" aria-label="Riferimenti normativi">
          {c.chips.map((ch) => <li>{ch}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="aziendale-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="aziendale-aree" class="section-title">{areeTitle}</h2>
      <AreaGrid aree={c.sottoAree} />
    </div>
  </section>

  <section class="section section--alt-2" aria-labelledby="aziendale-ottieni">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Che cosa consegniamo</p>
        <h2 id="aziendale-ottieni" class="two-col__title">{ottieniTitle}</h2>
      </div>
      <ul class="checklist">
        {c.ottieni.map((o) => (
          <li class="checklist__item">
            <span class="checklist__tick" aria-hidden="true">✓</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ServiceExtras part="ruoli" id="aziendale" title={ruoliTitle} ruoli={c.ruoli} />

  <hr class="rule" aria-hidden="true" />

  <Steps eyebrow="Come lavoriamo" title={stepsTitle} steps={c.fasi} labelledby="aziendale-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-aziendale"
    labelledby="aziendale-faq"
    items={c.faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="aziendale" items={c.fonti} nota={c.fontiNota} />

  <ServiceExtras part="correlati" id="aziendale" correlati={c.correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title={c.ctaTitle}
    lede={c.ctaLede}
    image={{ src: ctaImg.src ?? undefined, alt: ctaImg.alt }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="aziendale-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }
  .note { font-size: var(--text-sm) !important; color: var(--color-muted) !important; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
