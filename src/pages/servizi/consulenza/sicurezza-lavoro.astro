---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const c = {
  "title": "DVR e RSPP esterno a Napoli (D.Lgs. 81/08)",
  "description": "Valutazione dei rischi, RSPP esterno, nomine, formazione e scadenzario dal primo dipendente. Sopralluogo, un referente, preventivo scritto. Napoli e Campania.",
  "eyebrow": "Consulenza · Sicurezza sul lavoro",
  "h1": "Sicurezza sul lavoro — D.Lgs. 81/08.",
  "lede": "Il D.Lgs. 81/08 vale dal primo dipendente. Ti seguiamo dalla valutazione dei rischi alla gestione delle scadenze, con un unico referente.",
  "aChi": [
    "Imprese di ogni settore e dimensione con almeno un lavoratore; soci e familiari rientrano se lavorano alle dipendenze dell'impresa (per l'impresa familiare e i soci senza vincolo di subordinazione valgono gli obblighi dell'art. 21 del D.Lgs. 81/08).",
    "Datori di lavoro che vogliono capire se possono svolgere direttamente i compiti di RSPP o se serve un RSPP esterno.",
    "Aziende che hanno un DVR «fatto anni fa» e temono di essere scoperte senza saperlo.",
    "Imprese che operano anche in cantiere (vedi la pagina Sicurezza nei cantieri)."
  ],
  "chips": [
    "D.Lgs. 81/08",
    "DVR — art. 28",
    "RSPP — artt. 31-34",
    "Accordo Stato-Regioni 17/04/2025",
    "D.L. 159/2025 — L. 198/2025",
    "Patente a crediti — art. 27"
  ],
  "intro": [
    "Il D.Lgs. 81/08 non chiede un foglio da archiviare: chiede di valutare i rischi reali, formare le persone, tenere in ordine documenti e scadenze e dimostrarlo in qualsiasi momento davanti a un ispettore. Vale per l'artigiano con un dipendente e per l'azienda con cinquanta: cambia la complessità degli adempimenti, non l'obbligo.",
    "Il quadro normativo si è mosso molto: il D.L. 159/2025 (convertito con L. 198/2025) ha aggiornato il Testo Unico su patente a crediti, badge di cantiere e sorveglianza sanitaria; l'Accordo Stato-Regioni del 17 aprile 2025 ha riscritto le regole della formazione, in vigore in via esclusiva dal 24 maggio 2026; dal 31 ottobre 2025 la programmazione di misure di prevenzione delle condotte violente o moleste è tra le misure generali di tutela (art. 15, c. 1, lett. z-bis) e l'Ispettorato indica di darne evidenza nel DVR. Chi si è fermato al modello fatto anni fa rischia di trovarsi scoperto senza saperlo."
  ],
  "sottoAree": [
    {
      "nome": "DVR — Documento di Valutazione dei Rischi",
      "desc": "Redazione e aggiornamento del DVR, con evidenza delle misure di prevenzione delle condotte violente o moleste. Datato, firmato, coerente con l'attività reale, non un modello generico."
    },
    {
      "nome": "Formazione di lavoratori, preposti, dirigenti e datori di lavoro",
      "desc": "Pianificazione dei corsi generali e specifici secondo l'Accordo Stato-Regioni 17/04/2025 e dei relativi aggiornamenti, in coordinamento con la nostra area Formazione."
    },
    {
      "nome": "Sopralluoghi e verifiche periodiche",
      "desc": "Controllo di attrezzature, impianti e luoghi di lavoro con la periodicità richiesta dalla normativa, per arrivare pronti a ogni ispezione e non solo per adempimento formale."
    },
    {
      "nome": "Patente a crediti e cantieri",
      "desc": "Verifica dei requisiti per imprese e lavoratori autonomi che operano in cantieri temporanei o mobili, gestione della patente a crediti e del badge digitale di cantiere introdotto dal D.L. 159/2025."
    },
    {
      "nome": "Scadenze e rapporti con gli enti",
      "desc": "Scadenzario di rinnovi formativi, aggiornamenti documentali e verifiche, con assistenza in caso di ispezione da parte di ASL o Ispettorato Nazionale del Lavoro."
    }
  ],
  "ottieni": [
    "Un DVR datato, firmato e coerente con i rischi reali della tua attività, con le valutazioni specifiche richieste.",
    "Chiarezza su chi deve fare che cosa: organigramma della sicurezza con RSPP, medico competente, addetti antincendio e primo soccorso, preposti.",
    "Piano della formazione in regola con l'Accordo Stato-Regioni 17/04/2025, con date e attestati.",
    "Uno scadenzario unico per aggiornamenti, verifiche periodiche e rinnovi, seguito da un solo referente."
  ],
  "ruoli": [
    {
      "titolo": "Svolto direttamente da iCuraImpresa",
      "desc": "Valutazione dei rischi e DVR, incarico di RSPP esterno, sopralluoghi, scadenzario, assistenza alle ispezioni, piano della formazione."
    },
    {
      "titolo": "Coordinato da iCuraImpresa",
      "desc": "Medico competente e sorveglianza sanitaria; misurazioni strumentali (rumore, vibrazioni, agenti chimici) quando richieste dalla valutazione."
    },
    {
      "titolo": "Svolto da terzi",
      "desc": "Il medico competente firma protocollo sanitario e giudizi di idoneità; i laboratori accreditati eseguono le analisi."
    }
  ],
  "fasi": [
    {
      "n": "01",
      "titolo": "Sopralluogo e mappatura dei rischi",
      "desc": "Veniamo in azienda, osserviamo i processi reali e individuiamo i rischi specifici: dalle attrezzature ai luoghi di lavoro, fino alle mansioni più esposte. È il punto di partenza per un DVR che regge a un controllo."
    },
    {
      "n": "02",
      "titolo": "DVR, nomine e organigramma della sicurezza",
      "desc": "Redigiamo il DVR datato e firmato, individuiamo se serve un RSPP esterno o se il datore di lavoro può svolgere direttamente i compiti dopo la formazione prevista, e completiamo le nomine obbligatorie."
    },
    {
      "n": "03",
      "titolo": "Formazione di lavoratori e preposti",
      "desc": "Pianifichiamo la formazione generale e specifica per ogni mansione secondo l'Accordo Stato-Regioni 17/04/2025, compresi i percorsi per preposti, dirigenti e datori di lavoro."
    },
    {
      "n": "04",
      "titolo": "Gestione nel tempo e scadenzario",
      "desc": "Teniamo sotto controllo aggiornamenti del DVR, rinnovi della formazione, verifiche periodiche di attrezzature e impianti, obblighi legati a patente a crediti e cantieri. Un referente unico, non un ufficio da rincorrere."
    }
  ],
  "faq": [
    {
      "q": "Devo fare il DVR anche se ho un solo dipendente?",
      "a": "Sì, se c'è almeno un lavoratore ai sensi dell'art. 2 del D.Lgs. 81/08: dal primo dipendente, anche a tempo parziale o determinato, il datore di lavoro deve valutare i rischi e redigere il DVR, datato e firmato (l'autocertificazione non è più ammessa). La presenza di un familiare o di un socio non basta da sola a far scattare l'obbligo: conta la condizione in cui lavora. I componenti dell'impresa familiare (art. 230-bis c.c.) e i soci che lavorano senza vincolo di subordinazione rientrano nell'art. 21 del D.Lgs. 81/08, con obblighi propri (attrezzature conformi, dispositivi di protezione, tesserino di riconoscimento in cantiere) e con formazione e sorveglianza sanitaria facoltative; se invece il familiare o il socio è assunto come dipendente, è un lavoratore a tutti gli effetti. Verifichiamo la tua situazione nel primo incontro. La mancata redazione del DVR è punita con l'arresto o con l'ammenda a carico del datore di lavoro (art. 55, c. 1, D.Lgs. 81/08)."
    },
    {
      "q": "Devo nominare per forza un RSPP esterno?",
      "a": "Dipende. Entro le soglie dell'Allegato 2 del D.Lgs. 81/08 il datore di lavoro può svolgere direttamente i compiti di RSPP (art. 34), dopo la formazione prevista dall'Accordo Stato-Regioni 17/04/2025: il corso base di 16 ore più un modulo comune di 8 ore con esercitazione sul DVR e i moduli tecnici per settore. Sopra le soglie dell'Allegato 2 il datore di lavoro non può ricoprire il ruolo: serve un RSPP, interno o esterno; nei casi dell'art. 31, comma 6, deve essere interno. Nel primo incontro verifichiamo la strada corretta per la tua attività."
    },
    {
      "q": "Che cosa cambia con l'Accordo Stato-Regioni del 17 aprile 2025?",
      "a": "L'Accordo, in vigore dal 24 maggio 2025, ha riunito in un testo unico la formazione sulla sicurezza: introduce un corso per i datori di lavoro (16 ore), rafforza la formazione dei preposti e ridefinisce durate, modalità e aggiornamenti per lavoratori, dirigenti e figure della sicurezza; nell'Allegato II elenca le attrezzature con abilitazione obbligatoria. Dal 24 maggio 2026 i corsi si erogano solo con le nuove regole: gli attestati conseguiti prima restano validi fino alla loro scadenza naturale."
    },
    {
      "q": "La patente a crediti riguarda anche la mia azienda?",
      "a": "Se operi in cantieri temporanei o mobili, come impresa o come lavoratore autonomo, sì: è obbligatoria dal 1° ottobre 2024, salvo le esclusioni previste (per esempio le mere forniture senza posa in opera, le prestazioni intellettuali e le imprese con attestazione SOA in classifica pari o superiore alla III). Il D.L. 159/2025 ha inasprito il quadro sanzionatorio e introdotto il badge digitale di cantiere. Ne parliamo nella pagina Sicurezza nei cantieri."
    },
    {
      "q": "Che cosa rischia il datore di lavoro che viene ispezionato senza essere in regola?",
      "a": "Dipende da che cosa manca. La mancata valutazione dei rischi e la mancata designazione dell'RSPP sono punite con l'arresto o con l'ammenda (art. 55 D.Lgs. 81/08), con cornici più severe nei casi aggravati; nei casi previsti dall'art. 14 può scattare la sospensione dell'attività. Gli importi delle ammende sono rivalutati periodicamente (art. 306): per questo non li pubblichiamo e li verifichiamo sul caso concreto. A questo si aggiunge il fermo dell'attività, con un impatto economico spesso superiore alla sanzione."
    },
    {
      "q": "Con quale frequenza vanno aggiornati DVR e formazione?",
      "a": "Il DVR va rielaborato quando cambiano i processi produttivi o l'organizzazione del lavoro, dopo infortuni significativi o quando emergono rischi non valutati. La formazione si aggiorna con le periodicità stabilite dall'Accordo Stato-Regioni 17/04/2025 per ciascuna figura. Nel piano di gestione nel tempo teniamo traccia di ogni scadenza e la anticipiamo, non la rincorriamo."
    }
  ],
  "fonti": [
    "D.Lgs. 81/2008 — artt. 15, 28, 31, 34, 55, 306 e Allegato 2",
    "Accordo Stato-Regioni 17 aprile 2025 (G.U. n. 119 del 24 maggio 2025) — in vigore dal 24 maggio 2025; periodo transitorio concluso il 24 maggio 2026",
    "D.L. 31 ottobre 2025, n. 159, convertito con L. 198/2025 — misure urgenti per la tutela della salute e sicurezza sul lavoro",
    "Ispettorato Nazionale del Lavoro, circolare n. 1/2026 — prime indicazioni operative sul D.L. 159/2025"
  ],
  "fontiNota": "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.",
  "correlati": [
    {
      "nome": "Formazione",
      "desc": "Corsi per lavoratori, preposti, dirigenti e datori di lavoro secondo l'Accordo 2025.",
      "href": "/servizi/formazione"
    },
    {
      "nome": "Medicina del lavoro",
      "desc": "Sorveglianza sanitaria e medico competente, organizzati in azienda.",
      "href": "/servizi/consulenza/medicina-lavoro"
    },
    {
      "nome": "ISO 45001",
      "desc": "Il sistema di gestione della sicurezza, certificabile.",
      "href": "/servizi/certificazioni/iso-45001"
    }
  ],
  "ctaTitle": "Mettiamo in regola la tua azienda, partendo dai rischi reali.",
  "ctaLede": "Raccontaci che cosa fate e quante persone lavorano con te: ti diciamo quali obblighi scattano e in che ordine affrontarli. Richiedi un ricontatto: ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
};

const eyebrow = "Consulenza · Sicurezza sul lavoro";
const h1 = "Sicurezza sul lavoro — D.Lgs. 81/08.";
const taglineTitle = "Un obbligo che vale dal primo dipendente.";
const areeTitle = "Tutti gli adempimenti del Testo Unico, seguiti da un solo referente.";
const ottieniTitle = "Che cosa resta in azienda, a lavoro finito.";
const ruoliTitle = "Responsabilità chiare, dal primo giorno.";
const stepsTitle = "Dal primo incontro alla gestione nel tempo.";

const img = {
  "src": "/images/sicurezza-ispezione-capannone.webp",
  "alt": "Ispezione di sicurezza in capannone logistico italiano: consulente adulto in elmetto bianco e giubbotto navy con clipboard digitale che osserva uno scaffale industriale; sullo sfondo carrelli elevatori fermi e zona delimitata da nastro giallo-nero; luce industriale fredda dall'alto, palette desaturata; fotografia documentaria, no posa frontale, no sorrisi"
};
const ctaImg = {
  "src": "/images/sicurezza-ispezione-capannone.webp",
  "alt": "Consulente iCura Impresa durante un sopralluogo in azienda: adulto con casco bianco e block-notes osserva gli impianti e parla con il responsabile, atmosfera collaborativa e rassicurante, ambiente industriale italiano con luce naturale, palette desaturata sobria toni navy e grigio, fotografia documentaria professionale, no posa"
};
---

<Base title={c.title} description={c.description}>
  <header class="page-header section">
    <div class="container">
      <a href="/servizi/consulenza" class="breadcrumb-back">&larr; Torna a Consulenza</a>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <Placeholder aspect="21/9" src={img.src ?? undefined} alt={img.alt} />
    </div>
  </section>

  <ServiceExtras part="aChi" id="sicurezza-lavoro" items={c.aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>{taglineTitle}</h2>
      </div>
      <div class="prose">
        {c.intro.map((p) => <p>{p}</p>)}
        <ul class="chips" aria-label="Riferimenti normativi">
          {c.chips.map((ch) => <li>{ch}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="sicurezza-lavoro-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="sicurezza-lavoro-aree" class="section-title">{areeTitle}</h2>
      <AreaGrid aree={c.sottoAree} />
    </div>
  </section>

  <section class="section section--alt-2" aria-labelledby="sicurezza-lavoro-ottieni">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Che cosa consegniamo</p>
        <h2 id="sicurezza-lavoro-ottieni" class="two-col__title">{ottieniTitle}</h2>
      </div>
      <ul class="checklist">
        {c.ottieni.map((o) => (
          <li class="checklist__item">
            <span class="checklist__tick" aria-hidden="true">✓</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ServiceExtras part="ruoli" id="sicurezza-lavoro" title={ruoliTitle} ruoli={c.ruoli} />

  <hr class="rule" aria-hidden="true" />

  <Steps eyebrow="Come lavoriamo" title={stepsTitle} steps={c.fasi} labelledby="sicurezza-lavoro-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-sicurezza-lavoro"
    labelledby="sicurezza-lavoro-faq"
    items={c.faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="sicurezza-lavoro" items={c.fonti} nota={c.fontiNota} />

  <ServiceExtras part="correlati" id="sicurezza-lavoro" correlati={c.correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title={c.ctaTitle}
    lede={c.ctaLede}
    image={{ src: ctaImg.src ?? undefined, alt: ctaImg.alt }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="sicurezza-lavoro-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .breadcrumb-back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .breadcrumb-back:hover { color: var(--color-accent); text-decoration: none; }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 56ch; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }
  .note { font-size: var(--text-sm) !important; color: var(--color-muted) !important; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
