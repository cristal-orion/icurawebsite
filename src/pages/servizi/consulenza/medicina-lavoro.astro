---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const c = {
  "title": "Medicina del lavoro e medico competente a Napoli",
  "description": "Nomina del medico competente, protocollo sanitario, visite periodiche e idoneità, coordinati con il DVR. Per le imprese di Napoli e Campania.",
  "eyebrow": "Servizi · Medicina del lavoro",
  "h1": "Medicina del lavoro.",
  "lede": "Dove c'è un rischio per la salute, la legge chiede sorveglianza sanitaria vera: medico competente nominato, protocollo scritto sui rischi reali, visite fatte e verbalizzate. Non un modulo di idoneità generico.",
  "aChi": [
    "Aziende la cui valutazione dei rischi individua esposizioni che richiedono sorveglianza sanitaria: movimentazione manuale dei carichi, videoterminali oltre le 20 ore settimanali, rumore, agenti chimici o biologici, lavoro notturno.",
    "Datori di lavoro con un medico competente «sulla carta» e un protocollo copiato da un'altra azienda.",
    "Imprese che vogliono organizzare le visite in sede senza fermare la produzione."
  ],
  "chips": [
    "D.Lgs. 81/08 — Titolo I, Capo III, Sez. V",
    "Art. 41 — sorveglianza sanitaria",
    "Art. 25 — medico competente",
    "Art. 18 — obblighi del datore di lavoro",
    "Art. 28 — stress lavoro-correlato",
    "D.L. 159/2025 — L. 198/2025"
  ],
  "intro": [
    "La sorveglianza sanitaria scatta ogni volta che la valutazione dei rischi individua un'esposizione che la richiede. In quei casi il datore di lavoro deve nominare un medico competente e organizzare le visite: non è una scelta discrezionale, è un obbligo che discende dall'art. 41 del D.Lgs. 81/08.",
    "Il punto debole più comune non è l'assenza totale di sorveglianza, ma quella fatta a metà: un medico nominato solo sulla carta, un protocollo copiato da un'azienda con mansioni diverse, visite in ritardo o senza verbale. Davanti a un ispettore, o dopo un infortunio, questi dettagli pesano quanto l'assenza del medico. Il D.L. 159/2025 (convertito con L. 198/2025) è intervenuto anche su questa materia, a conferma che va presidiata con continuità."
  ],
  "sottoAree": [
    {
      "nome": "Nomina del medico competente",
      "desc": "Verifichiamo se la valutazione dei rischi fa scattare l'obbligo (artt. 18 e 41) e coordiniamo il medico competente, con lettera di incarico e inserimento nel DVR."
    },
    {
      "nome": "Protocollo sanitario su misura",
      "desc": "Il medico competente costruisce il protocollo sulle mansioni reali della tua azienda: rischio per rischio, accertamento per accertamento, con la periodicità corretta per ciascuno."
    },
    {
      "nome": "Visite mediche in azienda",
      "desc": "Preventiva, periodica, al cambio di mansione, alla cessazione: le organizziamo in sede, con date fissate e comunicate per tempo."
    },
    {
      "nome": "Giudizio di idoneità alla mansione",
      "desc": "Ogni visita si chiude con un giudizio scritto — idoneità piena, con prescrizioni o limitazioni, inidoneità — che gestiamo dal punto di vista documentale, compresi gli eventuali ricorsi all'organo di vigilanza."
    },
    {
      "nome": "Rischio stress lavoro-correlato",
      "desc": "Valutazione secondo la metodologia INAIL, integrata nel DVR come richiede l'art. 28."
    },
    {
      "nome": "Cartelle sanitarie e dati relativi alla salute",
      "desc": "Supporto alla tenuta e conservazione delle cartelle sanitarie e di rischio, con le cautele previste per i dati relativi alla salute."
    }
  ],
  "ottieni": [
    "Un medico competente davvero operativo, non solo una firma su un incarico.",
    "Un protocollo sanitario scritto sui rischi delle tue mansioni, aggiornato quando cambiano lavorazioni o organico.",
    "Visite pianificate in anticipo, fatte in azienda, con verbali e giudizi di idoneità in ordine.",
    "Cartelle sanitarie tenute a norma e coordinate con DVR e formazione.",
    "Un referente unico anche quando serve gestire un ricorso o un accertamento straordinario."
  ],
  "ruoli": [
    {
      "titolo": "Svolto direttamente da iCuraImpresa",
      "desc": "Verifica dell'obbligo nel DVR, coordinamento del medico competente, organizzazione delle visite, scadenzario, valutazione dello stress lavoro-correlato insieme al medico."
    },
    {
      "titolo": "Coordinato da iCuraImpresa",
      "desc": "Il medico competente, incaricato dal datore di lavoro, redige il protocollo sanitario, effettua le visite ed esprime i giudizi di idoneità."
    },
    {
      "titolo": "Svolto da terzi",
      "desc": "Laboratori e strutture sanitarie per gli accertamenti integrativi previsti dal protocollo."
    }
  ],
  "fasi": [
    {
      "n": "01",
      "titolo": "Sopralluogo",
      "desc": "Veniamo in azienda, osserviamo mansioni e lavorazioni reali e verifichiamo se e dove scatta l'obbligo di sorveglianza sanitaria."
    },
    {
      "n": "02",
      "titolo": "Protocollo e nomina",
      "desc": "Il medico competente analizza il DVR, redige il protocollo sanitario mansione per mansione e viene formalmente nominato."
    },
    {
      "n": "03",
      "titolo": "Visite e giudizi",
      "desc": "Fissiamo il calendario delle visite, le organizziamo in sede e raccogliamo i giudizi di idoneità con la documentazione."
    },
    {
      "n": "04",
      "titolo": "Gestione nel tempo",
      "desc": "Teniamo lo scadenzario delle visite periodiche, aggiorniamo il protocollo a ogni variazione e seguiamo eventuali ricorsi o controlli."
    }
  ],
  "faq": [
    {
      "q": "Devo nominare il medico competente anche se ho pochi dipendenti?",
      "a": "Il numero di dipendenti non c'entra: conta il rischio. Se la valutazione dei rischi individua un'esposizione che richiede sorveglianza sanitaria, il medico competente va nominato, anche in un'azienda con un solo dipendente."
    },
    {
      "q": "Ogni quanto vanno fatte le visite mediche periodiche?",
      "a": "Di norma con periodicità annuale (art. 41, c. 2, lett. b), ma è il medico competente a stabilire la cadenza corretta in base al protocollo sanitario: può essere più ravvicinata per rischi specifici o diversa se motivata. Non esiste una periodicità unica per tutte le mansioni."
    },
    {
      "q": "Che cosa succede se un lavoratore risulta non idoneo alla mansione?",
      "a": "Il medico competente esprime un giudizio di idoneità piena, con prescrizioni o limitazioni, oppure di inidoneità temporanea o permanente. In caso di limitazioni o inidoneità il datore di lavoro adegua la mansione dove possibile. Lavoratore e datore di lavoro possono presentare ricorso contro il giudizio entro trenta giorni all'organo di vigilanza competente (art. 41, c. 9)."
    },
    {
      "q": "Lo stress lavoro-correlato è davvero obbligatorio da valutare?",
      "a": "Sì, per tutte le aziende: è parte della valutazione dei rischi prevista dall'art. 28 del D.Lgs. 81/08. Il percorso valutativo di riferimento è la metodologia INAIL, e il risultato va documentato nel DVR."
    },
    {
      "q": "Che cosa cambia con il decreto-legge del 2025 sulla sicurezza sul lavoro?",
      "a": "Il D.L. 159/2025, convertito con L. 198/2025, ha previsto per le mansioni a elevato rischio infortunistico accertamenti del medico competente su alcol e sostanze stupefacenti in presenza di ragionevoli indizi; la disciplina attuativa è demandata a un Accordo Stato-Regioni. Verifichiamo con il medico competente che cosa è già applicabile alla tua azienda."
    },
    {
      "q": "Le cartelle sanitarie sono dati particolari secondo il GDPR?",
      "a": "Sì: i dati relativi alla salute dei lavoratori rientrano tra le categorie particolari di dati personali e richiedono misure di sicurezza rafforzate. Il medico competente custodisce le cartelle sanitarie e di rischio con cautele più stringenti di quelle degli altri documenti aziendali."
    }
  ],
  "fonti": [
    "D.Lgs. 81/2008 — artt. 18, 25, 28, 41",
    "D.L. 159/2025, convertito con L. 198/2025 — disposizioni su sorveglianza sanitaria e accertamenti",
    "INAIL — metodologia per la valutazione del rischio stress lavoro-correlato"
  ],
  "fontiNota": "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.",
  "correlati": [
    {
      "nome": "Sicurezza sul lavoro",
      "desc": "Il DVR da cui discende l'obbligo di sorveglianza sanitaria.",
      "href": "/servizi/consulenza/sicurezza-lavoro"
    },
    {
      "nome": "GDPR e privacy",
      "desc": "Il trattamento dei dati relativi alla salute dei lavoratori.",
      "href": "/servizi/consulenza/gdpr"
    },
    {
      "nome": "Formazione",
      "desc": "Formazione dei lavoratori coordinata con le visite periodiche.",
      "href": "/servizi/formazione"
    }
  ],
  "ctaTitle": "Verifichiamo se e dove scatta l'obbligo, senza girarci intorno.",
  "ctaLede": "Portiamo il medico competente in azienda, non il contrario. Raccontaci mansioni e numero di addetti: ti diciamo che cosa serve. Richiedi un ricontatto: ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
};

const eyebrow = "Consulenza · Medicina del lavoro";
const h1 = "Medicina del lavoro.";
const taglineTitle = "La sorveglianza fatta a metà pesa quanto non farla.";
const areeTitle = "Dalla nomina del medico competente al giudizio di idoneità.";
const ottieniTitle = "Che cosa resta in azienda, a lavoro finito.";
const ruoliTitle = "Responsabilità chiare, dal primo giorno.";
const stepsTitle = "Dal primo incontro alla gestione nel tempo.";

const img = {
  "src": "/images/consulenza-medicina-lavoro.webp",
  "alt": "Medico competente durante una visita di sorveglianza sanitaria in azienda: adulto in camice misura la pressione a un lavoratore in abbigliamento tecnico, stanza riservata e ordinata, luce naturale, atmosfera professionale e rispettosa"
};
const ctaImg = {
  "src": "/images/consulenza-medicina-lavoro.webp",
  "alt": "Medico competente durante una visita di sorveglianza sanitaria in azienda: adulto in camice misura la pressione a un lavoratore in abbigliamento tecnico, stanza riservata e ordinata, luce naturale, atmosfera professionale e rispettosa"
};
---

<Base title={c.title} description={c.description}>
  <header class="page-header section">
    <div class="container">
      <a href="/servizi/consulenza" class="breadcrumb-back">&larr; Torna a Consulenza</a>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{h1}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <Placeholder aspect="21/9" src={img.src ?? undefined} alt={img.alt} />
    </div>
  </section>

  <ServiceExtras part="aChi" id="medicina-lavoro" items={c.aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>{taglineTitle}</h2>
      </div>
      <div class="prose">
        {c.intro.map((p) => <p>{p}</p>)}
        <ul class="chips" aria-label="Riferimenti normativi">
          {c.chips.map((ch) => <li>{ch}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="medicina-lavoro-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="medicina-lavoro-aree" class="section-title">{areeTitle}</h2>
      <AreaGrid aree={c.sottoAree} />
    </div>
  </section>

  <section class="section section--alt-2" aria-labelledby="medicina-lavoro-ottieni">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Che cosa consegniamo</p>
        <h2 id="medicina-lavoro-ottieni" class="two-col__title">{ottieniTitle}</h2>
      </div>
      <ul class="checklist">
        {c.ottieni.map((o) => (
          <li class="checklist__item">
            <span class="checklist__tick" aria-hidden="true">✓</span>
            <span>{o}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ServiceExtras part="ruoli" id="medicina-lavoro" title={ruoliTitle} ruoli={c.ruoli} />

  <hr class="rule" aria-hidden="true" />

  <Steps eyebrow="Come lavoriamo" title={stepsTitle} steps={c.fasi} labelledby="medicina-lavoro-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-medicina-lavoro"
    labelledby="medicina-lavoro-faq"
    items={c.faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="medicina-lavoro" items={c.fonti} nota={c.fontiNota} />

  <ServiceExtras part="correlati" id="medicina-lavoro" correlati={c.correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title={c.ctaTitle}
    lede={c.ctaLede}
    image={{ src: ctaImg.src ?? undefined, alt: ctaImg.alt }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="medicina-lavoro-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .breadcrumb-back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .breadcrumb-back:hover { color: var(--color-accent); text-decoration: none; }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 56ch; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }
  .note { font-size: var(--text-sm) !important; color: var(--color-muted) !important; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
