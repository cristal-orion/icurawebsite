---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import CtaBand from "@components/CtaBand.astro";

const aree = [
  {
    nome: "Sgravi INAIL — oscillazione OT23",
    desc: "Riduzione del premio assicurativo per le imprese che adottano interventi di prevenzione. Predisponiamo domanda e documentazione.",
  },
  {
    nome: "Formazione finanziata",
    desc: "Fondi interprofessionali per formare il personale a costo zero. Domanda, erogazione e rendicontazione gestite da noi.",
    href: "/servizi/formazione",
    cta: "Vai alla formazione",
  },
  {
    nome: "Bandi regionali e nazionali",
    desc: "Contributi a fondo perduto e finanziamenti agevolati per investimenti, innovazione e crescita d'impresa. Scrematura, domanda, monitoraggio.",
  },
  {
    nome: "Credito d'imposta",
    desc: "Beni strumentali, formazione 4.0, transizione 5.0. Verifichiamo l'ammissibilità e prepariamo la documentazione tecnica.",
  },
];

const fasi = [
  { n: "01", titolo: "Pre-check", desc: "Verifichiamo idoneità dell'impresa e del progetto. Gratuito." },
  { n: "02", titolo: "Progettazione", desc: "Definiamo l'intervento e prepariamo la documentazione tecnica." },
  { n: "03", titolo: "Domanda", desc: "Compilazione e invio nei tempi e sui portali previsti dal bando." },
  { n: "04", titolo: "Rendicontazione", desc: "Esecuzione, monitoraggio e chiusura della pratica all'ente." },
];
---

<Base
  title="Finanza agevolata"
  description="Bando ISI, sgravi INAIL, fondi interprofessionali, bandi regionali e nazionali, credito d'imposta. iCura Impresa ti accompagna dalla domanda alla rendicontazione."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Servizi · 04</p>
      <h1>Finanza agevolata.</h1>
      <p class="lede">
        Contributi, fondi e crediti d'imposta esistono. Il difficile è intercettarli e portarli a casa senza errori. Lo facciamo noi.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/bando-linea-produzione.webp"
        alt="Linea di produzione metalmeccanica italiana modernizzata: una pressa industriale nuova in primo piano con barriere fotoelettriche di sicurezza ben visibili e segnaletica gialla a terra; sullo sfondo sfocato un operatore in DPI completi consulta un tablet rugged; capannone ben illuminato luce diurna mista, palette desaturata con accenti arancio sui DPI; fotografia editoriale industriale, no posa marketing, no slogan visibili"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Cosa intercettiamo</p>
      <AreaGrid aree={aree} />
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section">
    <div class="container">
      <p class="eyebrow">02 — Come funziona</p>
      <h2 class="fasi__heading">Quattro fasi, una persona di riferimento.</h2>
      <ol class="fasi">
        {fasi.map((f) => (
          <li class="fase">
            <span class="fase__n">{f.n}</span>
            <h3 class="fase__titolo">{f.titolo}</h3>
            <p class="fase__desc">{f.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand
    title="Capiamo insieme cosa puoi ottenere."
    lede="Il pre-check è gratuito · risposta entro 48 ore. Vediamo quali contributi e agevolazioni puoi davvero intercettare."
    image={{
      src: "/images/bando-documenti-inail.webp",
      alt: "Consulente di finanza agevolata iCura Impresa al lavoro con un imprenditore: due adulti in ufficio napoletano luminoso esaminano documenti e un prospetto di bando sullo schermo, espressione collaborativa e fiduciosa, scrivania ordinata, palette desaturata sobria toni navy e grigio, fotografia documentaria professionale, no posa",
    }}
    primary={{ href: "/contatti", label: "Verifica le opportunità" }}
    labelledby="finanza-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 52ch; }

  .fasi__heading { font-size: var(--text-3xl); margin-bottom: var(--space-xl); max-width: 22ch; }
  .fasi {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .fase {
    padding: var(--space-lg);
    border: var(--rule-hair) solid var(--color-rule);
    margin-left: -1px;
  }
  .fase:first-child { margin-left: 0; }
  .fase__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-md);
  }
  .fase__titolo { font-size: var(--text-xl); margin: 0 0 var(--space-2xs); font-weight: 500; }
  .fase__desc { color: var(--color-ink-2); margin: 0; font-size: var(--text-md); }

  @media (max-width: 56rem) {
    .fasi { grid-template-columns: 1fr; }
    .fase { margin-left: 0; margin-top: -1px; }
  }
  @media (min-width: 56rem) and (max-width: 76rem) {
    .fasi { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
