---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Datori di lavoro che devono formare lavoratori, preposti e dirigenti secondo l'Accordo Stato-Regioni del 17 aprile 2025.",
  "Imprese con attestati in scadenza o rilasciati con le regole precedenti, da verificare e aggiornare.",
  "Aziende che usano carrelli elevatori, piattaforme, gru o macchine movimento terra e devono abilitare gli operatori.",
  "Imprese che aderiscono (o possono aderire) a un fondo interprofessionale e vogliono finanziare i corsi.",
];

const corsi = [
  {
    formato: "In aula",
    desc: "A Napoli o nella tua sede, con docenti qualificati.",
  },
  {
    formato: "A distanza",
    desc: "Per i contenuti che l'Accordo consente in e-learning, su piattaforma con tracciamento e verifica finale.",
  },
  {
    formato: "In azienda",
    desc: "Sui rischi reali delle tue lavorazioni e sui turni del personale.",
  },
];

const catalogo = [
  {
    id: "cat-lavoratori",
    nome: "Formazione dei lavoratori",
    desc: "Formazione generale (4 ore) e specifica per rischio basso, medio o alto (4, 8 o 12 ore), con aggiornamento quinquennale (6 ore), secondo l'Accordo Stato-Regioni 17/04/2025.",
  },
  {
    id: "cat-ruoli",
    nome: "Ruoli della sicurezza",
    desc: "Preposti (12 ore), dirigenti, datori di lavoro (corso di 16 ore) e datori di lavoro che svolgono direttamente i compiti di RSPP, RSPP e ASPP (moduli A, B, C), RLS: formazione iniziale e aggiornamenti con le durate previste dall'Accordo per ciascun ruolo.",
  },
  {
    id: "cat-emergenze",
    nome: "Gestione delle emergenze",
    desc: "Addetti antincendio (livelli 1, 2 e 3 ai sensi del D.M. 2 settembre 2021) e addetti al primo soccorso (gruppi A, B e C), con i relativi aggiornamenti periodici.",
  },
  {
    id: "cat-attrezzature",
    nome: "Attrezzature — abilitazioni",
    desc: "Carrelli elevatori, piattaforme di lavoro elevabili, gru, trattori, macchine movimento terra: abilitazioni previste dall'Accordo Stato-Regioni 17/04/2025 (Allegato II).",
  },
  {
    id: "cat-rischi",
    nome: "Rischi specifici",
    desc: "Lavori in quota, spazi confinati, rischio chimico, DPI di terza categoria, rischio elettrico (PES/PAV/PEI).",
  },
];

const resta = [
  "Un piano formativo per ruolo, con date, durate, modalità e aggiornamenti.",
  "Attestati validi a tutti gli effetti di legge, con registro presenze e tracciabilità, pronti da esibire in caso di controllo.",
  "Lo scadenzario degli aggiornamenti, seguito da noi.",
  "Quando l'impresa ha i requisiti: pratica di finanziamento con il fondo interprofessionale, dalla domanda alla rendicontazione.",
];

const ruoli = [
  {
    titolo: "Svolto direttamente da iCuraImpresa",
    desc: "Analisi dei fabbisogni, piano formativo, organizzazione ed erogazione dei corsi in aula e in azienda con i nostri docenti, scadenzario, gestione delle pratiche con i fondi.",
  },
  {
    titolo: "Coordinato da iCuraImpresa",
    desc: "La formazione a distanza su piattaforma e-learning con tracciamento; gli attestati sono rilasciati tramite un ente di formazione partner, secondo le regole dell'Accordo.",
  },
  {
    titolo: "Svolto da terzi",
    desc: "I fondi interprofessionali approvano e finanziano i piani; il medico competente o altri soggetti abilitati intervengono dove la norma li richiede (per esempio nel primo soccorso).",
  },
];

const fasi = [
  { n: "01", titolo: "Analisi dei ruoli", desc: "Ci dici quante persone e con quali mansioni: individuiamo chi deve fare che cosa e quali attestati sono ancora validi." },
  { n: "02", titolo: "Piano e finanziamento", desc: "Costruiamo il piano con durate, modalità e date; verifichiamo se l'impresa può finanziare i corsi con un fondo interprofessionale e, in caso, presentiamo la domanda." },
  { n: "03", titolo: "Erogazione", desc: "Eroghiamo i corsi in aula, a distanza o in azienda, con registro presenze e verifiche di apprendimento." },
  { n: "04", titolo: "Attestati e aggiornamenti", desc: "Consegniamo gli attestati, aggiorniamo lo scadenzario e ti avvisiamo prima di ogni scadenza." },
];

const faq = [
  {
    q: "La formazione sulla sicurezza è davvero obbligatoria?",
    a: "Sì. L'art. 37 del D.Lgs. 81/08 impone la formazione di tutti i lavoratori, oltre a quella specifica per preposti, dirigenti, datori di lavoro, RSPP, RLS e addetti alle emergenze. In caso di ispezione o infortunio, la mancata formazione è tra le prime cose contestate al datore di lavoro.",
  },
  {
    q: "Quanto dura la formazione e ogni quanto va aggiornata?",
    a: "La formazione generale dei lavoratori dura 4 ore, quella specifica 4, 8 o 12 ore in base al livello di rischio; l'aggiornamento è di 6 ore ogni 5 anni. Per gli altri ruoli (preposti, dirigenti, datori di lavoro, RSPP, antincendio, primo soccorso, attrezzature) durate e aggiornamenti sono stabiliti dall'Accordo Stato-Regioni 17/04/2025 e dai decreti di settore: ti diamo noi il piano corretto.",
  },
  {
    q: "I corsi a distanza valgono come quelli in aula?",
    a: "Per i contenuti che l'Accordo consente in modalità e-learning (per esempio la formazione generale e parte degli aggiornamenti), la formazione a distanza su piattaforma con tracciamento è valida. Le parti pratiche — antincendio, primo soccorso, attrezzature — richiedono la presenza. Componiamo il percorso in modo che sia a norma.",
  },
  {
    q: "Gli attestati rilasciati prima del nuovo Accordo sono ancora validi?",
    a: "Gli attestati conseguiti con le regole precedenti restano validi fino alla loro scadenza naturale; gli aggiornamenti si fanno con le nuove regole. Se hai dubbi su un attestato, chiedici una verifica: la facciamo con te, documento per documento.",
  },
  {
    q: "È vero che la formazione può essere finanziata?",
    a: "Se l'impresa aderisce a un fondo interprofessionale (o ci aderisce), i corsi possono essere finanziati con i piani del fondo: le imprese versano all'INPS lo 0,30% delle retribuzioni (contributo ex art. 25 L. 845/1978) e, con l'adesione, quella quota confluisce nel fondo scelto. Verifichiamo i requisiti, presentiamo la domanda e curiamo la rendicontazione. Non tutti i corsi e non tutte le imprese sono finanziabili: te lo diciamo prima.",
  },
  {
    q: "Rilasciate attestati riconosciuti?",
    a: "Sì. Al termine del corso rilasciamo attestati validi a tutti gli effetti di legge, con registro presenze e tracciabilità. Gli attestati sono emessi tramite un ente di formazione partner, secondo quanto previsto dall'Accordo Stato-Regioni.",
  },
];

const fonti = [
  "D.Lgs. 81/2008, art. 37",
  "Accordo Stato-Regioni 17 aprile 2025 (G.U. n. 119 del 24 maggio 2025) — in vigore dal 24 maggio 2025; transitorio concluso il 24 maggio 2026",
  "D.M. 2 settembre 2021 — formazione antincendio",
  "D.M. 15 luglio 2003, n. 388 — primo soccorso",
  "L. 388/2000, art. 118 — fondi paritetici interprofessionali; L. 845/1978, art. 25",
];

const correlati = [
  { nome: "Sicurezza sul lavoro", desc: "DVR, RSPP e organigramma: da dove nasce il piano formativo.", href: "/servizi/consulenza/sicurezza-lavoro" },
  { nome: "Finanza Agevolata", desc: "Fondi e agevolazioni per formazione e investimenti.", href: "/servizi/finanza-agevolata" },
  { nome: "HACCP", desc: "Formazione degli alimentaristi per le attività del settore alimentare.", href: "/servizi/consulenza/haccp" },
];
---

<Base
  title="Corsi sicurezza sul lavoro a Napoli"
  description="Formazione lavoratori, preposti, dirigenti, RSPP, antincendio, primo soccorso e HACCP: in aula a Napoli, in azienda o a distanza. Attestati e scadenzario inclusi."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Servizi · 02</p>
      <h1>Formazione sulla sicurezza: corsi obbligatori in aula, a distanza e in azienda.</h1>
      <p class="lede">
        Aula, formazione a distanza e corsi in azienda. Tutta la formazione obbligatoria sulla sicurezza, costruita sui ruoli reali della tua impresa e, quando i requisiti lo consentono, finanziata con i fondi che hai già versato. Il futuro cresce con le persone.
      </p>
    </div>
  </header>

  <ServiceExtras part="aChi" id="formazione" items={aChi} />

  {/* ───── Contesto ───── */}
  <section class="section section--ink" aria-labelledby="formazione-contesto">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Il bisogno</p>
        <h2 id="formazione-contesto" class="two-col__title">Obbligatoria per legge. Utile per davvero.</h2>
      </div>
      <div class="prose">
        <p>
          La formazione non è un favore alla burocrazia: è ciò che mette le persone in condizione di lavorare in sicurezza e l'azienda al riparo da responsabilità. L'art. 37 del D.Lgs. 81/08 ne fa un obbligo del datore di lavoro; l'Accordo Stato-Regioni del 17 aprile 2025 stabilisce contenuti, durate, modalità e aggiornamenti per ogni ruolo. Dal 24 maggio 2026 i corsi si erogano solo con le nuove regole.
        </p>
        <p>
          Noi la rendiamo semplice: capiamo chi deve fare che cosa, costruiamo il piano, eroghiamo i corsi e — quando l'impresa ha i requisiti — li facciamo finanziare dai fondi interprofessionali invece che dal tuo budget.
        </p>
        <ul class="chips" aria-label="Riferimenti normativi">
          <li>Art. 37 D.Lgs. 81/08</li>
          <li>Accordo Stato-Regioni 17/04/2025</li>
          <li>Allegato II — attrezzature</li>
          <li>D.M. 2 settembre 2021 — antincendio</li>
          <li>D.M. 388/2003 — primo soccorso</li>
          <li>Fondi interprofessionali — art. 118 L. 388/2000</li>
        </ul>
      </div>
    </div>
  </section>

  {/* ───── Catalogo corsi ───── */}
  <section class="section" aria-labelledby="formazione-catalogo">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="formazione-catalogo" class="section-title">I corsi che eroghiamo e come li eroghiamo.</h2>
      <AreaGrid aree={catalogo} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/formazione-aula-adulti.webp"
        alt="Aula di formazione professionale italiana vista dal fondo: sei adulti seduti in due file consultano dispense cartacee, di spalle alla camera; in primo piano sfocato la spalla di una docente che indica una lavagna a fogli mobili con uno schema di sicurezza disegnato a mano; luce naturale da finestre laterali alte, sedie ergonomiche scure, niente proiettori accesi; palette desaturata professionale, no studenti universitari, target adulti 30-55 anni"
      />
    </div>
  </section>

  {/* ───── Le tre modalità ───── */}
  <section class="section section--alt-2" aria-labelledby="formazione-formati">
    <div class="container">
      <p class="eyebrow">Aula, a distanza, in azienda</p>
      <h2 id="formazione-formati" class="section-title">Tre modalità, un solo piano: ogni corso nella modalità che l'Accordo consente per quel contenuto.</h2>
      <div class="corsi">
        {corsi.map((c, i) => (
          <article class="corso">
            <span class="corso__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="corso__formato">{c.formato}</h3>
            <p class="corso__desc">{c.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ───── Finanziamento ───── */}
  <section class="section finanziamento" aria-labelledby="formazione-fondi">
    <div class="container">
      <div class="finanziamento__inner">
        <p class="eyebrow">Fondi interprofessionali</p>
        <h2 id="formazione-fondi">Finanziata dai fondi interprofessionali, quando l'impresa ha i requisiti.</h2>
        <p>
          Le imprese versano all'INPS lo 0,30% delle retribuzioni (contributo ex art. 25 L. 845/1978) e, con l'adesione, quella quota confluisce nel fondo scelto. Verifichiamo i requisiti, presentiamo la domanda e curiamo la rendicontazione. Non tutti i corsi e non tutte le imprese sono finanziabili: te lo diciamo prima.
        </p>
        <div class="finanziamento__ctas">
          <a href="/contatti" class="btn btn--primary">
            Richiedi un ricontatto
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/servizi/finanza-agevolata" class="link-cta">
            Finanza Agevolata
            <span class="link-cta__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <ServiceExtras part="resta" id="formazione" items={resta} />

  <ServiceExtras part="ruoli" id="formazione" ruoli={ruoli} />

  {/* ───── Come lavoriamo ───── */}
  <Steps
    eyebrow="Come lavoriamo"
    title="Dal piano formativo agli attestati."
    steps={fasi}
    labelledby="formazione-fasi"
  />

  <hr class="rule" aria-hidden="true" />

  {/* ───── FAQ ───── */}
  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-formazione"
    labelledby="formazione-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras
    part="fonti"
    id="formazione"
    items={fonti}
    nota="Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico."
  />

  <ServiceExtras part="correlati" id="formazione" correlati={correlati} />

  <CtaBand
    title="Costruiamo il piano formativo della tua impresa."
    lede="Ci dici quante persone e che ruoli: ti diciamo che cosa è obbligatorio, quanto dura e se puoi farlo finanziare. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve. Oppure chiama lo 081 658 0779."
    image={{
      src: "/images/formazione-aula-adulti.webp",
      alt: "Docente iCura Impresa in aula durante un corso sulla sicurezza sul lavoro: adulto spiega a un gruppo di lavoratori attenti, atmosfera professionale e concreta, aula italiana con luce naturale, palette desaturata sobria toni navy e grigio, fotografia documentaria, no posa",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    labelledby="formazione-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 56ch; }

  .corsi {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .corso {
    padding: var(--space-lg);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    transition: border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .corso:hover {
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-rule));
    transform: translateY(-2px);
  }
  .corso__n {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-md);
  }
  .corso__formato {
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-sm);
  }
  .corso__desc {
    color: var(--color-ink-2);
    margin-bottom: var(--space-md);
    line-height: 1.5;
  }

  .finanziamento { background: var(--color-paper-3); }
  .finanziamento__inner { max-width: 60rem; }
  .finanziamento h2 { font-size: var(--text-3xl); margin-bottom: var(--space-md); }
  .finanziamento p {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    margin-bottom: var(--space-lg);
    max-width: 64ch;
  }
  .finanziamento__ctas {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 56rem) {
    .corsi { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .corso:hover { transform: none; }
  }
</style>
