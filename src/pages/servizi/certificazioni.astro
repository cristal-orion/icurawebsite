---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import CtaBand from "@components/CtaBand.astro";

const aree = [
  {
    nome: "ISO 9001 — Qualità",
    desc: "Sistema di gestione della qualità. Processi più ordinati, meno errori, un requisito sempre più richiesto da clienti e committenti.",
  },
  {
    nome: "ISO 14001 — Ambiente",
    desc: "Sistema di gestione ambientale. Controllo degli impatti, conformità normativa e un vantaggio competitivo concreto.",
  },
  {
    nome: "ISO 45001 — Sicurezza",
    desc: "Sistema di gestione della salute e sicurezza sul lavoro. Riduce il rischio di infortuni e formalizza le buone prassi.",
  },
  {
    nome: "Attestazione SOA",
    desc: "Requisito obbligatorio per partecipare alle gare di lavori pubblici. Attesta la capacità dell'impresa di eseguire opere pubbliche.",
  },
  {
    nome: "Procedure di gara & avvalimenti",
    desc: "Supporto alla partecipazione a bandi pubblici e privati, con avvalimenti e reperimento dei requisiti tecnici ed economici.",
  },
];
---

<Base
  title="Certificazioni"
  description="Certificazioni ISO 9001, 14001, 45001, Attestazione SOA e supporto alle procedure di gara. Affiancamento dall'analisi iniziale all'audit finale."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Servizi · 05</p>
      <h1>Certificazioni.</h1>
      <p class="lede">
        Le certificazioni aprono gare, rassicurano i clienti e mettono ordine nei processi. Ti accompagniamo dall'analisi iniziale all'audit finale.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Cosa certifichiamo</p>
      <AreaGrid aree={aree} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/certificazioni-audit-iso.webp"
        alt="Riunione di audit documentale in ufficio professionale italiano: gruppo di consulenti adulti seduti attorno a un tavolo in legno chiaro confronta registri, checklist e tavole tecniche; sullo sfondo finestra con luce naturale e scaffale con raccoglitori; palette desaturata sobria, abiti in toni navy e grigio, fotografia documentaria professionale"
      />
    </div>
  </section>

  <section class="section metodo">
    <div class="container metodo__grid">
      <div>
        <p class="eyebrow">Come lavoriamo</p>
        <h2>Affiancamento, non solo carte.</h2>
      </div>
      <div class="metodo__body">
        <p>
          Analizziamo lo stato dell'azienda, costruiamo la documentazione su misura e prepariamo le persone all'audit dell'ente. Tempi tipici: 3–5 mesi, contro i 6–12 di un percorso non seguito.
        </p>
        <p>
          Niente moduli copia-incolla: il sistema di gestione deve reggere la verifica e restare utile dopo il certificato.
        </p>
        <a href="/contatti" class="link-cta">
          Parla con un consulente
          <span class="link-cta__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Quale certificazione ti serve davvero?"
    lede="Te lo diciamo con onestà, senza venderti percorsi inutili: una valutazione iniziale per capire da dove partire."
    image={{
      src: "/images/certificazioni-audit-iso.webp",
      alt: "Consulente certificazioni iCura Impresa con un imprenditore durante un audit di sistema: due adulti in ufficio italiano esaminano registri e checklist su un tavolo ordinato, espressione professionale e rassicurante, palette desaturata sobria toni navy e grigio, fotografia documentaria, no posa",
    }}
    primary={{ href: "/contatti", label: "Richiedi una valutazione" }}
    labelledby="certificazioni-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 54ch; }

  .metodo { background: var(--color-paper-2); }
  .metodo__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .metodo h2 { font-size: var(--text-3xl); margin: 0; max-width: 14ch; }
  .metodo__body p { font-size: var(--text-lg); color: var(--color-ink-2); margin: 0 0 var(--space-md); line-height: 1.55; max-width: 56ch; }

  @media (max-width: 56rem) {
    .metodo__grid { grid-template-columns: 1fr; }
  }
</style>
