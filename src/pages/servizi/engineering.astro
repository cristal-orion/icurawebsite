---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import CtaBand from "@components/CtaBand.astro";

const aree = [
  {
    nome: "Progettazione edile",
    desc: "Pratiche edilizie, ristrutturazioni, sopraelevazioni, accatastamenti. Dal progetto al collaudo.",
  },
  {
    nome: "Impiantistica",
    desc: "Elettrico, idraulico, termico, antincendio. Progetto, direzione lavori, dichiarazioni di conformità.",
  },
  {
    nome: "Prevenzione incendi",
    desc: "CPI, SCIA antincendio, valutazione del rischio. Per attività soggette al DPR 151/2011.",
  },
  {
    nome: "Qualifiche e test materiali",
    desc: "Prove di laboratorio, verifiche periodiche, qualifiche WPS/WPQR per saldature.",
  },
];
---

<Base
  title="Engineering"
  description="Progettazione edile e impiantistica, prevenzione incendi, qualifiche e test materiali."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Servizi · 03</p>
      <h1>Engineering.</h1>
      <p class="lede">
        Quando il progetto, l'impianto o l'autorizzazione richiede una firma tecnica, ci pensiamo noi.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section">
    <div class="container">
      <p class="eyebrow">Quattro aree integrate</p>
      <AreaGrid aree={aree} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="16/9"
        src="/images/engineering-render-cad-impianti.webp"
        alt="Render tecnico di una sezione architettonica: vista assonometrica di un capannone industriale con impianti elettrici e antincendio evidenziati in linee colorate sottili su sfondo bianco-grigio chiaro; quote in grigio scuro tipografia tecnica; nessuna persona, nessun testo decorativo; stile drafting CAD moderno pulito, dettaglio leggibile, no rendering iperrealistico, no ombre fotografiche"
      />
    </div>
  </section>

  <CtaBand
    title="Progetto, impianto, certificazione: parliamone."
    lede="Un sopralluogo tecnico per inquadrare l'intervento e dirti come procedere. Senza impegno."
    image={{
      src: "/images/home-cnc-barriera.webp",
      alt: "Tecnico iCura Impresa in sopralluogo su un impianto industriale: adulto con casco e tablet rugged verifica un quadro elettrico o un impianto antincendio, atmosfera competente e rassicurante, capannone italiano con luce naturale, palette desaturata sobria toni navy e grigio, fotografia documentaria professionale, no posa",
    }}
    primary={{ href: "/contatti", label: "Richiedi un sopralluogo" }}
    labelledby="engineering-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 50ch; }
</style>
