---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Imprese che partecipano a gare con Criteri Ambientali Minimi (CAM) o lavorano per filiere che chiedono la certificazione ambientale.",
  "Impianti di gestione rifiuti e attività con autorizzazioni ambientali (AUA, emissioni, scarichi).",
  "Aziende che vogliono presidiare in modo ordinato rifiuti, MUD, registri ed emissioni.",
];

const sottoAree = [
  { nome: "Analisi ambientale iniziale", desc: "Identifichiamo aspetti e impatti ambientali della tua attività e la loro significatività, con la ricognizione degli obblighi di legge applicabili." },
  { nome: "Mappa degli obblighi di conformità", desc: "Colleghiamo il sistema alle autorizzazioni e agli adempimenti reali: AUA, gestione rifiuti, MUD, registri, emissioni. Così le scadenze non sfuggono." },
  { nome: "Sistema di gestione su misura", desc: "Politica ambientale, procedure, controlli operativi, obiettivi e indicatori costruiti sul tuo ciclo produttivo, non un modello generico." },
  { nome: "Formazione e audit interno", desc: "Formiamo il personale e verifichiamo il sistema con un audit interno prima dell’organismo, gestendo le non conformità." },
  { nome: "Assistenza all’audit di certificazione", desc: "Ti affianchiamo nelle due fasi dell’audit dell’organismo accreditato fino al rilascio del certificato." },
  { nome: "Mantenimento e sorveglianza", desc: "Seguiamo gli audit di sorveglianza annuali e l’aggiornamento del sistema, compresa l’eventuale transizione a nuove edizioni della norma." },
];

const resta = [
  "Un certificato rilasciato da un organismo terzo accreditato sull’edizione vigente della norma.",
  "Punteggio nelle gare con Criteri Ambientali Minimi, dove la ISO 14001 è mezzo di prova riconosciuto.",
  "Riduzione del 40% delle garanzie finanziarie per l’iscrizione all’Albo gestori ambientali e per le spedizioni transfrontaliere di rifiuti (artt. 212 e 194 D.Lgs. 152/2006).",
  "Un presidio ordinato di AUA, rifiuti, MUD ed emissioni, con meno rischio di sanzioni.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Analisi ambientale, mappa degli obblighi, progettazione del sistema, formazione, audit interno, assistenza all’audit, mantenimento." },
  { titolo: "Svolto da terzi", desc: "L’organismo di certificazione accreditato svolge l’audit e rilascia il certificato." },
];

const fasi = [
  { titolo: "Analisi ambientale", desc: "Mappiamo aspetti, impatti e obblighi di legge dell’attività: è la base del sistema." },
  { titolo: "Progettazione del sistema", desc: "Costruiamo politica, procedure, controlli operativi, obiettivi e indicatori sul tuo ciclo produttivo." },
  { titolo: "Formazione e audit interno", desc: "Formiamo il personale e proviamo il sistema con una verifica interna prima dell’organismo." },
  { titolo: "Audit di certificazione e mantenimento", desc: "L’organismo accreditato verifica in due fasi e rilascia il certificato; gestiamo le sorveglianze annuali e il rinnovo triennale." },
];

const faq = [
  { q: "La ISO 14001 è obbligatoria?", a: "No, è volontaria. Diventa di fatto necessaria per partecipare a gare con Criteri Ambientali Minimi, quando la richiedono clienti o filiere, o per ottenere benefici come la riduzione delle garanzie finanziarie sui rifiuti." },
  { q: "Quanto vale nelle gare pubbliche?", a: "Nel Codice dei contratti i CAM sono obbligatori come specifiche tecniche e criteri premianti (art. 57 D.Lgs. 36/2023): la ISO 14001 è tra i mezzi di prova riconosciuti e concorre al punteggio tecnico dell’offerta." },
  { q: "Aiuta con le garanzie finanziarie di chi gestisce rifiuti?", a: "Sì: per l’iscrizione all’Albo nazionale gestori ambientali (art. 212, cc. 10 e 11, D.Lgs. 152/2006) e per le spedizioni transfrontaliere (art. 194, c. 4) le garanzie sono ridotte del 40% per le imprese certificate ISO 14001 e del 50% per quelle registrate EMAS; per commercianti e intermediari la riduzione è ribadita dal D.M. 20 giugno 2011. Per le garanzie legate alle autorizzazioni degli impianti valgono le regole della Regione competente: le verifichiamo caso per caso." },
  { q: "Quale edizione della norma si applica?", a: "Ti certifichiamo sull’edizione vigente della norma e, quando ISO pubblica una nuova edizione, seguiamo la transizione nei tempi previsti dagli organismi di accreditamento: i certificati sull’edizione precedente restano validi durante il periodo di transizione." },
  { q: "Quanto dura il certificato?", a: "Tre anni, con audit di sorveglianza annuali e un rinnovo alla scadenza tramite una verifica completa del sistema." },
];

const fonti = [
  "UNI EN ISO 14001 — Sistemi di gestione ambientale. Requisiti e guida per l’uso",
  "D.Lgs. 36/2023, art. 57 — Criteri Ambientali Minimi",
  "D.Lgs. 152/2006, artt. 194, c. 4 e 212, cc. 10-11 — riduzione delle garanzie per EMAS e ISO 14001; D.M. 20 giugno 2011, art. 4, c. 4",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "Consulenza ambientale", desc: "AUA, rifiuti, MUD ed emissioni: la conformità alla base del sistema.", href: "/servizi/consulenza/ambiente" },
  { nome: "ISO 9001", desc: "Il sistema per la qualità, integrabile con l’ambiente.", href: "/servizi/certificazioni/iso-9001" },
  { nome: "ISO 45001", desc: "Il sistema per la sicurezza, integrabile con l’ambiente.", href: "/servizi/certificazioni/iso-45001" },
];
---

<Base
  title="Certificazione ISO 14001 a Napoli"
  description="Sistema di gestione ambientale ISO 14001:2015: analisi iniziale, adempimenti, procedure e audit fino al certificato. Consulenza a Napoli e in Campania."
>
  <header class="page-header section">
    <div class="container">
      <a href="/servizi/certificazioni" class="breadcrumb-back">&larr; Torna a Certificazioni</a>
      <p class="eyebrow">Certificazioni · Ambiente</p>
      <h1>ISO 14001 — Ambiente.</h1>
      <p class="lede">
        Gestire l’ambiente, non solo dichiararlo. Un sistema che tiene sotto controllo rifiuti, scarichi, emissioni e consumi — e che vale punti nelle gare e riduzioni sulle garanzie.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/consulenza-ambiente-rifiuti.webp"
        alt="Verifica ambientale in un capannone industriale: due adulti controllano registri e contenitori nell'area rifiuti su un tavolo d'ispezione, segnaletica a pavimento e luce naturale, fotografia documentaria professionale"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="iso14001" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Un sistema costruito sul tuo ciclo produttivo.</h2>
      </div>
      <div class="prose">
        <p>
          La ISO 14001 definisce i requisiti di un sistema di gestione ambientale: un insieme strutturato di procedure e controlli con cui l’azienda tiene sotto controllo i propri impatti — rifiuti, scarichi, emissioni, energia, risorse — e ne migliora le prestazioni nel tempo. È volontaria e applicabile a qualsiasi organizzazione.
        </p>
        <p>
          I due vantaggi più concreti: nelle gare con Criteri Ambientali Minimi (D.Lgs. 36/2023, art. 57) è un mezzo di prova riconosciuto che pesa sul punteggio tecnico; per chi gestisce rifiuti, le garanzie finanziarie dovute per l’iscrizione all’Albo nazionale gestori ambientali (art. 212 D.Lgs. 152/2006) e per le spedizioni transfrontaliere (art. 194) sono ridotte del 40% per le imprese certificate ISO 14001 (50% con registrazione EMAS). Il certificato lo rilascia un organismo terzo accreditato; noi costruiamo il sistema e portiamo l’azienda pronta all’audit, sull’edizione vigente della norma.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>ISO 14001</li>
          <li>Accredia</li>
          <li>CAM — art. 57 D.Lgs. 36/2023</li>
          <li>Artt. 194 e 212 D.Lgs. 152/2006</li>
          <li>AUA</li>
          <li>MUD / RENTRI</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="iso14001-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="iso14001-aree" class="section-title">Dall’analisi degli impatti al mantenimento.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <ServiceExtras part="resta" id="iso14001" items={resta} />

  <ServiceExtras part="ruoli" id="iso14001" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Il percorso verso il certificato." steps={fasi} labelledby="iso14001-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-iso14001"
    labelledby="iso14001-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="iso14001" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="iso14001" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Ti serve la ISO 14001?"
    lede="Partiamo da una valutazione degli aspetti ambientali della tua attività per capire che cosa serve davvero e con quali tempi. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/consulenza-ambiente-rifiuti.webp",
      alt: "Consulente ambientale iCura Impresa durante una verifica in azienda: adulto controlla registri e procedure ambientali con il responsabile, area ordinata e luce naturale, palette sobria toni navy e grigio, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="iso14001-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .breadcrumb-back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .breadcrumb-back:hover { color: var(--color-accent); text-decoration: none; }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 56ch; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
