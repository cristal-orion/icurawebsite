---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Aziende ICT, società di servizi e fornitori della pubblica amministrazione a cui i clienti affidano dati e sistemi.",
  "Organizzazioni soggette (o potenzialmente soggette) alla direttiva NIS 2 e al D.Lgs. 138/2024.",
  "Imprese che vogliono dimostrare con un certificato le misure di sicurezza richieste dall’art. 32 del GDPR.",
];

const sottoAree = [
  { nome: "Analisi del contesto e degli asset", desc: "Mappiamo le informazioni che contano — dati dei clienti, competenze, sistemi, fornitori — e definiamo il perimetro del sistema: che cosa proteggere e da che cosa." },
  { nome: "Valutazione e trattamento del rischio", desc: "Individuiamo minacce e vulnerabilità, misuriamo il rischio e scegliamo come trattarlo. È il cuore della norma: la sicurezza si costruisce sui rischi reali." },
  { nome: "Controlli dell’Allegato A e dichiarazione di applicabilità", desc: "Selezioniamo i controlli dell’Allegato A (organizzativi, sulle persone, fisici e tecnologici) applicabili alla tua realtà e li dichiariamo nella SoA, con la motivazione di ogni scelta." },
  { nome: "Politiche, procedure e gestione degli incidenti", desc: "Politiche, regole d’uso, gestione degli accessi, copie di sicurezza, continuità operativa e una procedura di gestione degli incidenti che funziona anche sotto pressione." },
  { nome: "Formazione, consapevolezza e audit interno", desc: "La sicurezza è fatta di persone: formiamo il personale sui rischi (phishing, password, dati) e proviamo il sistema con un audit interno prima dell’organismo." },
  { nome: "Assistenza all’audit e integrazione GDPR / NIS 2", desc: "Ti affianchiamo nelle due fasi dell’audit dell’organismo accreditato e colleghiamo il sistema agli obblighi GDPR e, dove applicabile, alla NIS 2." },
];

const resta = [
  "Un certificato rilasciato da un organismo terzo accreditato.",
  "Un requisito o punteggio sempre più richiesto nelle gare e nella qualifica dei fornitori.",
  "Un rafforzamento concreto della conformità al GDPR (misure tecniche e organizzative ex art. 32).",
  "Una base solida per gli obblighi NIS 2 e per la fiducia di clienti e partner.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Analisi del contesto, analisi del rischio, progettazione del sistema, politiche e procedure, formazione, audit interno, assistenza all’audit, mantenimento." },
  { titolo: "Coordinato da iCuraImpresa", desc: "Fornitori IT e sistemisti per le misure tecniche di loro competenza (reti, backup, accessi)." },
  { titolo: "Svolto da terzi", desc: "L’organismo di certificazione accreditato svolge l’audit e rilascia il certificato." },
];

const fasi = [
  { titolo: "Analisi dei gap", desc: "Fotografiamo lo stato della sicurezza delle informazioni rispetto alla norma e definiamo il perimetro." },
  { titolo: "Analisi del rischio e progettazione", desc: "Valutiamo i rischi, scegliamo i controlli dell’Allegato A, redigiamo la dichiarazione di applicabilità e costruiamo politiche e procedure." },
  { titolo: "Formazione e audit interno", desc: "Formiamo le persone, alziamo la consapevolezza e verifichiamo il sistema con un audit interno." },
  { titolo: "Audit di certificazione e mantenimento", desc: "L’organismo accreditato verifica in due fasi e rilascia il certificato; gestiamo sorveglianze annuali, riesame dei rischi e rinnovo triennale." },
];

const faq = [
  { q: "La ISO 27001 è obbligatoria?", a: "No, non è obbligatoria per legge. Sta però diventando requisito o punteggio in molte gare — soprattutto con la pubblica amministrazione e nel settore ICT — e un titolo richiesto negli albi fornitori di chi ti affida i propri dati." },
  { q: "La ISO 27001 sostituisce il GDPR?", a: "No: sono due cose diverse che si rafforzano a vicenda. Un sistema conforme alla ISO 27001 è un modo strutturato di garantire le «misure tecniche e organizzative adeguate» richieste dall’art. 32 del GDPR; la conformità al GDPR resta più ampia (basi giuridiche, informative, diritti degli interessati)." },
  { q: "Che cosa sono i controlli dell’Allegato A?", a: "Sono i controlli di sicurezza previsti dalla norma (93 nell’edizione 2022, in quattro temi: organizzativi, sulle persone, fisici e tecnologici). Non si applicano tutti: si scelgono in base al rischio e si dichiarano nella dichiarazione di applicabilità, motivando inclusioni ed esclusioni." },
  { q: "Serve un reparto IT strutturato per partire?", a: "No. La ISO 27001 è una norma organizzativa, non solo tecnica: riguarda processi, persone e responsabilità. Si parte da un’analisi dei gap e si costruisce il sistema anche in aziende piccole o che si appoggiano a fornitori IT esterni." },
  { q: "Quanto dura la certificazione?", a: "Tre anni, con audit di sorveglianza annuali e un audit di rinnovo alla scadenza." },
];

const fonti = [
  "ISO/IEC 27001:2022 — Information security management systems. Requirements",
  "Regolamento (UE) 2016/679, art. 32",
  "Direttiva (UE) 2022/2555 (NIS 2) e D.Lgs. 4 settembre 2024, n. 138",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "GDPR e privacy", desc: "Registro, informative e DPO: la conformità che il sistema sostiene.", href: "/servizi/consulenza/gdpr" },
  { nome: "ISO 9001", desc: "Il sistema per la qualità, con la stessa struttura.", href: "/servizi/certificazioni/iso-9001" },
  { nome: "ISO 37001", desc: "Il sistema anticorruzione, integrabile.", href: "/servizi/certificazioni/iso-37001" },
];
---

<Base
  title="Certificazione ISO 27001 per PMI"
  description="Sistema di gestione della sicurezza delle informazioni ISO/IEC 27001: analisi dei rischi, controlli dell’Allegato A, procedure, audit. Anche insieme al GDPR."
>
  <PageHero back={{ href: "/servizi/certificazioni", label: "Torna a Certificazioni" }}>
    <Fragment slot="eyebrow">Certificazioni · Sicurezza delle informazioni</Fragment>
    <Fragment slot="title">ISO 27001 — Sicurezza delle informazioni.</Fragment>
    <Fragment slot="lede">Il sistema di gestione della sicurezza delle informazioni. Protegge dati, competenze e sistemi, rafforza la conformità al GDPR ed è sempre più spesso una chiave d’accesso a gare e clienti, specie nell’ICT e nei servizi.</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/consulenza-gdpr-privacy.webp"
        alt="Sicurezza delle informazioni in ufficio: due professionisti adulti verificano su un laptop registri di accesso, backup e procedure di protezione dei dati, ambiente ordinato e luce naturale, palette sobria toni navy e grigio, fotografia documentaria professionale"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="iso27001" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Protegge i dati, e dimostra ai clienti che lo fai davvero.</h2>
      </div>
      <div class="prose">
        <p>
          La ISO/IEC 27001 definisce i requisiti di un sistema di gestione della sicurezza delle informazioni: un modo strutturato per proteggere riservatezza, integrità e disponibilità dei dati, partendo dall’analisi dei rischi reali dell’azienda. Non è un antivirus in più: è il metodo con cui decidi che cosa proteggere, come e con quali controlli, documentandolo nella dichiarazione di applicabilità.
        </p>
        <p>
          Non è obbligatoria, ma porta vantaggi concreti: è sempre più richiesta nelle gare e nella qualifica dei fornitori; rafforza la conformità al GDPR come «misura tecnica e organizzativa adeguata» (art. 32); offre una base solida per gli obblighi della NIS 2. Il certificato lo rilascia un organismo terzo accreditato.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>ISO/IEC 27001:2022</li>
          <li>Accredia</li>
          <li>Allegato A — dichiarazione di applicabilità</li>
          <li>Analisi del rischio</li>
          <li>GDPR — art. 32</li>
          <li>NIS 2 — D.Lgs. 138/2024</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="iso27001-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="iso27001-aree" class="section-title">Dall’analisi del rischio al certificato.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <ServiceExtras part="resta" id="iso27001" items={resta} />

  <ServiceExtras part="ruoli" id="iso27001" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Il percorso verso il certificato." steps={fasi} labelledby="iso27001-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-iso27001"
    labelledby="iso27001-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="iso27001" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="iso27001" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Vuoi certificarti ISO 27001?"
    lede="Verifichiamo insieme il perimetro giusto e i rischi da coprire, con un solo referente per sicurezza delle informazioni, GDPR e certificazione. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/certificazioni-audit-iso.webp",
      alt: "Consulente certificazioni iCura Impresa con un imprenditore durante un audit del sistema di sicurezza delle informazioni: due adulti in ufficio esaminano registri e checklist su un tavolo ordinato, palette sobria toni navy e grigio, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="iso27001-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
