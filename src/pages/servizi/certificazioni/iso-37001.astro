---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Imprese che lavorano con la pubblica amministrazione, partecipano a gare o operano in filiere che chiedono presìdi anticorruzione.",
  "Organizzazioni con un modello 231 da rafforzare sui reati corruttivi (art. 25 D.Lgs. 231/2001).",
  "Aziende che vogliono regole chiare su omaggi, ospitalità, sponsorizzazioni, intermediari e conflitti di interesse.",
];

const sottoAree = [
  { nome: "Analisi del rischio corruttivo", desc: "Mappiamo i processi più esposti — gare e appalti, rapporti con la PA, omaggi e ospitalità, sponsorizzazioni, intermediari — e misuriamo dove può annidarsi il rischio." },
  { nome: "Politica anticorruzione e ruoli", desc: "Definiamo la politica, l’impegno del vertice e la funzione di conformità, con ruoli e responsabilità chiari e verificabili." },
  { nome: "Due diligence su partner e fornitori", desc: "Procedure di verifica proporzionate al rischio su soci in affari, fornitori, agenti e operazioni." },
  { nome: "Controlli finanziari e commerciali", desc: "Regole su omaggi, ospitalità, donazioni, sponsorizzazioni e conflitti di interesse, con controlli sui flussi finanziari che rendono la corruzione difficile e tracciabile." },
  { nome: "Segnalazioni e whistleblowing", desc: "Canali di segnalazione conformi al D.Lgs. 24/2023, con tutela del segnalante e una procedura seria di gestione e indagine." },
  { nome: "Formazione, audit interno e assistenza all’audit", desc: "Formiamo le persone, verifichiamo il sistema con un audit interno e ti affianchiamo nelle due fasi dell’audit dell’organismo accreditato, integrando il tutto con il modello 231." },
];

const resta = [
  "Un certificato rilasciato da un organismo terzo accreditato.",
  "Maggiore affidabilità e punteggi nelle gare pubbliche, e un elemento a supporto del rating di legalità.",
  "Un rafforzamento del modello 231 sui reati corruttivi e della posizione degli amministratori.",
  "Un presidio concreto su omaggi, conflitti di interesse, due diligence dei partner e rapporti con la PA.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Analisi del rischio, progettazione del sistema, politiche e procedure, canali di segnalazione, formazione, audit interno, assistenza all’audit, raccordo con il modello 231." },
  { titolo: "Svolto da terzi", desc: "L’organismo di certificazione accreditato svolge l’audit e rilascia il certificato; l’organismo di vigilanza 231 opera in autonomia." },
];

const fasi = [
  { titolo: "Analisi del rischio corruttivo", desc: "Fotografiamo i processi esposti e definiamo perimetro e piano del sistema." },
  { titolo: "Progettazione del sistema", desc: "Politica, ruoli, controlli finanziari e commerciali, due diligence e canali di segnalazione." },
  { titolo: "Formazione e audit interno", desc: "Formiamo le persone sui comportamenti corretti e proviamo il sistema con una verifica interna." },
  { titolo: "Audit di certificazione e mantenimento", desc: "L’organismo accreditato verifica in due fasi e rilascia il certificato; gestiamo sorveglianze, rinnovo e raccordo con il modello 231." },
];

const faq = [
  { q: "La ISO 37001 è obbligatoria?", a: "No, non è imposta dalla legge. Diventa però un vantaggio competitivo nelle gare pubbliche e nei rapporti con la PA e le grandi committenti, e un segnale di affidabilità verso partner e stakeholder." },
  { q: "Che rapporto ha con il modello 231?", a: "Sono complementari. La ISO 37001 presidia i reati corruttivi previsti dall’art. 25 del D.Lgs. 231/2001 e rafforza l’idoneità del modello su quel fronte, ma non lo sostituisce: l’efficacia esimente va valutata in concreto. Il modo migliore di usarla è integrarla con il modello 231 e l’organismo di vigilanza." },
  { q: "Vale per il rating di legalità?", a: "Il rating di legalità è rilasciato dall’AGCM sulla base di requisiti propri; la certificazione anticorruzione documenta presìdi che vanno nella stessa direzione e rafforzano il profilo dell’impresa." },
  { q: "Copre anche la corruzione tra privati?", a: "Sì. La norma riguarda la prevenzione della corruzione in senso ampio: verso la pubblica amministrazione e tra privati, attiva e passiva, diretta e tramite terzi. Non copre invece frode, cartelli o altre condotte illecite diverse dalla corruzione." },
  { q: "Quanto dura la certificazione?", a: "Tre anni, con audit di sorveglianza annuali e un audit di rinnovo alla scadenza." },
];

const fonti = [
  "UNI ISO 37001 — Sistemi di gestione per la prevenzione della corruzione",
  "D.Lgs. 231/2001, art. 25",
  "D.Lgs. 10 marzo 2023, n. 24 — protezione delle persone che segnalano violazioni",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "Consulenza aziendale", desc: "Modello 231, deleghe e organigramma.", href: "/servizi/consulenza/aziendale" },
  { nome: "ISO 9001", desc: "Il sistema per la qualità, con la stessa struttura.", href: "/servizi/certificazioni/iso-9001" },
  { nome: "Attestazione SOA", desc: "La qualificazione per i lavori pubblici.", href: "/servizi/certificazioni/soa" },
];
---

<Base
  title="Certificazione ISO 37001 anticorruzione"
  description="Sistema di gestione per la prevenzione della corruzione ISO 37001, coordinato con il modello 231 e il rating di legalità. Consulenza fino all’audit."
>
  <header class="page-header section">
    <div class="container">
      <a href="/servizi/certificazioni" class="breadcrumb-back">&larr; Torna a Certificazioni</a>
      <p class="eyebrow">Certificazioni · Anticorruzione</p>
      <h1>ISO 37001 — Anticorruzione.</h1>
      <p class="lede">
        Il sistema di gestione per prevenire, individuare e gestire la corruzione. Rafforza il modello 231, dà affidabilità e punteggi nelle gare pubbliche e mette ordine su omaggi, conflitti di interesse e rapporti con la pubblica amministrazione.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/chi-siamo-scrivania-firma.webp"
        alt="Governance e conformità aziendale in ufficio: due professionisti adulti esaminano contratti e procedure di controllo su una scrivania ordinata, penna e documenti in primo piano, luce naturale, palette sobria toni navy e grigio, fotografia documentaria professionale"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="iso37001" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Rendere la corruzione difficile, e dimostrarlo.</h2>
      </div>
      <div class="prose">
        <p>
          La ISO 37001 definisce i requisiti di un sistema di gestione per la prevenzione della corruzione: politica, impegno del vertice, funzione di conformità, analisi del rischio, due diligence, controlli finanziari e commerciali e canali di segnalazione. L’obiettivo non è un adempimento in più, ma rendere concretamente più difficile — e più facile da individuare — la corruzione dentro e attorno all’azienda.
        </p>
        <p>
          Non è obbligatoria, ma porta vantaggi concreti: affidabilità e punteggi nelle gare pubbliche, utilità nei rapporti con la pubblica amministrazione e con le filiere, rafforzamento del modello 231 sui reati corruttivi. Condivide la struttura delle altre norme ISO. Il certificato lo rilascia un organismo terzo accreditato.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>ISO 37001</li>
          <li>Accredia</li>
          <li>Modello 231 — art. 25</li>
          <li>Whistleblowing — D.Lgs. 24/2023</li>
          <li>Rating di legalità</li>
          <li>Due diligence</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="iso37001-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="iso37001-aree" class="section-title">Dal rischio corruttivo ai controlli che reggono.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <ServiceExtras part="resta" id="iso37001" items={resta} />

  <ServiceExtras part="ruoli" id="iso37001" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Il percorso verso il certificato." steps={fasi} labelledby="iso37001-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-iso37001"
    labelledby="iso37001-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="iso37001" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="iso37001" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Vuoi certificarti ISO 37001?"
    lede="Valutiamo il rischio corruttivo della tua azienda e come integrare il sistema con il modello 231, con un solo referente per la conformità al modello 231 e per la certificazione. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/certificazioni-audit-iso.webp",
      alt: "Consulente certificazioni iCura Impresa con un imprenditore durante un audit del sistema anti-corruzione: due adulti in ufficio esaminano procedure e registri di controllo su un tavolo ordinato, palette sobria toni navy e grigio, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="iso37001-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .breadcrumb-back {
    display: inline-block;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-2);
    text-decoration: none;
  }
  .breadcrumb-back:hover { color: var(--color-accent); text-decoration: none; }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 56ch; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
