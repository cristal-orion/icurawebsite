---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Imprese di ogni dimensione: la prassi prevede quattro fasce con indicatori proporzionati, anche per micro e piccole imprese.",
  "Aziende che partecipano a gare pubbliche o a bandi che premiano la certificazione.",
  "Organizzazioni che vogliono un vantaggio contributivo e un segnale concreto verso clienti e dipendenti.",
];

const sottoAree = [
  { nome: "Cultura e strategia (15%)", desc: "Politiche, obiettivi e impegno della direzione sulla parità di genere." },
  { nome: "Governance (15%)", desc: "Presidio organizzativo, ruoli e responsabilità sulla parità, con un comitato guida o un referente dedicato." },
  { nome: "Processi HR (10%)", desc: "Selezione, gestione e sviluppo del personale in ottica di parità e non discriminazione." },
  { nome: "Crescita e inclusione (20%)", desc: "Opportunità di crescita e inclusione delle donne in azienda, presenza nei ruoli e nei percorsi di carriera." },
  { nome: "Equità remunerativa (20%)", desc: "Analisi e riduzione del divario retributivo di genere a parità di ruolo." },
  { nome: "Genitorialità e conciliazione (20%)", desc: "Tutela della genitorialità e misure di conciliazione tra vita e lavoro." },
];

const resta = [
  "Un certificato rilasciato da un organismo accreditato, valido ai sensi del Codice delle pari opportunità.",
  "La domanda di esonero contributivo all’INPS, per la durata di validità della certificazione.",
  "Punteggio premiale nelle gare pubbliche (art. 108, c. 7, D.Lgs. 36/2023) e riduzione della garanzia (Allegato II.13), cumulabile con le altre.",
  "Un sistema di monitoraggio con indicatori e piano d’azione, mantenuto nel tempo.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Analisi dei gap, politiche, piano d’azione, sistema di monitoraggio, preparazione all’audit, domanda di esonero, mantenimento." },
  { titolo: "Svolto da terzi", desc: "L’organismo accreditato svolge l’audit e rilascia il certificato; l’INPS riconosce l’esonero nei limiti delle risorse." },
];

const fasi = [
  { titolo: "Analisi dei gap sui sei ambiti", desc: "Fotografiamo la situazione rispetto agli indicatori applicabili alla tua fascia dimensionale." },
  { titolo: "Politiche, obiettivi e indicatori", desc: "Definiamo piano d’azione, referente o comitato guida e il set di indicatori da monitorare." },
  { titolo: "Sistema di monitoraggio", desc: "Impostiamo raccolta dati, procedure e cruscotto di monitoraggio nel tempo." },
  { titolo: "Audit, esonero e mantenimento", desc: "L’organismo accreditato verifica documentazione e attuazione (serve almeno il 60%); presentiamo la domanda INPS e seguiamo i monitoraggi annuali." },
];

const faq = [
  { q: "L’esonero contributivo è ancora attivo?", a: "Sì. L’art. 5 della L. 162/2021 prevede, per le aziende in possesso della certificazione, un esonero fino all’1% dei contributi a carico del datore di lavoro, nel limite di 50.000 euro l’anno, per la validità della certificazione. L’esonero è riconosciuto nei limiti delle risorse stanziate: se non bastano, può essere ridotto proporzionalmente." },
  { q: "La certificazione dà vantaggi nelle gare pubbliche?", a: "Sì: punteggio premiale (art. 108, c. 7, D.Lgs. 36/2023) e riduzione della garanzia prevista dall’Allegato II.13, cumulabile con le altre riduzioni. È inoltre elemento premiante in diversi bandi di incentivazione." },
  { q: "Una piccola o micro impresa può ottenerla?", a: "Sì. La UNI/PdR 125 prevede quattro fasce dimensionali con indicatori proporzionati e semplificati per le micro (1–9 addetti) e le piccole (10–49) imprese." },
  { q: "Come si ottiene e quanto dura?", a: "Con un’analisi dei gap sui sei ambiti, la definizione di politiche e indicatori, un sistema di monitoraggio e l’audit di un organismo accreditato (serve almeno il 60% di punteggio). La validità è di tre anni, con verifiche annuali di mantenimento." },
  { q: "Esistono contributi per coprire i costi della certificazione?", a: "Sono stati attivati in passato avvisi nazionali e regionali a sportello, fino a esaurimento dei fondi. Verifichiamo insieme quali strumenti risultano aperti nel momento in cui decidi di partire: non diamo per scontato che lo siano." },
];

const fonti = [
  "UNI/PdR 125:2022 — Linee guida sul sistema di gestione per la parità di genere",
  "L. 5 novembre 2021, n. 162, art. 5 — esonero contributivo",
  "D.Lgs. 36/2023, art. 108, c. 7 e Allegato II.13",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "Consulenza aziendale", desc: "Organizzazione, ruoli e processi HR.", href: "/servizi/consulenza/aziendale" },
  { nome: "Formazione", desc: "Formazione e sviluppo delle competenze.", href: "/servizi/formazione" },
  { nome: "ISO 9001", desc: "Il sistema per la qualità, integrabile.", href: "/servizi/certificazioni/iso-9001" },
];
---

<Base
  title="Certificazione parità di genere UNI/PdR 125"
  description="Certificazione della parità di genere UNI/PdR 125:2022: requisiti, indicatori, esonero contributivo e premialità nelle gare. Anche per PMI e micro imprese."
>
  <PageHero back={{ href: "/servizi/certificazioni", label: "Torna a Certificazioni" }}>
    <Fragment slot="eyebrow">Certificazioni · Parità di genere</Fragment>
    <Fragment slot="title">Parità di genere — UNI/PdR 125.</Fragment>
    <Fragment slot="lede">Un percorso che misura e migliora la parità in azienda su sei ambiti — e che dà accesso a un esonero contributivo e a punteggi premiali nelle gare e nei bandi.</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/chi-siamo-riunione-team.webp"
        alt="Team aziendale misto in riunione operativa in un ufficio luminoso: donne e uomini adulti confrontano documenti attorno a un tavolo, clima professionale e collaborativo, palette sobria toni navy e grigio, fotografia documentaria"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="paritagenere" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Non un adempimento formale: un vantaggio misurabile.</h2>
      </div>
      <div class="prose">
        <p>
          La UNI/PdR 125:2022 è la prassi di riferimento nazionale per un sistema di gestione della parità di genere. Misura, con indicatori quantitativi e qualitativi, la maturità dell’organizzazione su sei ambiti — cultura e strategia, governance, processi HR, crescita e inclusione, equità remunerativa, genitorialità e conciliazione — con un punteggio minimo di sintesi del 60% per ottenere la certificazione.
        </p>
        <p>
          Oltre al valore verso clienti e dipendenti, i benefici sono concreti: un esonero contributivo fino all’1% dei contributi a carico del datore di lavoro, nel limite di 50.000 euro l’anno (art. 5 L. 162/2021), e, nelle gare pubbliche, punteggi premiali e riduzione della garanzia. Il certificato lo rilascia un organismo accreditato; noi costruiamo il sistema e gestiamo la domanda di esonero all’INPS.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>UNI/PdR 125:2022</li>
          <li>Accredia</li>
          <li>Esonero INPS — art. 5 L. 162/2021</li>
          <li>Art. 108 D.Lgs. 36/2023</li>
          <li>Allegato II.13 — garanzie</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="paritagenere-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="paritagenere-aree" class="section-title">I sei ambiti che la prassi valuta.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <ServiceExtras part="resta" id="paritagenere" items={resta} />

  <ServiceExtras part="ruoli" id="paritagenere" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Dall’analisi dei gap all’esonero contributivo." steps={fasi} labelledby="paritagenere-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-paritagenere"
    labelledby="paritagenere-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="paritagenere" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="paritagenere" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Vuoi la certificazione della parità di genere?"
    lede="Partiamo da un’analisi dei gap sui sei ambiti per capire dove sei e che cosa serve per il 60%, e per attivare esonero e premialità. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/chi-siamo-riunione-team.webp",
      alt: "Consulente iCura Impresa con la direzione di un'azienda durante la definizione del piano per la parità di genere: team misto attorno a un tavolo in un ufficio luminoso, clima collaborativo, palette sobria, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="paritagenere-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
