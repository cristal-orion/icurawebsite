---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Imprese di costruzioni e impiantistiche che vogliono partecipare agli appalti di lavori pubblici.",
  "Imprese già attestate che devono gestire verifica triennale, rinnovo o aumento di classifica.",
  "Chi non ha tutti i requisiti e vuole valutare l’avvalimento.",
];

const sottoAree = [
  { nome: "Verifica dei requisiti", desc: "Analizziamo quali requisiti l’impresa già possiede — lavori eseguiti, direzione tecnica, cifra d’affari, organico, regolarità — e individuiamo categorie e classifiche adeguate ai lavori che vuoi eseguire." },
  { nome: "Categorie OG e OS", desc: "Ti guidiamo tra opere generali e opere specializzate e tra le classifiche di importo, scegliendo la qualificazione giusta per le gare a cui punti." },
  { nome: "Predisposizione della documentazione", desc: "Raccogliamo e prepariamo certificati di esecuzione lavori, bilanci, dati su direzione tecnica, organico e attrezzature, correggendo le lacune prima dell’istruttoria." },
  { nome: "Avvalimento", desc: "Quando manca un requisito tecnico o economico, gestiamo l’avvalimento (art. 104 D.Lgs. 36/2023): individuiamo l’impresa ausiliaria e curiamo il contratto, scritto a pena di nullità." },
  { nome: "Rapporto con l’organismo SOA", desc: "Selezioniamo l’organismo autorizzato e seguiamo l’istruttoria fino al rilascio dell’attestato, facendo da interfaccia unica." },
  { id: "gare", nome: "Gare e scadenze", desc: "Supporto alla partecipazione alle gare, con avvalimenti e reperimento dei requisiti; verifica di mantenimento al terzo anno e rinnovo quinquennale, così l’impresa non resta mai scoperta." },
];

const classifiche = [
  { cl: "I", imp: "258.000 €" },
  { cl: "II", imp: "516.000 €" },
  { cl: "III", imp: "1.033.000 €" },
  { cl: "III-bis", imp: "1.500.000 €" },
  { cl: "IV", imp: "2.582.000 €" },
  { cl: "IV-bis", imp: "3.500.000 €" },
  { cl: "V", imp: "5.165.000 €" },
  { cl: "VI", imp: "10.329.000 €" },
  { cl: "VII", imp: "15.494.000 €" },
  { cl: "VIII", imp: "oltre 15.494.000 €" },
];

const resta = [
  "La qualificazione per partecipare agli appalti di lavori pubblici di importo pari o superiore a 150.000 euro.",
  "Le categorie (OG/OS) e le classifiche di importo adeguate ai lavori che vuoi eseguire.",
  "L’avvalimento gestito quando mancano requisiti tecnici o economici.",
  "Le scadenze presidiate: verifica triennale e rinnovo quinquennale seguiti da noi.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Verifica dei requisiti, scelta di categorie e classifiche, raccolta e predisposizione della documentazione, gestione dell’avvalimento, interfaccia con l’organismo SOA, scadenzario, supporto alle gare." },
  { titolo: "Svolto da terzi", desc: "L’organismo SOA autorizzato svolge l’istruttoria e rilascia l’attestazione, comunicandola all’ANAC." },
];

const fasi = [
  { titolo: "Analisi preliminare", desc: "Verifichiamo i requisiti già posseduti e individuiamo categorie e classifiche adeguate ai lavori target." },
  { titolo: "Raccolta della documentazione", desc: "Predisponiamo certificati di esecuzione lavori, bilanci, direzione tecnica, organico e attrezzature, sanando le lacune." },
  { titolo: "Istruttoria SOA", desc: "L’organismo autorizzato verifica la documentazione; gestiamo integrazioni ed eventuale avvalimento." },
  { titolo: "Rilascio, mantenimento e rinnovo", desc: "La SOA rilascia l’attestazione e la comunica all’ANAC; seguiamo la verifica al terzo anno e avviamo il rinnovo almeno 90 giorni prima della scadenza." },
];

const faq = [
  { q: "Quando è obbligatoria la SOA?", a: "Per eseguire lavori pubblici di importo pari o superiore a 150.000 euro (art. 100 D.Lgs. 36/2023 e Allegato II.12). Sotto questa soglia si applicano i requisiti semplificati previsti dal Codice." },
  { q: "Che cosa sono le categorie OG e OS?", a: "OG sono le opere generali (interventi complessivi, come edifici o strade); OS sono le opere specializzate (lavorazioni specialistiche, come impianti o restauri). L’attestato è rilasciato per una o più categorie, ciascuna con una classifica di importo." },
  { q: "Fino a che importo posso lavorare con la mia classifica?", a: "Le classifiche di importo sono: I fino a 258.000 €; II fino a 516.000 €; III fino a 1.033.000 €; III-bis fino a 1.500.000 €; IV fino a 2.582.000 €; IV-bis fino a 3.500.000 €; V fino a 5.165.000 €; VI fino a 10.329.000 €; VII fino a 15.494.000 €; VIII oltre 15.494.000 €. La qualificazione in una classifica abilita a concorrere fino all’importo della classifica aumentato di un quinto." },
  { q: "Non ho tutti i requisiti: posso comunque qualificarmi?", a: "Sì, ricorrendo all’avvalimento (art. 104 D.Lgs. 36/2023): un’impresa ausiliaria mette a disposizione, con contratto scritto, i requisiti mancanti. È una strada che gestiamo direttamente." },
  { q: "Quanto dura l’attestazione?", a: "Ha efficacia di cinque anni, con verifica del mantenimento dei requisiti al terzo anno; il rinnovo va avviato almeno 90 giorni prima della scadenza. I tempi di rilascio dipendono dalla completezza documentale e dalle categorie richieste: te li indichiamo dopo l’analisi preliminare." },
];

const fonti = [
  "D.Lgs. 31 marzo 2023, n. 36 — artt. 100 e 104; Allegato II.12 (sistema di qualificazione)",
  "ANAC — manuale sulla qualificazione per l’esecuzione di lavori pubblici",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "ISO 9001", desc: "Riduzione della garanzia nelle gare e albi fornitori.", href: "/servizi/certificazioni/iso-9001" },
  { nome: "Sicurezza nei cantieri", desc: "PSC, POS e patente a crediti per i lavori che eseguirai.", href: "/servizi/consulenza/cantieri" },
  { nome: "Engineering", desc: "Progettazione e direzione lavori.", href: "/servizi/engineering" },
];
---

<Base
  title="Attestazione SOA: categorie OG e OS"
  description="Attestazione SOA per i lavori pubblici: requisiti, categorie OG e OS, classifiche, avvalimento e documenti. Consulenza a Napoli e in Campania."
>
  <PageHero back={{ href: "/servizi/certificazioni", label: "Torna a Certificazioni" }}>
    <Fragment slot="eyebrow">Certificazioni · Lavori pubblici</Fragment>
    <Fragment slot="title">Attestazione SOA.</Fragment>
    <Fragment slot="lede">La chiave per gli appalti di lavori pubblici di importo pari o superiore a 150.000 euro. Certifica le categorie di opere e le classifiche di importo che la tua impresa è qualificata a eseguire.</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/certificazioni-soa-gare.webp"
        alt="Preparazione di una pratica SOA e di gara: piani di cantiere, dossier, laptop e casco su un tavolo, due adulti verificano requisiti e documentazione, luce naturale, fotografia documentaria professionale"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="soa" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Senza SOA adeguata, resti fuori dalla gara.</h2>
      </div>
      <div class="prose">
        <p>
          L’attestazione SOA qualifica un’impresa a eseguire lavori pubblici di importo pari o superiore a 150.000 euro (art. 100 D.Lgs. 36/2023 e Allegato II.12). Certifica che l’impresa è idonea a eseguire opere di una specifica natura — le categorie OG (opere generali) e OS (opere specializzate) — e fino a un determinato valore, definito dalle classifiche di importo (dalla I alla VIII). La rilasciano gli organismi SOA autorizzati e vigilati dall’ANAC.
        </p>
        <p>
          Ottenerla significa dimostrare requisiti generali, tecnici (lavori eseguiti, direzione tecnica) ed economico-finanziari (cifra d’affari, organico, attrezzature). Quando manca un requisito, l’avvalimento consente di integrarlo con un’impresa ausiliaria. Noi verifichiamo i requisiti, prepariamo la documentazione e seguiamo l’istruttoria fino al rilascio. La nostra impresa è a sua volta attestata SOA OG1.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>D.Lgs. 36/2023 — art. 100</li>
          <li>Allegato II.12</li>
          <li>ANAC</li>
          <li>Categorie OG / OS</li>
          <li>Classifiche I–VIII</li>
          <li>Avvalimento — art. 104</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="soa-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="soa-aree" class="section-title">Dalla verifica dei requisiti al rinnovo.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <section class="section section--alt-2" aria-labelledby="soa-classifiche">
    <div class="container">
      <p class="eyebrow">Classifiche di importo</p>
      <h2 id="soa-classifiche" class="section-title">Fino a che importo posso lavorare con la mia classifica?</h2>
      <p class="classifiche-note">La qualificazione in una classifica abilita a concorrere fino all’importo della classifica aumentato di un quinto.</p>
      <div class="table-wrap">
        <table class="soa-table">
          <thead>
            <tr><th scope="col">Classifica</th><th scope="col">Importo qualificabile</th></tr>
          </thead>
          <tbody>
            {classifiche.map((r) => (
              <tr><td>{r.cl}</td><td>{r.imp}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <ServiceExtras part="resta" id="soa" items={resta} />

  <ServiceExtras part="ruoli" id="soa" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Il percorso verso l’attestazione." steps={fasi} labelledby="soa-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-soa"
    labelledby="soa-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="soa" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="soa" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Ti serve la SOA per una gara?"
    lede="Verifichiamo i requisiti che già hai, individuiamo categorie e classifiche giuste e, se serve, gestiamo l’avvalimento. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/certificazioni-soa-gare.webp",
      alt: "Consulente iCura Impresa con un imprenditore edile durante la preparazione di una pratica SOA: verifica di requisiti e documentazione su un tavolo con piani e casco, luce naturale, palette sobria, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="soa-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  .classifiche-note { font-size: var(--text-sm); color: var(--color-muted); max-width: 60ch; margin: 0 0 var(--space-lg); }
  .table-wrap { overflow-x: auto; }
  .soa-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    background: var(--color-surface);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .soa-table th, .soa-table td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: var(--rule-hair) solid var(--color-rule-2);
  }
  .soa-table th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    font-weight: 600;
  }
  .soa-table td:first-child { font-family: var(--font-mono); font-weight: 600; color: var(--color-accent); }
  .soa-table tbody tr:last-child td { border-bottom: 0; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
