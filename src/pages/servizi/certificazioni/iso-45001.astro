---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Imprese con rischi rilevanti — produzione, logistica, costruzioni, impianti — che vogliono un sistema di gestione della sicurezza verificato da terzi.",
  "Aziende che vogliono accedere alla riduzione del premio INAIL con il modello OT23.",
  "Organizzazioni che devono rafforzare il modello organizzativo ex art. 30 D.Lgs. 81/08 e D.Lgs. 231/2001.",
];

const sottoAree = [
  { nome: "Analisi dei gap sulla sicurezza", desc: "Confrontiamo lo stato dell’azienda con i requisiti della norma e con gli obblighi del D.Lgs. 81/08: DVR, procedure e formazione già presenti sono il punto di partenza." },
  { nome: "Sistema di gestione della sicurezza", desc: "Politica, analisi del contesto, valutazione dei rischi, ruoli, procedure operative, gestione delle emergenze e obiettivi di miglioramento, con la consultazione e partecipazione dei lavoratori." },
  { nome: "Formazione e audit interno", desc: "Formiamo le persone e verifichiamo il sistema con un audit interno prima dell’organismo, così le non conformità emergono in tempo." },
  { nome: "Assistenza all’audit di certificazione", desc: "Ti affianchiamo nelle due fasi dell’audit dell’organismo accreditato fino al rilascio del certificato." },
  { nome: "Domanda OT23 e riduzione del premio INAIL", desc: "Prepariamo e presentiamo la domanda OT23 per la riduzione del tasso medio di tariffa, utilizzando la certificazione come intervento di valore prevenzionale." },
  { nome: "Integrazione con il modello 231", desc: "Colleghiamo il sistema all’art. 30 del D.Lgs. 81/08 e agli elementi del modello organizzativo 231 (sistema disciplinare, organismo di vigilanza)." },
];

const resta = [
  "Un certificato rilasciato da un organismo terzo accreditato.",
  "L’accesso alla riduzione del premio INAIL con il modello OT23, in base alla dimensione aziendale.",
  "Un elemento a favore per l’efficacia esimente ex D.Lgs. 231/2001, da integrare con gli altri elementi del modello.",
  "Un sistema che le persone applicano davvero: procedure, emergenze, indicatori, riesame.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Analisi dei gap, progettazione del sistema, formazione, audit interno, assistenza all’audit, domanda OT23, mantenimento." },
  { titolo: "Svolto da terzi", desc: "L’organismo di certificazione accreditato svolge l’audit e rilascia il certificato; l’INAIL valuta la domanda OT23." },
];

const fasi = [
  { titolo: "Analisi dei gap", desc: "Fotografiamo lo stato dell’azienda rispetto alla norma e al D.Lgs. 81/08 e definiamo il piano." },
  { titolo: "Progettazione del sistema", desc: "Valutazione dei rischi, procedure, ruoli, emergenze, obiettivi e partecipazione dei lavoratori." },
  { titolo: "Formazione e audit interno", desc: "Formiamo il personale e proviamo il sistema con una verifica interna prima dell’organismo." },
  { titolo: "Audit, OT23 e mantenimento", desc: "L’organismo accreditato verifica in due fasi e rilascia il certificato; gestiamo le sorveglianze annuali, il rinnovo e la domanda OT23." },
];

const faq = [
  { q: "La ISO 45001 è obbligatoria?", a: "No, non è imposta dalla legge. Diventa però requisito o vantaggio competitivo per gare, grandi committenti e filiere, e riduce l’esposizione dell’impresa." },
  { q: "Quanto posso risparmiare sul premio INAIL con la ISO 45001?", a: "Tramite il modello OT23 la certificazione da parte di un organismo accreditato è tra gli interventi di valore prevenzionale che danno accesso alla riduzione del tasso medio di tariffa; la percentuale dipende dalla dimensione aziendale (dal 28% per le imprese fino a 10 lavoratori-anno al 5% per le più grandi). La domanda si presenta ogni anno entro l’ultimo giorno di febbraio sul portale INAIL, per gli interventi realizzati nell’anno precedente." },
  { q: "La ISO 45001 mi mette al riparo dalla responsabilità 231?", a: "È un forte elemento a favore: l’art. 30 del D.Lgs. 81/08 individua nei sistemi di gestione della sicurezza riconosciuti la base del modello organizzativo con efficacia esimente, «per le parti corrispondenti». Non è automatico: va integrata con gli elementi del modello 231 (sistema disciplinare, organismo di vigilanza) e l’idoneità è valutata in concreto dal giudice." },
  { q: "Serve avere già un sistema di sicurezza per partire?", a: "No: si parte da un’analisi dei gap sullo stato attuale (DVR, procedure, formazione) e si costruisce da lì il sistema conforme alla norma." },
  { q: "Quanto dura la certificazione?", a: "Tre anni, con audit di sorveglianza annuali e un audit di rinnovo alla scadenza." },
];

const fonti = [
  "UNI ISO 45001 — Sistemi di gestione per la salute e sicurezza sul lavoro",
  "D.Lgs. 81/2008, art. 30 — modelli di organizzazione e di gestione",
  "INAIL — Modello OT23 e guida alla compilazione (edizione annuale)",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "Sicurezza sul lavoro", desc: "Il DVR e l’organigramma da cui parte il sistema.", href: "/servizi/consulenza/sicurezza-lavoro" },
  { nome: "Consulenza aziendale", desc: "Modello 231 e deleghe coerenti con il sistema.", href: "/servizi/consulenza/aziendale" },
  { nome: "Bando ISI INAIL", desc: "Contributi per investimenti in sicurezza.", href: "/bando-isi" },
];
---

<Base
  title="ISO 45001 e riduzione premio INAIL"
  description="Sistema di gestione della sicurezza ISO 45001: dal DVR al certificato, con la riduzione del premio INAIL (OT23) quando spetta. Napoli e Campania."
>
  <PageHero back={{ href: "/servizi/certificazioni", label: "Torna a Certificazioni" }}>
    <Fragment slot="eyebrow">Certificazioni · Salute e sicurezza</Fragment>
    <Fragment slot="title">ISO 45001 — Salute e sicurezza.</Fragment>
    <Fragment slot="lede">Il sistema di gestione della salute e sicurezza sul lavoro. Riduce gli infortuni, può ridurre il premio INAIL con il modello OT23 e rafforza la posizione dell’impresa davanti alla responsabilità 231.</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/sicurezza-ispezione-capannone.webp"
        alt="Sopralluogo di sicurezza in un capannone industriale: tecnico con casco e giacca navy verifica una checklist di sicurezza insieme a un responsabile, ambiente ordinato e luce naturale, fotografia documentaria professionale"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="iso45001" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Meno infortuni, meno premio INAIL, meno responsabilità.</h2>
      </div>
      <div class="prose">
        <p>
          La ISO 45001 definisce i requisiti di un sistema di gestione della salute e sicurezza sul lavoro: politiche, ruoli, valutazione dei rischi, partecipazione dei lavoratori e miglioramento continuo per prevenire infortuni e malattie professionali. Condivide la struttura di ISO 9001 e 14001, quindi si integra con gli altri sistemi.
        </p>
        <p>
          Non è obbligatoria, ma porta vantaggi concreti: con il modello OT23 dà accesso alla riduzione del tasso medio di tariffa INAIL; è la base riconosciuta per il modello di organizzazione e gestione dell’art. 30 del D.Lgs. 81/08, rilevante per l’efficacia esimente ex D.Lgs. 231/2001. Il certificato lo rilascia un organismo terzo accreditato.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>ISO 45001</li>
          <li>Accredia</li>
          <li>OT23 — INAIL</li>
          <li>Art. 30 D.Lgs. 81/08</li>
          <li>D.Lgs. 231/2001</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="iso45001-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="iso45001-aree" class="section-title">Dal sistema di gestione alla domanda OT23.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <ServiceExtras part="resta" id="iso45001" items={resta} />

  <ServiceExtras part="ruoli" id="iso45001" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Il percorso verso il certificato." steps={fasi} labelledby="iso45001-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-iso45001"
    labelledby="iso45001-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="iso45001" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="iso45001" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Vuoi certificarti ISO 45001?"
    lede="Verifichiamo che cosa serve per arrivare all’audit e se puoi accedere alla riduzione del premio con l’OT23, con un solo referente per sicurezza e certificazione. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/sicurezza-ispezione-capannone.webp",
      alt: "Consulente sicurezza iCura Impresa durante un sopralluogo con un imprenditore in un capannone: verifica di procedure e checklist, casco e giacca navy, luce naturale, palette sobria, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="iso45001-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
