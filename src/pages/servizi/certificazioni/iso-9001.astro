---
import Base from "@layouts/Base.astro";
import PageHero from "@components/PageHero.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ServiceExtras from "@components/ServiceExtras.astro";

const aChi = [
  "Imprese che partecipano a gare pubbliche o vogliono entrare negli albi fornitori di grandi committenti.",
  "Aziende in crescita che devono mettere ordine in processi, ruoli e responsabilità.",
  "Organizzazioni che vogliono misurare la qualità con indicatori e ridurre errori e non conformità.",
];

const sottoAree = [
  { nome: "Analisi dei gap", desc: "Confrontiamo l’organizzazione con i requisiti della ISO 9001:2015 e individuiamo che cosa manca davvero: mappiamo processi, ruoli e rischi reali, senza liste di controllo standard." },
  { nome: "Sistema di gestione su misura", desc: "Politica della qualità, procedure, obiettivi e indicatori costruiti sui tuoi processi. Niente moduli copia-incolla." },
  { nome: "Formazione e audit interno", desc: "Prepariamo le persone ad applicare il sistema e lo mettiamo alla prova con una verifica interna e il riesame con la direzione, così le non conformità emergono prima dell’organismo." },
  { nome: "Assistenza all’audit di certificazione", desc: "Ti affianchiamo nelle due fasi dell’audit dell’organismo accreditato (fase 1 documentale e fase 2 sul campo) e nella chiusura degli eventuali rilievi." },
  { nome: "Mantenimento e sorveglianza", desc: "Seguiamo gli audit di sorveglianza annuali e il rinnovo alla scadenza del triennio: il sistema deve restare vivo e utile." },
  { nome: "Integrazione con altri sistemi", desc: "La 9001 condivide la struttura di ISO 14001 e 45001: se vuoi più certificazioni, costruiamo un unico sistema integrato invece di tre paralleli." },
];

const resta = [
  "Un sistema documentato e applicato, pronto per l’audit dell’organismo accreditato.",
  "Processi misurabili con indicatori, ruoli e responsabilità chiari, meno errori e non conformità.",
  "Il diritto alla riduzione del 30% della garanzia nelle gare pubbliche (art. 106, c. 8, D.Lgs. 36/2023) e un titolo richiesto negli albi fornitori.",
  "Il calendario delle sorveglianze e del rinnovo, seguito da noi.",
];

const ruoli = [
  { titolo: "Svolto direttamente da iCuraImpresa", desc: "Analisi dei gap, progettazione e documentazione del sistema, formazione, audit interno, riesame, assistenza all’audit, mantenimento." },
  { titolo: "Svolto da terzi", desc: "L’organismo di certificazione accreditato svolge l’audit e rilascia il certificato: consulenza e certificazione restano ruoli separati (ISO/IEC 17021-1)." },
];

const fasi = [
  { titolo: "Analisi dei gap", desc: "Fotografiamo lo stato attuale rispetto alla norma e definiamo il piano di lavoro con priorità concrete." },
  { titolo: "Documentazione", desc: "Costruiamo il sistema di gestione per la qualità su misura: processi, procedure, obiettivi e indicatori." },
  { titolo: "Formazione e audit interno", desc: "Formiamo il personale e verifichiamo il sistema con un audit interno prima dell’organismo." },
  { titolo: "Audit di certificazione e mantenimento", desc: "L’organismo accreditato verifica in due fasi e rilascia il certificato; gestiamo poi le sorveglianze annuali e il rinnovo triennale." },
];

const faq = [
  { q: "La ISO 9001 è obbligatoria?", a: "No, non è obbligatoria per legge. Diventa però necessaria di fatto per partecipare con vantaggio a gare pubbliche, entrare negli albi fornitori di grandi clienti o soddisfare requisiti contrattuali di filiera." },
  { q: "Quanto vale la certificazione in una gara pubblica?", a: "Dà diritto alla riduzione del 30% della garanzia (art. 106, c. 8, D.Lgs. 36/2023) e può essere valorizzata con punteggio tecnico nell’offerta. L’entità del punteggio dipende dal singolo bando." },
  { q: "Quanto dura il certificato?", a: "Tre anni, con audit di sorveglianza ogni anno e un audit di rinnovo alla scadenza del triennio." },
  { q: "Il certificato lo rilasciate voi?", a: "No, ed è giusto che sia così: lo rilascia un organismo di certificazione terzo e accreditato. Per il principio di imparzialità chi fa consulenza non può anche certificare. Noi prepariamo l’azienda e la affianchiamo all’audit." },
  { q: "Quanto tempo serve per ottenerla?", a: "Dipende dalla dimensione, dal numero di sedi e da quanto l’azienda è già strutturata. Dopo l’analisi dei gap ti diamo un calendario realistico con le tappe fino all’audit." },
];

const fonti = [
  "UNI EN ISO 9001:2015 — Sistemi di gestione per la qualità. Requisiti",
  "D.Lgs. 36/2023, art. 106, c. 8 — riduzione della garanzia per certificazione ISO 9001",
  "ISO/IEC 17021-1 — requisiti per gli organismi di certificazione",
];
const fontiNota = "Contenuti verificati al 7 ottobre 2026. Le norme cambiano: prima di decidere, verifichiamo insieme il caso specifico.";

const correlati = [
  { nome: "ISO 14001", desc: "Il sistema ambientale, integrabile con la qualità.", href: "/servizi/certificazioni/iso-14001" },
  { nome: "ISO 45001", desc: "Il sistema per la sicurezza, integrabile con la qualità.", href: "/servizi/certificazioni/iso-45001" },
  { nome: "Consulenza aziendale", desc: "Organizzazione, deleghe e responsabilità alla base del sistema.", href: "/servizi/consulenza/aziendale" },
];
---

<Base
  title="Certificazione ISO 9001 a Napoli"
  description="Sistema di gestione per la qualità ISO 9001:2015: analisi, procedure, audit interno e certificato con organismo accreditato. Lo applichiamo anche a noi dal 2019."
>
  <PageHero back={{ href: "/servizi/certificazioni", label: "Torna a Certificazioni" }}>
    <Fragment slot="eyebrow">Certificazioni · Qualità</Fragment>
    <Fragment slot="title">ISO 9001 — Qualità.</Fragment>
    <Fragment slot="lede">È il sistema di gestione più diffuso al mondo. Non un bollino in cornice: un modo di lavorare che riduce errori e sprechi, e un titolo che apre gare pubbliche e albi fornitori. Lo applichiamo anche a noi stessi: iCuraImpresa è certificata ISO 9001 dal 2019.</Fragment>
  </PageHero>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/certificazioni-audit-iso.webp"
        alt="Riunione di audit del sistema qualità in ufficio professionale: consulenti adulti confrontano registri, checklist e procedure attorno a un tavolo, luce naturale, fotografia documentaria sobria toni navy e grigio"
      />
    </div>
  </section>

  <ServiceExtras part="aChi" id="iso9001" items={aChi} />

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Il bisogno</p>
        <h2>Non certifica il prodotto: certifica come lavori.</h2>
      </div>
      <div class="prose">
        <p>
          La ISO 9001:2015 definisce i requisiti di un sistema di gestione per la qualità: non attesta il singolo prodotto, ma la capacità dell’organizzazione di gestire processi e risorse in modo ordinato, riducendo errori e non conformità e migliorando nel tempo. Si fonda sull’approccio per processi, sul ciclo PDCA e sul pensiero basato sul rischio.
        </p>
        <p>
          Non è obbligatoria per legge, ma è sempre più spesso una chiave d’accesso: nelle gare pubbliche dà diritto alla riduzione del 30% della garanzia (art. 106, c. 8, D.Lgs. 36/2023) ed è valorizzabile a punteggio tecnico; per molte filiere è un requisito d’ingresso negli albi fornitori. Il certificato lo rilascia un organismo terzo accreditato: noi portiamo l’azienda pronta all’audit.
        </p>
        <ul class="chips" aria-label="Riferimenti">
          <li>ISO 9001:2015</li>
          <li>Accredia</li>
          <li>Ciclo PDCA</li>
          <li>Pensiero basato sul rischio</li>
          <li>Albi fornitori</li>
          <li>Art. 106 D.Lgs. 36/2023</li>
        </ul>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="iso9001-aree">
    <div class="container">
      <p class="eyebrow">Che cosa facciamo</p>
      <h2 id="iso9001-aree" class="section-title">Dall’analisi dei gap al mantenimento.</h2>
      <AreaGrid aree={sottoAree} />
    </div>
  </section>

  <ServiceExtras part="resta" id="iso9001" items={resta} />

  <ServiceExtras part="ruoli" id="iso9001" ruoli={ruoli} />

  <Steps eyebrow="Come lavoriamo" title="Il percorso verso il certificato." steps={fasi} labelledby="iso9001-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-iso9001"
    labelledby="iso9001-faq"
    items={faq}
    tone="alt-blue"
  />

  <ServiceExtras part="fonti" id="iso9001" items={fonti} nota={fontiNota} />

  <ServiceExtras part="correlati" id="iso9001" correlati={correlati} />

  <CtaBand
    eyebrow="Il prossimo passo"
    title="Parti dalla ISO 9001?"
    lede="Una valutazione iniziale onesta per capire da dove cominciare e quanto tempo serve, senza venderti percorsi inutili. Ti rispondiamo noi, per email o per telefono, per capire insieme che cosa serve."
    image={{
      src: "/images/certificazioni-audit-iso.webp",
      alt: "Consulente certificazioni iCura Impresa con un imprenditore durante un audit di sistema qualità: due adulti in ufficio esaminano registri e checklist su un tavolo ordinato, palette sobria toni navy e grigio, fotografia documentaria",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Oppure chiama lo 081 658 0779" }}
    labelledby="iso9001-cta"
  />
</Base>

<style>
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 20ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 62ch; }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>
