---
import Base from "@layouts/Base.astro";
import DotGrid from "@components/DotGrid.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import { offerte, tipi, euro, type Tipo } from "../data/acquista";

const filtri: { id: "" | Tipo; label: string }[] = [
  { id: "", label: "Tutto" },
  ...(Object.keys(tipi) as Tipo[]).map((t) => ({ id: t, label: tipi[t].plurale })),
];
const conta = (t: "" | Tipo) => (t ? offerte.filter((o) => o.tipo === t).length : offerte.length);

// "Che cosa vuoi ottenere?": ogni scelta filtra il catalogo (per tipo o per elenco di offerte).
const regola = ["dvr-nuovo", "revisione-dvr", "duvri", "nomine-sicurezza", "checkup-documentale-sicurezza", "corso-lavoratori-generale-4h", "corso-lavoratori-specifica-basso-4h", "pos-cantiere", "manuale-haccp", "informative-privacy", "registro-trattamenti", "nomine-privacy"];
const obiettivi = [
  { t: "Mettermi in regola", d: "DVR, DUVRI, nomine e formazione obbligatoria: le cose che un controllo chiede per prime.", filtro: "", slugs: regola.join(",") },
  { t: "Formare il personale", d: "Corsi a calendario con attestato, in aula a Napoli o in videoconferenza, e corsi in azienda.", filtro: "corso_calendario", slugs: "" },
  { t: "Avere una risposta subito", d: "Una consulenza in videochiamata con un tecnico: domande concrete, risposta scritta.", filtro: "consulenza", slugs: "" },
  { t: "Un documento pronto", d: "Servizi a prezzo fisso con perimetro chiaro: invii il brief, ricevi il documento.", filtro: "servizio", slugs: "" },
];

const passi = [
  { t: "Scegli e invii la richiesta", d: "Prezzi IVA esclusa, con il totale sempre in vista. Compili il modulo d’ordine: nessun pagamento in questo momento." },
  { t: "Ti confermiamo il passo successivo", d: "Entro 2 giorni lavorativi ti scriviamo: data del corso, verifica che l’offerta sia adatta, richiesta del brief, istruzioni di pagamento." },
  { t: "Erogazione e fattura", d: "Una persona segue la tua pratica dall’inizio alla fine; la fattura elettronica arriva via SDI. Gli attestati dei corsi solo dopo registro e verifica." },
];

const verifica = [
  "iCuraImpresa S.r.l., P.IVA 09078161214, sede operativa a Napoli, Corso Secondigliano 236",
  "Certificazione ISO 45001 (TNV) per progettazione ed erogazione di corsi di formazione e consulenza",
  "Fattura elettronica per ogni ordine; nessun rinnovo automatico; prezzi senza costi nascosti",
  "Ogni scheda dice che cosa è incluso, che cosa no e le condizioni di annullamento",
];

const faq = [
  { q: "Perché vedo due prezzi?", a: "Il prezzo barrato è il listino. Il prezzo in evidenza vale per il primo ordine dal sito di ogni cliente (stessa partita IVA, codice fiscale o email): dal secondo ordine si applica il listino. Non ci sono altri sconti né promozioni a tempo." },
  { q: "Pago subito online?", a: "No. Invii la richiesta d’ordine, noi verifichiamo disponibilità e adeguatezza e ti mandiamo conferma e istruzioni di pagamento. Per bonifico e fattura a 30 giorni sui contratti annuali chiedi un preventivo dalla pagina Contatti." },
  { q: "Sono un privato, posso acquistare?", a: "Sì. Per i privati valgono le tutele del Codice del Consumo, compreso il diritto di recesso entro 14 giorni dove applicabile." },
  { q: "Come ricevo la fattura?", a: "Via SDI, al codice destinatario o alla PEC che indichi; la copia di cortesia arriva per email." },
  { q: "E se devo annullare?", a: "Ogni scheda dice entro quando il rimborso è integrale (per esempio 7 giorni prima di un corso, 24 ore prima di una consulenza). Scrivici o chiamaci: i casi fuori termine li valuta una persona." },
];
---

<Base
  title="Acquista online: corsi, consulenze e documenti a prezzo chiaro"
  crumb="Acquista online"
  description="Corsi sulla sicurezza con attestato, consulenze in videochiamata e documenti a prezzo fisso (DVR, DUVRI, HACCP, privacy). Prezzi IVA esclusa, cosa è incluso, cosa succede dopo."
>
  <header class="shop-hero section--ink" aria-labelledby="shop-heading">
    <DotGrid />
    <div class="container">
      <p class="eyebrow">Acquista online</p>
      <h1 id="shop-heading" class="shop-hero__title">Formazione, consulenze e documenti <span class="accent">a prezzo chiaro.</span></h1>
      <p class="shop-hero__lede">
        Corsi con data e attestato, un’ora con un tecnico, documenti a prezzo fisso: scegli, invii la richiesta e sai subito che cosa succede dopo. Per tutto il resto c’è il preventivo.
      </p>
      <div class="shop-hero__ctas">
        <a href="#catalogo" class="btn btn--primary">Vai al catalogo <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href="/contatti" class="shop-hero__alt">Chiedi un preventivo</a>
      </div>
    </div>
  </header>

  <section class="section goals" aria-labelledby="goals-heading">
    <div class="container">
      <p class="eyebrow">Parti da quello che ti serve</p>
      <h2 id="goals-heading" class="goals__title">Che cosa vuoi ottenere?</h2>
      <ul class="goals__list">
        {obiettivi.map((o, i) => (
          <li>
            <a href="#catalogo" class="goals__item" data-shop-goal={o.filtro} data-shop-slugs={o.slugs} data-shop-goal-label={o.t}>
              <span class="goals__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="goals__t">{o.t}</span>
              <span class="goals__d">{o.d}</span>
              <span class="goals__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="catalogo" class="section section--alt catalog" aria-labelledby="catalog-heading" data-shop>
    <div class="container">
      <div class="catalog__head">
        <div>
          <p class="eyebrow">Il catalogo</p>
          <h2 id="catalog-heading" class="catalog__title">{offerte.length} offerte, prezzo e perimetro in chiaro.</h2>
        </div>
        <label class="catalog__search">
          <span class="sr-only">Cerca nel catalogo</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input type="search" placeholder="Cerca: DVR, antincendio, HACCP…" data-shop-q />
        </label>
      </div>

      <div class="catalog__filters" role="group" aria-label="Filtra per tipo">
        {filtri.map((f) => (
          <button type="button" class="catalog__filter" data-shop-filter={f.id} aria-pressed={f.id === "" ? "true" : "false"}>
            {f.label} <span class="catalog__count">{conta(f.id)}</span>
          </button>
        ))}
      </div>
      <p class="catalog__active" data-shop-active hidden>
        <span data-shop-active-label></span>
        <button type="button" data-shop-reset>Mostra tutto ×</button>
      </p>

      <ul class="catalog__grid">
        {offerte.map((o) => (
          <li class="prod" data-tipo={o.tipo} data-slug={o.slug} data-text={`${o.titolo} ${o.lede} ${tipi[o.tipo].label}`.toLowerCase()}>
            <a href={`/acquista/${o.slug}`} class="prod__link">
              <span class="prod__tipo">{tipi[o.tipo].label}</span>
              <span class="prod__titolo">{o.titolo}</span>
              <span class="prod__lede">{o.lede}</span>
              <span class="prod__prezzo">
                {o.listino > o.prezzo && <s>{euro(o.listino)}</s>}
                <strong>{euro(o.prezzo)}</strong>
                <small>+ IVA · a {o.unita}</small>
              </span>
              <span class="prod__cta">Dettagli e ordine <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="catalog__empty" data-shop-empty hidden>
        Nessuna offerta corrisponde. Prova con un’altra parola, oppure <a href="/contatti">scrivici che cosa cerchi</a>.
      </p>
      <p class="catalog__note">Prezzi IVA esclusa. Il prezzo in evidenza vale per il primo ordine dal sito; il barrato è il listino.</p>
    </div>
  </section>

  <section class="section how section--ink" aria-labelledby="how-heading">
    <DotGrid />
    <div class="container how__grid">
      <div>
        <p class="eyebrow">Come funziona</p>
        <h2 id="how-heading" class="how__title">Tre passi, nessuna sorpresa.</h2>
      </div>
      <ol class="how__list">
        {passi.map((p, i) => (
          <li class="how__item">
            <span class="how__n">{i + 1}</span>
            <h3 class="how__t">{p.t}</h3>
            <p class="how__d">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="verifica-heading">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Garanzie</p>
        <h2 id="verifica-heading" class="two-col__title">Quello che puoi verificare.</h2>
      </div>
      <ul class="verify">
        {verifica.map((v) => (
          <li>
            <span class="verify__tick" aria-hidden="true">✓</span>
            {v}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faq} name="faq-acquista" tone="alt" />

  <CtaBand
    title="Non trovi quello che ti serve?"
    lede="Contratti annuali, più sedi, corsi su misura: ti prepariamo un preventivo scritto."
    primary={{ href: "/contatti", label: "Chiedi un preventivo" }}
    secondary={{ href: "tel:+390816580779", label: "Chiama 081 658 0779" }}
    labelledby="acquista-cta-heading"
  />
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-shop]").forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>(".prod"));
    const filters = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-shop-filter]"));
    const q = root.querySelector<HTMLInputElement>("[data-shop-q]")!;
    const empty = root.querySelector<HTMLElement>("[data-shop-empty]")!;
    const active = root.querySelector<HTMLElement>("[data-shop-active]")!;
    const activeLabel = root.querySelector<HTMLElement>("[data-shop-active-label]")!;
    let tipo = "";
    let slugs: string[] | null = null;

    const apply = () => {
      const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let n = 0;
      for (const el of items) {
        const ok =
          (!tipo || el.dataset.tipo === tipo) &&
          (!slugs || slugs.includes(el.dataset.slug!)) &&
          words.every((w) => el.dataset.text!.includes(w));
        el.hidden = !ok;
        if (ok) n++;
      }
      empty.hidden = n > 0;
      for (const f of filters) f.setAttribute("aria-pressed", String(!slugs && f.dataset.shopFilter === tipo));
    };

    const setTipo = (t: string) => {
      tipo = t;
      slugs = null;
      active.hidden = true;
      apply();
    };
    for (const f of filters) f.addEventListener("click", () => setTipo(f.dataset.shopFilter!));
    q.addEventListener("input", apply);
    root.querySelector("[data-shop-reset]")!.addEventListener("click", () => setTipo(""));

    // Le scelte "Che cosa vuoi ottenere?" filtrano il catalogo prima di scorrerci.
    document.querySelectorAll<HTMLAnchorElement>("[data-shop-goal]").forEach((a) => {
      a.addEventListener("click", () => {
        q.value = "";
        tipo = a.dataset.shopGoal!;
        slugs = a.dataset.shopSlugs ? a.dataset.shopSlugs.split(",") : null;
        active.hidden = !slugs;
        activeLabel.textContent = `Obiettivo: ${a.dataset.shopGoalLabel}`;
        apply();
      });
    });
  });
</script>

<style>
  /* ───── Hero ───── */
  .shop-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--space-3xl);
  }
  .shop-hero__title {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
    max-width: 16ch;
    margin: 0 0 var(--space-lg);
  }
  .shop-hero__lede { font-size: var(--text-lg); line-height: 1.55; max-width: 56ch; margin: 0 0 var(--space-xl); }
  .shop-hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); }
  .shop-hero__alt { font-weight: 500; text-underline-offset: 4px; }

  /* ───── Obiettivi ───── */
  .goals__title { font-size: var(--text-3xl); font-weight: 500; letter-spacing: -0.02em; margin: 0 0 var(--space-xl); }
  .goals__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .goals__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-lg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .goals__item:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: var(--shadow-lift); text-decoration: none; }
  .goals__n { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); letter-spacing: 0.06em; }
  .goals__t { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 500; letter-spacing: -0.015em; }
  .goals__d { font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.5; padding-right: var(--space-md); }
  .goals__arrow { position: absolute; right: var(--space-lg); top: var(--space-lg); color: var(--color-accent); transition: transform var(--dur-fast) var(--ease-out); }
  .goals__item:hover .goals__arrow { transform: translate(2px, 2px) rotate(90deg); }

  /* ───── Catalogo ───── */
  .catalog__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .catalog__title { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 22ch; }
  .catalog__search {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex: 0 1 22rem;
    padding: 0 var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-muted);
  }
  .catalog__search:focus-within { border-color: var(--color-accent); outline: 2px solid var(--color-focus); outline-offset: 1px; }
  .catalog__search svg { width: 1.1rem; height: 1.1rem; flex: none; }
  .catalog__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    padding: 0.75rem 0;
    font: inherit;
    font-size: var(--text-md);
    color: var(--color-ink);
    outline: none;
  }
  .catalog__filters { display: flex; flex-wrap: wrap; gap: var(--space-xs); margin-bottom: var(--space-lg); }
  .catalog__filter {
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.55em 1em;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .catalog__filter:hover { border-color: var(--color-accent); }
  .catalog__filter[aria-pressed="true"] { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); }
  .catalog__count { font-family: var(--font-mono); font-size: 0.85em; opacity: 0.6; margin-left: 0.25em; }
  .catalog__active { display: flex; gap: var(--space-sm); align-items: center; margin: calc(-1 * var(--space-sm)) 0 var(--space-lg); font-weight: 500; color: var(--color-accent); }
  .catalog__active[hidden] { display: none; }
  .catalog__active button { font: inherit; font-size: var(--text-sm); background: none; border: 0; color: var(--color-ink-2); text-decoration: underline; cursor: pointer; }

  .catalog__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-md);
  }
  .prod[hidden] { display: none; }
  .prod__link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .prod__link:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: var(--shadow-lift); text-decoration: none; }
  .prod__tipo { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); }
  .prod__titolo { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; }
  .prod__lede { font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.5; }
  .prod__prezzo { margin-top: auto; padding-top: var(--space-sm); display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2em 0.5em; border-top: 1px solid var(--color-rule); }
  .prod__prezzo s { color: var(--color-muted); font-size: var(--text-sm); }
  .prod__prezzo strong { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.01em; }
  .prod__prezzo small { font-size: var(--text-xs); color: var(--color-muted); }
  .prod__cta { font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); }
  .prod__cta span { display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
  .prod__link:hover .prod__cta span { transform: translateX(3px); }
  .catalog__empty { padding: var(--space-xl); text-align: center; color: var(--color-ink-2); }
  .catalog__empty a { color: var(--color-accent); }
  .catalog__note { margin: var(--space-lg) 0 0; font-size: var(--text-sm); color: var(--color-muted); }

  /* ───── Come funziona ───── */
  .how { position: relative; isolation: isolate; overflow: clip; }
  .how__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-2xl); align-items: start; }
  .how__title { font-size: var(--text-3xl); font-weight: 500; letter-spacing: -0.02em; max-width: 12ch; }
  .how__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); counter-reset: none; }
  .how__item { padding-top: var(--space-md); border-top: 2px solid var(--color-accent); }
  .how__n { display: block; font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; color: var(--color-accent); line-height: 1; margin-bottom: var(--space-sm); }
  .how__t { font-size: var(--text-lg); font-weight: 500; margin: 0 0 var(--space-2xs); }
  .how__d { font-size: var(--text-sm); line-height: 1.55; margin: 0; }

  /* ───── Garanzie ───── */
  .two-col { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-xl); align-items: start; }
  .verify { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .verify li { display: flex; gap: var(--space-sm); padding: var(--space-md) 0; border-top: var(--rule-hair) solid var(--color-rule); font-size: var(--text-md); color: var(--color-ink-2); line-height: 1.5; }
  .verify li:first-child { border-top: 0; padding-top: 0; }
  .verify__tick { flex: none; display: grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--color-accent-soft); color: var(--color-accent); font-size: 0.8rem; font-weight: 700; }

  @media (max-width: 64rem) {
    .goals__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .how__grid { grid-template-columns: 1fr; gap: var(--space-lg); }
  }
  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
    .how__list { grid-template-columns: 1fr; }
  }
  @media (max-width: 40rem) {
    .goals__list { grid-template-columns: 1fr; }
    .catalog__search { flex-basis: 100%; }
  }
</style>
