---
import Base from "@layouts/Base.astro";
import DotGrid from "@components/DotGrid.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ShopIcon from "@components/ShopIcon.astro";
import { offerte, tipi, euro, aree, gruppi, catalogo, areaOf, gruppoDi, meta, type Gruppo, type Area } from "../data/acquista";

// Filtri del catalogo: che cosa compri (gruppo) e per che cosa (argomento).
// I conteggi qui sono quelli di partenza; lo script li ricalcola a ogni scelta.
const filtriGruppo = (Object.keys(gruppi) as Gruppo[]).map((id) => ({
  id,
  label: gruppi[id].label,
  n: offerte.filter((o) => gruppoDi(o.tipo) === id).length,
}));
const filtriArea = (Object.keys(aree) as Area[]).map((id) => ({
  id,
  label: aree[id].label,
  n: offerte.filter((o) => areaOf(o) === id).length,
}));
// Quale icona per quale tipo di offerta.
const icona = (g: Gruppo) => (g === "corsi" ? "corso" : g === "consulenze" ? "consulenza" : "servizio") as "corso" | "consulenza" | "servizio";

// "Che cosa vuoi ottenere?": ogni scelta filtra il catalogo (per tipo o per elenco di offerte).
const regola = ["dvr-nuovo", "revisione-dvr", "duvri", "nomine-sicurezza", "checkup-documentale-sicurezza", "corso-lavoratori-generale-4h", "corso-lavoratori-specifica-basso-4h", "pos-cantiere", "manuale-haccp", "informative-privacy", "registro-trattamenti", "nomine-privacy"];
const obiettivi = [
  { t: "Mettermi in regola", d: "DVR, DUVRI, nomine e formazione obbligatoria: le cose che un controllo chiede per prime.", filtro: "", slugs: regola.join(",") },
  { t: "Formare il personale", d: "Corsi a calendario con attestato, in aula a Napoli o in videoconferenza, e corsi in azienda.", filtro: "corsi", slugs: "" },
  { t: "Avere una risposta subito", d: "Una consulenza in videochiamata con un tecnico: domande concrete, risposta scritta.", filtro: "consulenze", slugs: "" },
  { t: "Un documento pronto", d: "Servizi a prezzo fisso con perimetro chiaro: invii il brief, ricevi il documento.", filtro: "servizi", slugs: "" },
];

const passi = [
  { t: "Scegli e invii la richiesta", d: "Prezzi IVA esclusa, con il totale sempre in vista. Compili il modulo d’ordine: nessun pagamento in questo momento." },
  { t: "Ti confermiamo il passo successivo", d: "Entro 2 giorni lavorativi ti scriviamo: data del corso, verifica che l’offerta sia adatta, richiesta del brief, istruzioni di pagamento." },
  { t: "Erogazione e fattura", d: "Una persona segue la tua pratica dall’inizio alla fine; la fattura elettronica arriva via SDI. Gli attestati dei corsi solo dopo registro e verifica." },
];

const verifica = [
  "iCuraImpresa S.r.l., P.IVA 09078161214, sede operativa a Napoli, Corso Secondigliano 236",
  "Certificazione ISO 45001 (TNV) per progettazione ed erogazione di corsi di formazione e consulenza",
  "Fattura elettronica per ogni ordine; nessun rinnovo automatico; prezzi senza costi nascosti",
  "Ogni scheda dice che cosa è incluso, che cosa no e le condizioni di annullamento",
];

const faq = [
  { q: "Perché vedo due prezzi?", a: "Il prezzo barrato è il listino. Il prezzo in evidenza vale per il primo ordine dal sito di ogni cliente (stessa partita IVA, codice fiscale o email): dal secondo ordine si applica il listino. Non ci sono altri sconti né promozioni a tempo." },
  { q: "Pago subito online?", a: "No. Invii la richiesta d’ordine, noi verifichiamo disponibilità e adeguatezza e ti mandiamo conferma e istruzioni di pagamento. Per bonifico e fattura a 30 giorni sui contratti annuali chiedi un preventivo dalla pagina Contatti." },
  { q: "Sono un privato, posso acquistare?", a: "Sì. Per i privati valgono le tutele del Codice del Consumo, compreso il diritto di recesso entro 14 giorni dove applicabile." },
  { q: "Come ricevo la fattura?", a: "Via SDI, al codice destinatario o alla PEC che indichi; la copia di cortesia arriva per email." },
  { q: "E se devo annullare?", a: "Ogni scheda dice entro quando il rimborso è integrale (per esempio 7 giorni prima di un corso, 24 ore prima di una consulenza). Scrivici o chiamaci: i casi fuori termine li valuta una persona." },
];
---

<Base
  title="Acquista online: corsi, consulenze e documenti a prezzo chiaro"
  crumb="Acquista online"
  description="Corsi sulla sicurezza con attestato, consulenze in videochiamata e documenti a prezzo fisso (DVR, DUVRI, HACCP, privacy). Prezzi IVA esclusa, cosa è incluso, cosa succede dopo."
>
  <header class="shop-hero section--ink" aria-labelledby="shop-heading">
    <DotGrid />
    <div class="container">
      <p class="eyebrow">Acquista online</p>
      <h1 id="shop-heading" class="shop-hero__title">Formazione, consulenze e documenti <span class="accent">a prezzo chiaro.</span></h1>
      <p class="shop-hero__lede">
        Corsi con data e attestato, un’ora con un tecnico, documenti a prezzo fisso: scegli, invii la richiesta e sai subito che cosa succede dopo. Per tutto il resto c’è il preventivo.
      </p>
      <div class="shop-hero__ctas">
        <a href="#catalogo" class="btn btn--primary">Vai al catalogo <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a href="/contatti" class="shop-hero__alt">Chiedi un preventivo</a>
      </div>
    </div>
  </header>

  <section class="section goals" aria-labelledby="goals-heading">
    <div class="container">
      <p class="eyebrow">Parti da quello che ti serve</p>
      <h2 id="goals-heading" class="goals__title">Che cosa vuoi ottenere?</h2>
      <ul class="goals__list">
        {obiettivi.map((o, i) => (
          <li>
            <a href="#catalogo" class="goals__item" data-shop-goal={o.filtro} data-shop-slugs={o.slugs} data-shop-goal-label={o.t} data-shop-goal-idx={i}>
              <span class="goals__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="goals__t">{o.t}</span>
              <span class="goals__d">{o.d}</span>
              <span class="goals__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="catalogo" class="section section--alt catalog" aria-labelledby="catalog-heading" data-shop>
    <div class="container">
      <div class="catalog__head">
        <div>
          <p class="eyebrow">Il catalogo</p>
          <h2 id="catalog-heading" class="catalog__title">{offerte.length} offerte, prezzo e perimetro in chiaro.</h2>
        </div>
        <label class="catalog__search">
          <span class="sr-only">Cerca nel catalogo</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input type="search" placeholder="Cerca: DVR, antincendio, HACCP…" data-shop-q />
        </label>
      </div>

      <div class="catalog__bar">
        <div class="catalog__facet" role="group" aria-label="Filtra per tipo">
          <span class="catalog__facet-label" aria-hidden="true">Tipo</span>
          <div class="catalog__chips">
            <button type="button" class="catalog__filter" data-shop-tipo="" aria-pressed="true">
              Tutto <span class="catalog__count">{offerte.length}</span>
            </button>
            {filtriGruppo.map((f) => (
              <button type="button" class="catalog__filter" data-shop-tipo={f.id} aria-pressed="false">
                {f.label} <span class="catalog__count">{f.n}</span>
              </button>
            ))}
          </div>
        </div>
        <div class="catalog__facet" role="group" aria-label="Filtra per argomento">
          <span class="catalog__facet-label" aria-hidden="true">Argomento</span>
          <div class="catalog__chips">
            <button type="button" class="catalog__filter" data-shop-area="" aria-pressed="true">
              Tutti <span class="catalog__count">{offerte.length}</span>
            </button>
            {filtriArea.map((f) => (
              <button type="button" class="catalog__filter" data-area={f.id} data-shop-area={f.id} aria-pressed="false">
                <span class="catalog__dot" aria-hidden="true"></span>{f.label} <span class="catalog__count">{f.n}</span>
              </button>
            ))}
          </div>
        </div>
        <p class="catalog__summary">
          <span data-shop-summary aria-live="polite">{offerte.length} offerte</span>
          <span class="catalog__goal" data-shop-active hidden>Obiettivo: <b data-shop-active-label></b></span>
          <button type="button" class="catalog__reset" data-shop-reset hidden>Azzera i filtri ×</button>
        </p>
      </div>

      <div class="catalog__groups">
        {catalogo.map((g) => (
          <section class="shop-group" data-group={g.id} aria-labelledby={`grp-${g.id}`}>
            <header class="shop-group__head">
              <h3 id={`grp-${g.id}`} class="shop-group__title">{g.label} <span class="shop-group__count" data-group-count>{g.offerte.length}</span></h3>
              <p class="shop-group__desc">{g.desc}</p>
            </header>
            <ul class="catalog__grid">
              {g.offerte.map((o) => {
                const area = areaOf(o);
                return (
                  <li class="prod" data-gruppo={g.id} data-area={area} data-slug={o.slug} data-text={`${o.titolo} ${o.lede} ${tipi[o.tipo].label} ${aree[area].label}`.toLowerCase()}>
                    <a href={`/acquista/${o.slug}`} class="prod__link">
                      <span class="prod__top">
                        <span class="prod__icon"><ShopIcon name={icona(g.id)} /></span>
                        <span class="prod__area">{aree[area].label}</span>
                      </span>
                      <span class="prod__tipo">{tipi[o.tipo].label}</span>
                      <span class="prod__titolo">{o.titolo}</span>
                      <span class="prod__lede">{o.lede}</span>
                      <ul class="prod__meta" aria-label="In breve">
                        {meta(o).map((m) => <li>{m}</li>)}
                      </ul>
                      <span class="prod__foot">
                        <span class="prod__prezzo">
                          {o.listino > o.prezzo && <s>{euro(o.listino)}</s>}
                          <strong>{euro(o.prezzo)}</strong>
                          <small>+ IVA · a {o.unita}</small>
                        </span>
                        <span class="prod__cta">Dettagli e ordine <span aria-hidden="true">→</span></span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
      <p class="catalog__empty" data-shop-empty hidden>
        Nessuna offerta corrisponde. Prova con un’altra parola, oppure <a href="/contatti">scrivici che cosa cerchi</a>.
      </p>
      <p class="catalog__note">Prezzi IVA esclusa. Il prezzo in evidenza vale per il primo ordine dal sito; il barrato è il listino.</p>
    </div>
  </section>

  <section class="section how section--ink" aria-labelledby="how-heading">
    <DotGrid />
    <div class="container how__grid">
      <div>
        <p class="eyebrow">Come funziona</p>
        <h2 id="how-heading" class="how__title">Tre passi, nessuna sorpresa.</h2>
      </div>
      <ol class="how__list">
        {passi.map((p, i) => (
          <li class="how__item">
            <span class="how__n">{i + 1}</span>
            <h3 class="how__t">{p.t}</h3>
            <p class="how__d">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="verifica-heading">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">Garanzie</p>
        <h2 id="verifica-heading" class="two-col__title">Quello che puoi verificare.</h2>
      </div>
      <ul class="verify">
        {verifica.map((v) => (
          <li>
            <span class="verify__tick" aria-hidden="true">✓</span>
            {v}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faq} name="faq-acquista" tone="alt" />

  <CtaBand
    title="Non trovi quello che ti serve?"
    lede="Contratti annuali, più sedi, corsi su misura: ti prepariamo un preventivo scritto."
    primary={{ href: "/contatti", label: "Chiedi un preventivo" }}
    secondary={{ href: "tel:+390816580779", label: "Chiama 081 658 0779" }}
    labelledby="acquista-cta-heading"
  />
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-shop]").forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>(".prod"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-group]"));
    const tipoBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-shop-tipo]"));
    const areaBtns = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-shop-area]"));
    const q = root.querySelector<HTMLInputElement>("[data-shop-q]")!;
    const empty = root.querySelector<HTMLElement>("[data-shop-empty]")!;
    const summary = root.querySelector<HTMLElement>("[data-shop-summary]")!;
    const goalPill = root.querySelector<HTMLElement>("[data-shop-active]")!;
    const goalLabel = root.querySelector<HTMLElement>("[data-shop-active-label]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-shop-reset]")!;
    const goals = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-shop-goal]"));

    // Stato dei filtri. `goal` è l'indice dell'obiettivo scelto più su, se questo ha un elenco
    // fisso di offerte (-1 = nessuno); gli obiettivi per tipo diventano un normale filtro tipo.
    const state = { tipo: "", area: "", q: "", goal: -1 };
    const goalSlugs = () => (state.goal >= 0 ? goals[state.goal].dataset.shopSlugs!.split(",") : null);

    // Un'offerta passa se rispetta tutti i filtri, tranne quello in `skip`. Serve per i
    // conteggi: ogni chip dice quante offerte avrebbe *con gli altri filtri già attivi*.
    const passes = (el: HTMLElement, skip?: "tipo" | "area") => {
      const words = state.q.toLowerCase().trim().split(/\s+/).filter(Boolean);
      const slugs = goalSlugs();
      return (
        (skip === "tipo" || !state.tipo || el.dataset.gruppo === state.tipo) &&
        (skip === "area" || !state.area || el.dataset.area === state.area) &&
        (!slugs || slugs.includes(el.dataset.slug!)) &&
        words.every((w) => el.dataset.text!.includes(w))
      );
    };

    const setChip = (btn: HTMLButtonElement, count: number, pressed: boolean) => {
      btn.querySelector(".catalog__count")!.textContent = String(count);
      btn.setAttribute("aria-pressed", String(pressed));
      btn.disabled = count === 0 && !pressed; // nessuna offerta con questa combinazione
    };

    const apply = () => {
      let n = 0;
      for (const el of items) {
        const ok = passes(el);
        el.hidden = !ok;
        if (ok) n++;
      }
      // Una sezione senza offerte visibili sparisce; il numero nel titolo segue i filtri.
      for (const g of groups) {
        const k = g.querySelectorAll(".prod:not([hidden])").length;
        g.hidden = k === 0;
        g.querySelector("[data-group-count]")!.textContent = String(k);
      }
      // Con un obiettivo a elenco fisso nessun chip risulta "premuto".
      const custom = state.goal >= 0;
      for (const b of tipoBtns) {
        const v = b.dataset.shopTipo!;
        setChip(b, items.filter((el) => passes(el, "tipo") && (!v || el.dataset.gruppo === v)).length, !custom && state.tipo === v);
      }
      for (const b of areaBtns) {
        const v = b.dataset.shopArea!;
        setChip(b, items.filter((el) => passes(el, "area") && (!v || el.dataset.area === v)).length, !custom && state.area === v);
      }

      empty.hidden = n > 0;
      summary.textContent = n === items.length ? `${n} offerte` : `${n} ${n === 1 ? "offerta" : "offerte"} su ${items.length}`;
      goalPill.hidden = !custom;
      if (custom) goalLabel.textContent = goals[state.goal].dataset.shopGoalLabel!;
      reset.hidden = !(state.tipo || state.area || state.q.trim() || custom);
    };

    // Lo stato sta nell'URL: tornando indietro da una scheda prodotto i filtri restano.
    const sync = () => {
      const p = new URLSearchParams();
      if (state.tipo) p.set("tipo", state.tipo);
      if (state.area) p.set("argomento", state.area);
      if (state.q.trim()) p.set("q", state.q.trim());
      if (state.goal >= 0) p.set("obiettivo", String(state.goal));
      const s = p.toString();
      history.replaceState(null, "", location.pathname + (s ? `?${s}` : "") + location.hash);
    };
    const set = (patch: Partial<typeof state>) => {
      Object.assign(state, { goal: -1 }, patch);
      apply();
      sync();
    };

    for (const b of tipoBtns) b.addEventListener("click", () => set({ tipo: b.dataset.shopTipo! }));
    for (const b of areaBtns) b.addEventListener("click", () => set({ area: b.dataset.shopArea! }));
    q.addEventListener("input", () => {
      state.q = q.value;
      apply();
      sync();
    });
    reset.addEventListener("click", () => {
      q.value = "";
      set({ tipo: "", area: "", q: "" });
    });

    // Le scelte "Che cosa vuoi ottenere?" filtrano il catalogo prima di scorrerci.
    goals.forEach((a, i) =>
      a.addEventListener("click", () => {
        q.value = "";
        set({ tipo: a.dataset.shopGoal!, area: "", q: "", goal: a.dataset.shopSlugs ? i : -1 });
      }),
    );

    // Stato iniziale dall'URL (si ignorano valori che non esistono).
    const params = new URLSearchParams(location.search);
    const pick = (btns: HTMLButtonElement[], key: string, attr: "shopTipo" | "shopArea") => {
      const v = params.get(key) ?? "";
      return btns.some((b) => b.dataset[attr] === v) ? v : "";
    };
    state.tipo = pick(tipoBtns, "tipo", "shopTipo");
    state.area = pick(areaBtns, "argomento", "shopArea");
    state.q = params.get("q") ?? "";
    q.value = state.q;
    const g = Number(params.get("obiettivo") ?? -1);
    state.goal = Number.isInteger(g) && g >= 0 && g < goals.length && goals[g].dataset.shopSlugs ? g : -1;
    apply();
  });
</script>

<style>
  /* ───── Hero ───── */
  .shop-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--space-3xl);
  }
  .shop-hero__title {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 0.98;
    max-width: 16ch;
    margin: 0 0 var(--space-lg);
  }
  .shop-hero__lede { font-size: var(--text-lg); line-height: 1.55; max-width: 56ch; margin: 0 0 var(--space-xl); }
  .shop-hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); }
  .shop-hero__alt { font-weight: 500; text-underline-offset: 4px; }

  /* ───── Obiettivi ───── */
  .goals__title { font-size: var(--text-3xl); font-weight: 500; letter-spacing: -0.02em; margin: 0 0 var(--space-xl); }
  .goals__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .goals__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-lg);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }
  .goals__item:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: var(--shadow-lift); text-decoration: none; }
  .goals__n { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); letter-spacing: 0.06em; }
  .goals__t { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 500; letter-spacing: -0.015em; }
  .goals__d { font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.5; padding-right: var(--space-md); }
  .goals__arrow { position: absolute; right: var(--space-lg); top: var(--space-lg); color: var(--color-accent); transition: transform var(--dur-fast) var(--ease-out); }
  .goals__item:hover .goals__arrow { transform: translate(2px, 2px) rotate(90deg); }

  /* ───── Catalogo ───── */
  .catalog__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .catalog__title { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 22ch; }
  .catalog__search {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    flex: 0 1 22rem;
    padding: 0 var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 999px;
    color: var(--color-muted);
  }
  .catalog__search:focus-within { border-color: var(--color-accent); outline: 2px solid var(--color-focus); outline-offset: 1px; }
  .catalog__search svg { width: 1.1rem; height: 1.1rem; flex: none; }
  .catalog__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    padding: 0.75rem 0;
    font: inherit;
    font-size: var(--text-md);
    color: var(--color-ink);
    outline: none;
  }
  /* Filtri: una riga per tipo, una per argomento, poi il numero di risultati.
     I numeri nei chip dicono quante offerte darebbe ogni scelta con gli altri filtri attivi. */
  .catalog__bar { display: grid; gap: var(--space-xs); margin-bottom: var(--space-xl); }
  .catalog__facet { display: flex; align-items: center; gap: var(--space-sm); }
  .catalog__facet-label {
    flex: none;
    width: 6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .catalog__chips { display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .catalog__filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.55em 1em;
    border-radius: 999px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
