---
import Base from "@layouts/Base.astro";
import DotGrid from "@components/DotGrid.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";
import ShopIcon from "@components/ShopIcon.astro";
import { offerte, tipi, euro, catalogo, scheda, sconto } from "../data/acquista";

// "DVR nuovo (una sede, fino a 15 addetti)" → titolo + precisazione su una riga a parte.
const spezza = (t: string) => {
  const m = t.match(/^(.*?)\s*\((.*)\)\s*$/);
  return m ? { t: m[1], extra: m[2] } : { t, extra: "" };
};
const scontoMax = Math.max(...offerte.map(sconto));

const fatti = [
  { k: "Offerte", v: String(offerte.length), d: "corsi, documenti e consulenze" },
  { k: "Risposta", v: "2 gg", d: "lavorativi per la conferma" },
  { k: "Pagamento", v: "Dopo", d: "nessun addebito alla richiesta" },
  { k: "Primo ordine", v: `fino a −${scontoMax}%`, d: "rispetto al listino" },
];

const passi = [
  { t: "Scegli e invii la richiesta", d: "Prezzi IVA esclusa, con il totale sempre in vista. Compili il modulo d’ordine: nessun pagamento in questo momento." },
  { t: "Ti confermiamo il passo successivo", d: "Entro 2 giorni lavorativi ti scriviamo: data del corso, verifica che l’offerta sia adatta, richiesta del brief, istruzioni di pagamento." },
  { t: "Erogazione e fattura", d: "Una persona segue la tua pratica dall’inizio alla fine; la fattura elettronica arriva via SDI. Gli attestati dei corsi solo dopo registro e verifica." },
];

const verifica = [
  "iCuraImpresa S.r.l., P.IVA 09078161214, sede operativa a Napoli, Corso Secondigliano 236",
  "Certificazione ISO 45001 (TNV) per progettazione ed erogazione di corsi di formazione e consulenza",
  "Fattura elettronica per ogni ordine; nessun rinnovo automatico; prezzi senza costi nascosti",
  "Ogni scheda dice che cosa è incluso, che cosa no e le condizioni di annullamento",
];

const faq = [
  { q: "Perché vedo due prezzi?", a: "Il prezzo barrato è il listino. Il prezzo in evidenza vale per il primo ordine dal sito di ogni cliente (stessa partita IVA, codice fiscale o email): dal secondo ordine si applica il listino. Non ci sono altri sconti né promozioni a tempo." },
  { q: "Pago subito online?", a: "No. Invii la richiesta d’ordine, noi verifichiamo disponibilità e adeguatezza e ti mandiamo conferma e istruzioni di pagamento. Per bonifico e fattura a 30 giorni sui contratti annuali chiedi un preventivo dalla pagina Contatti." },
  { q: "Sono un privato, posso acquistare?", a: "Sì. Per i privati valgono le tutele del Codice del Consumo, compreso il diritto di recesso entro 14 giorni dove applicabile." },
  { q: "Come ricevo la fattura?", a: "Via SDI, al codice destinatario o alla PEC che indichi; la copia di cortesia arriva per email." },
  { q: "E se devo annullare?", a: "Ogni scheda dice entro quando il rimborso è integrale (per esempio 7 giorni prima di un corso, 24 ore prima di una consulenza). Scrivici o chiamaci: i casi fuori termine li valuta una persona." },
];
---

<Base
  title="Acquista online: corsi, consulenze e documenti a prezzo chiaro"
  crumb="Acquista online"
  description="Corsi sulla sicurezza con attestato, consulenze in videochiamata e documenti a prezzo fisso (DVR, DUVRI, HACCP, privacy). Prezzi IVA esclusa, cosa è incluso, cosa succede dopo."
>
  {/* ───── HERO: titolo, dati in breve e i cinque reparti ───── */}
  <header class="shop-hero section--ink" aria-labelledby="shop-heading">
    <DotGrid />
    <div class="container">
      <div class="shop-hero__top">
        <div>
          <h1 id="shop-heading" class="shop-hero__title">Sicurezza a <span class="accent">prezzo chiaro.</span></h1>
          <p class="shop-hero__lede">
            Corsi con attestato, documenti e consulenze. Apri la scheda e sai subito che cosa ricevi, in quanto tempo e a quanto. Invii la richiesta: il pagamento si concorda dopo.
          </p>
        </div>
        <dl class="shop-facts">
          {fatti.map((f) => (
            <div class="shop-facts__row">
              <dt>{f.k}</dt>
              <dd><strong>{f.v}</strong><span>{f.d}</span></dd>
            </div>
          ))}
        </dl>
      </div>

      <nav class="shop-depts" aria-label="Reparti del catalogo">
        <p class="shop-depts__label">Scegli il reparto</p>
        <ul>
          {catalogo.map((c) => (
            <li>
              <a href="#catalogo" class="shop-dept" data-cat={c.id} data-shop-cat={c.id}>
                <span class="shop-dept__name">{c.label}</span>
                <span class="shop-dept__meta">{c.offerte.length} offerte · da {euro(c.daPrezzo)}<span class="shop-dept__arrow" aria-hidden="true">→</span></span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  {/* ───── CATALOGO ───── */}
  <section id="catalogo" class="catalog" aria-labelledby="catalog-heading" data-shop>
    <h2 id="catalog-heading" class="sr-only">Catalogo</h2>

    {/* barra che resta in alto mentre si scorre: reparti + ricerca */}
    <div class="catalog__bar">
      <div class="container catalog__bar-inner">
        <div class="catalog__tabs" role="group" aria-label="Filtra per reparto">
          <button type="button" class="shop-tab" data-shop-tab="" aria-pressed="true">
            Tutto <span class="shop-tab__n">{offerte.length}</span>
          </button>
          {catalogo.map((c) => (
            <button type="button" class="shop-tab" data-cat={c.id} data-shop-tab={c.id} aria-pressed="false">
              <span class="shop-tab__dot" aria-hidden="true"></span>{c.breve} <span class="shop-tab__n">{c.offerte.length}</span>
            </button>
          ))}
        </div>
        <label class="catalog__search">
          <span class="sr-only">Cerca nel catalogo</span>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input type="search" placeholder="Cerca: DVR, antincendio, HACCP…" data-shop-q />
        </label>
      </div>
    </div>

    <div class="container">
      <p class="catalog__summary">
        <span data-shop-summary aria-live="polite">{offerte.length} offerte in {catalogo.length} reparti</span>
        <button type="button" class="catalog__reset" data-shop-reset hidden>Azzera i filtri ×</button>
      </p>

      <div class="catalog__depts">
        {catalogo.map((c) => (
          <section class="dept" id={`reparto-${c.id}`} data-cat={c.id} data-dept aria-labelledby={`dept-${c.id}`}>
            <header class="dept__head">
              <span class="dept__icon"><ShopIcon name={c.icona} /></span>
              <div class="dept__txt">
                <h3 id={`dept-${c.id}`} class="dept__title">{c.label}</h3>
                <p class="dept__desc">{c.desc}</p>
              </div>
              <p class="dept__meta"><strong data-dept-count>{c.offerte.length}</strong> offerte<span>da {euro(c.daPrezzo)} + IVA</span></p>
            </header>

            <ul class="dept__grid">
              {c.offerte.map((o) => {
                const { t, extra } = spezza(o.titolo);
                const sc = sconto(o);
                return (
                  <li class="prod" data-cat={c.id} data-slug={o.slug} data-text={`${o.titolo} ${o.lede} ${tipi[o.tipo].label} ${c.label}`.toLowerCase()}>
                    <a href={`/acquista/${o.slug}`} class="prod__link">
                      <span class="prod__head">
                        <span class="prod__tipo">{tipi[o.tipo].label}</span>
                        {sc > 0 && <span class="prod__sconto" title="Prezzo del primo ordine dal sito">−{sc}%</span>}
                      </span>
                      <span class="prod__titolo">{t}</span>
                      {extra && <span class="prod__extra">{extra}</span>}
                      <span class="prod__lede">{o.lede}</span>
                      <dl class="prod__spec">
                        {scheda(o).map((r) => (
                          <div><dt>{r.k}</dt><dd>{r.v}</dd></div>
                        ))}
                      </dl>
                      <span class="prod__foot">
                        <span class="prod__prezzo">
                          <strong>{euro(o.prezzo)}</strong>
                          {o.listino > o.prezzo && <s>{euro(o.listino)}</s>}
                          <small>+ IVA · a {o.unita}</small>
                        </span>
                        <span class="prod__go" aria-hidden="true">→</span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>

      <p class="catalog__empty" data-shop-empty hidden>
        Nessuna offerta corrisponde. Prova con un’altra parola, oppure <a href="/contatti">scrivici che cosa cerchi</a>.
      </p>
      <p class="catalog__note">Prezzi IVA esclusa. Il prezzo in evidenza vale per il primo ordine dal sito; il barrato è il listino.</p>
    </div>
  </section>

  <section class="section how section--ink" aria-labelledby="how-heading">
    <DotGrid />
    <div class="container how__grid">
      <div>
        <h2 id="how-heading" class="how__title">Tre passi, nessuna sorpresa.</h2>
      </div>
      <ol class="how__list">
        {passi.map((p, i) => (
          <li class="how__item">
            <span class="how__n">{i + 1}</span>
            <h3 class="how__t">{p.t}</h3>
            <p class="how__d">{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="verifica-heading">
    <div class="container two-col">
      <div class="two-col__head">
        <h2 id="verifica-heading" class="two-col__title">Quello che puoi verificare.</h2>
      </div>
      <ul class="verify">
        {verifica.map((v) => (
          <li>
            <svg class="verify__tick" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
            {v}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faq} name="faq-acquista" tone="alt" />

  <CtaBand
    title="Non trovi quello che ti serve?"
    lede="Contratti annuali, più sedi, corsi su misura: ti prepariamo un preventivo scritto."
    primary={{ href: "/contatti", label: "Chiedi un preventivo" }}
    secondary={{ href: "tel:+390816580779", label: "Chiama 081 658 0779" }}
    labelledby="acquista-cta-heading"
  />
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-shop]").forEach((root) => {
    const items = Array.from(root.querySelectorAll<HTMLElement>(".prod"));
    const depts = Array.from(root.querySelectorAll<HTMLElement>("[data-dept]"));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-shop-tab]"));
    const q = root.querySelector<HTMLInputElement>("[data-shop-q]")!;
    const empty = root.querySelector<HTMLElement>("[data-shop-empty]")!;
    const summary = root.querySelector<HTMLElement>("[data-shop-summary]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-shop-reset]")!;
    const heroLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-shop-cat]"));

    const state = { cat: "", q: "" };
    const matches = (el: HTMLElement) =>
      state.q.toLowerCase().trim().split(/\s+/).filter(Boolean).every((w) => el.dataset.text!.includes(w));

    const apply = () => {
      let n = 0;
      for (const el of items) {
        const ok = (!state.cat || el.dataset.cat === state.cat) && matches(el);
        el.hidden = !ok;
        if (ok) n++;
      }
      // Un reparto senza offerte visibili sparisce; il numero nell'intestazione segue la ricerca.
      for (const d of depts) {
        const k = d.querySelectorAll(".prod:not([hidden])").length;
        d.hidden = k === 0;
        d.querySelector("[data-dept-count]")!.textContent = String(k);
      }
      // Ogni linguetta dice quante offerte darebbe con la ricerca in corso.
      for (const t of tabs) {
        const v = t.dataset.shopTab!;
        const k = items.filter((el) => (!v || el.dataset.cat === v) && matches(el)).length;
        t.querySelector(".shop-tab__n")!.textContent = String(k);
        t.setAttribute("aria-pressed", String(state.cat === v));
        t.disabled = k === 0 && state.cat !== v;
      }
      empty.hidden = n > 0;
      summary.textContent =
        n === items.length ? `${n} offerte in ${depts.length} reparti` : `${n} ${n === 1 ? "offerta" : "offerte"} su ${items.length}`;
      reset.hidden = !(state.cat || state.q.trim());
    };

    // Lo stato sta nell'URL: tornando indietro da una scheda prodotto i filtri restano.
    const sync = () => {
      const p = new URLSearchParams();
      if (state.cat) p.set("reparto", state.cat);
      if (state.q.trim()) p.set("q", state.q.trim());
      const s = p.toString();
      history.replaceState(null, "", location.pathname + (s ? `?${s}` : "") + location.hash);
    };
    const set = (patch: Partial<typeof state>) => {
      Object.assign(state, patch);
      apply();
      sync();
    };
    // Se la barra è già agganciata in alto, si torna all'inizio del catalogo.
    const toTop = () => {
      const y = root.getBoundingClientRect().top + scrollY;
      if (scrollY > y) scrollTo({ top: y, behavior: "smooth" });
    };

    for (const t of tabs) t.addEventListener("click", () => { set({ cat: t.dataset.shopTab! }); toTop(); });
    for (const a of heroLinks) a.addEventListener("click", (e) => {
      e.preventDefault();
      set({ cat: a.dataset.shopCat! });
      scrollTo({ top: root.getBoundingClientRect().top + scrollY, behavior: "smooth" });
    });
    q.addEventListener("input", () => set({ q: q.value }));
    reset.addEventListener("click", () => { q.value = ""; set({ cat: "", q: "" }); });

    // Stato iniziale dall'URL (si ignorano valori che non esistono).
    const params = new URLSearchParams(location.search);
    const cat = params.get("reparto") ?? "";
    state.cat = tabs.some((t) => t.dataset.shopTab === cat) ? cat : "";
    state.q = params.get("q") ?? "";
    q.value = state.q;
    apply();
  });
</script>

<style>
  /* Colore di ogni reparto: campi pieni in hero, pallini dei filtri, icona del reparto */
  [data-cat="formazione"] { --cat: #0e7490; }
  [data-cat="documenti"] { --cat: #1d4ed8; }
  [data-cat="haccp"] { --cat: #047857; }
  [data-cat="privacy"] { --cat: #be123c; }
  [data-cat="consulenze"] { --cat: #b45309; }

  /* ───── Hero ───── */
  .shop-hero { position: relative; isolation: isolate; overflow: clip; padding-block: var(--space-2xl); }
  .shop-hero__top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--space-2xl); align-items: end; }
  .shop-hero__title { font-size: clamp(2.4rem, 1.2rem + 4vw, 4.75rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1; margin: 0 0 var(--space-md); }
  .shop-hero__lede { font-size: var(--text-lg); line-height: 1.55; max-width: 50ch; margin: 0; color: color-mix(in srgb, var(--color-paper) 80%, transparent); }

  /* dati in breve: un riquadro pieno, quattro dati in griglia separati solo dallo spazio */
  .shop-facts {
    margin: 0; padding: var(--space-lg);
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg) var(--space-md);
    border-radius: var(--radius-lg);
    background: #16213a;
  }
  .shop-facts__row { display: flex; flex-direction: column; gap: 0.3rem; }
  .shop-facts dt { font-size: var(--text-sm); font-weight: 600; color: #93c5fd; }
  .shop-facts dd { margin: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .shop-facts strong { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; color: #fff; letter-spacing: -0.01em; }
  .shop-facts span { font-size: var(--text-sm); color: #cbd5e1; }

  /* i cinque reparti: campi di colore pieno, il nome grande */
  .shop-depts { margin-top: var(--space-2xl); }
  .shop-depts__label { margin: 0 0 var(--space-sm); font-size: var(--text-md); font-weight: 600; color: #cbd5e1; }
  .shop-depts ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-sm); }
  .shop-dept {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.4rem; height: 100%; min-height: 9.5rem;
    padding: var(--space-md); border-radius: var(--radius-lg);
    background: var(--cat);
    color: #fff; text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .shop-dept:hover, .shop-dept:focus-visible { transform: translateY(-4px); background: color-mix(in srgb, var(--cat) 82%, white); text-decoration: none; }
  .shop-dept:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .shop-dept__name { font-family: var(--font-display); font-weight: 650; font-size: clamp(1.125rem, 0.8rem + 0.7vw, 1.4rem); line-height: 1.12; letter-spacing: -0.015em; }
  .shop-dept__meta { display: flex; align-items: center; gap: 0.5rem; font-size: var(--text-sm); color: rgba(255, 255, 255, 0.88); }
  .shop-dept__arrow { margin-left: auto; font-size: var(--text-lg); color: #fff; transition: transform var(--dur-fast) var(--ease-out); }
  .shop-dept:hover .shop-dept__arrow { transform: translateY(3px) rotate(90deg); }

  /* ───── Catalogo ───── */
  .catalog { background: var(--color-paper-2); padding-bottom: var(--space-3xl); }
  /* barra fissa piena: la sfocatura resta solo all'header */
  .catalog__bar { position: sticky; top: var(--header-h); z-index: 20; background: var(--color-paper); }
  .catalog__bar-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); padding-block: 0.75rem; }
  .catalog__tabs { display: flex; gap: 0.35rem; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .catalog__tabs::-webkit-scrollbar { display: none; }
  .shop-tab {
    flex: none; display: inline-flex; align-items: center; gap: 0.45em;
    font: inherit; font-size: var(--text-sm); font-weight: 500;
    padding: 0.55em 1em; border: 0; border-radius: 999px;
    background: var(--color-paper-3); color: var(--color-ink);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .shop-tab:hover:not(:disabled) { background: color-mix(in srgb, var(--cat, var(--color-accent)) 16%, var(--color-paper-3)); }
  .shop-tab[aria-pressed="true"] { background: var(--color-ink); color: #fff; }
  .shop-tab:disabled { opacity: 0.4; cursor: not-allowed; }
  .shop-tab__dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--cat); }
  .shop-tab__n { font-variant-numeric: tabular-nums; opacity: 0.6; }
  .catalog__search {
    flex: 0 0 18rem; display: flex; align-items: center; gap: var(--space-xs);
    padding: 0 var(--space-sm); background: var(--color-paper-3);
    border-radius: 999px; color: var(--color-ink-2);
  }
  .catalog__search:focus-within { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .catalog__search svg { width: 1.05rem; height: 1.05rem; flex: none; }
  .catalog__search input { flex: 1; min-width: 0; border: 0; background: none; padding: 0.65rem 0; font: inherit; font-size: var(--text-md); color: var(--color-ink); outline: none; }
  .catalog__search input::placeholder { color: var(--color-muted); }

  .catalog__summary { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2xs) var(--space-md); margin: var(--space-lg) 0 var(--space-md); font-size: var(--text-md); color: var(--color-ink-2); }
  .catalog__reset { font: inherit; background: none; border: 0; color: var(--color-accent); font-weight: 600; cursor: pointer; }
  .catalog__reset[hidden] { display: none; }

  /* ───── Reparto ───── */
  .catalog__depts { display: grid; gap: var(--space-2xl); }
  .dept[hidden] { display: none; }
  .dept { scroll-margin-top: calc(var(--header-h) + 5rem); }
  .dept__head {
    display: grid; grid-template-columns: auto 1fr auto; gap: var(--space-md) var(--space-lg); align-items: center;
    margin-bottom: var(--space-md);
  }
  .dept__icon { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 14px; color: #fff; background: var(--cat); --icon-size: 1.7rem; }
  .dept__title { margin: 0; font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .dept__desc { margin: 0.35rem 0 0; font-size: var(--text-md); color: var(--color-ink-2); max-width: 70ch; line-height: 1.5; }
  .dept__meta { margin: 0; text-align: right; font-size: var(--text-md); color: var(--color-ink-2); white-space: nowrap; }
  .dept__meta strong { font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-ink); margin-right: 0.25rem; }
  .dept__meta span { display: block; font-size: var(--text-sm); color: var(--color-ink-2); }

  /* ───── Card prodotto: una scheda tecnica, bianca sul grigio ───── */
  .dept__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
  .prod[hidden] { display: none; }
  .prod__link {
    position: relative; display: flex; flex-direction: column; height: 100%;
    padding: var(--space-lg);
    background: var(--color-surface); border-radius: 14px;
    color: var(--color-ink); text-decoration: none;
    outline: 2px solid transparent; outline-offset: -2px;
    transition: outline-color var(--dur-fast) var(--ease-out), transform 300ms var(--ease-out);
  }
  .prod__link:hover, .prod__link:focus-visible { outline-color: var(--cat); transform: translateY(-3px); text-decoration: none; }
  .prod__head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: var(--space-sm); }
  .prod__tipo { font-size: var(--text-sm); font-weight: 600; color: var(--cat); }
  .prod__sconto { margin-left: auto; font-size: var(--text-sm); font-weight: 700; padding: 0.25rem 0.55rem; border-radius: 6px; color: #166534; background: #dcfce7; }
