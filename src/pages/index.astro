---
import Base from "@layouts/Base.astro";
import ServiceIcon from "@components/ServiceIcon.astro";
import BandiInEvidenza from "@components/BandiInEvidenza.astro";

// Macro-aree (griglia servizi): foto reali + icona + link alle pagine servizio.
const servizi = [
  {
    titolo: "Consulenza e Sicurezza",
    slogan: "Tu scegli la meta. Insieme costruiamo il percorso. Proteggi ciò che conta.",
    desc: "Mettiamo a fuoco le esigenze della tua impresa e definiamo insieme priorità, scelte e azioni concrete: organizzazione e deleghe di funzioni, modelli 231, privacy, ambiente. Un interlocutore unico che conosce la tua azienda e ti accompagna nelle decisioni. Persone, ambienti e attività: ti affianchiamo nella valutazione dei rischi e nell’organizzazione della prevenzione, perché la sicurezza diventi parte del lavoro di ogni giorno. Quando arriva un’ispezione, trova un sistema che funziona, non una pila di carte.",
    comprende: ["Consulenza aziendale e organizzativa", "GDPR, privacy e cybersecurity", "Ambiente", "Sicurezza sul lavoro (D.Lgs. 81/08)", "Sicurezza nei cantieri e patente a crediti", "Sicurezza alimentare HACCP", "Medicina del lavoro"],
    href: "/servizi/consulenza",
    icon: "consulenza",
    img: "/images/macroaree-consulenza.webp",
    alt: "Consulenza e sicurezza sul lavoro iCura Impresa",
    dark: false,
  },
  {
    titolo: "Engineering",
    slogan: "Costruisci su basi sicure.",
    desc: "Dal rilievo 3D con scanner laser alla progettazione degli spazi e degli impianti, fino alla prevenzione incendi, colleghiamo esigenze operative e competenze tecniche: una sola squadra, un solo responsabile per ogni pratica, dal progetto al collaudo.",
    comprende: ["Progettazione edile e impiantistica", "Rilievi 3D e nuvole di punti", "Prevenzione incendi e CPI", "Direzione lavori, collaudi e perizie", "Pratiche autorizzative"],
    href: "/servizi/engineering",
    icon: "engineering",
    img: "/images/macroaree-engineering.webp",
    alt: "Engineering e prevenzione incendi iCura Impresa",
    dark: true,
  },
  {
    titolo: "Formazione",
    slogan: "Il futuro cresce con le persone.",
    desc: "Percorsi formativi per sviluppare competenze utili, affrontare nuove responsabilità e accompagnare l’evoluzione dell’impresa. In aula, a distanza o in azienda, senza fermare il lavoro. E, quando i requisiti lo consentono, con i fondi che hai già versato.",
    comprende: ["Formazione obbligatoria (Accordo Stato-Regioni 17/04/2025)", "Aula, a distanza, in azienda", "Fondi interprofessionali", "Attestati e registri"],
    href: "/servizi/formazione",
    icon: "formazione",
    img: "/images/macroaree-formazione.webp",
    alt: "Formazione sicurezza in aula iCura Impresa",
    dark: false,
  },
] as const;
const serviziWide = [
  {
    titolo: "Sistemi di Gestione",
    slogan: "Dai valore a come lavori.",
    desc: "Ti aiutiamo a organizzare processi e responsabilità, a sviluppare sistemi di gestione che lavorano ogni giorno e ad affrontare i percorsi di certificazione e di qualificazione per le gare. La certificazione la rilascia l’organismo: noi ti accompagniamo fino a lì.",
    comprende: ["ISO 9001 — Qualità", "ISO 14001 — Ambiente", "ISO 45001 — Salute e sicurezza", "ISO 27001 — Sicurezza delle informazioni", "ISO 37001 — Anticorruzione", "Parità di genere UNI/PdR 125", "Attestazione SOA"],
    href: "/servizi/certificazioni",
    icon: "certificazioni",
    img: "/images/macroaree-certificazioni.webp",
    alt: "Certificazioni ISO e attestazione SOA iCura Impresa",
    dark: true,
  },
  {
    titolo: "Finanza Agevolata",
    slogan: "Dai risorse alle tue idee.",
    desc: "Individuiamo le opportunità compatibili con i tuoi progetti e ti accompagniamo nella verifica dei requisiti, nella preparazione delle domande e nella rendicontazione. Ogni bando è un percorso con regole e scadenze: lo seguiamo con te dall’inizio alla fine.",
    comprende: ["Bando ISI INAIL", "ZES Unica Mezzogiorno", "Iper-ammortamento 2026–2028", "Fondi interprofessionali per la formazione"],
    href: "/servizi/finanza-agevolata",
    icon: "finanza-agevolata",
    img: "/images/macroaree-finanza-agevolata.webp",
    alt: "Finanza agevolata e bandi iCura Impresa",
    dark: false,
  },
] as const;

const team = [
  { img: "/images/sicurezza-ispezione-capannone.webp", alt: "Area sicurezza e D.Lgs. 81/08 iCura Impresa", h: "Sicurezza sul Lavoro", k: "D.Lgs. 81/08 · Cantieri · HACCP" },
  { img: "/images/consulenza-medicina-lavoro.webp", alt: "Area medicina del lavoro iCura Impresa", h: "Medicina del lavoro", k: "Sorveglianza sanitaria" },
  { img: "/images/formazione-aula-adulti.webp", alt: "Area formazione iCura Impresa", h: "Formazione", k: "Aula · A distanza · In azienda" },
  { img: "/images/chi-siamo-riunione-team.webp", alt: "Area engineering iCura Impresa", h: "Engineering", k: "Progettazione · Prevenzione incendi · Collaudi" },
];

// Come lavoriamo (testi del cliente).
const passi = [
  { t: "Ti ascoltiamo", d: "Veniamo in azienda, guardiamo e ascoltiamo: dove vuoi arrivare e che cosa ti frena." },
  { t: "Definiamo le priorità", d: "Che cosa serve subito, che cosa può aspettare, che cosa si può finanziare." },
  { t: "Costruiamo il progetto", d: "Responsabili, date, documenti e formazione: un piano chiaro, con nome e cognome." },
  { t: "Ti affianchiamo nel tempo", d: "Scadenze, verifiche, ispezioni, bandi: restiamo al tuo fianco quando cambia qualcosa." },
];
---

<Base
  title="Consulenza e sicurezza sul lavoro a Napoli"
  description="iCuraImpresa, Napoli: consulenza aziendale, sicurezza sul lavoro, formazione, engineering, certificazioni ISO, digitale e finanza agevolata. Un solo referente."
  pageClass="page-home"
>
  {/* ───── HERO SPLIT ───── */}
  <section class="hero">
    <div class="container">
      <div class="hero__card">
        <div class="hero__media group">
          <img
            src="/images/sicurezza-ispezione-capannone.webp"
            alt="Tecnico iCura Impresa durante un sopralluogo di sicurezza in un capannone industriale"
          />
          <div class="hero__media-veil" aria-hidden="true"></div>
        </div>

        <div class="hero__panel">
          <span class="hero__brand">
            <img
              class="hero__brand-mark"
              src="/images/brand/logo-icura-white.webp"
              alt=""
              width="460"
              height="600"
              decoding="async"
              aria-hidden="true"
            />
            <span class="hero__brand-name">i<strong>Cura</strong>Impresa</span>
          </span>
          <h1 class="hero__title">
            Realizza <span class="accent">l’azienda dei tuoi sogni.</span>
          </h1>
          <p class="hero__lede">
            Sicurezza sul lavoro, formazione, certificazioni ISO, engineering, digitale e finanza agevolata
            per le imprese. A Napoli e in Campania, con un referente che risponde con nome e cognome;
            certificazioni e bandi in tutta Italia.
          </p>
          <p class="hero__lede hero__lede--sub">
            Proteggi le persone. Fai crescere le competenze. Dai forza ai tuoi progetti.
          </p>

          <div class="hero__ctas">
            <a href="/contatti" class="hero__cta-primary">Parliamo della tua impresa</a>
            <a href="#servizi" class="hero__cta-link">
              Esplora le aree
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <dl class="hero__metrics">
            <div class="metric">
              <dt class="metric__n">Dal 2014</dt>
              <dd class="metric__label">a Napoli, S.r.l. dal 2018</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">ISO 9001 dal 2019</dt>
              <dd class="metric__label">e ISO 14001: ciò che chiediamo ai clienti lo applichiamo a noi</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">SOA OG1 III-bis</dt>
              <dd class="metric__label">e abilitazioni impianti D.M. 37/2008, lettere A–G</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">Nove persone</dt>
              <dd class="metric__label">guidate da un ingegnere; un referente per ogni pratica</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">Preventivo scritto</dt>
              <dd class="metric__label">che dice che cosa è compreso e chi fa che cosa</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  {/* ───── STRIP AGEVOLAZIONI ───── */}
  <section class="strip" aria-labelledby="strip-heading">
    <div class="container strip__inner">
      <div class="strip__msg">
        <span class="strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </span>
        <div>
          <p class="strip__kicker">Bandi, scadenze e regole</p>
          <p id="strip-heading" class="strip__title">Bando ISI INAIL, ZES Unica Mezzogiorno, Iper-ammortamento 2026–2028</p>
        </div>
      </div>
      <a href="/servizi/finanza-agevolata" class="strip__cta">Scopri la finanza agevolata</a>
    </div>
  </section>

  {/* ───── GRIGLIA SERVIZI ───── */}
  <section id="servizi" class="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="services__head">
        <div>
          <p class="eyebrow">Le aree</p>
          <h2 id="services-heading" class="services__title">Una squadra <span class="italic">intorno</span> alla tua impresa.</h2>
        </div>
        <p class="services__note">
          Al centro ci sei tu, con la tua impresa. Intorno, le competenze di iCuraImpresa che lavorano
          insieme per i tuoi obiettivi: scegli un’area per scoprirla.
        </p>
      </div>

      <div class="services__grid">
        {servizi.map((s) => (
          <a href={s.href} class={`svc-card group${s.dark ? " svc-card--dark" : ""}`}>
            <span class="svc-card__top" aria-hidden="true">
              <span class="svc-card__icon"><ServiceIcon name={s.icon} /></span>
              <svg class="svc-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </span>
            <h3 class="svc-card__title">{s.titolo}</h3>
            <p class="svc-card__slogan">{s.slogan}</p>
            <p class="svc-card__desc">{s.desc}</p>
            <p class="svc-card__desc"><strong>Che cosa comprende:</strong> {s.comprende.join(" · ")}</p>
            <img src={s.img} alt={s.alt} class="svc-card__img media-grayscale" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>

      <div class="services__grid services__grid--wide">
        {serviziWide.map((s) => (
          <a href={s.href} class={`svc-card svc-card--row group${s.dark ? " svc-card--dark" : ""}`}>
            <span class="svc-card__body">
              <span class="svc-card__top" aria-hidden="true">
                <span class="svc-card__icon"><ServiceIcon name={s.icon} /></span>
                <svg class="svc-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </span>
              <h3 class="svc-card__title">{s.titolo}</h3>
              <p class="svc-card__slogan">{s.slogan}</p>
              <p class="svc-card__desc">{s.desc}</p>
            <p class="svc-card__desc"><strong>Che cosa comprende:</strong> {s.comprende.join(" · ")}</p>
            </span>
            <img src={s.img} alt={s.alt} class="svc-card__img svc-card__img--row media-grayscale" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>

      <a href="/servizi/digitale" class="services__more">
        <span class="services__more-body">
          <span class="services__more-title">Digitale e IA</span>
          <span class="services__more-slogan">Dai forma digitale al tuo metodo.</span>
          <span class="services__more-desc">Processi digitalizzati, app e gestionali su misura costruiti con l’intelligenza artificiale, integrati con sistemi di gestione e consulenza.</span>
        </span>
        <span class="services__more-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  {/* ───── BANDI, SCADENZE E RISPOSTE ───── */}
  <BandiInEvidenza />

  {/* ───── COME LAVORIAMO ───── */}
  <section class="why section--ink" aria-labelledby="why-heading">
    <div class="container why__grid">
      <div class="why__body">
        <p class="eyebrow">Come lavoriamo</p>
        <h2 id="why-heading" class="why__title">I tuoi obiettivi sono la <span class="accent">nostra passione.</span></h2>
        <p class="why__lede">Partiamo da ciò che vuoi realizzare. Mettiamo a fuoco le esigenze, colleghiamo le competenze e costruiamo insieme i prossimi passi.</p>
        <ol class="why__list">
          {passi.map((p, i) => (
            <li class="why__item">
              <span class="why__n">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="why__item-title">{p.t}</h3>
                <p class="why__item-desc">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="why__note"><strong>Sicura. Certificata. Finanziata.</strong> Il nostro impegno: attività, responsabilità e scadenze definite prima di iniziare.</p>
      </div>
      <div class="why__media">
        <img src="/images/chi-siamo-riunione-team.webp" alt="Team di consulenti iCura Impresa in riunione operativa" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ───── TEAM ───── */}
  <section class="team section--alt" aria-labelledby="team-heading">
    <div class="container">
      <div class="team__head">
        <p class="eyebrow">Le persone</p>
        <h2 id="team-heading" class="team__title">Una squadra di competenze costruita intorno alla tua impresa.</h2>
        <p class="team__lede">Ingegneri, tecnici e consulenti che fanno propri i tuoi obiettivi e li portano a compimento. Un referente per ogni pratica, con nome e cognome, dal primo incontro all’ispezione.</p>
      </div>
      <div class="team__grid">
        {team.map((t) => (
          <article class="team-tile group">
            <div class="team-tile__media">
              <img src={t.img} alt={t.alt} class="media-grayscale" loading="lazy" decoding="async" />
            </div>
            <h3 class="team-tile__h">{t.h}</h3>
            <p class="team-tile__k">{t.k}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ───── CONTATTI + FORM ───── */}
  <section class="contact section--ink" aria-labelledby="contact-heading">
    <div class="container contact__grid">
      <div class="contact__intro">
        <p class="eyebrow">Il prossimo passo</p>
        <h2 id="contact-heading" class="contact__title">Raccontaci <span class="accent">dove vuoi</span> arrivare.</h2>
        <p class="contact__lede">
          Un progetto da sviluppare, persone da formare, un’organizzazione da migliorare: iniziamo dalla tua esigenza.
          Il prossimo passo della tua impresa comincia da una conversazione.
        </p>
        <div class="contact__cards">
          <div class="contact__box">
            <span class="contact__box-label">Sede operativa</span>
            <p class="contact__box-value">Corso Secondigliano 236</p>
            <p class="contact__box-sub">80144 Napoli (NA)</p>
          </div>
          <div class="contact__box">
            <span class="contact__box-label">Telefono</span>
            <p class="contact__box-value"><a href="tel:+390816580779">081 658 0779</a></p>
            <p class="contact__box-sub"><a href="mailto:info@icuraimpresa.it">info@icuraimpresa.it</a></p>
          </div>
        </div>
      </div>

      {/* Invio gestito da src/scripts/lead-form.ts → Klaviyo (client-side). */}
      <form class="contact__form" data-lead-form>
        <h3 class="contact__form-title">Raccontaci di che cosa hai bisogno</h3>
        <p class="contact__form-sub">I campi con asterisco (*) sono obbligatori.</p>
        <input type="text" name="company_website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="contact__row">
          <div class="field">
            <label for="cf-nome">Nome e cognome *</label>
            <input id="cf-nome" name="nome" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-azienda">Azienda</label>
            <input id="cf-azienda" name="azienda" type="text" autocomplete="organization" />
          </div>
        </div>
        <div class="field">
          <label for="cf-email">Email *</label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="cf-area">Di che cosa hai bisogno</label>
          <select id="cf-area" name="area">
            <option>Consulenza &amp; Sicurezza</option>
            <option>Engineering &amp; Antincendio</option>
            <option>Formazione</option>
            <option>Certificazioni &amp; Gare</option>
            <option>Finanza agevolata</option>
            <option>Non lo so ancora: parliamone</option>
          </select>
        </div>
        <div class="field">
          <label for="cf-msg">Raccontaci in due righe</label>
          <textarea id="cf-msg" name="messaggio" rows="4"></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="privacy" required />
          <span>Ho letto l’<a href="/privacy">informativa privacy</a> e acconsento al trattamento dei dati per rispondere alla mia richiesta. *</span>
        </label>
        <label class="consent">
          <input type="checkbox" name="marketing" />
          <span>Voglio ricevere avvisi su bandi, scadenze e novità normative (facoltativo, revocabile in ogni momento).</span>
        </label>
        <button type="submit" class="btn btn--primary btn--cta contact__submit">
          Invia la richiesta
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
        <p class="contact__call">Oppure chiama: <a href="tel:+390816580779">081 658 0779</a></p>
        <p class="form-status" data-lead-status role="status" aria-live="polite" hidden></p>

        <div class="form-thanks" data-lead-success role="status" hidden>
          <span class="form-thanks__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </span>
          <span class="form-thanks__title">Grazie<span data-thanks-name></span>!</span>
          <span class="form-thanks__text">Abbiamo ricevuto la tua richiesta: ti rispondiamo noi, per email o per telefono.</span>
        </div>
      </form>
    </div>
  </section>

  <script>
    import "../scripts/lead-form.ts";
  </script>
</Base>

<style>
  /* ───────── HERO (full-bleed, full-screen) ───────── */
  .hero { padding: 0; }
  .hero .container { max-width: none; padding-inline: 0; }
  .hero__card {
    display: grid;
    grid-template-columns: 38% 62%;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
  }
  .hero__media { position: relative; background: var(--color-ink); overflow: hidden; }
  .hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__media-veil {
    position: absolute; inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-ink) 45%, transparent), transparent);
  }
  .hero__panel {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
  }
  .hero__brand { display: inline-flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); }
  .hero__brand-mark { height: 4.25rem; width: auto; }
  .hero__brand-name {
    font-family: var(--font-wordmark); font-weight: 500; font-size: var(--text-2xl);
    letter-spacing: -0.025em; color: var(--color-paper);
  }
  .hero__brand-name strong { font-weight: 800; }
  .hero__title {
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-paper);
    max-width: 16ch;
  }
  .hero__title .accent { color: var(--color-accent); }
  .hero__lede {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-paper) 80%, transparent);
    max-width: 48ch;
  }
  .hero__lede--sub { margin-top: calc(var(--space-sm) * -1); font-weight: 600; color: var(--color-paper); }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); margin-top: var(--space-sm); }
  .hero__cta-primary {
    display: inline-flex; align-items: center;
    padding: 0.9rem 1.8rem;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .hero__cta-primary:hover { background: #fff; color: var(--color-ink); text-decoration: none; }
  .hero__cta-link {
    display: inline-flex; align-items: center; gap: 0.5em;
    color: var(--color-paper); font-weight: 600; font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hero__cta-link:hover { color: var(--color-accent); text-decoration: none; }

  .hero__metrics {
    display: flex; flex-wrap: wrap; gap: var(--space-lg) var(--space-xl);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid color-mix(in srgb, var(--color-paper) 12%, transparent);
  }
  .metric { display: flex; flex-direction: column; gap: 0.2rem; margin: 0; max-width: 15rem; }
  .metric__n { font-family: var(--font-display); font-weight: 700; font-size: var(--text-2xl); color: var(--color-paper); }
  .metric__label {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); margin: 0;
  }

  /* ───────── STRIP AGEVOLAZIONI ───────── */
