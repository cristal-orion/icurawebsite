---
import Base from "@layouts/Base.astro";

// Macro-aree (griglia servizi): foto reali + link alle pagine servizio.
const servizi = [
  {
    titolo: "Consulenza & Sicurezza",
    desc: "DVR, RSPP, D.Lgs. 81/08, cantieri (PSC/POS), HACCP, medicina del lavoro, GDPR e ambiente.",
    href: "/servizi/consulenza",
    img: "/images/macroaree-consulenza.webp",
    alt: "Consulenza e sicurezza sul lavoro iCura Impresa",
    dark: false,
  },
  {
    titolo: "Engineering & Antincendio",
    desc: "Progettazione edile e impiantistica, prevenzione incendi e CPI, collaudi e perizie tecniche.",
    href: "/servizi/engineering",
    img: "/images/macroaree-engineering.webp",
    alt: "Engineering e prevenzione incendi iCura Impresa",
    dark: true,
  },
  {
    titolo: "Formazione",
    desc: "Corsi in aula ed e-learning: RSPP/RLS/preposti, antincendio e primo soccorso, attrezzature.",
    href: "/servizi/formazione",
    img: "/images/macroaree-formazione.webp",
    alt: "Formazione sicurezza in aula iCura Impresa",
    dark: false,
  },
];
const serviziWide = [
  {
    titolo: "Certificazioni & Gare",
    desc: "ISO 9001/14001/45001, parità di genere UNI/PdR 125, Attestazione SOA per le gare d'appalto.",
    href: "/servizi/certificazioni",
    img: "/images/macroaree-certificazioni.webp",
    alt: "Certificazioni ISO e attestazione SOA iCura Impresa",
    dark: true,
  },
  {
    titolo: "Finanza agevolata",
    desc: "Bando ISI INAIL, ZES Unica, Transizione 5.0, fondi interprofessionali e OT23.",
    href: "/servizi/finanza-agevolata",
    img: "/images/macroaree-finanza-agevolata.webp",
    alt: "Finanza agevolata e bandi iCura Impresa",
    dark: false,
  },
];

const team = [
  { img: "/images/team-icura.webp", alt: "Area sicurezza e D.Lgs. 81/08 iCura Impresa", h: "Sicurezza & 81/08", k: "RSPP · DVR · Cantieri" },
  { img: "/images/consulenza-medicina-lavoro.webp", alt: "Area medicina del lavoro iCura Impresa", h: "Medicina del lavoro", k: "Medico competente · Idoneità" },
  { img: "/images/formazione-aula-adulti.webp", alt: "Area formazione iCura Impresa", h: "Formazione", k: "Aula · E-learning · Attestati" },
  { img: "/images/chi-siamo-riunione-team.webp", alt: "Area engineering iCura Impresa", h: "Engineering", k: "Progettazione · CPI · Collaudi" },
];
---

<Base
  title="iCura Impresa"
  description="Un solo interlocutore per la sicurezza, la formazione, l'engineering, la finanza agevolata e le certificazioni della tua impresa. Napoli, dal 2014."
  pageClass="page-home"
>
  {/* ───── HERO SPLIT ───── */}
  <section class="hero">
    <div class="container">
      <div class="hero__card">
        <div class="hero__media group">
          <img
            src="/images/sicurezza-ispezione-capannone.webp"
            alt="Tecnico iCura Impresa durante un sopralluogo di sicurezza in un capannone industriale"
            class="media-grayscale"
          />
          <div class="hero__media-veil" aria-hidden="true"></div>
        </div>

        <div class="hero__panel">
          <span class="hero__brand">
            <img
              class="hero__brand-mark"
              src="/images/brand/logo-icura-white.webp"
              alt=""
              width="460"
              height="600"
              decoding="async"
              aria-hidden="true"
            />
            <span class="hero__brand-name">iCura Impresa</span>
          </span>
          <h1 class="hero__title">
            Un solo interlocutore <span class="accent">per la sicurezza</span> della tua impresa.
          </h1>
          <p class="hero__lede">
            Sicurezza sul lavoro, formazione, engineering, finanza agevolata e certificazioni.
            Un unico team multidisciplinare, dal 2014.
          </p>

          <div class="hero__ctas">
            <a href="/contatti" class="hero__cta-primary">Richiedi una consulenza</a>
            <a href="/servizi/consulenza" class="hero__cta-link">
              I nostri servizi
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <dl class="hero__metrics">
            <div class="metric">
              <dt class="metric__n">2014</dt>
              <dd class="metric__label">Anno di fondazione</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">5</dt>
              <dd class="metric__label">Aree integrate</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">48h</dt>
              <dd class="metric__label">Risposta media</dd>
            </div>
            <div class="metric">
              <dt class="metric__n">100+</dt>
              <dd class="metric__label">Imprese servite</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  {/* ───── STRIP AGEVOLAZIONI ───── */}
  <section class="strip" aria-labelledby="strip-heading">
    <div class="container strip__inner">
      <div class="strip__msg">
        <span class="strip__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </span>
        <div>
          <p class="strip__kicker">Agevolazioni in scadenza</p>
          <p id="strip-heading" class="strip__title">Bandi e incentivi 2026 — ZES Unica, Bando ISI INAIL, Transizione 5.0</p>
        </div>
      </div>
      <a href="/servizi/finanza-agevolata" class="strip__cta">Scopri le scadenze</a>
    </div>
  </section>

  {/* ───── GRIGLIA SERVIZI ───── */}
  <section class="services" aria-labelledby="services-heading">
    <div class="container">
      <div class="services__head">
        <div>
          <p class="eyebrow">Le nostre aree</p>
          <h2 id="services-heading" class="services__title">Tutto in regola, <span class="italic">in un posto</span> solo.</h2>
        </div>
        <p class="services__note">
          Cinque aree che si parlano tra loro: dalla sicurezza sul lavoro alla finanza agevolata,
          gestite da un unico team multidisciplinare.
        </p>
      </div>

      <div class="services__grid">
        {servizi.map((s) => (
          <a href={s.href} class={`svc-card group${s.dark ? " svc-card--dark" : ""}`}>
            <span class="svc-card__top" aria-hidden="true">
              <span class="svc-card__rule"></span>
              <svg class="svc-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </span>
            <h3 class="svc-card__title">{s.titolo}</h3>
            <p class="svc-card__desc">{s.desc}</p>
            <img src={s.img} alt={s.alt} class="svc-card__img media-grayscale" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>

      <div class="services__grid services__grid--wide">
        {serviziWide.map((s) => (
          <a href={s.href} class={`svc-card svc-card--row group${s.dark ? " svc-card--dark" : ""}`}>
            <span class="svc-card__body">
              <span class="svc-card__top" aria-hidden="true">
                <span class="svc-card__rule"></span>
                <svg class="svc-card__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </span>
              <h3 class="svc-card__title">{s.titolo}</h3>
              <p class="svc-card__desc">{s.desc}</p>
            </span>
            <img src={s.img} alt={s.alt} class="svc-card__img svc-card__img--row media-grayscale" loading="lazy" decoding="async" />
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ───── PERCHÉ iCURA ───── */}
  <section class="why section--ink" aria-labelledby="why-heading">
    <div class="container why__grid">
      <div class="why__body">
        <p class="eyebrow">Il metodo</p>
        <h2 id="why-heading" class="why__title">Perché <span class="accent">iCura.</span></h2>
        <ol class="why__list">
          <li class="why__item">
            <span class="why__n">01</span>
            <div>
              <h3 class="why__item-title">Un solo interlocutore</h3>
              <p class="why__item-desc">Sicurezza, formazione, engineering, finanza e certificazioni sotto lo stesso tetto. Niente rimbalzi tra studi diversi.</p>
            </div>
          </li>
          <li class="why__item">
            <span class="why__n">02</span>
            <div>
              <h3 class="why__item-title">Team multidisciplinare</h3>
              <p class="why__item-desc">Ingegneri, medici del lavoro, tecnici e commercialisti che si parlano tra loro. Quando un caso tocca più aree, coordiniamo noi.</p>
            </div>
          </li>
          <li class="why__item">
            <span class="why__n">03</span>
            <div>
              <h3 class="why__item-title">Tariffa prevedibile</h3>
              <p class="why__item-desc">Retainer annuale: documentazione, aggiornamenti e supporto continuo a un costo chiaro, senza extra a sorpresa.</p>
            </div>
          </li>
        </ol>
      </div>
      <div class="why__media">
        <img src="/images/chi-siamo-riunione-team.webp" alt="Team di consulenti iCura Impresa in riunione operativa" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ───── TEAM ───── */}
  <section class="team section--alt" aria-labelledby="team-heading">
    <div class="container">
      <div class="team__head">
        <p class="eyebrow">Chi siamo</p>
        <h2 id="team-heading" class="team__title">Un team che parla la stessa lingua.</h2>
      </div>
      <div class="team__grid">
        {team.map((t) => (
          <article class="team-tile group">
            <div class="team-tile__media">
              <img src={t.img} alt={t.alt} class="media-grayscale" loading="lazy" decoding="async" />
            </div>
            <h3 class="team-tile__h">{t.h}</h3>
            <p class="team-tile__k">{t.k}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ───── CONTATTI + FORM ───── */}
  <section class="contact section--ink" aria-labelledby="contact-heading">
    <div class="container contact__grid">
      <div class="contact__intro">
        <p class="eyebrow">Contatti</p>
        <h2 id="contact-heading" class="contact__title">Pronto a <span class="accent">metterti</span> in regola?</h2>
        <p class="contact__lede">
          Sopralluogo gratuito e risposta entro 48 ore. Prima capiamo se possiamo esserti utili, poi decidi tu.
        </p>
        <div class="contact__cards">
          <div class="contact__box">
            <span class="contact__box-label">Sede</span>
            <p class="contact__box-value">Corso Secondigliano, 236</p>
            <p class="contact__box-sub">80144 Napoli</p>
          </div>
          <div class="contact__box">
            <span class="contact__box-label">Chiamaci</span>
            <p class="contact__box-value"><a href="tel:+390816580779">+39 081 658 0779</a></p>
            <p class="contact__box-sub"><a href="mailto:info@icuraimpresa.it">info@icuraimpresa.it</a></p>
          </div>
        </div>
      </div>

      <form class="contact__form" action="#" method="POST" novalidate>
        <h3 class="contact__form-title">Richiedi una consulenza</h3>
        <div class="contact__row">
          <div class="field">
            <label for="cf-nome">Nome</label>
            <input id="cf-nome" name="nome" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" required autocomplete="email" />
          </div>
        </div>
        <div class="field">
          <label for="cf-area">Area di interesse</label>
          <select id="cf-area" name="area">
            <option>Consulenza &amp; Sicurezza</option>
            <option>Engineering &amp; Antincendio</option>
            <option>Formazione</option>
            <option>Certificazioni &amp; Gare</option>
            <option>Finanza agevolata</option>
          </select>
        </div>
        <div class="field">
          <label for="cf-msg">Messaggio</label>
          <textarea id="cf-msg" name="messaggio" rows="4"></textarea>
        </div>
        <label class="consent">
          <input type="checkbox" name="privacy" required />
          <span>Acconsento al trattamento dei dati secondo la <a href="/privacy">privacy policy</a>.</span>
        </label>
        <button type="submit" class="btn btn--primary contact__submit">
          Invia richiesta
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      </form>
    </div>
  </section>
</Base>

<style>
  /* ───────── HERO (full-bleed, full-screen) ───────── */
  .hero { padding: 0; }
  .hero .container { max-width: none; padding-inline: 0; }
  .hero__card {
    display: grid;
    grid-template-columns: 38% 62%;
    min-height: calc(100svh - var(--header-h));
    overflow: hidden;
  }
  .hero__media { position: relative; background: var(--color-ink); overflow: hidden; }
  .hero__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__media-veil {
    position: absolute; inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-ink) 45%, transparent), transparent);
  }
  .hero__panel {
    background: var(--color-ink);
    color: var(--color-paper);
    padding: clamp(var(--space-lg), 4vw, var(--space-2xl));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-md);
  }
  .hero__brand { display: inline-flex; align-items: center; gap: var(--space-sm); margin-bottom: var(--space-md); }
  .hero__brand-mark { height: 4.25rem; width: auto; }
  .hero__brand-name {
    font-family: var(--font-display); font-weight: 700; font-size: var(--text-2xl);
    letter-spacing: -0.025em; color: var(--color-paper);
  }
  .hero__title {
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-paper);
    max-width: 16ch;
  }
  .hero__title .accent { color: var(--color-accent); }
  .hero__lede {
    font-size: var(--text-lg);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-paper) 80%, transparent);
    max-width: 48ch;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-lg); margin-top: var(--space-sm); }
  .hero__cta-primary {
    display: inline-flex; align-items: center;
    padding: 0.9rem 1.8rem;
    background: var(--color-accent);
    color: #fff;
    font-weight: 600;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .hero__cta-primary:hover { background: #fff; color: var(--color-ink); text-decoration: none; }
  .hero__cta-link {
    display: inline-flex; align-items: center; gap: 0.5em;
    color: var(--color-paper); font-weight: 600; font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .hero__cta-link:hover { color: var(--color-accent); text-decoration: none; }

  .hero__metrics {
    display: flex; flex-wrap: wrap; gap: var(--space-lg) var(--space-xl);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid color-mix(in srgb, var(--color-paper) 12%, transparent);
  }
  .metric { display: flex; flex-direction: column; gap: 0.2rem; margin: 0; }
  .metric__n { font-family: var(--font-display); font-weight: 700; font-size: var(--text-2xl); color: var(--color-paper); }
  .metric__label {
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); margin: 0;
  }

  /* ───────── STRIP AGEVOLAZIONI ───────── */
  .strip { background: var(--color-accent); color: #fff; padding-block: var(--space-md); }
  .strip__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md); }
  .strip__msg { display: flex; align-items: center; gap: var(--space-md); }
  .strip__icon {
    flex: none; width: 2.5rem; height: 2.5rem; display: grid; place-items: center;
    border-radius: 50%; background: color-mix(in srgb, #fff 20%, transparent);
  }
  .strip__icon svg { width: 1.25rem; height: 1.25rem; }
  .strip__kicker { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.85; margin: 0; }
  .strip__title { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; line-height: 1.2; margin: 0.1rem 0 0; max-width: 60ch; }
  .strip__cta {
    flex: none;
    display: inline-flex; align-items: center;
    padding: 0.7rem 1.5rem; background: #fff; color: var(--color-accent);
    font-weight: 600; border-radius: var(--radius-pill); text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .strip__cta:hover { background: var(--color-ink); color: #fff; text-decoration: none; }

  /* ───────── SERVIZI ───────── */
  .services { padding-block: var(--space-3xl); }
  .services__head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end;
    gap: var(--space-lg); margin-bottom: var(--space-2xl);
  }
  .services__title { font-size: var(--text-4xl); font-weight: 700; letter-spacing: -0.03em; line-height: 1.05; max-width: 16ch; }
  .services__title .italic { font-style: italic; font-weight: 400; }
  .services__note { color: var(--color-muted); max-width: 40ch; font-size: var(--text-md); }

  .services__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-lg); }
  .services__grid--wide { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: var(--space-lg); }

  .svc-card {
    display: flex; flex-direction: column;
    padding: var(--space-xl);
    background: var(--color-surface);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    text-decoration: none; color: inherit;
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .svc-card:hover { border-color: color-mix(in srgb, var(--color-accent) 40%, transparent); box-shadow: var(--shadow-lift); transform: translateY(-3px); text-decoration: none; }
  .svc-card--dark { background: var(--color-ink); border-color: color-mix(in srgb, var(--color-accent) 14%, transparent); }

  .svc-card__top { display: flex; align-items: center; justify-content: space-between; color: var(--color-accent); margin-bottom: var(--space-xl); }
  .svc-card__rule { width: 2rem; height: 1px; background: color-mix(in srgb, var(--color-accent) 40%, transparent); }
  .svc-card__arrow { width: 1.25rem; height: 1.25rem; transition: transform var(--dur-base) var(--ease-out); }
  .svc-card:hover .svc-card__arrow { transform: rotate(45deg); }
  .svc-card--dark .svc-card__arrow { color: var(--color-paper); }

  .svc-card__title { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 var(--space-sm); color: var(--color-ink); }
  .svc-card--dark .svc-card__title { color: var(--color-paper); }
  .svc-card__desc { font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-lg); flex: 1; }
  .svc-card--dark .svc-card__desc { color: color-mix(in srgb, var(--color-paper) 62%, transparent); }
  .svc-card__img { width: 100%; height: 12rem; object-fit: cover; border-radius: var(--radius-input); }

  .svc-card--row { flex-direction: row; align-items: center; gap: var(--space-xl); }
  .svc-card--row .svc-card__body { flex: 1; display: flex; flex-direction: column; }
  .svc-card--row .svc-card__desc { margin-bottom: 0; }
  .svc-card__img--row { width: 11rem; height: 11rem; flex: none; }

  /* ───────── PERCHÉ ───────── */
  .why { padding-block: var(--space-3xl); overflow: hidden; }
  .why__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: center; }
  .why__title { font-size: var(--text-4xl); font-weight: 700; letter-spacing: -0.03em; margin-bottom: var(--space-xl); }
  .why__title .accent { color: var(--color-accent); }
  .why__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-lg); }
  .why__item { display: flex; gap: var(--space-md); align-items: flex-start; }
  .why__n { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 700; color: var(--color-accent); flex: none; }
  .why__item-title { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; margin: 0 0 0.3rem; color: var(--color-paper); }
  .why__item-desc { font-size: var(--text-sm); line-height: 1.6; color: color-mix(in srgb, var(--color-paper) 62%, transparent); margin: 0; }
  .why__media { position: relative; border-radius: var(--radius-lg); overflow: hidden; border: var(--rule-hair) solid color-mix(in srgb, var(--color-paper) 12%, transparent); }
  .why__media img { width: 100%; height: 100%; max-height: 32rem; object-fit: cover; display: block; }

  /* ───────── TEAM ───────── */
  .team { padding-block: var(--space-3xl); }
  .team__head { text-align: center; max-width: 40ch; margin: 0 auto var(--space-2xl); }
  .team__head .eyebrow { text-align: center; }
  .team__title { font-size: var(--text-3xl); font-weight: 700; letter-spacing: -0.025em; }
  .team__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-lg); }
  .team-tile__media { position: relative; height: 22rem; border-radius: var(--radius-card); overflow: hidden; background: var(--color-ink); margin-bottom: var(--space-md); }
