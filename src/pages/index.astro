---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import ServiceIcon from "@components/ServiceIcon.astro";
import CtaBand from "@components/CtaBand.astro";

const servizi = [
  {
    n: "01",
    icon: "consulenza" as const,
    titolo: "Consulenza",
    sintesi:
      "Sicurezza sul lavoro (D.Lgs. 81/08), cantieri, HACCP, medicina del lavoro, GDPR e ambiente. Un solo contratto per tutti gli adempimenti.",
    href: "/servizi/consulenza",
  },
  {
    n: "02",
    icon: "formazione" as const,
    titolo: "Formazione",
    sintesi:
      "Corsi in aula, e-learning e HACCP. Spesso a costo zero tramite i fondi interprofessionali.",
    href: "/servizi/formazione",
  },
  {
    n: "03",
    icon: "engineering" as const,
    titolo: "Engineering",
    sintesi:
      "Progettazione edile e impiantistica, prevenzione incendi, qualifiche e test sui materiali.",
    href: "/servizi/engineering",
  },
  {
    n: "04",
    icon: "finanza-agevolata" as const,
    titolo: "Finanza agevolata",
    sintesi:
      "Bando ISI, sgravi INAIL, fondi interprofessionali e crediti d'imposta. Dalla domanda alla rendicontazione.",
    href: "/servizi/finanza-agevolata",
  },
  {
    n: "05",
    icon: "certificazioni" as const,
    titolo: "Certificazioni",
    sintesi:
      "ISO 9001, 14001 e 45001, Attestazione SOA e supporto alle gare d'appalto.",
    href: "/servizi/certificazioni",
  },
];

const stats = [
  { num: "2014", label: "Anno di fondazione" },
  { num: "5", label: "Aree di consulenza integrate" },
  { num: "48h", label: "Tempo medio di risposta" },
  { num: "Napoli", label: "Sede operativa" },
];
---

<Base title="iCura Impresa" pageClass="page-home">
  {/* ───── Hero · Marquee + vertical rail ───── */}
  <section class="hero-impact" aria-labelledby="hero-heading">
    <img
      class="hero-impact__media"
      src="/images/home-cantiere-planimetria.webp"
      alt=""
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <div class="hero-impact__veil" aria-hidden="true"></div>

    <div class="container hero-impact__inner">
      <aside class="hero-impact__rail" aria-hidden="true">
        <span class="hero-impact__rail-n">00 / Home</span>
        <img
          class="hero-impact__rail-mark"
          src="/images/brand/brand-mark-hero.png"
          alt=""
          width="360"
          height="423"
          loading="eager"
          decoding="async"
        />
        <span class="hero-impact__rail-meta">
          Napoli<br />dal 2014
        </span>
      </aside>

      <div class="hero-impact__copy">
        <p class="hero-impact__kicker">
          <span class="eyebrow__dot" aria-hidden="true"></span>
          Consulenza · Formazione · Engineering · Finanza · Certificazioni
        </p>
        <h1 id="hero-heading" class="hero-impact__title">
          <span class="sr-only">iCura Impresa — </span>
          <span class="hero-impact__title-line">Cantieri, cucine,</span>
          <span class="hero-impact__title-line">capannoni.</span>
          <span class="hero-impact__title-line hero-impact__title-line--quiet">Sotto lo stesso tetto.</span>
        </h1>
        <p class="hero-impact__lede">
          Ingegneri, medici del lavoro, tecnici e commercialisti per oltre cento imprese italiane. Un solo interlocutore, dal sopralluogo alla pratica.
        </p>
        <div class="hero-impact__ctas">
          <a href="/contatti" class="btn btn--primary">
            Richiedi consulenza
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/servizi/consulenza" class="hero-impact__link">
            Vedi i servizi
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <dl class="hero-impact__proof" aria-label="Dati principali iCura Impresa">
        <div>
          <dt>2014</dt>
          <dd>fondazione</dd>
        </div>
        <div>
          <dt>5</dt>
          <dd>aree integrate</dd>
        </div>
        <div>
          <dt>100+</dt>
          <dd>imprese seguite</dd>
        </div>
        <div>
          <dt>48h</dt>
          <dd>risposta media</dd>
        </div>
      </dl>

      <span class="hero-impact__marquee" aria-hidden="true">iCura Impresa</span>
    </div>
  </section>

  <hr class="rule rule--thick" aria-hidden="true" />

  {/* ───── Intro · chi siamo sintetico ───── */}
  <section class="section intro" aria-labelledby="intro-heading">
    <div class="container intro__grid">
      <div class="intro__lead">
        <p class="eyebrow">01 — Chi siamo</p>
        <h2 id="intro-heading" class="intro__title">
          Un team multidisciplinare che si occupa di tutto ciò che la tua impresa non dovrebbe gestire da sola.
        </h2>
      </div>
      <div class="intro__body">
        <p>
          Ingegneri, medici del lavoro, tecnici e commercialisti sotto lo stesso tetto. Nata nel 2014 come studio di consulenza, oggi S.r.l. operativa su tutta Italia.
        </p>
        <p>
          Pensiamo che la sicurezza non sia un certificato da archiviare, ma un mestiere quotidiano. Lo facciamo per oltre cento imprese, dal cantiere alla cucina, dal magazzino all'ufficio.
        </p>
        <div class="intro__ctas">
          <a href="/chi-siamo#team" class="link-cta">
            Conosci il team
            <span class="link-cta__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/servizi/consulenza" class="link-cta">
            Scopri i servizi
            <span class="link-cta__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  {/* ───── Immagine wide · brand atmosphere ───── */}
  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/sicurezza-ispezione-capannone.webp"
        alt="Consulente per la sicurezza sul lavoro in sopralluogo dentro un capannone industriale italiano: adulto con casco bianco e tablet controlla macchinari e vie di passaggio, ambiente ordinato, luce naturale, fotografia documentaria professionale"
      />
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  {/* ───── Servizi · 4 categorie ───── */}
  <section class="section servizi" aria-labelledby="servizi-heading">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">02 — Cosa facciamo</p>
        <h2 id="servizi-heading" class="section-head__title">
          Cinque aree, un solo interlocutore.
        </h2>
      </header>

      <ul class="servizi__grid">
        {servizi.map((s) => (
          <li class="servizio-card">
            <span class="servizio-card__icon" aria-hidden="true">
              <ServiceIcon name={s.icon} />
            </span>
            <span class="servizio-card__n" aria-hidden="true">{s.n}</span>
            <h3 class="servizio-card__title">{s.titolo}</h3>
            <p class="servizio-card__text">{s.sintesi}</p>
            <a href={s.href} class="link-cta servizio-card__link">
              Approfondisci
              <span class="link-cta__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ───── Bando ISI · stat-led strip ───── */}
  <section class="section bando" aria-labelledby="bando-heading">
    <div class="container bando__grid">
      <div class="bando__copy">
        <p class="eyebrow">03 — In evidenza</p>
        <h2 id="bando-heading" class="bando__title">
          Bando ISI 2024 — <span class="bando__amount">369&nbsp;mln&nbsp;€</span> a fondo perduto.
        </h2>
        <p class="bando__lede">
          Fino al 65% dell'investimento, massimo 130.000 €. Per le imprese che vogliono mettere in sicurezza macchinari, processi, ambienti. Ti accompagniamo in tutta la pratica.
        </p>
        <div class="bando__ctas">
          <a href="/bando-isi" class="btn btn--primary">
            Verifica idoneità
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/contatti" class="btn btn--secondary">Parla con noi</a>
        </div>
      </div>
      <div class="bando__media">
        <Placeholder
          aspect="4/3"
          src="/images/home-cnc-barriera.webp"
          alt="Macchinario industriale CNC nuovo in primo piano installato in officina italiana di media dimensione: dettaglio della testa di lavoro con barriera fotoelettrica di sicurezza attiva, etichetta CE visibile, cavi ordinati in canalina; operatore adulto in DPI navy completi (occhiali, guanti, scarpe antinfortunistiche) consulta uno schermo di controllo touch sulla destra; luce naturale dall'alto da lucernario industriale, ombre morbide; palette desaturata con accenti caldi arancio sui DPI di sicurezza; fotografia documentaria editoriale, no posa marketing, no scintille spettacolari"
        />
      </div>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  {/* ───── Stats strip · T4 numbered ───── */}
  <section class="section section--tight stats" aria-labelledby="stats-heading">
    <div class="container">
      <h2 id="stats-heading" class="sr-only">Numeri iCura Impresa</h2>
      <dl class="stats__list">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat__num">{s.num}</dt>
            <dd class="stat__label">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  {/* ───── Final CTA · CtaBand riusabile ───── */}
  <CtaBand
    eyebrow="04 — Iniziamo"
    title="Una mail, una chiamata, un sopralluogo. Senza impegno."
    lede="Sopralluogo gratuito e risposta entro 48 ore. Prima capiamo se possiamo esserti utile, poi decidi tu."
    image={{
      alt: "Consulente iCura Impresa durante un sopralluogo in azienda: adulto con casco bianco e block-notes parla con il titolare accanto a un macchinario industriale, atmosfera collaborativa e rassicurante, officina italiana con luce naturale di mattina, palette desaturata sobria in toni navy e grigio, fotografia documentaria professionale, no posa, no strette di mano da stock",
    }}
    primary={{ href: "/contatti", label: "Richiedi consulenza" }}
    secondary={{ href: "tel:+390816580779", label: "081 658 0779" }}
    labelledby="closing-heading"
  />
</Base>

<style>
  /* ───── Hero · Marquee + vertical rail ───── */
  .hero-impact {
    position: relative;
    min-height: 100svh;
    display: grid;
    overflow: clip;
    background: var(--color-ink);
    border-bottom: var(--rule-thick) solid var(--color-ink);
    isolation: isolate;
  }

  .hero-impact__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
    z-index: 0;
  }

  .hero-impact__veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(
        100deg,
        color-mix(in oklch, var(--color-ink) 92%, transparent) 0%,
        color-mix(in oklch, var(--color-ink) 70%, transparent) 38%,
        color-mix(in oklch, var(--color-ink) 28%, transparent) 78%,
        color-mix(in oklch, var(--color-ink) 8%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--color-ink) 32%, transparent) 0%,
        color-mix(in oklch, var(--color-ink) 14%, transparent) 50%,
        color-mix(in oklch, var(--color-ink) 70%, transparent) 100%
      );
  }

  .hero-impact__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto;
    column-gap: var(--space-xl);
    row-gap: var(--space-lg);
    align-content: end;
    padding-top: calc(var(--space-3xl) + var(--space-md));
    padding-bottom: var(--space-lg);
    min-height: 100svh;
  }

  /* Rail verticale — meta brand */
  .hero-impact__rail {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-right: var(--rule-hair) solid color-mix(in oklch, var(--color-paper) 22%, transparent);
    padding-right: var(--space-md);
  }

  .hero-impact__rail-n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-paper) 70%, transparent);
  }

  .hero-impact__rail-mark {
    width: clamp(3rem, 5vw, 4.25rem);
    height: auto;
    object-fit: contain;
    margin-top: auto;
  }

  .hero-impact__rail-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-paper) 78%, transparent);
    line-height: 1.5;
  }

  /* Copy block */
  .hero-impact__copy {
    grid-column: 2;
    grid-row: 1;
    max-width: 64rem;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero-impact__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: color-mix(in oklch, var(--color-paper) 86%, transparent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .hero-impact__kicker .eyebrow__dot {
    background: var(--color-highlight);
  }

  .hero-impact__title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9.5vw, 8.75rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: var(--space-2xs) 0 var(--space-2xs);
    color: var(--color-paper);
    display: block;
  }
  .hero-impact__title-line {
    display: block;
  }
  .hero-impact__title-line--quiet {
    color: color-mix(in oklch, var(--color-paper) 62%, transparent);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .hero-impact__lede {
    color: color-mix(in oklch, var(--color-paper) 88%, transparent);
    font-size: var(--text-lg);
    line-height: 1.45;
    max-width: 52ch;
    margin: var(--space-sm) 0 0;
  }

  .hero-impact__ctas {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--space-md);
  }

  .hero-impact .btn--primary {
    background: var(--color-paper);
    color: var(--color-accent);
    border-color: var(--color-paper);
  }
  .hero-impact .btn--primary:hover {
    background: color-mix(in oklch, var(--color-paper) 92%, var(--color-highlight) 8%);
    border-color: color-mix(in oklch, var(--color-paper) 92%, var(--color-highlight) 8%);
  }

  .hero-impact__link {
    color: var(--color-paper);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: color-mix(in oklch, var(--color-paper) 55%, transparent);
    white-space: nowrap;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .hero-impact__link:hover { text-decoration-color: var(--color-paper); }

  /* Proof strip */
  .hero-impact__proof {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-md) 0 0;
    border-top: var(--rule-hair) solid color-mix(in oklch, var(--color-paper) 22%, transparent);
  }
  .hero-impact__proof div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .hero-impact__proof dt {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    font-feature-settings: "tnum";
  }
  .hero-impact__proof dd {
    margin: 0;
    color: color-mix(in oklch, var(--color-paper) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Marquee wordmark · bordo basso */
  .hero-impact__marquee {
    grid-column: 1 / -1;
    grid-row: 3;
    display: block;
    color: color-mix(in oklch, var(--color-paper) 12%, transparent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 13vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    margin-top: var(--space-lg);
    margin-bottom: calc(var(--space-xl) * -1);
    margin-inline-start: calc(var(--space-md) * -1);
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  /* ───── Intro ───── */
  .intro__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .intro__lead { position: sticky; top: calc(var(--space-md) + 64px); }
  .intro__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .intro__body p { color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.55; max-width: 56ch; }
  .intro__ctas {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  /* ───── Section head ───── */
  .section-head { margin-bottom: var(--space-xl); }
  .section-head__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    max-width: 22ch;
  }

  /* ───── Servizi · griglia card con icone ───── */
  .servizi__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }
  .servizio-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    padding: var(--space-lg);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card);
    transition: border-color var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .servizio-card:hover {
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-rule));
    transform: translateY(-2px);
  }
  .servizio-card__icon {
    color: var(--color-accent);
    margin-bottom: var(--space-2xs);
  }
  .servizio-card__n {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .servizio-card__title {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .servizio-card__text {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }
  /* stretched link: l'intera card è cliccabile */
  .servizio-card__link {
    margin-top: var(--space-xs);
    align-self: flex-start;
  }
  .servizio-card__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .servizio-card { transition: border-color var(--dur-fast) var(--ease-out); }
    .servizio-card:hover { transform: none; }
  }

  /* ───── Bando ISI ───── */
  .bando { background: var(--color-accent-soft); }
  .bando__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .bando__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .bando__amount {
    color: var(--color-highlight);
    font-weight: 600;
    font-feature-settings: "tnum";
    white-space: nowrap;
  }
  .bando__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.5;
    max-width: 48ch;
    margin-top: var(--space-md);
  }
  .bando__ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  /* ───── Stats ───── */
  .stats__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .stat__num {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
    font-feature-settings: "tnum";
  }
  .stat__label {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  /* ───── Responsive ───── */
  @media (max-width: 64rem) {
    .servizi__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 40rem) {
    .servizi__grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 56rem) {
    .hero-impact {
      min-height: 92svh;
    }
    .hero-impact__media {
      object-position: center;
