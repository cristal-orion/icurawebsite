---
import Base from "@layouts/Base.astro";
import CtaBand from "@components/CtaBand.astro";
import MacroAree from "@components/MacroAree.astro";
import BandiInEvidenza from "@components/BandiInEvidenza.astro";
import AreaGrid from "@components/AreaGrid.astro";
import ParallaxBand from "@components/ParallaxBand.astro";

const stats = [
  { num: "2014", label: "Anno di fondazione" },
  { num: "5", label: "Aree di consulenza integrate" },
  { num: "48h", label: "Tempo medio di risposta" },
  { num: "Napoli", label: "Sede operativa" },
];

const ambiti = [
  {
    nome: "Sicurezza sul lavoro",
    desc: "DVR, RSPP, sopralluoghi e adempimenti del D.Lgs. 81/08. Cantieri con PSC, POS e coordinamento.",
    href: "/servizi/consulenza",
    cta: "Vai alla consulenza",
  },
  {
    nome: "Salute e igiene",
    desc: "Medicina del lavoro e sorveglianza sanitaria, medico competente, HACCP per il settore alimentare.",
    href: "/servizi/consulenza",
    cta: "Scopri di più",
  },
  {
    nome: "Ambiente e privacy",
    desc: "AUA, gestione rifiuti, MUD ed emissioni in atmosfera. GDPR, DPO e registri dei trattamenti.",
    href: "/servizi/consulenza",
    cta: "Scopri di più",
  },
  {
    nome: "Engineering e antincendio",
    desc: "Progettazione edile e impiantistica, prevenzione incendi e CPI, collaudi e perizie.",
    href: "/servizi/engineering",
    cta: "Vai a engineering",
  },
  {
    nome: "Certificazioni e gare",
    desc: "ISO 9001, 14001, 45001, parità di genere UNI/PdR 125, Attestazione SOA e procedure di gara.",
    href: "/servizi/certificazioni",
    cta: "Vai alle certificazioni",
  },
  {
    nome: "Formazione e finanza",
    desc: "Corsi obbligatori in aula ed e-learning, bando ISI, ZES, Transizione 5.0 e fondi interprofessionali.",
    href: "/servizi/finanza-agevolata",
    cta: "Vai alla finanza",
  },
];

const settori = [
  "Edilizia e cantieri",
  "Manifatturiero e metalmeccanica",
  "Logistica e magazzini",
  "Alimentare e Ho.Re.Ca.",
  "Commercio e uffici",
  "Sanità e servizi",
];

const perche = [
  {
    titolo: "Un solo interlocutore",
    desc: "Sicurezza, formazione, engineering, finanza e certificazioni sotto lo stesso tetto. Niente rimbalzi tra studi diversi.",
  },
  {
    titolo: "Team multidisciplinare",
    desc: "Ingegneri, medici del lavoro, tecnici e commercialisti che si parlano tra loro. Quando un caso tocca più aree, coordiniamo noi.",
  },
  {
    titolo: "Tariffa prevedibile",
    desc: "Retainer annuale: documentazione, aggiornamenti e supporto continuo a un costo chiaro, senza extra a sorpresa.",
  },
];
---

<Base title="iCura Impresa" pageClass="page-home">
  {/* ───── Hero · foto sfondo + logo + brand + frase + cerchi ───── */}
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero__stage">
      <img
        class="hero__bg"
        src="/images/home-cantiere-planimetria.webp"
        alt=""
        loading="eager"
        decoding="async"
        aria-hidden="true"
      />
      <div class="hero__veil" aria-hidden="true"></div>
      <div class="container hero__inner">
        <img
          class="hero__logo"
          src="/images/brand/logo-icura-white.webp"
          alt=""
          width="460"
          height="600"
          loading="eager"
          decoding="async"
          aria-hidden="true"
        />
        <h1 id="hero-heading" class="hero__brand">iCura Impresa</h1>
        <p class="hero__phrase">
          Un solo interlocutore per la sicurezza sul lavoro, la formazione, l'engineering, la finanza agevolata e le certificazioni della tua impresa.
        </p>
        <div class="hero__ctas">
          <a href="/contatti" class="btn btn--primary">
            Richiedi consulenza
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/servizi/consulenza" class="hero__link">
            Vedi i servizi
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    {/* Cerchi macro-aree dentro la hero (richiesta cliente) */}
    <MacroAree />
  </section>

  {/* ───── Intro · chi siamo sintetico ───── */}
  <section class="section section--alt intro" aria-labelledby="intro-heading">
    <div class="container intro__grid">
      <div class="intro__lead">
        <p class="eyebrow">01 — Chi siamo</p>
        <h2 id="intro-heading" class="intro__title">
          Un team multidisciplinare che si occupa di tutto ciò che la tua impresa non dovrebbe gestire da sola.
        </h2>
      </div>
      <div class="intro__body">
        <p>
          Ingegneri, medici del lavoro, tecnici e commercialisti sotto lo stesso tetto. Nata nel 2014 come studio di consulenza, oggi S.r.l. operativa su tutta Italia.
        </p>
        <p>
          Pensiamo che la sicurezza non sia un certificato da archiviare, ma un mestiere quotidiano. Lo facciamo per oltre cento imprese, dal cantiere alla cucina, dal magazzino all'ufficio.
        </p>
        <div class="intro__ctas">
          <a href="/chi-siamo#team" class="link-cta">
            Conosci il team
            <span class="link-cta__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/servizi/consulenza" class="link-cta">
            Scopri i servizi
            <span class="link-cta__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ───── Ambiti · tutto ciò di cui ci occupiamo (ampiezza) ───── */}
  <section class="section section--alt-blue ambiti" aria-labelledby="ambiti-heading">
    <div class="container">
      <p class="eyebrow">02 — Di cosa ci occupiamo</p>
      <h2 id="ambiti-heading" class="ambiti__title">
        Tutto quello che la tua impresa deve avere in regola, in un posto solo.
      </h2>
      <p class="ambiti__lede">
        Dalla sicurezza sul lavoro agli adempimenti ambientali, dalle certificazioni ISO ai bandi: aree diverse, un'unica regia.
      </p>
      <AreaGrid aree={ambiti} />

      <div class="settori" aria-labelledby="settori-heading">
        <p id="settori-heading" class="settori__label">Settori che seguiamo</p>
        <ul class="chips chips--inline" aria-label="Settori serviti">
          {settori.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ───── Fascia in parallasse · statement ───── */}
  <ParallaxBand
    src="/images/sicurezza-ispezione-capannone.webp"
    alt="Consulente per la sicurezza sul lavoro in sopralluogo dentro un capannone industriale italiano: adulto con casco bianco e tablet controlla macchinari e vie di passaggio, ambiente ordinato, luce naturale, fotografia documentaria professionale"
    eyebrow="Dal 2014, su tutta Italia"
    title="Dal cantiere alla cucina, sotto lo stesso tetto."
    lede="Un solo team multidisciplinare per la sicurezza, la formazione, l'engineering, la finanza agevolata e le certificazioni della tua impresa."
    cta={{ href: "/contatti", label: "Richiedi una consulenza" }}
    labelledby="parallax-home"
  />

  {/* ───── Agevolazioni in evidenza · sfondo azzurro ───── */}
  <BandiInEvidenza />

  {/* ───── Perché iCura · tre pilastri ───── */}
  <section class="section section--alt-2 perche" aria-labelledby="perche-heading">
    <div class="container">
      <p class="eyebrow">03 — Perché iCura</p>
      <h2 id="perche-heading" class="perche__title">Non un fornitore in più. Uno in meno di cui preoccuparsi.</h2>
      <ul class="perche__grid">
        {perche.map((p, i) => (
          <li class="pilastro">
            <span class="pilastro__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="pilastro__titolo">{p.titolo}</h3>
            <p class="pilastro__desc">{p.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ───── Stats strip · T4 numbered ───── */}
  <section class="section section--tight stats" aria-labelledby="stats-heading">
    <div class="container">
      <h2 id="stats-heading" class="sr-only">Numeri iCura Impresa</h2>
      <dl class="stats__list">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat__num">{s.num}</dt>
            <dd class="stat__label">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  {/* ───── Final CTA · CtaBand riusabile ───── */}
  <CtaBand
    eyebrow="02 — Iniziamo"
    title="Una mail, una chiamata, un sopralluogo. Senza impegno."
    lede="Sopralluogo gratuito e risposta entro 48 ore. Prima capiamo se possiamo esserti utile, poi decidi tu."
    image={{
      src: "/images/home-cnc-barriera.webp",
      alt: "Consulente iCura Impresa durante un sopralluogo in azienda: adulto con casco bianco e block-notes parla con il titolare accanto a un macchinario industriale, atmosfera collaborativa e rassicurante, officina italiana con luce naturale di mattina, palette desaturata sobria in toni navy e grigio, fotografia documentaria professionale, no posa, no strette di mano da stock",
    }}
    primary={{ href: "/contatti", label: "Richiedi consulenza" }}
    secondary={{ href: "tel:+390816580779", label: "081 658 0779" }}
    labelledby="closing-heading"
  />
</Base>

<style>
  /* ───── Hero · foto sfondo + logo + brand + frase + cerchi ───── */
  .hero {
    border-bottom: var(--rule-thick) solid var(--color-ink);
  }
  .hero__stage {
    position: relative;
    overflow: clip;
    isolation: isolate;
    background: var(--color-ink);
    padding-top: calc(var(--space-3xl) + var(--space-md));
    padding-bottom: var(--space-2xl);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: 0;
  }
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--color-ink) 68%, transparent) 0%,
        color-mix(in oklch, var(--color-ink) 46%, transparent) 45%,
        color-mix(in oklch, var(--color-ink) 84%, transparent) 100%
      );
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero__logo {
    height: clamp(5rem, 9vw, 7.5rem);
    width: auto;
    margin-bottom: var(--space-md);
    animation: heroIn 700ms var(--ease-out) both;
  }
  .hero__brand {
    font-size: var(--text-4xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-paper);
    margin: 0;
    animation: heroIn 700ms var(--ease-out) 80ms both;
  }
  .hero__phrase {
    font-size: var(--text-lg);
    color: color-mix(in oklch, var(--color-paper) 90%, transparent);
    line-height: 1.5;
    max-width: 56ch;
    margin: var(--space-md) auto 0;
    text-wrap: balance;
    animation: heroIn 700ms var(--ease-out) 160ms both;
  }
  .hero__ctas {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-lg);
    animation: heroIn 700ms var(--ease-out) 240ms both;
  }
  .hero .btn--primary {
    background: var(--color-paper);
    color: var(--color-accent);
    border-color: var(--color-paper);
  }
  .hero .btn--primary:hover {
    background: color-mix(in oklch, var(--color-paper) 92%, var(--color-highlight) 8%);
    border-color: color-mix(in oklch, var(--color-paper) 92%, var(--color-highlight) 8%);
  }
  .hero__link {
    color: var(--color-paper);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: color-mix(in oklch, var(--color-paper) 55%, transparent);
    white-space: nowrap;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .hero__link:hover { text-decoration-color: var(--color-paper); }
  /* Cerchi macro-aree sotto lo stage, su fondo chiaro */
  .hero :global(.macroaree) { padding-block: var(--space-2xl); }
  @keyframes heroIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  /* ───── Hero · Marquee + vertical rail ───── */
  .hero-impact {
    position: relative;
    min-height: 100svh;
    display: grid;
    overflow: clip;
    background: var(--color-ink);
    border-bottom: var(--rule-thick) solid var(--color-ink);
    isolation: isolate;
  }

  .hero-impact__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
    z-index: 0;
  }

  .hero-impact__veil {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(
        100deg,
        color-mix(in oklch, var(--color-ink) 95%, transparent) 0%,
        color-mix(in oklch, var(--color-ink) 78%, transparent) 40%,
        color-mix(in oklch, var(--color-ink) 30%, transparent) 78%,
        color-mix(in oklch, var(--color-ink) 8%, transparent) 100%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklch, var(--color-ink) 32%, transparent) 0%,
        color-mix(in oklch, var(--color-ink) 14%, transparent) 50%,
        color-mix(in oklch, var(--color-ink) 70%, transparent) 100%
      );
  }

  .hero-impact__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(7rem, 11rem) minmax(0, 1fr);
    grid-template-rows: 1fr auto auto;
    column-gap: var(--space-xl);
    row-gap: var(--space-lg);
    align-content: end;
    padding-top: calc(var(--space-3xl) + var(--space-md));
    padding-bottom: var(--space-lg);
    min-height: 100svh;
  }

  /* Rail verticale — meta brand */
  .hero-impact__rail {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-right: var(--rule-hair) solid color-mix(in oklch, var(--color-paper) 22%, transparent);
    padding-right: var(--space-md);
  }

  .hero-impact__rail-n {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-paper) 70%, transparent);
  }

  .hero-impact__rail-mark {
    width: clamp(3rem, 5vw, 4.25rem);
    height: auto;
    object-fit: contain;
    margin-top: auto;
  }

  .hero-impact__rail-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--color-paper) 78%, transparent);
    line-height: 1.5;
  }

  /* Copy block */
  .hero-impact__copy {
    grid-column: 2;
    grid-row: 1;
    max-width: 64rem;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .hero-impact__kicker {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: color-mix(in oklch, var(--color-paper) 86%, transparent);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
  }
  .hero-impact__kicker .eyebrow__dot {
    background: var(--color-highlight);
  }

  .hero-impact__title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9.5vw, 8.75rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.025em;
    margin: var(--space-2xs) 0 var(--space-2xs);
    color: var(--color-paper);
    display: block;
  }
  .hero-impact__title-line {
    display: block;
  }
  .hero-impact__title-line--quiet {
    color: color-mix(in oklch, var(--color-paper) 62%, transparent);
    font-weight: 400;
    font-style: italic;
    letter-spacing: -0.02em;
  }

  .hero-impact__lede {
    color: color-mix(in oklch, var(--color-paper) 88%, transparent);
    font-size: var(--text-lg);
    line-height: 1.45;
    max-width: 52ch;
    margin: var(--space-sm) 0 0;
  }

  /* Reveal della descrizione al primo scroll — attivo solo con JS + motion on.
     Senza JS o con reduced-motion la descrizione resta subito visibile. */
  .hero-impact.js-hero-defer .hero-impact__lede {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
    will-change: opacity, transform;
  }
  .hero-impact.js-hero-defer.is-revealed .hero-impact__lede {
    opacity: 1;
    transform: none;
  }

  /* Entrata in scena di kicker + righe del titolo al caricamento.
     Attiva solo con JS + motion on (gate .js-hero-defer). Senza JS o con
     reduced-motion restano subito visibili. */
  .hero-impact.js-hero-defer .hero-impact__kicker,
  .hero-impact.js-hero-defer .hero-impact__title-line {
    opacity: 0;
    transform: translateY(26px);
    transition: opacity 800ms var(--ease-out),
      transform 800ms var(--ease-out);
    transition-delay: var(--enter-delay, 0ms);
    will-change: opacity, transform;
  }
  .hero-impact.js-hero-defer.is-entered .hero-impact__kicker,
  .hero-impact.js-hero-defer.is-entered .hero-impact__title-line {
    opacity: 1;
    transform: none;
  }

  .hero-impact__ctas {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--space-md);
  }

  .hero-impact .btn--primary {
    background: var(--color-paper);
    color: var(--color-accent);
    border-color: var(--color-paper);
  }
  .hero-impact .btn--primary:hover {
    background: color-mix(in oklch, var(--color-paper) 92%, var(--color-highlight) 8%);
    border-color: color-mix(in oklch, var(--color-paper) 92%, var(--color-highlight) 8%);
  }

  .hero-impact__link {
    color: var(--color-paper);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
    text-decoration-color: color-mix(in oklch, var(--color-paper) 55%, transparent);
    white-space: nowrap;
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .hero-impact__link:hover { text-decoration-color: var(--color-paper); }

  /* Proof strip */
  .hero-impact__proof {
    grid-column: 2;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: var(--space-md) 0 0;
    border-top: var(--rule-hair) solid color-mix(in oklch, var(--color-paper) 22%, transparent);
  }
  .hero-impact__proof div {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }
  .hero-impact__proof dt {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.025em;
    font-feature-settings: "tnum";
  }
  .hero-impact__proof dd {
    margin: 0;
    color: color-mix(in oklch, var(--color-paper) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Marquee wordmark · bordo basso */
  .hero-impact__marquee {
    grid-column: 1 / -1;
    grid-row: 3;
    display: block;
    color: color-mix(in oklch, var(--color-paper) 12%, transparent);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 13vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.03em;
    margin-top: var(--space-lg);
    margin-bottom: calc(var(--space-xl) * -1);
    margin-inline-start: calc(var(--space-md) * -1);
    white-space: nowrap;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  /* ───── Intro ───── */
  .intro__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .intro__lead { position: sticky; top: calc(var(--space-md) + 64px); }
  .intro__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .intro__body p { color: var(--color-ink-2); font-size: var(--text-lg); line-height: 1.55; max-width: 56ch; }
  .intro__ctas {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }

  /* ───── Stats ───── */
  .stats__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
  }
  .stat { display: flex; flex-direction: column; gap: 0.25rem; }
  .stat__num {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    line-height: 1;
    font-feature-settings: "tnum";
  }
  .stat__label {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  /* ───── Ambiti ───── */
  .ambiti__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.025em;
    max-width: 24ch;
  }
