---
// Landing dell'analizzatore DVR (statica). L'app vera è di Vincenzo e gira altrove:
// qui si spiega che cosa controlla e si porta alla registrazione; dopo l'accesso
// l'area (/analizzatore-dvr/area) apre l'app.
import Base from "@layouts/Base.astro";
import DotGrid from "@components/DotGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";

const REG = "/analizzatore-dvr/registrati/";
const ACC = "/analizzatore-dvr/accedi/";

// Card "esempio di riscontro" nell'hero: ricalca la schermata vera dell'app (tre aree con
// esito e punteggio, poi i rilievi), ma con valori illustrativi, non presi da un DVR reale.
const esempio = [
  { stato: "Da aggiornare", s: "rosso", valore: "4", p: 100, area: "Norme citate aggiornate", esito: "4 atti abrogati citati come vigenti" },
  { stato: "In ordine", s: "verde", valore: "92", p: 92, area: "Rischi dovuti per il settore", esito: "Capitoli dovuti: 8 su 9 presenti" },
  { stato: "Da rivedere", s: "giallo", valore: "74", p: 74, area: "Data, revisione e figure", esito: "Data e revisione trovate, manca una figura" },
];

// Esempio di anonimizzazione nella sezione privacy (dati inventati, etichettati come esempio).
const anon = [
  { k: "Ragione sociale", v: "Rossi Costruzioni S.r.l.", oscura: true },
  { k: "Sede", v: "Via Roma 12, Napoli", oscura: true },
  { k: "RSPP", v: "Ing. Marco Esposito", oscura: true },
  { k: "Norma citata", v: "D.M. 10 marzo 1998", oscura: false },
];

const perChi = [
  {
    tag: "Imprenditori",
    titolo: "Sai se il DVR che hai in cassetto regge un controllo?",
    testo: "Il documento te l'ha fatto qualcuno anni fa, poi l'azienda è cambiata e le norme anche. In un minuto vedi se cita leggi abrogate, se mancano capitoli che il tuo settore richiede e se ha data, revisione e firme in ordine.",
  },
  {
    tag: "Consulenti e studi della sicurezza",
    titolo: "Un secondo paio d'occhi prima di consegnare.",
    testo: "Passa al controllo un DVR che stai rivedendo o che erediti da un altro studio: i rilievi sono segnati pagina per pagina, così sai subito dove mettere le mani.",
  },
];

const controlli = [
  {
    n: "01",
    titolo: "Norme citate ancora in vigore",
    cerca: "Legge ogni citazione di legge nel documento e la confronta con la normativa in vigore.",
    trova: ["Atti abrogati citati come vigenti, con le pagine in cui compaiono", "Per ogni atto abrogato, la norma da citare oggi al suo posto", "Articoli abrogati o inesistenti"],
  },
  {
    n: "02",
    titolo: "Rischi dovuti per il tuo settore",
    cerca: "Riconosce il settore dalle attività descritte e dal codice ATECO del documento, poi cerca i capitoli di rischio che quel settore si porta dietro.",
    trova: ["Capitoli dovuti presenti e mancanti", "Temi nominati ma senza un capitolo dedicato", "Se il settore non si riconosce, i capitoli dovuti a ogni DVR"],
  },
  {
    n: "03",
    titolo: "Data, revisione e figure della sicurezza",
    cerca: "Controlla i requisiti formali dell'art. 28 del D.Lgs. 81/2008 e l'età del documento.",
    trova: ["Data del documento e numero di revisione", "Datore di lavoro, RSPP, medico competente, RLS", "Valutazioni da ripetere perché il documento è troppo vecchio"],
  },
];

const riscontro = [
  { t: "Un esito per ogni area", d: "In ordine, da rivedere o da aggiornare, con un punteggio su 100: vedi subito dove il documento tiene e dove no." },
  { t: "I rilievi sulle pagine", d: "Clicchi un rilievo e vedi la pagina del DVR con il punto evidenziato. La pagina la disegna il tuo browser." },
  { t: "Che cosa citare al suo posto", d: "Per ogni norma abrogata trovi quella oggi in vigore: non solo l'errore, anche la correzione." },
  { t: "Gravità e fonti", d: "Ogni rilievo dice se è importante o da rivedere e su quale riferimento normativo si basa." },
];

const fasi = [
  { titolo: "Registrati", desc: "Nome, email, azienda, numero di dipendenti e anni di attività. Due minuti, gratis." },
  { titolo: "Carica il PDF", desc: "Dalla tua area apri l'analizzatore e scegli il PDF del DVR, anche scansionato. I dati sensibili si oscurano prima della valutazione." },
  { titolo: "Leggi il riscontro", desc: "In genere in meno di un minuto: esito e punteggio per ogni area, rilievi pagina per pagina." },
  { titolo: "Se serve, sistemiamolo", desc: "Un consulente iCura legge con te il riscontro e ti dice che cosa aggiornare e in che ordine." },
];

const faq = [
  {
    q: "Quanto costa?",
    a: "Niente. L'analizzatore è gratuito: chiediamo solo una registrazione con i dati essenziali della tua azienda.",
  },
  {
    q: "Perché devo registrarmi?",
    a: "Numero di dipendenti e anni di attività ci aiutano a leggere il riscontro nel contesto giusto, e la registrazione ti dà un'area da cui riaprire l'analizzatore quando aggiorni il documento.",
  },
  {
    q: "Che cosa succede al mio DVR dopo il controllo?",
    a: "Prima della valutazione il documento viene anonimizzato: ragione sociale, indirizzi e nomi delle persone vengono oscurati. Il file si legge solo per la verifica e si cancella appena letto: non resta sui nostri sistemi.",
  },
  {
    q: "Che file posso caricare?",
    a: "Il DVR in PDF. Se è una scansione, le pagine si leggono con il riconoscimento del testo; per i documenti lunghi il controllo richiede più tempo e ricevi un link per tornare al riscontro.",
  },
  {
    q: "L'analizzatore sostituisce il consulente?",
    a: "No. È un riscontro a regole su norme citate, capitoli e requisiti formali dell'art. 28 del D.Lgs. 81/2008. Non è una valutazione dei rischi e non sostituisce il lavoro del consulente né quello del datore di lavoro.",
  },
  {
    q: "Il riscontro dice «da aggiornare»: e adesso?",
    a: "Non vuol dire che il documento sia da rifare da capo: spesso basta aggiornare i riferimenti normativi e qualche capitolo. Un nostro consulente della sicurezza può leggerlo con te, dirti che cosa aggiornare per primo e, se vuoi, occuparsene.",
  },
];
---

<Base
  title="Analizzatore DVR: verifica gratis il tuo Documento di Valutazione dei Rischi"
  description="Carica il DVR in PDF e in meno di un minuto scopri se cita norme abrogate, se mancano capitoli dovuti per il tuo settore e se data, revisione e figure sono in regola. Gratis, con registrazione."
  crumb="Analizzatore DVR"
>
  <!-- ── HERO ─────────────────────────────────────────────── -->
  <header class="dvr-hero">
    <DotGrid />
    <div class="container dvr-hero__grid">
      <div class="dvr-hero__copy">
        <p class="eyebrow">Analizzatore DVR · prova gratuita</p>
        <h1 class="dvr-hero__title">Il tuo DVR è ancora <em>in regola?</em></h1>
        <p class="dvr-hero__lede">
          Carica il Documento di Valutazione dei Rischi in PDF: in meno di un minuto ricevi un riscontro su tre punti che contano in caso di controllo.
        </p>
        <div class="dvr-hero__ctas">
          <a href={REG} class="btn btn--primary btn--cta">
            Registrati e valuta il tuo DVR
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a href={ACC} class="dvr-hero__login">Hai già un accesso? <span>Accedi</span></a>
        </div>
        <ul class="dvr-hero__facts" aria-label="In breve">
          <li>PDF, anche scansionato</li>
          <li>Dati sensibili oscurati prima della valutazione</li>
          <li>Il file si cancella dopo la lettura</li>
        </ul>
      </div>

      <figure class="riscontro" aria-label="Esempio di riscontro dell'analizzatore">
        <div class="riscontro__head">
          <span class="doc-mini" aria-hidden="true"><i></i><b></b><i></i><b class="corto"></b><i></i><i class="corto"></i></span>
          <span class="riscontro__id">
            <span class="riscontro__title">Il riscontro sul tuo DVR</span>
            <span class="riscontro__meta">DVR_aziendale.pdf · 48 pagine</span>
          </span>
          <span class="riscontro__anon">Dati oscurati</span>
        </div>
        <ol class="riscontro__list">
          {esempio.map((r, i) => (
            <li class="riscontro__row" style={`--i:${i}`}>
              <span class={`anello anello--${r.s}`} style={`--p:${r.p}`} aria-hidden="true"><span>{r.valore}</span></span>
              <span class="riscontro__txt">
                <span class={`riscontro__stato stato--${r.s}`}>{r.stato}</span>
                <span class="riscontro__area">{r.area}</span>
                <span class="riscontro__esito">{r.esito}</span>
              </span>
            </li>
          ))}
        </ol>
        <div class="rilievo">
          <span class="rilievo__g">Importante</span>
          <p class="rilievo__t">Cita il D.M. 10/3/1998 come vigente: è abrogato; oggi si cita il D.M. 3/9/2021.</p>
          <span class="rilievo__pp" aria-label="Pagine"><i class="is-on">p. 12</i><i>p. 13</i><i>p. 31</i></span>
        </div>
        <figcaption class="riscontro__cap">Esempio illustrativo</figcaption>
      </figure>
    </div>
  </header>

  <!-- ── PER CHI ──────────────────────────────────────────── -->
  <section class="section" aria-labelledby="dvr-perchi">
    <div class="container">
      <p class="eyebrow">Per chi è</p>
      <h2 id="dvr-perchi" class="section-title">Per chi il DVR lo firma e per chi lo scrive.</h2>
      <div class="perchi">
        {perChi.map((p) => (
          <article class="perchi__card">
            <span class="perchi__tag">{p.tag}</span>
            <h3 class="perchi__titolo">{p.titolo}</h3>
            <p class="perchi__testo">{p.testo}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── TRE CONTROLLI ────────────────────────────────────── -->
  <section class="section section--ink" aria-labelledby="dvr-controlli">
    <div class="container">
      <p class="eyebrow">Che cosa controlla</p>
      <h2 id="dvr-controlli" class="section-title">Tre controlli, quelli che contano in un'ispezione.</h2>
      <ol class="controlli">
        {controlli.map((c) => (
          <li class="controllo">
            <span class="controllo__n">{c.n}</span>
            <h3 class="controllo__titolo">{c.titolo}</h3>
            <p class="controllo__cerca">{c.cerca}</p>
            <ul class="controllo__trova" aria-label="Che cosa segnala">
              {c.trova.map((t) => <li>{t}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── IL RISCONTRO ─────────────────────────────────────── -->
  <section class="section" aria-labelledby="dvr-riscontro">
    <div class="container dvr-split">
      <div>
        <p class="eyebrow">Il riscontro</p>
        <h2 id="dvr-riscontro" class="section-title">Non solo un punteggio: <em>dove</em> intervenire.</h2>
        <p class="dvr-split__lede">Per ogni area un esito e un punteggio. Sotto, i rilievi uno per uno, con la pagina del documento in cui si trovano e che cosa scrivere al loro posto.</p>
      </div>
      <ul class="riscontro-feat">
        {riscontro.map((r) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="m8.5 12.4 2.4 2.5 4.6-5.1" /></svg>
            <span><strong>{r.t}</strong>{r.d}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── PRIVACY ──────────────────────────────────────────── -->
  <section class="section section--alt-blue" aria-labelledby="dvr-privacy">
    <div class="container dvr-split dvr-split--privacy">
      <div class="privacy">
        <p class="eyebrow">Il tuo documento</p>
        <h2 id="dvr-privacy" class="section-title">Prima si oscura, <em>poi</em> si valuta.</h2>
        <p>Un DVR contiene l'organizzazione della tua azienda, i nomi delle persone e i loro ruoli. Per questo, prima della valutazione, ragione sociale, indirizzi e nomi vengono oscurati: il controllo lavora su norme, capitoli e requisiti, non su chi sei.</p>
        <p>Il file si legge solo per la verifica e si cancella appena letto: non resta sui nostri sistemi. La pagina con i rilievi la disegna il tuo browser dal file che hai scelto.</p>
      </div>
      <figure class="anon" aria-label="Esempio di anonimizzazione">
        <div class="anon__head" aria-hidden="true">
          <span>Nel tuo DVR</span>
          <span>Nella valutazione</span>
        </div>
        <dl class="anon__list">
          {anon.map((a) => (
            <div class="anon__row">
              <dt>{a.k}</dt>
              <dd class="anon__da">{a.v}</dd>
              <dd class="anon__a">
                {a.oscura
                  ? <span class="oscurato" style={`--w:${Math.min(a.v.length, 22)}ch`}><span class="sr-only">oscurato</span></span>
                  : <span class="anon__resta">{a.v}</span>}
              </dd>
            </div>
          ))}
        </dl>
        <figcaption class="anon__cap">Esempio: i dati che identificano l'azienda e le persone si oscurano, le norme restano.</figcaption>
      </figure>
    </div>
  </section>

  <Steps eyebrow="Come funziona" title="Dalla registrazione al riscontro." steps={fasi} labelledby="dvr-fasi" />

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Prima di caricare il tuo DVR."
    name="faq-dvr"
    labelledby="dvr-faq"
    items={faq}
    tone="alt-blue"
  />

  <section class="section section--tight">
    <div class="container">
      <p class="dvr-disclaimer">
        Riscontro a regole su norme citate, capitoli e requisiti formali dell'art. 28 del D.Lgs. 81/2008. Non è una valutazione dei rischi e non sostituisce il lavoro del consulente né del datore di lavoro.
      </p>
    </div>
  </section>

  <CtaBand
    eyebrow="Prova gratuita"
    title="Registrati per valutare il tuo DVR."
    lede="Due minuti per creare l'accesso, meno di uno per il riscontro. Se qualcosa non torna, un consulente iCura ti dice da dove cominciare."
    image={{
      src: "/images/sicurezza-ispezione-capannone.webp",
      alt: "Consulente della sicurezza iCura Impresa durante un sopralluogo in un capannone industriale, con il documento di valutazione dei rischi in mano, fotografia documentaria",
    }}
    primary={{ href: REG, label: "Registrati gratis" }}
    secondary={{ href: ACC, label: "Hai già un accesso? Accedi" }}
    labelledby="dvr-cta"
  />
</Base>

<style>
  /* ── HERO ── */
  .dvr-hero {
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--color-ink); color: var(--color-paper);
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .dvr-hero__grid {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-2xl); align-items: center;
  }
  .dvr-hero__title {
    font-size: var(--text-display-s); font-weight: 700; letter-spacing: -0.03em; line-height: 0.98;
    color: var(--color-paper); margin: var(--space-xs) 0 0; max-width: 12ch;
  }
  .dvr-hero__title em { font-style: normal; color: var(--color-accent); }
  .dvr-hero__lede {
    font-size: var(--text-lg); line-height: 1.5; max-width: 46ch; margin-top: var(--space-md);
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
  }
  .dvr-hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-md) var(--space-lg); margin-top: var(--space-xl); }
  .dvr-hero .btn--primary { width: auto; background: var(--color-accent); color: #fff; border-color: var(--color-accent); }
  .dvr-hero .btn--primary:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); }
  .dvr-hero__login { font-size: var(--text-sm); color: color-mix(in srgb, var(--color-paper) 70%, transparent); text-decoration: none; }
  .dvr-hero__login span { color: var(--color-paper); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .dvr-hero__login:hover span { color: #93c5fd; }
  .dvr-hero__facts {
    list-style: none; padding: 0; margin: var(--space-xl) 0 0;
    display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg);
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--color-paper) 62%, transparent);
  }
  .dvr-hero__facts li { display: inline-flex; align-items: center; gap: 0.5em; }
  .dvr-hero__facts li::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); }

  /* Card "esempio di riscontro" */
  .riscontro {
    position: relative; margin: 0;
    background: var(--color-surface); color: var(--color-ink);
    border-radius: var(--radius-lg); box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5);
    padding: var(--space-lg);
    animation: riscontro-in 0.9s var(--ease-out) 0.15s both;
  }
  .riscontro__head { display: flex; align-items: center; gap: var(--space-sm); padding-bottom: var(--space-md); border-bottom: 1px solid var(--color-rule); }
  .riscontro__id { flex: 1; min-width: 0; }
  .riscontro__title { display: block; font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg); }
  .riscontro__meta { display: block; font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-muted); }
  .riscontro__anon {
    flex: none; padding: 0.2rem 0.55rem; border-radius: var(--radius-pill);
    background: var(--color-ink); color: var(--color-paper);
    font-family: var(--font-mono); font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.06em;
  }
  /* Miniatura del documento con i dati oscurati (barre nere), come l'anteprima dell'app */
  .doc-mini {
    flex: none; display: flex; flex-direction: column; gap: 3px; justify-content: center;
    width: 2.3rem; height: 2.9rem; padding: 0 0.35rem; border-radius: 3px;
    background: #fff; border: 1px solid var(--color-rule); box-shadow: var(--shadow-card);
  }
  .doc-mini i, .doc-mini b { display: block; height: 3px; border-radius: 1px; background: var(--color-paper-3); }
  .doc-mini b { height: 4px; background: var(--color-ink); width: 80%; }
  .doc-mini .corto { width: 55%; }

  .riscontro__list { list-style: none; margin: 0; padding: 0; }
  .riscontro__row {
    display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); align-items: center;
    padding: var(--space-sm) 0; border-bottom: 1px solid var(--color-rule-2);
    animation: riscontro-in 0.6s var(--ease-out) both;
    animation-delay: calc(0.6s + var(--i) * 0.3s);
  }
  .riscontro__txt { display: flex; flex-direction: column; min-width: 0; }
  .riscontro__stato { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .stato--rosso { color: #dc2626; }
  .stato--verde { color: #15803d; }
  .stato--giallo { color: #b45309; }
  .riscontro__area { font-weight: 600; font-size: var(--text-sm); }
  .riscontro__esito { font-size: var(--text-sm); color: var(--color-ink-2); }
  /* Anello col punteggio: conic-gradient al posto di un SVG */
  .anello {
    --c: var(--color-accent);
    display: grid; place-items: center; width: 2.9rem; height: 2.9rem; border-radius: 50%;
    background: conic-gradient(var(--c) calc(var(--p) * 1%), var(--color-paper-3) 0);
  }
  .anello span {
    display: grid; place-items: center; width: calc(100% - 7px); height: calc(100% - 7px); border-radius: 50%;
    background: var(--color-surface); font-family: var(--font-display); font-weight: 700; font-size: var(--text-sm);
  }
  .anello--rosso { --c: #dc2626; }
  .anello--verde { --c: #16a34a; }
  .anello--giallo { --c: var(--color-highlight); }

  .rilievo {
    margin-top: var(--space-md); padding: var(--space-sm) var(--space-md);
    border-left: 3px solid #dc2626; border-radius: 0 var(--radius-input) var(--radius-input) 0;
    background: #fef2f2;
    animation: riscontro-in 0.6s var(--ease-out) 1.6s both;
  }
  .rilievo__g { font-family: var(--font-mono); font-size: 0.66rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #dc2626; }
  .rilievo__t { margin: 0.2rem 0 0; font-size: var(--text-sm); line-height: 1.45; color: var(--color-ink); }
  .rilievo__pp { display: flex; gap: 0.35rem; margin-top: var(--space-xs); }
  .rilievo__pp i {
    font-style: normal; font-family: var(--font-mono); font-size: 0.68rem;
    padding: 0.1rem 0.45rem; border-radius: var(--radius-pill);
    background: var(--color-surface); border: 1px solid var(--color-rule); color: var(--color-ink-2);
  }
  .rilievo__pp i.is-on { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-paper); }
  .riscontro__cap {
    position: absolute; top: calc(var(--space-sm) * -1); right: var(--space-md);
    padding: 0.2rem 0.6rem; border-radius: var(--radius-pill);
    background: var(--color-ink-inset); color: color-mix(in srgb, var(--color-paper) 80%, transparent);
    font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.08em;
  }
  @keyframes riscontro-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .riscontro, .riscontro__row, .rilievo { animation: none; }
    .anon--anim .oscurato::after { transform: scaleX(1); transition: none; }
  }

  /* ── PER CHI ── */
  .section-title em { font-style: normal; color: var(--color-accent); }
  .perchi { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); margin-top: var(--space-xl); }
  .perchi__card {
    padding: clamp(var(--space-lg), 3vw, var(--space-xl));
    background: var(--color-surface); border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-card); box-shadow: var(--shadow-card);
  }
  .perchi__card:last-child { background: var(--color-paper-blue); }
  .perchi__tag { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent); }
  .perchi__titolo { font-size: var(--text-xl); font-weight: 600; letter-spacing: -0.01em; margin: var(--space-xs) 0 0; max-width: 24ch; }
  .perchi__testo { color: var(--color-ink-2); line-height: 1.6; margin: var(--space-sm) 0 0; max-width: 52ch; }

  /* ── CONTROLLI ── */
  .controlli { list-style: none; margin: var(--space-xl) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
  .controllo {
    padding: var(--space-lg); border-radius: var(--radius-card);
    background: var(--color-ink-inset);
    border: var(--rule-hair) solid color-mix(in srgb, var(--color-paper) 8%, transparent);
  }
  .controllo__n { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--color-accent); }
  .controllo__titolo { font-size: var(--text-xl); font-weight: 600; margin: var(--space-xs) 0 0; }
  .controllo__cerca { font-size: var(--text-sm); line-height: 1.55; margin: var(--space-sm) 0 0; }
  .controllo__trova { list-style: none; margin: var(--space-md) 0 0; padding: var(--space-md) 0 0; border-top: 1px solid color-mix(in srgb, var(--color-paper) 10%, transparent); display: grid; gap: var(--space-xs); }
  .controllo__trova li { display: grid; grid-template-columns: auto 1fr; gap: 0.6em; font-size: var(--text-sm); line-height: 1.45; }
  .controllo__trova li::before { content: "→"; color: var(--color-accent); }

  /* ── SPLIT (riscontro, privacy) ── */
  .dvr-split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-2xl); align-items: start; }
  .dvr-split__lede { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin-top: var(--space-md); max-width: 40ch; }
  .riscontro-feat { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg) var(--space-xl); }
  .riscontro-feat li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); color: var(--color-ink-2); line-height: 1.55; font-size: var(--text-sm); }
  .riscontro-feat svg { width: 1.4rem; height: 1.4rem; color: var(--color-accent); }
  .riscontro-feat strong { display: block; color: var(--color-ink); font-size: var(--text-md); font-weight: 600; margin-bottom: 0.2rem; }

  .dvr-split--privacy { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); align-items: center; }
  .privacy p:not(.eyebrow) { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: var(--space-md) 0 0; max-width: 54ch; }

  /* Esempio di anonimizzazione: a sinistra il dato, a destra come arriva alla valutazione */
  .anon {
    margin: 0; padding: var(--space-lg);
    background: var(--color-surface); border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lift);
  }
  .anon__head, .anon__row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
  .anon__head {
    padding-bottom: var(--space-sm); border-bottom: 1px solid var(--color-rule);
    font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-muted);
  }
  .anon__head span:last-child { color: var(--color-accent); }
  .anon__list { margin: 0; }
  .anon__row { padding: var(--space-sm) 0; border-bottom: 1px solid var(--color-rule-2); align-items: end; }
  .anon__row dt {
    grid-column: 1 / -1; font-family: var(--font-mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);
  }
  .anon__row dd { margin: 0; font-size: var(--text-sm); min-width: 0; }
  .anon__da { color: var(--color-ink); }
  .oscurato { position: relative; display: inline-block; width: min(var(--w), 100%); height: 1.05em; vertical-align: middle; }
  .oscurato::after {
    content: ""; position: absolute; inset: 0; border-radius: 2px; background: var(--color-ink);
    transform-origin: left;
  }
  /* Con JS le barre si "stendono" quando la card entra nello schermo; senza JS sono già piene. */
  .anon--anim .oscurato::after { transform: scaleX(0); transition: transform 0.7s var(--ease-out); }
  .anon--anim .anon__row:nth-child(2) .oscurato::after { transition-delay: 0.15s; }
  .anon--anim .anon__row:nth-child(3) .oscurato::after { transition-delay: 0.3s; }
  .anon--anim.is-in .oscurato::after { transform: scaleX(1); }
  .anon__resta { color: var(--color-ink); font-weight: 600; }
  .anon__cap { margin-top: var(--space-sm); font-size: var(--text-xs); color: var(--color-muted); line-height: 1.5; }

  .dvr-disclaimer { margin: 0 auto; max-width: 70ch; text-align: center; font-size: var(--text-sm); color: var(--color-muted); line-height: 1.6; }

  @media (max-width: 64rem) {
    .dvr-hero__grid, .dvr-split, .dvr-split--privacy { grid-template-columns: 1fr; }
    .controlli { grid-template-columns: 1fr; }
  }
  @media (max-width: 44rem) {
    .perchi, .riscontro-feat { grid-template-columns: 1fr; }
    .riscontro__anon { display: none; }
  }
</style>

<script>
  const card = document.querySelector<HTMLElement>(".anon");
  if (card && "IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    card.classList.add("anon--anim");
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        card.classList.add("is-in");
        io.disconnect();
      }
    }, { threshold: 0.5 });
    io.observe(card);
  }
</script>
