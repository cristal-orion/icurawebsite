---
// Area riservata: per ora contiene solo l'accesso all'analizzatore DVR.
// "Apri l'analizzatore" passa da /analizzatore-dvr/apri (registra l'apertura e rimanda all'app).
import Base from "@layouts/Base.astro";
import DotGrid from "@components/DotGrid.astro";
import { utenteCorrente } from "@lib/dvr/auth";

export const prerender = false;

const utente = utenteCorrente(Astro.cookies);
if (!utente) return Astro.redirect("/analizzatore-dvr/accedi/", 303);

Astro.response.headers.set("Cache-Control", "no-store");
const benvenuto = Astro.url.searchParams.has("benvenuto");
const nome = utente.nome.split(/\s+/)[0];

const prima = [
  { t: "Il DVR in PDF", d: "Anche scansionato: le pagine-immagine si leggono con il riconoscimento del testo." },
  { t: "Meno di un minuto", d: "Per una scansione lunga ricevi un link al riscontro e puoi tornare dopo." },
  { t: "Dati oscurati, file cancellato", d: "Ragione sociale, indirizzi e nomi si oscurano prima della valutazione; il PDF si cancella appena letto." },
];
---

<Base title="La tua area · Analizzatore DVR" noindex crumb="La tua area">
  <section class="area">
    <DotGrid />
    <div class="container area__inner">
      <div class="area__top">
        <p class="eyebrow">{utente.azienda}</p>
        <form method="post" action="/analizzatore-dvr/esci/">
          <button type="submit" class="area__esci">Esci</button>
        </form>
      </div>

      <h1 class="area__title">
        Ciao, <em>{nome}</em>.
      </h1>
      <p class="area__lede">
        {benvenuto
          ? "Il tuo accesso è pronto. Apri l'analizzatore, carica il PDF del DVR e leggi il riscontro su tre punti che contano in caso di controllo."
          : "Apri l'analizzatore, carica il PDF del DVR e leggi il riscontro."}
      </p>

      <div class="tool">
        <div class="tool__body">
          <span class="tool__tag">Analizzatore DVR</span>
          <h2 class="tool__title">Verifica il tuo Documento di Valutazione dei Rischi</h2>
          <p class="tool__text">Norme citate, rischi dovuti per il settore, data, revisione e figure: per ognuno un esito con il punteggio e i rilievi segnati sulle pagine del documento.</p>
          <a href="/analizzatore-dvr/apri/" class="btn btn--primary btn--cta tool__cta" target="_blank" rel="noopener">
            Apri l'analizzatore
            <span class="btn__arrow" aria-hidden="true">↗</span>
          </a>
          <p class="tool__note">Si apre in una nuova scheda.</p>
        </div>
        <ul class="tool__prima" aria-label="Prima di cominciare">
          {prima.map((p) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
              <span><strong>{p.t}</strong>{p.d}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="area__help">
        <p><strong>Vuoi metterlo a posto?</strong> Un consulente della sicurezza legge con te il riscontro e ti dice che cosa aggiornare e in che ordine.</p>
        <a href="/contatti?da=/analizzatore-dvr" class="link-cta">Richiedi un ricontatto <span class="link-cta__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .area {
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--color-ink); color: var(--color-paper);
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .area__inner { position: relative; max-width: 60rem; }
  .area__top { display: flex; justify-content: space-between; align-items: center; gap: var(--space-md); }
  .area__top .eyebrow { margin: 0; }
  .area__esci {
    padding: 0.45rem 1rem; border-radius: var(--radius-pill); cursor: pointer;
    background: transparent; color: color-mix(in srgb, var(--color-paper) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-paper) 25%, transparent);
    font: inherit; font-size: var(--text-sm);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .area__esci:hover { background: var(--color-paper); color: var(--color-ink); }
  .area__title {
    font-size: var(--text-4xl); font-weight: 700; letter-spacing: -0.025em; line-height: 1.02;
    color: var(--color-paper); margin: var(--space-md) 0 0;
  }
  .area__title em { font-style: normal; color: var(--color-accent); }
  .area__lede {
    font-size: var(--text-lg); line-height: 1.5; max-width: 52ch; margin-top: var(--space-md);
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
  }

  .tool {
    margin-top: var(--space-2xl);
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--color-surface); color: var(--color-ink);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lift); overflow: hidden;
  }
  .tool__body { padding: clamp(var(--space-lg), 3vw, var(--space-2xl)); }
  .tool__tag {
    display: inline-block; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent);
  }
  .tool__title { font-size: var(--text-2xl); font-weight: 700; letter-spacing: -0.015em; margin: var(--space-xs) 0 0; color: var(--color-ink); max-width: 22ch; }
  .tool__text { font-size: var(--text-md); color: var(--color-ink-2); line-height: 1.55; margin: var(--space-sm) 0 0; max-width: 46ch; }
  .tool__cta { width: auto; margin-top: var(--space-lg); }
  .tool__note { font-size: var(--text-xs); color: var(--color-muted); margin: var(--space-xs) 0 0; }
  .tool__prima {
    list-style: none; margin: 0; padding: clamp(var(--space-lg), 3vw, var(--space-2xl));
    background: var(--color-paper-blue); display: grid; gap: var(--space-md); align-content: center;
  }
  .tool__prima li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-sm); font-size: var(--text-sm); color: var(--color-ink-2); line-height: 1.5; }
  .tool__prima svg { width: 1.1rem; height: 1.1rem; color: var(--color-accent); margin-top: 0.15rem; }
  .tool__prima strong { display: block; color: var(--color-ink); font-weight: 600; }

  .area__help {
    margin-top: var(--space-xl); padding-top: var(--space-lg);
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 12%, transparent);
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-md);
  }
  .area__help p { margin: 0; max-width: 56ch; color: color-mix(in srgb, var(--color-paper) 72%, transparent); }
  .area__help strong { color: var(--color-paper); }
  .area__help .link-cta { color: var(--color-paper); }

  @media (max-width: 52rem) {
    .tool { grid-template-columns: 1fr; }
  }
</style>
