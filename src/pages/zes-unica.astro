---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import AreaGrid from "@components/AreaGrid.astro";
import Steps from "@components/Steps.astro";
import Faq from "@components/Faq.astro";
import CtaBand from "@components/CtaBand.astro";

const facts = [
  { num: "fino al 60%", label: "Credito d'imposta — piccole imprese in Campania" },
  { num: "2026", label: "Investimenti ammissibili (misura fino al 2028)" },
  { num: "200.000 €", label: "Soglia minima di progetto" },
];

const finanzia = [
  {
    nome: "Macchinari e impianti",
    desc: "Acquisto di nuovi macchinari, impianti e attrezzature destinati alla struttura produttiva.",
  },
  {
    nome: "Immobili strumentali",
    desc: "Acquisto, realizzazione o ampliamento di immobili strumentali all'investimento produttivo.",
  },
  {
    nome: "Strutture produttive nel Sud",
    desc: "Investimenti in unità produttive nelle aree della ZES Unica del Mezzogiorno, Campania inclusa.",
  },
];

const fasi = [
  { n: "01", titolo: "Pre-check", desc: "Verifichiamo che impresa e investimento rientrino nei requisiti della ZES Unica. È gratuito." },
  { n: "02", titolo: "Calcolo del beneficio", desc: "Stimiamo l'aliquota applicabile e il credito d'imposta atteso sul tuo progetto." },
  { n: "03", titolo: "Comunicazione all'AdE", desc: "Prepariamo e inviamo la comunicazione all'Agenzia delle Entrate nei termini della misura." },
  { n: "04", titolo: "Certificazione e compensazione", desc: "Coordiniamo la certificazione delle spese e l'utilizzo del credito in compensazione su F24." },
];

const faq = [
  {
    q: "La mia regione rientra nella ZES Unica?",
    a: "La ZES Unica copre l'intero Mezzogiorno: Abruzzo, Basilicata, Calabria, Campania, Molise, Puglia, Sardegna e Sicilia. L'aliquota base del credito cambia da regione a regione — più alta in Campania, Puglia, Calabria e Sicilia — e si somma alla maggiorazione per piccole e medie imprese. Nel pre-check verifichiamo la tua sede e il beneficio effettivo.",
  },
  {
    q: "Quali imprese possono accedere alla ZES Unica?",
    a: "Le imprese che realizzano investimenti in beni strumentali destinati a strutture produttive nelle regioni del Mezzogiorno, Campania inclusa. L'aliquota del credito dipende dalla dimensione dell'impresa e dalla regione: per le piccole imprese in Campania può arrivare fino al 60%. Nel pre-check verifichiamo la tua posizione esatta.",
  },
  {
    q: "C'è un importo minimo di investimento?",
    a: "Sì. Il progetto deve raggiungere una soglia minima di 200.000 €. Non esiste invece un tetto unico nazionale al beneficio: conta il rispetto delle intensità di aiuto previste per dimensione e territorio, che calcoliamo noi.",
  },
  {
    q: "Come si usa concretamente il credito d'imposta?",
    a: "Non è un rimborso in denaro: è un credito che abbatte le imposte e i contributi da versare, da utilizzare in compensazione tramite modello F24. Prima dell'utilizzo serve la certificazione delle spese da parte di un revisore legale, che coordiniamo noi.",
  },
  {
    q: "Posso cumulare la ZES con altre agevolazioni?",
    a: "In molti casi sì, ma entro i limiti dell'intensità massima di aiuto e con le regole anti-doppio-finanziamento. Verificare la cumulabilità prima di investire fa parte del nostro lavoro: serve a non vedersi revocare il credito in fase di controllo.",
  },
];
---

<Base
  title="ZES Unica 2026"
  description="Credito d'imposta ZES Unica 2026: fino al 60% per le piccole imprese della Campania e del Sud sugli investimenti in beni strumentali. iCura Impresa ti segue dal pre-check alla compensazione."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Finanza agevolata · ZES Unica</p>
      <h1>ZES Unica 2026.</h1>
      <p class="lede">
        Il credito d'imposta per chi investe nel Mezzogiorno. Per le imprese della Campania è una delle occasioni più forti del 2026: noi verifichiamo se puoi accedere e seguiamo tutta la pratica.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section section--tight">
    <div class="container">
      <dl class="facts">
        {facts.map((f) => (
          <div class="fact">
            <dt class="fact__num">{f.num}</dt>
            <dd class="fact__label">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <Placeholder
        aspect="21/9"
        src="/images/finanza-zes-transizione-impianto.webp"
        alt="Consulente di finanza agevolata iCura Impresa in uno stabilimento produttivo: consulente e titolare valutano su tablet un investimento in nuovo macchinario e monitoraggio energetico, barriere di sicurezza e luce naturale, fotografia industriale documentaria"
      />
    </div>
  </section>

  <section class="section section--ink">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Cos'è</p>
        <h2>Un credito d'imposta automatico per investire al Sud.</h2>
      </div>
      <div class="prose">
        <p>
          La ZES Unica riconosce alle imprese che investono in beni strumentali nelle regioni del Mezzogiorno — Campania compresa — un credito d'imposta proporzionale all'investimento. L'aliquota dipende dalla dimensione dell'impresa e dalla regione: per le piccole imprese in Campania può arrivare fino al 60%.
        </p>
        <p>
          Vale sugli investimenti realizzati nel 2026, con una soglia minima di progetto di 200.000 €. Il credito si utilizza in compensazione tramite F24, previa certificazione delle spese da parte di un revisore.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--alt-2">
    <div class="container">
      <p class="eyebrow">Cosa puoi finanziare</p>
      <AreaGrid aree={finanzia} />
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <Steps
    eyebrow="Come ti aiutiamo"
    title="Dal pre-check alla compensazione."
    steps={fasi}
    labelledby="zes-fasi"
  />

  <section class="section section--tight">
    <div class="container">
      <p class="note">
        Aliquote esatte, finestre di domanda e adempimenti dipendono da dimensione d'impresa, regione e aggiornamenti normativi: il pre-check è gratuito e lo facciamo noi.
      </p>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <Faq
    eyebrow="Domande frequenti"
    title="Le domande che ci fanno più spesso."
    name="faq-zes"
    labelledby="zes-faq"
    items={faq}
    tone="alt-blue"
  />

  <CtaBand
    title="Verifichiamo se la tua impresa può accedere."
    lede="Pre-check gratuito · risposta entro 48 ore. Ti diciamo con onestà se conviene e quanto puoi ottenere."
    image={{
      src: "/images/home-cnc-barriera.webp",
      alt: "Consulente iCura Impresa con un imprenditore valuta un progetto di investimento agevolato: documenti e prospetti su una scrivania ordinata, ambiente ufficio luminoso, palette desaturata sobria toni navy e grigio, fotografia documentaria professionale",
    }}
    primary={{ href: "/contatti", label: "Richiedi il pre-check" }}
    labelledby="zes-cta"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header h1 {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-md);
  }
  .lede { font-size: var(--text-xl); color: var(--color-ink-2); max-width: 54ch; }

  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
  }
  .fact { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .fact__num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .fact__label { font-size: var(--text-sm); color: var(--color-ink-2); margin: 0; line-height: 1.45; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .two-col h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; max-width: 18ch; }
  .prose p { font-size: var(--text-lg); color: var(--color-ink-2); line-height: 1.55; margin: 0 0 var(--space-md); max-width: 60ch; }
  .prose p:last-child { margin-bottom: 0; }
  .note { font-size: var(--text-sm) !important; color: var(--color-muted) !important; }

  @media (max-width: 56rem) {
    .facts { grid-template-columns: 1fr; gap: var(--space-md); }
    .two-col { grid-template-columns: 1fr; }
  }
</style>
