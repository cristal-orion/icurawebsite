---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import CtaBand from "@components/CtaBand.astro";

const competenze = [
  { area: "Consulenza e Sicurezza", desc: "D.Lgs. 81/08, DVR e RSPP, cantieri e patente a crediti, HACCP, medicina del lavoro; organizzazione e deleghe di funzioni, modelli 231, GDPR, privacy e cybersecurity, ambiente." },
  { area: "Formazione", desc: "Formazione obbligatoria e di sviluppo, in aula, a distanza o in azienda; fondi interprofessionali." },
  { area: "Engineering", desc: "Progettazione edile e impiantistica, rilievi 3D con scanner SLAM, prevenzione incendi, collaudi e pratiche." },
  { area: "Sistemi di Gestione", desc: "Sistemi di gestione ISO, parità di genere, attestazione SOA e qualificazione per le gare." },
  { area: "Digitale e IA", desc: "Processi digitalizzati, app e gestionali su misura costruiti con l’intelligenza artificiale." },
  { area: "Finanza Agevolata", desc: "Bandi INAIL, ZES Unica, iper-ammortamento e fondi per la formazione: requisiti, domande, rendicontazione." },
];

const fatti = [
  { num: "2014", label: "Nasce a Napoli" },
  { num: "2018", label: "Diventa S.r.l." },
  { num: "2019", label: "Certificata ISO 9001" },
  { num: "9", label: "Persone, guidate da un ingegnere" },
];

const storia = [
  {
    anno: "2014",
    titolo: "L’inizio",
    desc: "iCuraImpresa nasce a Napoli come progetto multidisciplinare al fianco delle imprese del territorio: sicurezza sul lavoro, formazione, consulenza.",
  },
  {
    anno: "2018",
    titolo: "Diventa S.r.l.",
    desc: "La struttura cresce e si organizza in società (ICURAIMPRESA S.r.l., costituita il 26 novembre 2018), ampliando le competenze oltre la sola sicurezza.",
  },
  {
    anno: "2019",
    titolo: "Certificazione ISO 9001",
    desc: "Il sistema di gestione per la qualità di iCuraImpresa è certificato ISO 9001:2015 da un organismo accreditato: lo stesso percorso che proponiamo ai clienti, applicato a noi stessi.",
  },
  {
    anno: "2021",
    titolo: "Abilitazioni impiantistiche",
    desc: "Abilitazioni per gli impianti ai sensi del D.M. 37/2008, lettere da A a G, accertate dalla Camera di Commercio.",
  },
  {
    anno: "2025",
    titolo: "Attestazione SOA OG1",
    desc: "Qualificazione per l’esecuzione di lavori pubblici nella categoria OG1 (classifica III-bis). Il sistema di gestione ambientale è certificato ISO 14001:2015.",
  },
  {
    anno: "Oggi",
    titolo: "Una squadra",
    desc: "Consulenza, formazione, sicurezza sul lavoro, engineering, sistemi di gestione, digitale e IA, finanza agevolata: una squadra di competenze costruita intorno a ogni impresa che seguiamo.",
  },
];

const passi = [
  { t: "Ti ascoltiamo", d: "Veniamo in azienda, guardiamo e ascoltiamo: dove vuoi arrivare e che cosa ti frena." },
  { t: "Definiamo le priorità", d: "Che cosa serve subito, che cosa può aspettare, che cosa si può finanziare." },
  { t: "Costruiamo il progetto", d: "Responsabili, date, documenti e formazione: un piano chiaro, con nome e cognome." },
  { t: "Ti affianchiamo nel tempo", d: "Scadenze, verifiche, ispezioni, bandi: restiamo al tuo fianco quando cambia qualcosa." },
];

const inBreve = [
  { k: "Chi", v: "ICURAIMPRESA S.r.l., società di ingegneri, tecnici e consulenti nata a Napoli nel 2014 come progetto multidisciplinare, costituita in S.r.l. il 26 novembre 2018; nove persone (dato 2025) guidate dal fondatore, l’Ing. Francesco Egidio Rattrovo." },
  { k: "Che cosa", v: "Consulenza aziendale, formazione sulla sicurezza, sicurezza sul lavoro (DVR, RSPP, cantieri, HACCP, medicina del lavoro), engineering, sistemi di gestione ISO e SOA, digitale e IA, finanza agevolata: un referente per ogni pratica." },
  { k: "Per chi", v: "Imprese di ogni dimensione, dalla micro impresa con il primo dipendente alla PMI strutturata: edilizia e impianti, ristorazione e alimentare, studi e strutture sanitarie, officine e trasporti, industria, condomini, cooperative e terzo settore." },
  { k: "Dove", v: "Sede operativa in Corso Secondigliano 236, 80144 Napoli; sede legale in Via John Fitzgerald Kennedy 73, 80125 Napoli. Di persona a Napoli e in Campania; certificazioni, finanza agevolata, consulenza organizzativa e digitale anche a distanza in tutta Italia." },
  { k: "Credenziali", v: "ISO 9001:2015 dal 2019 e ISO 14001:2015 certificate da organismo accreditato; attestazione SOA OG1 classifica III-bis; abilitazioni impianti D.M. 37/2008 lettere A–G; attività formativa nel sistema Federdat/Ebilav con attestati tramite ente di formazione partner." },
  { k: "Come", v: "Sopralluogo in azienda, priorità condivise, preventivo scritto che dice che cosa è compreso e chi fa che cosa, affiancamento nel tempo con scadenzario. Registro delle Imprese di Napoli, REA NA-1006960, C.F. e P.IVA 09078161214; telefono 081 658 0779, info@icuraimpresa.it." },
];

const credenziali = [
  { t: "ISO 9001:2015", d: "Sistema di gestione per la qualità certificato da organismo accreditato, dal 2019." },
  { t: "ISO 14001:2015", d: "Sistema di gestione ambientale certificato da organismo accreditato." },
  { t: "Attestazione SOA OG1", d: "Qualificazione per l’esecuzione di lavori pubblici, categoria OG1, classifica III-bis." },
  { t: "Abilitazioni D.M. 37/2008", d: "Impianti, lettere da A a G, accertate dalla Camera di Commercio di Napoli." },
  { t: "Centro di formazione", d: "Attività formativa nel sistema Federdat/Ebilav; attestati rilasciati tramite ente di formazione partner." },
  { t: "Registro delle Imprese di Napoli", d: "ICURAIMPRESA S.r.l. · REA NA-1006960 · C.F. e P.IVA 09078161214." },
];
---

<Base
  title="Chi siamo: la squadra di iCuraImpresa a Napoli"
  crumb="Chi siamo"
  description="Una squadra di competenze intorno alla tua impresa. A Napoli dal 2014, S.r.l. dal 2018, ISO 9001 dal 2019, ISO 14001, SOA OG1. Un referente per pratica."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Chi siamo</p>
      <h1 class="page-header__title">
        Una squadra di competenze costruita intorno alla tua impresa.
      </h1>
      <p class="page-header__lede">
        Nati a Napoli nel 2014, società dal 2018. Ingegneri, tecnici e consulenti che fanno propri i tuoi obiettivi e li portano a compimento: un referente per ogni pratica, dal primo incontro all’ispezione.
      </p>
      <dl class="fatti" aria-label="iCuraImpresa in breve">
        {fatti.map((f) => (
          <div class="fatto">
            <dt class="fatto__num">{f.num}</dt>
            <dd class="fatto__label">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <section class="section section--alt" aria-labelledby="competenze-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">01 — Le competenze</p>
        <h2 id="competenze-heading">Aree che si parlano tra loro.</h2>
        <p class="section-lede">
          Quando un caso tocca più aree — un investimento che richiede un progetto, una valutazione dei rischi, un corso e un bando — coordiniamo internamente. Un cliente, un referente, nessun rimbalzo tra studi separati.
        </p>
      </div>
      <ul class="comp-list">
        {competenze.map((c) => (
          <li class="comp">
            <h3 class="comp__area">{c.area}</h3>
            <p class="comp__desc">{c.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="storia-heading">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">02 — La nostra storia</p>
        <h2 id="storia-heading" class="two-col__title">Al fianco delle imprese dal 2014.</h2>
      </div>
      <ol class="timeline">
        {storia.map((s) => (
          <li class="tappa">
            <span class="tappa__anno">{s.anno}</span>
            <div class="tappa__body">
              <h3 class="tappa__titolo">{s.titolo}</h3>
              <p class="tappa__desc">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="metodo" class="section" aria-labelledby="metodo-heading">
    <div class="container metodo-grid">
      <div>
        <p class="eyebrow">03 — Come lavoriamo</p>
        <h2 id="metodo-heading">I tuoi obiettivi sono la nostra passione.</h2>
      </div>
      <div class="prose">
        <p>
          Partiamo da ciò che vuoi realizzare. Mettiamo a fuoco le esigenze, colleghiamo le competenze e costruiamo insieme i prossimi passi.
        </p>
        <ol class="passi">
          {passi.map((p, i) => (
            <li class="passo">
              <span class="passo__n">{String(i + 1).padStart(2, "0")}</span>
              <div>
                <h3 class="passo__titolo">{p.t}</h3>
                <p class="passo__desc">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
        <p>
          <strong>Il nostro impegno.</strong> Attività, responsabilità e scadenze definite prima di iniziare: dopo il primo incontro ricevi un preventivo scritto che dice che cosa è compreso, che cosa no e chi fa che cosa.
        </p>
      </div>
      <Placeholder
        aspect="3/4"
        src="/images/chi-siamo-scrivania-firma.webp"
        alt="Dettaglio di una scrivania da consulente professionista: due mani adulte di etnia mediterranea che firmano un documento cartaceo con penna stilografica nera; quaderno aperto con appunti tecnici a margine, una tazza di caffè espresso sul piattino, smartphone in posizione laterale; luce naturale laterale da finestra invernale napoletana; palette calda desaturata, no laptop visibile, no piante decorative, no posa da stock photo"
        class="metodo-grid__photo"
      />
    </div>
  </section>

  <section id="team" class="section section--alt-blue team" aria-labelledby="team-heading">
    <div class="container team__grid">
      <div class="team__intro">
        <p class="eyebrow">04 — Le persone</p>
        <h2 id="team-heading" class="team__title">Rispondiamo noi. Con nome e cognome.</h2>
        <p class="team__lede">
          Una squadra di nove persone (dato 2025) guidata dal fondatore, l’Ing. Francesco Egidio Rattrovo. Ogni pratica ha un referente che la segue dall’inizio alla fine; quando serve coordiniamo medico competente, laboratori, organismi di certificazione e altri professionisti.
        </p>
        <p class="team__who">
          <strong>Ing. Francesco Egidio Rattrovo</strong><br />
          Fondatore e socio di maggioranza · ingegnere
        </p>
        <p class="team__note">
          I profili dei consulenti, con ruoli e qualifiche, saranno pubblicati con il consenso di ciascuno.
        </p>
        <a href="/lavora-con-noi" class="link-cta">
          Lavora con noi
          <span class="link-cta__arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <figure class="team-photo">
        <img
          src="/images/team-icura.webp"
          alt="Il team di iCura Impresa al completo: ingegneri, tecnici e consulenti"
          width="1100"
          height="1375"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="inbreve-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">05 — In breve</p>
        <h2 id="inbreve-heading">iCuraImpresa in dieci righe.</h2>
      </div>
      <dl class="breve">
        {inBreve.map((r) => (
          <div class="breve__row">
            <dt class="breve__k">{r.k}</dt>
            <dd class="breve__v">{r.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="dove-lavoriamo" class="section section--alt" aria-labelledby="dove-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">06 — Dove lavoriamo</p>
        <h2 id="dove-heading">A Napoli e in Campania di persona; in tutta Italia dove serve.</h2>
      </div>
      <div class="prose">
        <p>
          Sopralluoghi, corsi in aula e in azienda, cantieri e ispezioni richiedono presenza: li facciamo a Napoli e provincia e in Campania. Certificazioni ISO e SOA, finanza agevolata, consulenza organizzativa e digitale si seguono anche a distanza, con incontri in videochiamata, e le pratiche nazionali (Bando ISI, iper-ammortamento, OT23, fondi per la formazione) valgono su tutto il territorio italiano. Per le misure riservate al Mezzogiorno, come la ZES Unica, verifichiamo prima se la tua sede rientra.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="credenziali-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">07 — Credenziali</p>
        <h2 id="credenziali-heading">Quello che chiediamo ai clienti, lo facciamo anche noi.</h2>
      </div>
      <ul class="comp-list">
        {credenziali.map((c) => (
          <li class="comp">
            <h3 class="comp__area">{c.t}</h3>
            <p class="comp__desc">{c.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Raccontaci dove vuoi arrivare."
    lede="Un progetto da sviluppare, persone da formare, un’organizzazione da migliorare: iniziamo dalla tua esigenza."
    image={{
      src: "/images/chi-siamo-riunione-team.webp",
      alt: "Due consulenti iCura Impresa in videochiamata conoscitiva con un cliente: adulti in ufficio napoletano luminoso davanti a un portatile, espressione cordiale e professionale, scrivania ordinata con block-notes, palette desaturata sobria toni navy e grigio, fotografia documentaria, no posa frontale",
    }}
    primary={{ href: "/contatti", label: "Richiedi un ricontatto" }}
    secondary={{ href: "tel:+390816580779", label: "Chiama 081 658 0779" }}
    labelledby="conoscerci-heading"
  />
</Base>

<script>
  // Reveal della foto del team: tendina + zoom che si assesta.
  // Stesso gating del reveal globale: parte solo con JS e motion attivo;
  // l'effetto CSS è agganciato a html.reveal-ready, quindi senza JS o con
  // prefers-reduced-motion la foto resta subito visibile.
  if (
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const photo = document.querySelector(".team-photo");
    if (photo) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -15% 0px", threshold: 0 }
      );
      io.observe(photo);
    }
  }
</script>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header__title {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-lg);
    max-width: 18ch;
  }
  .page-header__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: 56ch;
    line-height: 1.5;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .metodo-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .metodo-grid__photo { align-self: stretch; }

  .comp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }
  .comp__area {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2xs);
  }
  .comp__desc { font-size: var(--text-md); color: var(--color-ink-2); margin: 0; }

  .section-lede {
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: 1.55;
    max-width: 44ch;
    margin: var(--space-md) 0 0;
  }

  .passi { list-style: none; margin: var(--space-lg) 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-md); }
  .passo { display: flex; gap: var(--space-md); align-items: flex-start; }
  .passo__n { flex: none; font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); letter-spacing: 0.06em; padding-top: 0.25em; }
  .passo__titolo { font-size: var(--text-lg); font-weight: 500; letter-spacing: -0.015em; margin: 0 0 var(--space-3xs); }
  .passo__desc { font-size: var(--text-md) !important; margin: 0; line-height: 1.5; }

  .breve { margin: 0; display: flex; flex-direction: column; }
  .breve__row {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) 1fr;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .breve__row:first-child { border-top: 0; padding-top: 0; }
  .breve__k { font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600; color: var(--color-accent); letter-spacing: 0.06em; text-transform: uppercase; }
  .breve__v { margin: 0; font-size: var(--text-md); color: var(--color-ink-2); line-height: 1.55; }
  @media (max-width: 40rem) {
    .breve__row { grid-template-columns: 1fr; gap: var(--space-3xs); }
  }

  .prose p {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.55;
    max-width: 60ch;
  }

  /* ───── Fatti (in breve) ───── */
  .fatti {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .fatto { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .fatto__num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-ink);
    font-feature-settings: "tnum";
  }
  .fatto__label {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.35;
  }

  /* ───── Timeline (storia) ───── */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tappa {
    display: grid;
    grid-template-columns: minmax(5rem, 7rem) 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .tappa:first-child { border-top: 0; padding-top: 0; }
  .tappa__anno {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.06em;
    padding-top: 0.2em;
  }
  .tappa__titolo {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2xs);
  }
  .tappa__desc {
    color: var(--color-ink-2);
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    max-width: 56ch;
  }
  @media (max-width: 56rem) {
    .fatti { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
    .tappa { grid-template-columns: 1fr; gap: var(--space-2xs); }
  }

  /* ───── Team ───── */
  .team__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .team__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 15ch;
  }
  .team__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.55;
    margin-top: var(--space-md);
    max-width: 46ch;
  }

  .team__who { margin: var(--space-md) 0 0; font-size: var(--text-md); color: var(--color-ink); line-height: 1.45; }
  .team__note { margin: var(--space-xs) 0 var(--space-md); font-size: var(--text-sm); color: var(--color-muted); max-width: 46ch; }

  .team-photo {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-paper-2);
    aspect-ratio: 1100 / 1375;
    box-shadow: 0 1px 0 var(--color-rule), 0 18px 40px -24px rgba(0, 0, 0, 0.35);
  }
  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Effetto reveal: tendina che si apre dall'alto + zoom che si assesta.
     Gated su html.reveal-ready (lo aggiunge lo script globale solo con JS +
     motion attivo). Senza JS o con reduced-motion la foto è subito visibile. */
  html.reveal-ready .team-photo {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1000ms var(--ease-out);
  }
  html.reveal-ready .team-photo.is-visible {
    clip-path: inset(0 0 0 0);
  }
  html.reveal-ready .team-photo img {
    transform: scale(1.18);
    transition: transform 1400ms var(--ease-out);
    will-change: transform;
  }
  html.reveal-ready .team-photo.is-visible img {
    transform: scale(1);
  }

  @media (max-width: 64rem) {
    .metodo-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .metodo-grid__photo { grid-column: 1 / -1; }
  }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
