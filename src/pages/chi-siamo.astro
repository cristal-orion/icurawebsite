---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import CtaBand from "@components/CtaBand.astro";

const competenze = [
  { area: "Ingegneria", desc: "Sicurezza tecnica, progettazione edile e impiantistica, prevenzione incendi e CPI." },
  { area: "Medicina del lavoro", desc: "Sorveglianza sanitaria, idoneità alla mansione, protocolli e medico competente." },
  { area: "Certificazioni & qualità", desc: "Sistemi di gestione ISO, Attestazione SOA, parità di genere, procedure di gara." },
  { area: "Economia", desc: "Consulenza aziendale, finanza agevolata, bandi e crediti d'imposta." },
];

const fatti = [
  { num: "2014", label: "Nasce come studio di consulenza" },
  { num: "2018", label: "Diventa S.r.l." },
  { num: "100+", label: "Imprese seguite in Italia" },
  { num: "5", label: "Aree integrate sotto un tetto" },
];

const storia = [
  {
    anno: "2014",
    titolo: "L'inizio",
    desc: "Nasce a Napoli come studio di consulenza sulla sicurezza sul lavoro, al fianco delle imprese del territorio.",
  },
  {
    anno: "2018",
    titolo: "Diventa S.r.l.",
    desc: "La struttura cresce e si organizza in società, ampliando le competenze oltre la sola sicurezza.",
  },
  {
    anno: "Oggi",
    titolo: "Cinque aree, una regia",
    desc: "Ingegneri, medici del lavoro, tecnici e commercialisti seguono oltre cento imprese su tutta Italia, da un unico interlocutore.",
  },
];
---

<Base
  title="Chi siamo"
  description="iCura Impresa: team multidisciplinare di consulenza per la sicurezza sul lavoro. Napoli, dal 2014."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Chi siamo</p>
      <h1 class="page-header__title">
        Quattro mestieri sotto un solo tetto.
      </h1>
      <p class="page-header__lede">
        Nata nel 2014, S.r.l. dal 2018. Mettiamo insieme ingegneri, medici del lavoro, tecnici e commercialisti per dare alle imprese un unico interlocutore.
      </p>
      <dl class="fatti" aria-label="iCura Impresa in breve">
        {fatti.map((f) => (
          <div class="fatto">
            <dt class="fatto__num">{f.num}</dt>
            <dd class="fatto__label">{f.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <section class="section section--alt" aria-labelledby="competenze-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">01 — Competenze</p>
        <h2 id="competenze-heading">Quattro discipline, una sola filiera.</h2>
      </div>
      <ul class="comp-list">
        {competenze.map((c) => (
          <li class="comp">
            <h3 class="comp__area">{c.area}</h3>
            <p class="comp__desc">{c.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--ink" aria-labelledby="storia-heading">
    <div class="container two-col">
      <div class="two-col__head">
        <p class="eyebrow">02 — La nostra storia</p>
        <h2 id="storia-heading" class="two-col__title">Dieci anni al fianco delle imprese.</h2>
      </div>
      <ol class="timeline">
        {storia.map((s) => (
          <li class="tappa">
            <span class="tappa__anno">{s.anno}</span>
            <div class="tappa__body">
              <h3 class="tappa__titolo">{s.titolo}</h3>
              <p class="tappa__desc">{s.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="metodo-heading">
    <div class="container metodo-grid">
      <div>
        <p class="eyebrow">03 — Metodo</p>
        <h2 id="metodo-heading">Come lavoriamo.</h2>
      </div>
      <div class="prose">
        <p>
          Un cliente, un referente. Nessun rimbalzo tra studi separati. Quando un caso tocca più aree — un infortunio con risvolti tecnici e sanitari, ad esempio — coordiniamo internamente.
        </p>
        <p>
          Il modello è quello del retainer annuale: documentazione, formazione, aggiornamenti normativi e supporto continuo a una tariffa prevedibile. Niente extra a sorpresa.
        </p>
      </div>
      <Placeholder
        aspect="3/4"
        src="/images/chi-siamo-scrivania-firma.webp"
        alt="Dettaglio di una scrivania da consulente professionista: due mani adulte di etnia mediterranea che firmano un documento cartaceo con penna stilografica nera; quaderno aperto con appunti tecnici a margine, una tazza di caffè espresso sul piattino, smartphone in posizione laterale; luce naturale laterale da finestra invernale napoletana; palette calda desaturata, no laptop visibile, no piante decorative, no posa da stock photo"
        class="metodo-grid__photo"
      />
    </div>
  </section>

  <section id="team" class="section section--alt-blue team" aria-labelledby="team-heading">
    <div class="container team__grid">
      <div class="team__intro">
        <p class="eyebrow">04 — Il team</p>
        <h2 id="team-heading" class="team__title">Conosci il nostro team di esperti.</h2>
        <p class="team__lede">
          Ingegneri, medici del lavoro, tecnici e consulenti che seguono la tua impresa in prima persona. Un solo gruppo, sotto lo stesso tetto, dal sopralluogo alla pratica.
        </p>
      </div>
      <figure class="team-photo">
        <img
          src="/images/team-icura.webp"
          alt="Il team di iCura Impresa al completo: ingegneri, medici del lavoro, tecnici e consulenti"
          width="1100"
          height="1375"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <CtaBand
    title="Vuoi conoscerci?"
    lede="Una call gratuita di 30 minuti per capire se possiamo esserti utili. Senza impegno, parliamo della tua impresa e di cosa ti serve davvero."
    image={{
      src: "/images/chi-siamo-riunione-team.webp",
      alt: "Due consulenti iCura Impresa in videochiamata conoscitiva con un cliente: adulti in ufficio napoletano luminoso davanti a un portatile, espressione cordiale e professionale, scrivania ordinata con block-notes, palette desaturata sobria toni navy e grigio, fotografia documentaria, no posa frontale",
    }}
    primary={{ href: "/contatti", label: "Prenota la call" }}
    labelledby="conoscerci-heading"
  />
</Base>

<script>
  // Reveal della foto del team: tendina + zoom che si assesta.
  // Stesso gating del reveal globale: parte solo con JS e motion attivo;
  // l'effetto CSS è agganciato a html.reveal-ready, quindi senza JS o con
  // prefers-reduced-motion la foto resta subito visibile.
  if (
    !matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window
  ) {
    const photo = document.querySelector(".team-photo");
    if (photo) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        },
        { rootMargin: "0px 0px -15% 0px", threshold: 0 }
      );
      io.observe(photo);
    }
  }
</script>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header__title {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-lg);
    max-width: 18ch;
  }
  .page-header__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: 56ch;
    line-height: 1.5;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .metodo-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .metodo-grid__photo { align-self: stretch; }

  .comp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }
  .comp__area {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2xs);
  }
  .comp__desc { font-size: var(--text-md); color: var(--color-ink-2); margin: 0; }

  .prose p {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.55;
    max-width: 60ch;
  }

  /* ───── Fatti (in breve) ───── */
  .fatti {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-lg);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .fatto { display: flex; flex-direction: column; gap: var(--space-3xs); }
  .fatto__num {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-ink);
    font-feature-settings: "tnum";
  }
  .fatto__label {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.35;
  }

  /* ───── Timeline (storia) ───── */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tappa {
    display: grid;
    grid-template-columns: minmax(5rem, 7rem) 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .tappa:first-child { border-top: 0; padding-top: 0; }
  .tappa__anno {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.06em;
    padding-top: 0.2em;
  }
  .tappa__titolo {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-2xs);
  }
  .tappa__desc {
    color: var(--color-ink-2);
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    max-width: 56ch;
  }
  @media (max-width: 56rem) {
    .fatti { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-md); }
    .tappa { grid-template-columns: 1fr; gap: var(--space-2xs); }
  }

  /* ───── Team ───── */
  .team__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .team__title {
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: -0.03em;
    max-width: 15ch;
  }
  .team__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.55;
    margin-top: var(--space-md);
    max-width: 46ch;
  }

  .team-photo {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-paper-2);
    aspect-ratio: 1100 / 1375;
    box-shadow: 0 1px 0 var(--color-rule), 0 18px 40px -24px rgba(0, 0, 0, 0.35);
  }
  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Effetto reveal: tendina che si apre dall'alto + zoom che si assesta.
     Gated su html.reveal-ready (lo aggiunge lo script globale solo con JS +
     motion attivo). Senza JS o con reduced-motion la foto è subito visibile. */
  html.reveal-ready .team-photo {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1000ms var(--ease-out);
  }
  html.reveal-ready .team-photo.is-visible {
    clip-path: inset(0 0 0 0);
  }
  html.reveal-ready .team-photo img {
    transform: scale(1.18);
    transition: transform 1400ms var(--ease-out);
    will-change: transform;
  }
  html.reveal-ready .team-photo.is-visible img {
    transform: scale(1);
  }

  @media (max-width: 64rem) {
    .metodo-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .metodo-grid__photo { grid-column: 1 / -1; }
  }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
    .metodo-grid { grid-template-columns: 1fr; }
    .comp-list { grid-template-columns: 1fr; gap: var(--space-md); }
    .team__grid { grid-template-columns: 1fr; gap: var(--space-lg); }
    .team-photo { max-width: 28rem; }
  }
</style>
