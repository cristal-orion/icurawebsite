---
import Base from "@layouts/Base.astro";
import Placeholder from "@components/Placeholder.astro";
import CtaBand from "@components/CtaBand.astro";

const competenze = [
  { area: "Ingegneria", desc: "Sicurezza tecnica, progettazione, prevenzione incendi." },
  { area: "Medicina del lavoro", desc: "Sorveglianza sanitaria, idoneità, protocolli." },
  { area: "Certificazioni & qualità", desc: "Sistemi di gestione ISO, Attestazione SOA, gare." },
  { area: "Economia", desc: "Consulenza aziendale, finanza agevolata, bandi." },
];

// TEAM — placeholder. Sostituire nome + foto reali (droppare l'immagine in
// /public/images e impostare `foto`) quando arrivano dal cliente.
const team = [
  { nome: "Nome Cognome", ruolo: "Ingegnere della sicurezza", foto: undefined, alt: "Ritratto professionale di un ingegnere della sicurezza di iCura Impresa: adulto in ufficio napoletano, camicia in toni navy, espressione cordiale e sicura, sfondo neutro sfocato, luce naturale morbida, fotografia ritrattistica professionale" },
  { nome: "Nome Cognome", ruolo: "Medico del lavoro", foto: undefined, alt: "Ritratto professionale di un medico del lavoro di iCura Impresa: adulto con abito sobrio, espressione rassicurante, sfondo neutro sfocato, luce naturale morbida, fotografia ritrattistica professionale" },
  { nome: "Nome Cognome", ruolo: "Tecnico della prevenzione", foto: undefined, alt: "Ritratto professionale di un tecnico della prevenzione di iCura Impresa: adulto in abbigliamento da lavoro sobrio, espressione concreta e affidabile, sfondo neutro sfocato, luce naturale morbida, fotografia ritrattistica professionale" },
  { nome: "Nome Cognome", ruolo: "Consulente certificazioni e qualità", foto: undefined, alt: "Ritratto professionale di una consulente certificazioni e qualità di iCura Impresa: adulta in abito formale toni grigio e navy, espressione competente, sfondo neutro sfocato, luce naturale morbida, fotografia ritrattistica professionale" },
  { nome: "Nome Cognome", ruolo: "Consulente finanza agevolata", foto: undefined, alt: "Ritratto professionale di un consulente di finanza agevolata di iCura Impresa: adulto in abito formale, espressione professionale e disponibile, sfondo neutro sfocato, luce naturale morbida, fotografia ritrattistica professionale" },
  { nome: "Nome Cognome", ruolo: "Coordinamento e amministrazione", foto: undefined, alt: "Ritratto professionale di una responsabile coordinamento e amministrazione di iCura Impresa: adulta in abito sobrio, espressione organizzata e cordiale, sfondo neutro sfocato, luce naturale morbida, fotografia ritrattistica professionale" },
];
---

<Base
  title="Chi siamo"
  description="iCura Impresa: team multidisciplinare di consulenza per la sicurezza sul lavoro. Napoli, dal 2014."
>
  <header class="page-header section">
    <div class="container">
      <p class="eyebrow">Chi siamo</p>
      <h1 class="page-header__title">
        Quattro mestieri sotto un solo tetto.
      </h1>
      <p class="page-header__lede">
        Nata nel 2014, S.r.l. dal 2018. Mettiamo insieme ingegneri, medici del lavoro, tecnici e commercialisti per dare alle imprese un unico interlocutore.
      </p>
    </div>
  </header>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="competenze-heading">
    <div class="container two-col">
      <div>
        <p class="eyebrow">01 — Competenze</p>
        <h2 id="competenze-heading">Quattro discipline, una sola filiera.</h2>
      </div>
      <ul class="comp-list">
        {competenze.map((c) => (
          <li class="comp">
            <h3 class="comp__area">{c.area}</h3>
            <p class="comp__desc">{c.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section class="section" aria-labelledby="metodo-heading">
    <div class="container metodo-grid">
      <div>
        <p class="eyebrow">02 — Metodo</p>
        <h2 id="metodo-heading">Come lavoriamo.</h2>
      </div>
      <div class="prose">
        <p>
          Un cliente, un referente. Nessun rimbalzo tra studi separati. Quando un caso tocca più aree — un infortunio con risvolti tecnici e sanitari, ad esempio — coordiniamo internamente.
        </p>
        <p>
          Il modello è quello del retainer annuale: documentazione, formazione, aggiornamenti normativi e supporto continuo a una tariffa prevedibile. Niente extra a sorpresa.
        </p>
      </div>
      <Placeholder
        aspect="3/4"
        src="/images/chi-siamo-scrivania-firma.webp"
        alt="Dettaglio di una scrivania da consulente professionista: due mani adulte di etnia mediterranea che firmano un documento cartaceo con penna stilografica nera; quaderno aperto con appunti tecnici a margine, una tazza di caffè espresso sul piattino, smartphone in posizione laterale; luce naturale laterale da finestra invernale napoletana; palette calda desaturata, no laptop visibile, no piante decorative, no posa da stock photo"
        class="metodo-grid__photo"
      />
    </div>
  </section>

  <hr class="rule" aria-hidden="true" />

  <section id="team" class="section" aria-labelledby="team-heading">
    <div class="container">
      <header class="team-head">
        <p class="eyebrow">03 — Il team</p>
        <h2 id="team-heading">Le persone, non solo le pratiche.</h2>
        <p class="team-head__lede">
          Ingegneri, medici del lavoro, tecnici e consulenti che seguono la tua impresa in prima persona.
        </p>
      </header>
      <ul class="team-grid">
        {team.map((m) => (
          <li class="team-card">
            <Placeholder aspect="3/4" src={m.foto} alt={m.alt} />
            <h3 class="team-card__name">{m.nome}</h3>
            <p class="team-card__role">{m.ruolo}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    title="Vuoi conoscerci?"
    lede="Una call gratuita di 30 minuti per capire se possiamo esserti utili. Senza impegno, parliamo della tua impresa e di cosa ti serve davvero."
    image={{
      alt: "Due consulenti iCura Impresa in videochiamata conoscitiva con un cliente: adulti in ufficio napoletano luminoso davanti a un portatile, espressione cordiale e professionale, scrivania ordinata con block-notes, palette desaturata sobria toni navy e grigio, fotografia documentaria, no posa frontale",
    }}
    primary={{ href: "/contatti", label: "Prenota la call" }}
    labelledby="conoscerci-heading"
  />
</Base>

<style>
  .page-header { padding-block: var(--space-4xl) var(--space-xl); }
  .page-header__title {
    font-size: var(--text-display-s);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    margin-bottom: var(--space-lg);
    max-width: 18ch;
  }
  .page-header__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    max-width: 56ch;
    line-height: 1.5;
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .metodo-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 5fr) minmax(0, 3fr);
    gap: var(--space-xl);
    align-items: start;
  }
  .metodo-grid__photo { align-self: stretch; }

  .comp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-xl);
  }
  .comp__area {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2xs);
  }
  .comp__desc { font-size: var(--text-md); color: var(--color-ink-2); margin: 0; }

  .prose p {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.55;
    max-width: 60ch;
  }

  /* ───── Team ───── */
  .team-head { margin-bottom: var(--space-xl); max-width: 52ch; }
  .team-head__lede {
    font-size: var(--text-lg);
    color: var(--color-ink-2);
    line-height: 1.5;
    margin-top: var(--space-sm);
  }
  .team-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-lg);
  }
  .team-card :global(.placeholder) {
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: var(--space-sm);
  }
  .team-card__name {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .team-card__role {
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin: var(--space-3xs) 0 0;
  }

  @media (max-width: 64rem) {
    .metodo-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    .metodo-grid__photo { grid-column: 1 / -1; }
  }

  @media (max-width: 56rem) {
    .two-col { grid-template-columns: 1fr; }
    .metodo-grid { grid-template-columns: 1fr; }
    .comp-list { grid-template-columns: 1fr; gap: var(--space-md); }
    .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }
  }
</style>
