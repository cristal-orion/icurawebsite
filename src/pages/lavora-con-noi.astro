---
import Base from "@layouts/Base.astro";

const motivi = [
  {
    titolo: "Lavoro sul campo",
    desc: "Cantieri, capannoni, aziende vere. Non si timbra una scrivania: si va a vedere, misurare, risolvere.",
  },
  {
    titolo: "Crescita multidisciplinare",
    desc: "Sicurezza, engineering, certificazioni, finanza agevolata. Tocchi più aree e impari un mestiere completo.",
  },
  {
    titolo: "Un team, non silos",
    desc: "Affianchi consulenti senior dal primo giorno. Si impara facendo, con chi quel lavoro lo fa da anni.",
  },
  {
    titolo: "Formazione continua",
    desc: "Siamo anche un ente di formazione: aggiornamento tecnico e normativo è parte del lavoro, non un extra.",
  },
];
---

<Base
  title="Lavora con noi"
  description="Lavora con iCura Impresa: posizioni aperte per tecnici della sicurezza, consulenti ISO, ingegneri e consulenti di finanza agevolata. Completa il questionario attitudinale, bastano 5 minuti."
  pageClass="page-lavora"
>
  {/* ───── Hero split (clinico-tech) ───── */}
  <section class="lavora-hero" aria-labelledby="lavora-heading">
    <div class="lavora-hero__card">
      <div class="lavora-hero__media group">
        <img
          src="/images/lavora-team-industriale.webp"
          alt="Squadra iCura Impresa al lavoro in un contesto industriale"
          class="media-grayscale"
          loading="eager"
          decoding="async"
        />
        <div class="lavora-hero__veil" aria-hidden="true"></div>
      </div>

      <div class="lavora-hero__panel">
        <p class="lavora-hero__eyebrow">Carriere · Cantieri · Aziende</p>
        <h1 id="lavora-heading" class="lavora-hero__title">
          Cerchiamo persone <span class="accent">che fanno sul serio.</span>
        </h1>
        <p class="lavora-hero__lede">
          Ingegneri, tecnici della sicurezza, consulenti e profili junior. In iCura Impresa il lavoro è concreto e multidisciplinare: squadre che vanno sul posto e risolvono, non scrivanie isolate.
        </p>

        <div class="lavora-hero__ctas">
          <a href="#posizioni" class="lavora-hero__cta-primary">Vedi le posizioni</a>
          <a href="#perche-noi" class="lavora-hero__cta-link">
            Perché lavorare con noi
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <dl class="lavora-hero__metrics">
          <div class="metric"><dt class="metric__n">2014</dt><dd class="metric__label">Fondazione</dd></div>
          <div class="metric"><dt class="metric__n">100+</dt><dd class="metric__label">Imprese seguite</dd></div>
          <div class="metric"><dt class="metric__n">5</dt><dd class="metric__label">Aree integrate</dd></div>
          <div class="metric"><dt class="metric__n">Napoli</dt><dd class="metric__label">Sede operativa</dd></div>
        </dl>
      </div>
    </div>
  </section>

  {/* ───── Perché lavorare con noi ───── */}
  <section class="section section--alt why" id="perche-noi" aria-labelledby="why-heading">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">01 — Perché noi</p>
        <h2 id="why-heading" class="section-head__title">Un mestiere vero, non una scrivania.</h2>
      </header>
      <ol class="why__list">
        {motivi.map((m, i) => (
          <li class="why__item">
            <span class="why__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="why__title">{m.titolo}</h3>
            <p class="why__desc">{m.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ───── Posizioni + selezionatore ───── */}
  <section id="posizioni" class="section section--alt-blue positions" aria-labelledby="positions-heading">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">02 — Posizioni aperte</p>
        <h2 id="positions-heading" class="section-head__title">Trova il tuo ruolo.</h2>
        <p class="section-head__desc">
          Scegli la posizione di interesse e completa un breve questionario attitudinale. Bastano 5 minuti.
        </p>
      </header>

      {/* Profile cards — renderizzate via JS dal foglio "Posizioni" (fallback incluso) */}
      <div class="profiles-grid" id="profilesGrid">
        <div class="profiles-loading" id="profilesLoading">
          <div class="profiles-spinner"></div>
          <p>Carico le posizioni aperte…</p>
        </div>
      </div>

      <div class="profiles-controls" id="profilesControls" hidden>
        <div class="profiles-pager" id="profilesPager">
          <button class="profiles-pager-btn" id="profilesPrev" type="button" aria-label="Posizioni precedenti">←</button>
          <span class="profiles-pager-status" id="profilesPagerStatus">1 / 1</span>
          <button class="profiles-pager-btn" id="profilesNext" type="button" aria-label="Posizioni successive">→</button>
        </div>
        <button class="profiles-loadmore" id="profilesLoadMore" type="button">Mostra altre posizioni</button>
      </div>

      {/* Questionario */}
      <div class="questionnaire" id="questionnaire" style="display:none;">
        <div class="q-header">
          <button class="q-back" id="qBack" title="Torna indietro" type="button">
            <span aria-hidden="true">←</span><span class="q-back-label">Indietro</span>
          </button>
          <div class="q-progress-wrap">
            <div class="q-progress-bar"><div class="q-progress-fill" id="qProgress"></div></div>
            <span class="q-progress-text" id="qProgressText">1 / 17</span>
          </div>
          <span class="q-profile-badge" id="qProfileBadge"></span>
        </div>
        <div class="q-body" id="qBody">
          <div class="q-question-wrap" id="qQuestionWrap">
            <span class="q-step-label" id="qStepLabel"></span>
            <h3 class="q-question" id="qQuestion"></h3>
            <p class="q-hint" id="qHint"></p>
            <div class="q-options" id="qOptions"></div>
          </div>
        </div>
      </div>

      {/* Esito */}
      <div class="result" id="resultScreen" style="display:none;">
        <div class="result-card" id="resultCard">
          <div class="result-icon" id="resultIcon"></div>
          <h3 id="resultTitle"></h3>
          <p id="resultMessage"></p>
          <button class="btn btn--primary" id="resultBtn" style="display:none;"></button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // ===== POSIZIONI: fallback se l'Apps Script non risponde / non configurato =====
  const FALLBACK_POSITIONS = [
    { id: 'hse', titolo: 'Tecnico della sicurezza (HSE)',
      descrizione: 'Sopralluoghi, redazione DVR, coordinamento sicurezza in cantiere presso le aziende clienti.',
      ral: '€ 22.000 – 30.000', location: 'Napoli + cantieri', ordine: 10 },
    { id: 'iso', titolo: 'Consulente certificazioni ISO',
      descrizione: 'Implementazione di sistemi di gestione 9001/14001/45001, preparazione audit, supporto alle imprese.',
      ral: '€ 24.000 – 32.000', location: 'Napoli', ordine: 20 },
    { id: 'eng', titolo: 'Ingegnere / progettista junior',
      descrizione: 'Progettazione edile e impiantistica, pratiche, prevenzione incendi. Crescita affiancando il team tecnico.',
      ral: '€ 20.000 – 28.000', location: 'Napoli', ordine: 30 },
    { id: 'finanza', titolo: 'Consulente finanza agevolata',
      descrizione: 'Bandi, domande e rendicontazione: dalla lettura dell’avviso pubblico alla chiusura della pratica.',
      ral: '€ 22.000 – 30.000', location: 'Napoli', ordine: 40 },
    { id: 'spontanea', titolo: 'Candidatura spontanea',
      descrizione: 'Non hai trovato una posizione in linea con il tuo profilo? Inviaci comunque la tua candidatura.',
      ral: 'Da valutare', location: 'Napoli', ordine: 100 }
  ];

  const POSITION_ICONS = {
    hse:       '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>',
    iso:       '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>',
    eng:       '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 20h20"/><path d="M4 20V8l8-5 8 5v12"/><path d="M10 20v-6h4v6"/></svg>',
    finanza:   '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
    spontanea: '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    _default:  '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>'
  };

  let POSITIONS_LIST = [];
  let POSITIONS = {};

  // ===== QUESTIONARIO — 16 DOMANDE (4 opzioni universali) =====
  const ANSWER_OPTIONS = [
    { label: 'Sì / più sì che no',        value: 'si' },
    { label: 'Incerto / forse',           value: 'incerto' },
    { label: 'No / più no che sì',        value: 'no' },
    { label: 'Preferisco non rispondere', value: 'na' }
  ];

  // Q1–12 generiche (psico-attitudinali) · Q13–16 fit settore icura.
  // Lo scoring (dim/ideal/critical per id) vive nel backend Code.gs.
  const QUESTIONS = [
    { id: 1,  text: 'Le persone si accendono e si entusiasmano quando ti ascoltano?' },
    { id: 2,  text: 'Ci sono molte persone che ti seguirebbero, qualunque cosa tu decida di fare?' },
    { id: 3,  text: 'Hai difficoltà a convincere gli altri ad accettare i tuoi progetti e le tue idee?' },
    { id: 4,  text: 'Le interferenze esterne riescono facilmente a distoglierti da ciò che stai facendo?' },
    { id: 5,  text: 'Tendi a essere timido o riservato con persone che non conosci?' },
    { id: 6,  text: 'Guardando al futuro, pensi che ci siano cose che dovresti affrontare in modo diverso?' },
    { id: 7,  text: 'Ti ritrovi spesso a completare le attività all’ultimo momento utile?' },
    { id: 8,  text: 'Senti che la timidezza limita spesso le tue possibilità o le tue scelte?' },
    { id: 9,  text: 'Quando qualcuno vuole incontrarti, riesci già in anticipo a intuire ciò che ti dirà?' },
    { id: 10, text: 'Preferisci che le cose vengano fatte esattamente come indichi, piuttosto che adattarti agli altri?' },
    { id: 11, text: 'Ti capita di dire agli altri come fare le cose, anche dove la tua esperienza è limitata?' },
    { id: 12, text: 'Un buon leader deve saper sacrificare il bene del singolo quando serve per il bene del gruppo?' },
    { id: 13, text: 'Ti dà più energia stare a contatto con imprese, cantieri e aziende — vedere i problemi sul posto — che lavorare solo dietro una scrivania?' },
    { id: 14, text: 'Il tema della sicurezza sul lavoro e della tutela delle persone in azienda è qualcosa che senti vicino ai tuoi valori?' },
    { id: 15, text: 'Sei disponibile a spostarti per sopralluoghi e visite presso le aziende clienti, anche fuori sede?' },
    { id: 16, text: 'Quando emergono imprevisti normativi o tecnici, ti senti a tuo agio nel trovare soluzioni pratiche in tempi stretti?' }
  ];

  // ===== Endpoint webhook Apps Script (vedi apps-script/DEPLOY.md) =====
  const WEBHOOK_URL = 'https://script.google.com/macros/s/AKfycbzKIFU-S3n2BxKKIkhvDdwIMPhSz_nplg8y7Wnve2S8mvSfTRET6ir1Z_a6wwzU86CJxQ/exec';

  // ===== STATE =====
  // step -1 = intro, step 0 = contatti, step 1..16 = domanda
  let selectedPosition = null;
  let currentStep = -1;
  let contact = { nome: '', cognome: '', email: '', telefono: '', citta: '' };
  let answers = new Array(QUESTIONS.length).fill(null);
  let questionStartTime = 0;
  const TOTAL_STEPS = QUESTIONS.length + 1; // contatti + 16 domande

  // ===== DOM =====
  const profilesGrid = document.getElementById('profilesGrid');
  const profilesControls = document.getElementById('profilesControls');
  const profilesPrev = document.getElementById('profilesPrev');
  const profilesNext = document.getElementById('profilesNext');
  const profilesPagerStatus = document.getElementById('profilesPagerStatus');
  const profilesLoadMore = document.getElementById('profilesLoadMore');
  const questionnaire = document.getElementById('questionnaire');
  const qBack = document.getElementById('qBack');
  const qProgress = document.getElementById('qProgress');
  const qProgressText = document.getElementById('qProgressText');
  const qProfileBadge = document.getElementById('qProfileBadge');
  const qQuestionWrap = document.getElementById('qQuestionWrap');
  const qStepLabel = document.getElementById('qStepLabel');
  const qQuestion = document.getElementById('qQuestion');
  const qHint = document.getElementById('qHint');
  const qOptions = document.getElementById('qOptions');
  const qProgressWrap = qProgress.closest('.q-progress-wrap');
  const resultScreen = document.getElementById('resultScreen');

  function escapeHtml(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function escapeAttr(s) { return String(s || '').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }
  function ralLabel(value) { return /\d/.test(String(value || '')) ? 'RAL' : 'Contratto'; }

  // ===== Selezione posizione =====
  profilesGrid.addEventListener('click', (e) => {
    const card = e.target.closest('[data-profile]');
    if (!card) return;
    startQuiz(card.dataset.profile);
  });

  // ===== Caricamento posizioni (con paginazione) =====
  const PROFILES_PAGE_SIZE = 6;
  let profilesPage = 0;
  let profilesMobileShown = PROFILES_PAGE_SIZE;
  const isMobileLayout = () => window.matchMedia('(max-width: 48rem)').matches;
  const totalPages = () => Math.max(1, Math.ceil(POSITIONS_LIST.length / PROFILES_PAGE_SIZE));

  function cardHtml(p) {
    const icon = POSITION_ICONS[p.id] || POSITION_ICONS._default;
    return `
      <button class="profile-card" data-profile="${escapeAttr(p.id)}">
        <div class="profile-meta">
          <span class="profile-badge-type">Full time</span>
          <span class="profile-badge-loc">${escapeHtml(p.location || 'Napoli')}</span>
        </div>
        <div class="profile-icon">${icon}</div>
        <h3>${escapeHtml(p.titolo)}</h3>
        <p>${escapeHtml(p.descrizione)}</p>
        <div class="profile-footer">
          <div class="profile-ral">
            <span class="ral-label">${ralLabel(p.ral)}</span>
            <span class="ral-value">${escapeHtml(p.ral || '—')}</span>
          </div>
          <span class="profile-cta">Candidati <span aria-hidden="true">→</span></span>
        </div>
      </button>`;
  }

  function updateProfilesControls() {
    const total = POSITIONS_LIST.length;
    if (total <= PROFILES_PAGE_SIZE) { profilesControls.hidden = true; return; }
    profilesControls.hidden = false;
    const pages = totalPages();
    if (profilesPage > pages - 1) profilesPage = pages - 1;
    profilesPagerStatus.textContent = `${profilesPage + 1} / ${pages}`;
    profilesPrev.disabled = profilesPage <= 0;
    profilesNext.disabled = profilesPage >= pages - 1;
    if (isMobileLayout()) {
      profilesLoadMore.style.display = profilesMobileShown >= total ? 'none' : '';
    }
  }

  function renderProfilesGrid() {
    if (!POSITIONS_LIST.length) {
      profilesGrid.innerHTML = '<div class="profiles-empty">Nessuna posizione aperta al momento. Torna a trovarci presto.</div>';
      profilesControls.hidden = true;
      return;
    }
    const total = POSITIONS_LIST.length;
    let visible;
    if (isMobileLayout()) visible = POSITIONS_LIST.slice(0, Math.min(profilesMobileShown, total));
    else if (total > PROFILES_PAGE_SIZE) visible = POSITIONS_LIST.slice(profilesPage * PROFILES_PAGE_SIZE, profilesPage * PROFILES_PAGE_SIZE + PROFILES_PAGE_SIZE);
    else visible = POSITIONS_LIST;
    profilesGrid.innerHTML = visible.map(cardHtml).join('');
    updateProfilesControls();
  }

  profilesPrev.addEventListener('click', () => { if (profilesPage > 0) { profilesPage--; renderProfilesGrid(); } });
  profilesNext.addEventListener('click', () => { if (profilesPage < totalPages() - 1) { profilesPage++; renderProfilesGrid(); } });
  profilesLoadMore.addEventListener('click', () => { profilesMobileShown += PROFILES_PAGE_SIZE; renderProfilesGrid(); });
  let _resizeTimer = null;
  window.addEventListener('resize', () => {
    clearTimeout(_resizeTimer);
    _resizeTimer = setTimeout(() => { if (POSITIONS_LIST.length > PROFILES_PAGE_SIZE) renderProfilesGrid(); }, 150);
  });

  function applyPositions(list) {
    POSITIONS_LIST = (list || []).slice().sort((a, b) => (a.ordine - b.ordine) || a.titolo.localeCompare(b.titolo));
    POSITIONS = {};
    for (const p of POSITIONS_LIST) POSITIONS[p.id] = p.titolo;
  }

  async function loadPositions() {
    let list = null;
    if (WEBHOOK_URL) {
      try {
        const res = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify({ action: 'list_positions' })
        });
        if (res.ok) {
          const data = await res.json();
          if (data && data.ok && Array.isArray(data.positions) && data.positions.length) list = data.positions;
        }
      } catch (err) { console.warn('Fallback posizioni hardcoded:', err); }
    }
    applyPositions(list || FALLBACK_POSITIONS);
    renderProfilesGrid();
  }

  applyPositions(FALLBACK_POSITIONS);
  loadPositions();

  // ===== Flusso questionario =====
  function startQuiz(positionKey) {
    selectedPosition = positionKey;
    currentStep = -1;
    contact = { nome: '', cognome: '', email: '', telefono: '', citta: '' };
    answers = new Array(QUESTIONS.length).fill(null);
    profilesGrid.style.display = 'none';
    profilesControls.hidden = true;
    resultScreen.style.display = 'none';
    questionnaire.style.display = 'block';
    qProfileBadge.textContent = POSITIONS[selectedPosition] || '';
    questionnaire.scrollIntoView({ behavior: 'smooth', block: 'center' });
    renderStep();
  }

  function renderStep() {
    if (currentStep === -1) {
      qProgressWrap.style.visibility = 'hidden';
      qProgress.style.width = '0%';
    } else {
      qProgressWrap.style.visibility = 'visible';
      qProgress.style.width = (((currentStep + 1) / TOTAL_STEPS) * 100) + '%';
      qProgressText.textContent = `${currentStep + 1} / ${TOTAL_STEPS}`;
    }
    qQuestionWrap.style.animation = 'none';
    void qQuestionWrap.offsetHeight;
    qQuestionWrap.style.animation = 'qFadeIn 0.35s var(--ease-out)';

    if (currentStep === -1) renderIntroStep();
    else if (currentStep === 0) renderContactStep();
    else renderQuestionStep(currentStep - 1);
  }

  function renderIntroStep() {
    qStepLabel.textContent = 'Prima di iniziare';
    qQuestion.textContent = 'Come funziona il questionario';
    qHint.style.display = 'none';
    qOptions.classList.remove('q-options--quiz');
    qOptions.innerHTML = `
      <ol class="q-intro-steps">
        <li class="q-intro-step"><span class="q-intro-num">1</span><div class="q-intro-text"><strong>I tuoi dati</strong><span>Nome, contatti e posizione di interesse. Meno di un minuto.</span></div></li>
        <li class="q-intro-step"><span class="q-intro-num">2</span><div class="q-intro-text"><strong>16 domande attitudinali</strong><span>Una alla volta, con 4 opzioni di risposta. Non ci sono risposte giuste o sbagliate: rispondi onestamente.</span></div></li>
        <li class="q-intro-step"><span class="q-intro-num">3</span><div class="q-intro-text"><strong>Esito</strong><span>Se il profilo è in linea con la posizione, il nostro team ti ricontatterà per i passi successivi.</span></div></li>
      </ol>
      <div class="q-intro-meta">
        <span class="q-intro-meta-item">~ 5 minuti</span>
        <span class="q-intro-meta-item">Dati protetti (GDPR)</span>
        <span class="q-intro-meta-item">Puoi tornare indietro</span>
      </div>
      <button class="btn btn--primary q-fullbtn" id="qIntroStart" type="button">Inizia ora <span class="btn__arrow" aria-hidden="true">→</span></button>`;
    document.getElementById('qIntroStart').addEventListener('click', () => { currentStep = 0; renderStep(); });
  }

  function renderContactStep() {
    qStepLabel.textContent = 'I tuoi dati';
    qQuestion.textContent = 'Iniziamo con qualche informazione su di te';
    qHint.textContent = 'Useremo questi dati solo per ricontattarti.';
    qHint.style.display = '';
    qOptions.classList.remove('q-options--quiz');
    const positionOptions = POSITIONS_LIST
      .map(p => `<option value="${escapeAttr(p.id)}" ${p.id === selectedPosition ? 'selected' : ''}>${escapeHtml(p.titolo)}</option>`)
      .join('');
    qOptions.innerHTML = `
      <div class="q-input-row">
        <div class="q-input-group"><label for="qNome">Nome *</label><input type="text" id="qNome" class="q-input" placeholder="Mario" value="${escapeAttr(contact.nome)}" /></div>
        <div class="q-input-group"><label for="qCognome">Cognome *</label><input type="text" id="qCognome" class="q-input" placeholder="Rossi" value="${escapeAttr(contact.cognome)}" /></div>
      </div>
      <div class="q-input-group"><label for="qEmail">Email *</label><input type="email" id="qEmail" class="q-input" placeholder="mario.rossi@email.com" value="${escapeAttr(contact.email)}" /></div>
      <div class="q-input-row">
        <div class="q-input-group"><label for="qTelefono">Telefono *</label><input type="tel" id="qTelefono" class="q-input" placeholder="+39 333 1234567" value="${escapeAttr(contact.telefono)}" /></div>
        <div class="q-input-group"><label for="qCitta">Città *</label><input type="text" id="qCitta" class="q-input" placeholder="Napoli" value="${escapeAttr(contact.citta)}" /></div>
      </div>
      <div class="q-input-group"><label for="qPosizione">Posizione di interesse *</label><select id="qPosizione" class="q-input">${positionOptions}</select></div>
      <label class="q-consent" id="qConsentBox">
        <input type="checkbox" id="qPrivacy" />
        <span class="q-consent-text">Accetto il trattamento dei miei dati personali per finalità di selezione del personale, ai sensi del GDPR (Reg. UE 2016/679). <a href="/privacy">Leggi l'informativa</a>.</span>
      </label>
      <div class="q-consent-error" id="qContactError"></div>
      <button class="btn btn--primary q-fullbtn" id="qStart" type="button">Inizia il questionario <span class="btn__arrow" aria-hidden="true">→</span></button>`;
    document.getElementById('qStart').addEventListener('click', handleContactSubmit);
  }

  function showContactError(msg) { const el = document.getElementById('qContactError'); if (el) { el.textContent = msg; el.classList.add('visible'); } }
  function clearContactError() { const el = document.getElementById('qContactError'); if (el) el.classList.remove('visible'); }

  function renderQuestionStep(qIndex) {
    const q = QUESTIONS[qIndex];
    qStepLabel.textContent = `Domanda ${qIndex + 1} di ${QUESTIONS.length}`;
    qQuestion.textContent = q.text;
    qHint.style.display = 'none';
    qOptions.innerHTML = '';
    qOptions.classList.add('q-options--quiz');
    ANSWER_OPTIONS.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'q-option';
      btn.innerHTML = `<span class="q-option-label">${opt.label}</span><span class="q-option-check" aria-hidden="true">✓</span>`;
      if (answers[qIndex] && answers[qIndex].value === opt.value) btn.classList.add('selected');
      btn.addEventListener('click', () => handleAnswer(qIndex, opt.value, i));
      qOptions.appendChild(btn);
    });
    questionStartTime = performance.now();
  }

  async function handleContactSubmit() {
    clearContactError();
    const nome = document.getElementById('qNome').value.trim();
    const cognome = document.getElementById('qCognome').value.trim();
    const email = document.getElementById('qEmail').value.trim();
    const telefono = document.getElementById('qTelefono').value.trim();
    const citta = document.getElementById('qCitta').value.trim();
    const posizione = document.getElementById('qPosizione').value;
    const privacyAccepted = document.getElementById('qPrivacy').checked;

    if (!nome || !cognome || !email || !telefono || !citta) { showContactError('Compila tutti i campi obbligatori.'); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showContactError('Inserisci un indirizzo email valido.'); return; }
    if (!privacyAccepted) { showContactError('Per procedere devi accettare l’informativa privacy.'); return; }

    const btn = document.getElementById('qStart');
    const originalHTML = btn.innerHTML;
    btn.disabled = true;
    btn.textContent = 'Verifica in corso…';
    try {
      const dup = await checkDuplicate(email, telefono);
      if (dup === 'exists') {
        showContactError('Risulta già una candidatura con questa email o numero di telefono. Il questionario può essere svolto una sola volta.');
        btn.disabled = false; btn.innerHTML = originalHTML; return;
      }
    } catch (_) { /* in caso di errore di rete lasciamo procedere: dedup garantito al submit */ }

    contact = { nome, cognome, email, telefono, citta };
    selectedPosition = posizione;
    qProfileBadge.textContent = POSITIONS[selectedPosition] || '';
    currentStep = 1;
    renderStep();
  }

  async function checkDuplicate(email, telefono) {
    if (!WEBHOOK_URL) return 'unknown';
    const res = await fetch(WEBHOOK_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' },
      body: JSON.stringify({ action: 'check_duplicate', email, telefono })
    });
    if (!res.ok) throw new Error('check_duplicate http ' + res.status);
    const data = await res.json();
    return (data && data.ok && data.exists) ? 'exists' : 'ok';
  }

  function handleAnswer(qIndex, value, optionIdx) {
    const opts = qOptions.querySelectorAll('.q-option');
    opts.forEach(o => o.classList.remove('selected'));
    opts[optionIdx].classList.add('selected');
    const timeMs = questionStartTime ? Math.round(performance.now() - questionStartTime) : null;
    answers[qIndex] = { questionId: QUESTIONS[qIndex].id, value, timeMs };
    setTimeout(() => {
      if (qIndex + 1 < QUESTIONS.length) { currentStep++; renderStep(); }
      else submitCandidatura();
    }, 320);
  }

  async function submitCandidatura() {
    const payload = {
      posizione: POSITIONS[selectedPosition] || selectedPosition,
      posizioneKey: selectedPosition,
      contatto: contact,
      risposte: answers.map(a => a || { questionId: null, value: null, timeMs: null }),
      timestamp: new Date().toISOString(),
      userAgent: navigator.userAgent
    };
    console.log('Candidatura payload:', payload);
    let outcome = 'ok';
    if (WEBHOOK_URL) {
      try {
        const res = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) outcome = 'error';
        else {
          const data = await res.json().catch(() => ({}));
          if (data && data.ok === false && data.error === 'already_submitted') outcome = 'duplicate';
          else if (data && data.ok === false) outcome = 'error';
        }
      } catch (err) { console.error('Errore invio candidatura:', err); outcome = 'error'; }
    }
    showThankYou(outcome);
  }

  function showThankYou(outcome) {
    questionnaire.style.display = 'none';
    resultScreen.style.display = 'block';
    const icon = document.getElementById('resultIcon');
    const title = document.getElementById('resultTitle');
    const message = document.getElementById('resultMessage');
    const btn = document.getElementById('resultBtn');

    if (outcome === 'ok') {
      icon.className = 'result-icon success';
      icon.textContent = '✓';
      title.textContent = 'Grazie, abbiamo ricevuto la tua candidatura';
      message.textContent = 'Il nostro team valuterà il tuo profilo nei prossimi giorni. Se sarà in linea con le nostre ricerche, ti contatteremo per i passi successivi.';
      btn.textContent = 'Torna alle posizioni';
      btn.onclick = resetAll;
    } else if (outcome === 'duplicate') {
      icon.className = 'result-icon warning';
      icon.textContent = '!';
      title.textContent = 'Hai già completato il questionario';
      message.textContent = 'Risulta già una candidatura con la tua email o il tuo telefono. Il questionario può essere svolto una sola volta.';
      btn.textContent = 'Torna alle posizioni';
      btn.onclick = resetAll;
    } else {
      icon.className = 'result-icon warning';
      icon.textContent = '!';
      title.textContent = 'Qualcosa è andato storto';
      message.textContent = 'Non siamo riusciti a inviare la candidatura. Riprova tra qualche minuto oppure scrivici via email.';
      btn.textContent = 'Riprova';
      btn.onclick = () => { resultScreen.style.display = 'none'; questionnaire.style.display = 'block'; };
    }
    btn.style.display = 'inline-flex';
    resultScreen.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  qBack.addEventListener('click', () => {
    if (currentStep <= -1) resetAll();
    else { currentStep--; renderStep(); }
  });

  function resetAll() {
    selectedPosition = null;
    currentStep = -1;
    contact = { nome: '', cognome: '', email: '', telefono: '', citta: '' };
    answers = new Array(QUESTIONS.length).fill(null);
    questionnaire.style.display = 'none';
    resultScreen.style.display = 'none';
    profilesGrid.style.display = 'grid';
    renderProfilesGrid();
    profilesGrid.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
</script>

