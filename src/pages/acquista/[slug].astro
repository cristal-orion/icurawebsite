---
import Base from "@layouts/Base.astro";
import DotGrid from "@components/DotGrid.astro";
import { offerte, tipi, euro, conIva, type Offerta } from "../../data/acquista";

export function getStaticPaths() {
  return offerte.map((o) => ({ params: { slug: o.slug }, props: { o } }));
}

const { o } = Astro.props as { o: Offerta };
const tipo = tipi[o.tipo];
// Quantità solo dove il prezzo è "a partecipante".
const perPersona = o.unita === "partecipante";
const correlate = offerte.filter((x) => x.tipo === o.tipo && x.slug !== o.slug).slice(0, 3);
const titoloBreve = o.titolo.replace(/\s*\(.*\)\s*$/, "");
const briefPlaceholder =
  o.tipo === "corso_calendario"
    ? "Nomi dei partecipanti (anche dopo), periodo preferito, sede"
    : o.tipo === "consulenza"
      ? "Le domande che vuoi fare e 2-3 date possibili"
      : "Situazione attuale, documenti disponibili, referente";

const productLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: o.titolo,
  description: o.lede,
  provider: { "@id": new URL("/#organization", Astro.site).href },
  offers: {
    "@type": "Offer",
    price: o.prezzo.toFixed(2),
    priceCurrency: "EUR",
    priceSpecification: { "@type": "UnitPriceSpecification", price: o.prezzo.toFixed(2), priceCurrency: "EUR", valueAddedTaxIncluded: false },
  },
};
---

<Base
  title={`${titoloBreve}: ${euro(o.prezzo)} + IVA`}
  crumb={titoloBreve}
  description={`${o.lede} ${tipo.label}, ${euro(o.prezzo)} + IVA a ${o.unita}. Che cosa è incluso, come si svolge, condizioni.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />

  <header class="p-hero section--ink" aria-labelledby="p-heading">
    <DotGrid />
    <div class="container">
      <nav class="p-crumbs" aria-label="Percorso">
        <a href="/acquista">Acquista online</a>
        <span aria-hidden="true">/</span>
        <span>{tipo.plurale}</span>
      </nav>
      <p class="eyebrow">{tipo.label}</p>
      <h1 id="p-heading" class="p-hero__title">{o.titolo}</h1>
      <p class="p-hero__lede">{o.lede}</p>
    </div>
  </header>

  <div class="section">
    <div class="container p-grid">
      <article class="p-body">
        <section aria-labelledby="per-chi">
          <h2 id="per-chi">Per chi è</h2>
          <p>{o.perChi}</p>
          {o.quando && (<><h3>Quando è la scelta giusta</h3><p>{o.quando}</p></>)}
          {o.problema && (<><h3>Il problema che risolve</h3><p>{o.problema}</p></>)}
        </section>

        <section aria-labelledby="ricevi">
          <h2 id="ricevi">Che cosa ricevi</h2>
          <ul class="p-ticks">{o.ricevi.map((r) => <li>{r}</li>)}</ul>
        </section>

        <section aria-labelledby="svolge">
          <h2 id="svolge">Come si svolge</h2>
          <ol class="p-steps">{o.passi.map((p) => <li>{p}</li>)}</ol>
        </section>

        <section aria-labelledby="dettagli">
          <h2 id="dettagli">Durata, prerequisiti e condizioni</h2>
          <dl class="p-dl">
            {o.dettagli.map((d) => (
              <div><dt>{d.k}</dt><dd>{d.v}</dd></div>
            ))}
          </dl>
        </section>

        <section aria-labelledby="prezzo">
          <h2 id="prezzo">Prezzo e componenti</h2>
          <p>
            Prezzo di listino <s>{euro(o.listino)}</s> a {o.unita} + IVA. <strong>Primo ordine dal sito: {euro(o.prezzo)}</strong> a {o.unita} + IVA {o.iva}% ({euro(conIva(o.prezzo, o.iva) - o.prezzo)}) = <strong>{euro(conIva(o.prezzo, o.iva))}</strong>.
            Il prezzo del primo ordine vale una sola volta per cliente (stessa partita IVA, codice fiscale o email): dal secondo si applica il listino. Nessun costo nascosto: quello che è escluso è elencato qui sotto.
          </p>
          <div class="p-two">
            {o.incluso.length > 0 && (
              <div>
                <h3>Incluso</h3>
                <ul class="p-ticks">{o.incluso.map((x) => <li>{x}</li>)}</ul>
              </div>
            )}
            {o.escluso.length > 0 && (
              <div>
                <h3>Escluso</h3>
                <ul class="p-ticks p-ticks--no">{o.escluso.map((x) => <li>{x}</li>)}</ul>
              </div>
            )}
          </div>
        </section>

        {o.chiEroga && (
          <section aria-labelledby="chi">
            <h2 id="chi">Chi lo eroga</h2>
            <p>{o.chiEroga}</p>
          </section>
        )}

        <section aria-labelledby="dopo">
          <h2 id="dopo">Che cosa succede dopo la richiesta</h2>
          <ol class="p-steps">
            <li>Ti rispondiamo entro 2 giorni lavorativi con conferma e istruzioni di pagamento</li>
            {o.dopo.map((d) => <li>{d}</li>)}
          </ol>
        </section>

        {o.faq.length > 0 && (
          <section aria-labelledby="faq">
            <h2 id="faq">Domande frequenti</h2>
            {o.faq.map((f) => (
              <details class="p-faq">
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}
      </article>

      <aside class="p-aside" aria-labelledby="ordine-heading">
        {/* Invio gestito da src/scripts/lead-form.ts → Klaviyo (client-side). */}
        <form id="ordine" class="order" data-lead-form data-lead-origin="Richiesta d'ordine sito" data-order data-prezzo={o.prezzo} data-iva={o.iva}>
          <p class="order__tipo">{tipo.label}</p>
          <h2 id="ordine-heading" class="sr-only">Richiedi l’ordine</h2>
          <p class="order__listino">Listino <s>{euro(o.listino)}</s> + IVA</p>
          <p class="order__cifra">{euro(o.prezzo)} <small>+ IVA {o.iva}% · a {o.unita} · primo ordine dal sito</small></p>
          <p class="order__tot">Totale con IVA: <strong data-order-tot>{euro(conIva(o.prezzo, o.iva))}</strong>{perPersona && <span data-order-per> ({euro(conIva(o.prezzo, o.iva))} a partecipante)</span>}</p>

          <input type="text" name="company_website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="area" value={`Ordine: ${o.titolo}`} />
          <input type="hidden" data-lead-prop="Offerta" value={o.slug} />
          <input type="hidden" data-lead-prop="Prezzo unitario" value={`${euro(o.prezzo)} + IVA a ${o.unita}`} />
          <input type="hidden" data-lead-prop="Totale stimato IVA inclusa" data-order-tot-field value={euro(conIva(o.prezzo, o.iva))} />

          {perPersona && (
            <div class="field field--qty">
              <label for="o-qty">Partecipanti</label>
              <div class="qty">
                <button type="button" data-qty="-1" aria-label="Un partecipante in meno">−</button>
                <input id="o-qty" type="number" min="1" max="30" value="1" inputmode="numeric" data-lead-prop="Partecipanti" data-order-qty />
                <button type="button" data-qty="1" aria-label="Un partecipante in più">+</button>
              </div>
            </div>
          )}
          <div class="field">
            <label for="o-nome">Nome e cognome *</label>
            <input id="o-nome" name="nome" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="o-azienda">Azienda o ragione sociale</label>
            <input id="o-azienda" name="azienda" type="text" autocomplete="organization" />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="o-email">Email *</label>
              <input id="o-email" name="email" type="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="o-tel">Telefono *</label>
              <input id="o-tel" type="tel" required autocomplete="tel" data-lead-prop="Telefono" />
            </div>
          </div>
          <div class="field">
            <label for="o-piva">Partita IVA o codice fiscale</label>
            <input id="o-piva" type="text" autocomplete="off" data-lead-prop="P.IVA / C.F." />
          </div>
          <div class="field">
            <label for="o-brief">Note e brief (puoi completarlo dopo)</label>
            <textarea id="o-brief" name="messaggio" rows="3" placeholder={briefPlaceholder}></textarea>
          </div>
          <label class="consent">
            <input type="checkbox" name="privacy" required />
            <span>Ho letto l’<a href="/privacy">informativa privacy</a> e acconsento al trattamento dei dati per gestire la richiesta. *</span>
          </label>
          <label class="consent">
            <input type="checkbox" name="marketing" />
            <span>Voglio ricevere avvisi su bandi, scadenze e novità normative (facoltativo).</span>
          </label>
          <button type="submit" class="btn btn--primary btn--cta">
            Invia la richiesta d’ordine
            <span class="btn__arrow" aria-hidden="true">→</span>
          </button>
          <p class="order__note">Nessun pagamento ora: ti confermiamo disponibilità e ti mandiamo le istruzioni di pagamento. Fattura elettronica inclusa.</p>
          <p class="form-status" data-lead-status role="status" aria-live="polite" hidden></p>

          <div class="form-thanks" data-lead-success role="status" hidden>
            <span class="form-thanks__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
            </span>
            <span class="form-thanks__title">Richiesta inviata<span data-thanks-name></span>!</span>
            <span class="form-thanks__text">Ti scriviamo entro 2 giorni lavorativi con conferma e istruzioni di pagamento. Per urgenze: <a href="tel:+390816580779">081 658 0779</a>.</span>
          </div>
        </form>
      </aside>
    </div>
  </div>

  {/* Mobile: il form sta in fondo alla scheda, la barra lo tiene a portata di dito. */}
  <a href="#ordine" class="p-mbar" data-mbar>
    <span><strong>{euro(o.prezzo)}</strong> + IVA · a {o.unita}</span>
    <span class="p-mbar__cta">Richiedi <span aria-hidden="true">→</span></span>
  </a>

  {correlate.length > 0 && (
    <section class="section section--alt" aria-labelledby="altre-heading">
      <div class="container">
        <div class="more__head">
          <h2 id="altre-heading" class="more__title">Altri {tipo.plurale.toLowerCase()}</h2>
          <a href="/acquista#catalogo" class="link-cta">Tutto il catalogo <span class="link-cta__arrow" aria-hidden="true">→</span></a>
        </div>
        <ul class="more">
          {correlate.map((c) => (
            <li>
              <a href={`/acquista/${c.slug}`} class="more__link">
                <span class="more__t">{c.titolo}</span>
                <span class="more__p"><strong>{euro(c.prezzo)}</strong> + IVA · a {c.unita}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Base>

<script>
  import "../../scripts/lead-form.ts";

  // La barra mobile sparisce quando il form è già in vista.
  const mbar = document.querySelector<HTMLElement>("[data-mbar]");
  const ordine = document.getElementById("ordine");
  if (mbar && ordine && "IntersectionObserver" in window) {
    new IntersectionObserver(([e]) => mbar.classList.toggle("is-hidden", e.isIntersecting || e.boundingClientRect.top < 0)).observe(ordine);
  }

  // Totale che segue il numero di partecipanti.
  document.querySelectorAll<HTMLFormElement>("[data-order]").forEach((form) => {
    const qty = form.querySelector<HTMLInputElement>("[data-order-qty]");
    if (!qty) return;
    const prezzo = Number(form.dataset.prezzo), iva = Number(form.dataset.iva);
    const tot = form.querySelector<HTMLElement>("[data-order-tot]")!;
    const totField = form.querySelector<HTMLInputElement>("[data-order-tot-field]")!;
    const fmt = new Intl.NumberFormat("it-IT", { style: "currency", currency: "EUR" });
    const update = () => {
      const n = Math.min(30, Math.max(1, Math.round(Number(qty.value) || 1)));
      const v = fmt.format(Math.round(prezzo * n * (100 + iva)) / 100);
      tot.textContent = v;
      totField.value = v;
      tot.classList.remove("is-bump");
      void tot.offsetWidth;
      tot.classList.add("is-bump");
    };
    qty.addEventListener("input", update);
    qty.addEventListener("change", () => { qty.value = String(Math.min(30, Math.max(1, Math.round(Number(qty.value) || 1)))); update(); });
    form.querySelectorAll<HTMLButtonElement>("[data-qty]").forEach((b) =>
      b.addEventListener("click", () => {
        qty.value = String(Math.min(30, Math.max(1, (Number(qty.value) || 1) + Number(b.dataset.qty))));
        update();
      })
    );
  });
</script>

<style>
  .p-hero { position: relative; isolation: isolate; overflow: clip; padding-block: var(--space-2xl) var(--space-3xl); }
  .p-crumbs { display: flex; flex-wrap: wrap; gap: 0.5em; margin-bottom: var(--space-lg); font-size: var(--text-sm); color: color-mix(in oklch, var(--color-paper) 60%, transparent); }
  .p-crumbs a { text-underline-offset: 3px; }
  .p-hero__title { font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.025em; line-height: 1.05; max-width: 26ch; margin: 0 0 var(--space-md); }
  .p-hero__lede { font-size: var(--text-lg); line-height: 1.55; max-width: 56ch; margin: 0; }

  .p-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, 25rem); gap: var(--space-3xl); align-items: start; }
  .p-body { display: flex; flex-direction: column; gap: var(--space-2xl); }
  .p-body h2 { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0 0 var(--space-md); }
  .p-body h3 { font-size: var(--text-lg); font-weight: 500; margin: var(--space-lg) 0 var(--space-2xs); }
  .p-body p { font-size: var(--text-md); color: var(--color-ink-2); line-height: 1.6; max-width: 62ch; margin: 0; }
  .p-body s { color: var(--color-muted); }

  .p-ticks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
  .p-ticks li { position: relative; padding-left: 1.9rem; font-size: var(--text-md); color: var(--color-ink-2); line-height: 1.5; }
  .p-ticks li::before {
    content: "✓";
    position: absolute; left: 0; top: 0.1em;
    display: grid; place-items: center;
    width: 1.3rem; height: 1.3rem; border-radius: 50%;
    background: var(--color-accent-soft); color: var(--color-accent);
    font-size: 0.72rem; font-weight: 700;
  }
  .p-ticks--no li::before { content: "–"; background: var(--color-paper-2); color: var(--color-muted); }
  .p-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-lg); }

  .p-steps { list-style: none; margin: 0; padding: 0; counter-reset: s; display: flex; flex-direction: column; }
  .p-steps li {
    counter-increment: s;
    position: relative;
    padding: 0 0 var(--space-md) 2.6rem;
    font-size: var(--text-md);
    color: var(--color-ink-2);
    line-height: 1.5;
  }
  .p-steps li::before {
    content: counter(s, decimal-leading-zero);
    position: absolute; left: 0; top: 0;
    font-family: var(--font-mono); font-size: var(--text-sm); font-weight: 600;
    color: var(--color-accent); letter-spacing: 0.04em; padding-top: 0.15em;
  }
  .p-steps li:not(:last-child)::after {
    content: "";
    position: absolute; left: 0.7rem; top: 1.7rem; bottom: 0.3rem;
    width: 1px; background: var(--color-rule);
  }

  .p-dl { margin: 0; display: flex; flex-direction: column; }
  .p-dl > div { display: grid; grid-template-columns: minmax(7rem, 11rem) 1fr; gap: var(--space-md); padding: var(--space-sm) 0; border-top: var(--rule-hair) solid var(--color-rule); }
  .p-dl > div:first-child { border-top: 0; padding-top: 0; }
  .p-dl dt { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent); padding-top: 0.2em; }
  .p-dl dd { margin: 0; font-size: var(--text-md); color: var(--color-ink-2); line-height: 1.5; }

  .p-faq { border-top: var(--rule-hair) solid var(--color-rule); padding: var(--space-sm) 0; }
  .p-faq summary { cursor: pointer; font-weight: 500; font-size: var(--text-md); }
  .p-faq p { margin-top: var(--space-xs); }

  /* ───── Riquadro ordine ───── */
  .p-aside { position: sticky; top: calc(var(--header-h) + var(--space-md)); }
  .order {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lift);
  }
  .order__tipo { margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent); }
  .order__listino { margin: 0; font-size: var(--text-sm); color: var(--color-muted); }
  .order__cifra { margin: 0; font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.02em; line-height: 1.05; color: var(--color-ink); }
  .order__cifra small { display: block; margin-top: 0.35rem; font-family: var(--font-body); font-size: var(--text-xs); font-weight: 400; letter-spacing: 0; color: var(--color-muted); }
  .order__tot { margin: 0 0 var(--space-xs); padding-bottom: var(--space-sm); border-bottom: 1px solid var(--color-rule); font-size: var(--text-sm); color: var(--color-ink-2); }
  .order__tot strong { display: inline-block; color: var(--color-ink); }
  .order__tot strong.is-bump { animation: tot-bump 400ms var(--ease-out); }
  @keyframes tot-bump { 40% { transform: scale(1.08); color: var(--color-accent); } }
  .order__note { margin: 0; font-size: var(--text-xs); color: var(--color-muted); line-height: 1.5; text-align: center; }

  .field { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .field label { font-size: var(--text-sm); color: var(--color-ink-2); font-weight: 500; }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    background: var(--color-paper);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-input);
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-ink);
  }
  .field input:focus,
  .field textarea:focus { border-color: var(--color-accent); outline: 2px solid var(--color-focus); outline-offset: 1px; }
  .field textarea { resize: vertical; }
  .field-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm); }

  .qty { display: inline-flex; align-items: stretch; border: 1px solid var(--color-rule); border-radius: var(--radius-input); overflow: hidden; width: max-content; }
  .qty button { font: inherit; font-size: var(--text-lg); width: 2.6rem; border: 0; background: var(--color-paper-2); color: var(--color-ink); cursor: pointer; }
  .qty button:hover { background: var(--color-accent-soft); color: var(--color-accent); }
  .field .qty input { width: 3.5rem; border: 0; border-radius: 0; text-align: center; font-weight: 600; -moz-appearance: textfield; }
  .qty input::-webkit-inner-spin-button,
  .qty input::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

  .consent { display: flex; gap: 0.55rem; align-items: flex-start; font-size: var(--text-xs); color: var(--color-ink-2); line-height: 1.5; }
  .consent a { color: var(--color-accent); }
  .consent input { margin-top: 0.2rem; }

  .p-mbar { display: none; }
  @media (max-width: 64rem) {
    .p-mbar {
      position: fixed; left: var(--space-sm); right: var(--space-sm); bottom: var(--space-sm); z-index: 40;
      display: flex; justify-content: space-between; align-items: center; gap: var(--space-sm);
      padding: 0.6rem 0.6rem 0.6rem 1rem;
      background: var(--color-ink); color: var(--color-paper);
      border-radius: 999px; box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5);
      font-size: var(--text-sm); text-decoration: none;
      transition: transform 300ms var(--ease-out), opacity 300ms;
    }
    .p-mbar strong { font-size: var(--text-md); }
    .p-mbar.is-hidden { transform: translateY(150%); opacity: 0; pointer-events: none; }
    .p-mbar__cta { padding: 0.55rem 1rem; border-radius: 999px; background: var(--color-accent); color: #fff; font-weight: 600; }
  }

  /* ───── Correlate ───── */
  .more__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-md); margin-bottom: var(--space-lg); }
  .more__title { font-size: var(--text-2xl); font-weight: 500; letter-spacing: -0.02em; margin: 0; }
  .more { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-md); }
  .more__link {
    display: flex; flex-direction: column; justify-content: space-between; gap: var(--space-md);
    height: 100%; padding: var(--space-lg);
    background: var(--color-surface); border: 1px solid var(--color-rule); border-radius: var(--radius-card);
    color: var(--color-ink); text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out), transform 300ms var(--ease-out);
  }
  .more__link:hover { border-color: var(--color-accent); transform: translateY(-3px); text-decoration: none; }
  .more__t { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500; line-height: 1.25; }
  .more__p { font-size: var(--text-sm); color: var(--color-muted); }
  .more__p strong { font-size: var(--text-lg); color: var(--color-ink); }

